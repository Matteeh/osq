@@ -0,0 +1,46 @@
+//! Corpus test: this repository breaks none of the link rules the repository
+//! gate checks.
+
+use std::path::{Path, PathBuf};
+
+use osq_kernel_linter::link_gates;
+
+/// The link rules the repository gate blocks on.
+const GATED: [&str; 3] = [
+    "complete-capabilities",
+    "live-references",
+    "tagged-functions",
+];
+
+/// The repository root, three folders above this crate.
+fn repository_root() -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR"))
+        .ancestors()
+        .nth(3)
+        .expect("the repository root is three folders above crates/kernel/linter")
+        .to_path_buf()
+}
+
+/// Covers: rust-linter/repository-passes-the-link-gates
+#[test]
+#[ignore = "corpus test: runs the link gates on this repository"]
+fn repository_passes_the_link_gates() {
+    let findings = link_gates(
+        &repository_root(),
+        Path::new("decisions"),
+        Path::new("openspec"),
+        "rust",
+    )
+    .expect("the repository builds");
+
+    let failures: Vec<String> = findings
+        .iter()
+        .filter(|finding| GATED.contains(&finding.rule.as_str()))
+        .map(|finding| format!("{finding}\n  fix: {}", finding.fix))
+        .collect();
+    assert!(
+        failures.is_empty(),
+        "link gate findings:\n{}",
+        failures.join("\n")
+    );
+}
