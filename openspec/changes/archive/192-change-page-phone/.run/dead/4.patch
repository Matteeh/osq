+      document,
+      pending: false,
+      reason,
+      onReasonChange: () => {},
+      onRun: () => {},
+    }),
+  );
+}
+
+function renderTable(tasks: readonly WebTask[], targets: readonly string[]): string {
+  return renderToStaticMarkup(
+    createElement(TaskTable, { tasks, retry: { targets, pending: false, onRetry: () => {} } }),
+  );
+}
+
+describe('approval buttons', () => {
+  it('shows Approve in the bar and the manual command in the More actions menu', () => {
+    const document = actionsDoc([APPROVE], ['osq plan 001']);
+    const bar = renderBar(document);
+    const menu = renderMenu(document);
+
+    assert.match(bar, />Approve<\/button>/);
+    const combined = bar + menu;
+    assert.equal((combined.match(/class="action-button"/g) ?? []).length, 1);
+    assert.equal(bar.includes('>Land<'), false);
+    assert.equal(bar.includes('>Reject<'), false);
+    assert.equal(bar.includes('>Retry'), false);
+
+    assert.match(menu, /<summary aria-label="More actions">More actions<\/summary>/);
+    assert.match(menu, /<code>osq plan 001<\/code>/);
+  });
+});
+
+describe('result after a tap', () => {
+  it('shows the exit code, the message, and the next step', () => {
+    const result: WebActionResult = {
+      exitCode: 1,
+      stdout: '',
+      stderr: '',
+      error: { message: 'Error retrying 001 2:', next: 'osq retry 001 2' },
+    };
+    const html = renderToStaticMarkup(createElement(ActionResult, { result }));
+    assert.match(html, /Exit code 1/);
+    assert.match(html, /Error retrying 001 2:/);
+    assert.match(html, /Next: osq retry 001 2/);
+  });
+});
+
+describe('static export has no buttons', () => {
+  it('shows no action button and makes no actions request', () => {
+    const originalFetch = globalThis.fetch;
+    let requested = false;
+    globalThis.fetch = (() => {
+      requested = true;
+      throw new Error('no actions request is allowed');
+    }) as typeof globalThis.fetch;
+    let html = '';
+    try {
+      html = renderToStaticMarkup(createElement(ChangeView, { change: webChange() }));
+    } finally {
+      globalThis.fetch = originalFetch;
+    }
+    assert.equal(html.includes('action-button'), false);
+    assert.equal(html.includes('page-menu'), false);
+    assert.equal(requested, false);
+  });
+});
+
+describe('reject in the menu', () => {
+  it('puts Reject in the menu, Retry task 2 in its row, and only Approve in the bar', () => {
+    const document = actionsDoc([APPROVE, REJECT, RETRY_TASK_2]);
+    const bar = renderBar(document);
+    const menu = renderMenu(document);
+    const table = renderTable([task({ taskNumber: '2', title: 'Second' })], ['2']);
+
+    assert.equal((bar.match(/class="action-button"/g) ?? []).length, 1);
+    assert.match(bar, />Approve<\/button>/);
+    assert.equal(bar.includes('Retry task 2'), false);
+
+    const summaryIndex = menu.indexOf('aria-label="More actions"');
+    const rejectIndex = menu.indexOf('>Reject</button>');
+    const reasonIndex = menu.indexOf('class="action-reason-input"');
+    assert.ok(summaryIndex >= 0, 'the menu should show');
+    assert.ok(summaryIndex < rejectIndex, 'Reject should be inside the menu');
+    assert.ok(rejectIndex < reasonIndex, 'the reason field should follow Reject');
+
+    assert.match(table, /data-task="2"[\s\S]*Retry task 2[\s\S]*<\/tr>/);
+  });
+});
