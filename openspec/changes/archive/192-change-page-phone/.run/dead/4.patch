@@ -0,0 +1,77 @@
+import type { ReactElement } from 'react';
+import type { ApprovalFlag, WebAction, WebActionsDocument } from '../contracts.js';
+import { ApprovalFlags } from './ApprovalFlags.js';
+import type { ChangePageMain } from './page-model.js';
+
+export interface ActionButtonsProps {
+  readonly main: ChangePageMain;
+  readonly document: WebActionsDocument | null;
+  readonly pending: boolean;
+  readonly onRun: (action: WebAction) => void;
+  readonly flags?: readonly ApprovalFlag[];
+  readonly approveBlockedBy?: readonly string[];
+}
+
+function findAction(
+  document: WebActionsDocument | null,
+  verb: 'approve' | 'land',
+): WebAction | undefined {
+  return document?.actions.find((action) => action.verb === verb);
+}
+
+/**
+ * The button bar's main action item: the `Approve` item when the page's main
+ * is approve and the actions hold it, the `Land` item when the main is land
+ * and they hold that. The Approve item also holds the red-notice note and the
+ * review's flags. Without it the flags show where the bar begins.
+ *
+ * @scenario web-inspection: Approval buttons
+ * @scenario web-inspection: Reject in the menu
+ */
+export function ActionButtons({
+  main,
+  document,
+  pending,
+  onRun,
+  flags = [],
+  approveBlockedBy = [],
+}: ActionButtonsProps): ReactElement | null {
+  const approve = findAction(document, 'approve');
+  if (main === 'approve' && approve !== undefined) {
+    const blocked = approveBlockedBy.length > 0;
+    return (
+      <div className="action-item">
+        <button
+          type="button"
+          className="action-button"
+          disabled={pending || blocked}
+          onClick={() => onRun(approve)}
+        >
+          Approve
+        </button>
+        {blocked ? (
+          <p className="action-blocked" role="note">
+            Open each red notice to approve: {approveBlockedBy.join(', ')}
+          </p>
+        ) : null}
+        <ApprovalFlags flags={flags} />
+      </div>
+    );
+  }
+  const land = findAction(document, 'land');
+  if (main === 'land' && land !== undefined) {
+    return (
+      <div className="action-item">
+        <button
+          type="button"
+          className="action-button"
+          disabled={pending}
+          onClick={() => onRun(land)}
+        >
+          Land
+        </button>
+      </div>
+    );
+  }
+  return <ApprovalFlags flags={flags} />;
+}
