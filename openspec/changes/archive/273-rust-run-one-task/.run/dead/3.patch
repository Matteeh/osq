+//! The dead marker bodies `run` writes, in TypeScript's shapes (ADR 025).
+
+/// How many trailing bytes of a verify output a marker keeps.
+const OUTPUT_TAIL_BYTES: usize = 2000;
+
+/// The tail of a verify output, at most [`OUTPUT_TAIL_BYTES`] bytes long.
+///
+/// Implements: rust-run/run-verdict
+fn tail(output: &str) -> &str {
+    if output.len() <= OUTPUT_TAIL_BYTES {
+        return output;
+    }
+    let limit = output.len() - OUTPUT_TAIL_BYTES;
+    match output.char_indices().find(|(index, _)| *index >= limit) {
+        Some((index, _)) => &output[index..],
+        None => output,
+    }
+}
+
+/// The marker for an executor that died with `code` and `error`.
+///
+/// Implements: rust-run/executor-start
+pub(crate) fn crashed(code: i32, error: Option<&str>) -> String {
+    let error = error.unwrap_or_default();
+    format!(
+        "---\nreason: crashed\nexit_code: {code}\n---\nAgent crashed with code {code}: {error}\n"
+    )
+}
+
+/// The marker for an executor that hit its timeout with `code` and `error`.
+///
+/// Implements: rust-run/executor-start
+pub(crate) fn timeout(code: i32, error: Option<&str>) -> String {
+    let error = error.unwrap_or_default();
+    format!(
+        "---\nreason: timeout\nexit_code: {code}\n---\nAgent timed out with code {code}: {error}\n"
+    )
+}
+
+/// The marker for a task whose run wrote files outside its scope.
+///
+/// Implements: rust-run/run-scope-audit
+pub(crate) fn scope_violation(files: &[String]) -> String {
+    format!("---\nreason: scope_violation\n---\n{}\n", files.join("\n"))
+}
+
+/// The marker for a task that changed a frozen test without authorization.
+///
+/// Implements: rust-run/run-scope-audit
+pub(crate) fn undeclared_test_change(paths: &[String]) -> String {
+    let listed: Vec<String> = paths.iter().map(|path| format!("- {path}")).collect();
+    format!(
+        "---\nreason: undeclared_test_change\n---\nPreexisting test files were modified or deleted without both tests.modify: true and an authorizing scope entry:\n{}\n",
+        listed.join("\n")
+    )
+}
+
+/// The marker for a task whose result file the executor never wrote.
+///
+/// Implements: rust-run/run-verdict
+pub(crate) fn no_result(task: &str) -> String {
+    format!(
+        "---\nreason: no_result\n---\nAgent exited without writing result file at .run/results/{task}.md and produced no final text.\n"
+    )
+}
+
+/// The marker for a task whose result file states a real `## Blocked` need.
+///
+/// Implements: rust-run/run-verdict
+pub(crate) fn blocked(need: &str) -> String {
+    format!("---\nreason: blocked\n---\n{need}\n")
+}
+
+/// The marker for a task whose own verify failed, or timed out.
+///
+/// Implements: rust-run/run-verdict
+pub(crate) fn verify_red(command: &str, timed_out: bool, output: &str) -> String {
+    let timeout = if timed_out { "timed_out: true\n" } else { "" };
+    format!(
+        "---\nreason: verify_red\n{timeout}command: \"{command}\"\n---\nWatcher independent verify failed:\n{}\n",
+        tail(output)
+    )
+}
+
+/// The marker for a change whose verify failed, or timed out, after the task's.
+///
+/// Implements: rust-run/run-verdict
+pub(crate) fn change_verify_red(
+    command: &str,
+    exit_code: i32,
+    timed_out: bool,
+    output: &str,
+) -> String {
+    let timeout = if timed_out { "timed_out: true\n" } else { "" };
+    format!(
+        "---\nreason: change_verify_red\n{timeout}command: \"{command}\"\nexit_code: {exit_code}\n---\nChange-level verification failed after task verification passed.\n{}\n",
+        tail(output)
+    )
+}
