+/// Proves a red verify keeps the last 2000 bytes of its output.
+///
+/// Covers: rust-run/run-outcomes
+#[test]
+fn long_verify_output_keeps_its_tail() {
+    let root = repo("long-width", "done");
+    let multibyte =
+        "printf x; i=0; while [ $i -lt 1199 ]; do printf 'é'; i=$((i+1)); done; printf y; exit 1";
+    let expected = format!("{}y", "é".repeat(999));
+    assert_tail(&root, multibyte, &expected);
+
+    let root = repo("long-ascii", "done");
+    let ascii = "i=0; while [ $i -lt 2500 ]; do printf a; i=$((i+1)); done; exit 1";
+    assert_tail(&root, ascii, &"a".repeat(2000));
+}
+
+/// Proves one red verify's marker keeps exactly `expected` as its tail.
+fn assert_tail(root: &Path, command: &str, expected: &str) {
+    set_task_verify(root, command);
+    support::run(root, &["1", "1"]).expect_err("the task verify is red");
+    let marker = format!(
+        "---\nreason: verify_red\ncommand: \"{command}\"\n---\nWatcher independent verify failed:\n{expected}\n"
+    );
+    assert_eq!(dead_marker(root), marker);
+}
