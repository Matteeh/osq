+/// Proves the done row's record, event, verify, prompt and tick.
+///
+/// Covers: rust-run/done-task
+#[test]
+fn done_task() {
+    let root = repo("done-task", "done");
+    let output = support::run(&root, &["1", "1"]).expect("the row is done");
+    assert_eq!(output.text, "Task 1 of 001-a done\n");
+    let stamp = fs::read_to_string(inside(&root, &format!(".run/done/{TASK}")))
+        .expect("the done marker reads");
+    assert!(
+        stamp.len() == 25 && stamp.ends_with("Z\n"),
+        "one time: {stamp}"
+    );
+    let line = support::last_event(&root, TASK);
+    let envelope = parse_event_line(&line).expect("the last event parses");
+    match envelope.event {
+        Event::Done(data) => assert_eq!(data.task, TASK),
+        other => panic!("expected a done event, got {other:?}"),
+    }
+    let change_events = events(&root, "change");
+    assert!(
+        change_events
+            .iter()
+            .any(|envelope| matches!(&envelope.event, Event::VerifyRan(_))),
+        "the change stream holds a verify_ran event"
+    );
+    for stream in [events(&root, TASK), change_events] {
+        for envelope in stream {
+            if let Event::VerifyRan(data) = envelope.event {
+                assert!(data.output.is_none(), "an empty output stays absent");
+            }
+        }
+    }
+    let args = fs::read_to_string(inside(&root, ".run/fake-pi-args.txt"))
+        .expect("the fake pi wrote its arguments");
+    assert!(args.contains("Task File:"), "the prompt reaches pi: {args}");
+    assert!(
+        args.contains("Verify Command: test -f src/a.txt"),
+        "the prompt names the verify: {args}"
+    );
+    let tasks = support::read_text(&root, &format!("openspec/changes/{FOLDER}/tasks.md"));
+    assert!(
+        tasks.contains("- [x] 1. When run, it works"),
+        "the checkbox is ticked: {tasks}"
+    );
+}
