+//! The before and after git snapshots and the task's scope audit (ADR 017).
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::fs;
+use std::path::Path;
+
+use osq_core::FeatureError;
+use osq_core::{ChangedPath, Disallowed, LockRule, PathChange, ScopeAudit, audit_scope};
+use osq_kernel_specs::TaskFile;
+use osq_kernel_storage::ChangeEntry;
+use osq_kernel_vcs::{GitVcs, Vcs};
+use sha2::{Digest, Sha256};
+
+/// One status path's porcelain code and the hash of its bytes, or none.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct Entry {
+    /// The two-letter porcelain code, such as `??` or ` M`.
+    pub(crate) code: String,
+    /// The hash of the file's bytes, absent when the file is missing.
+    pub(crate) hash: Option<[u8; 32]>,
+}
+
+/// One run's git status, as path to entry.
+pub(crate) type Snapshot = BTreeMap<String, Entry>;
+
+/// Reads the status of every working tree path with a hash of its bytes.
+///
+/// # Errors
+///
+/// Returns a `Failed` error with the command `run` when git status cannot be
+/// read.
+///
+/// Implements: rust-run/run-scope-audit
+pub(crate) fn snapshot(root: &Path, vcs: &GitVcs) -> Result<Snapshot, FeatureError> {
+    let entries = vcs
+        .status()
+        .map_err(|error| FeatureError::failed("run", error.to_string()))?;
+    let mut snapshot = Snapshot::new();
+    for entry in entries {
+        let hash = fs::read(root.join(&entry.path))
+            .ok()
+            .map(|bytes| hash(&bytes));
+        snapshot.insert(
+            entry.path,
+            Entry {
+                code: entry.code,
+                hash,
+            },
+        );
+    }
+    Ok(snapshot)
+}
+
+/// The SHA-256 hash of `bytes`, so equal files hash equally within one run.
+fn hash(bytes: &[u8]) -> [u8; 32] {
+    Sha256::digest(bytes).into()
+}
+
+/// Audits every path the start changed against the task's scope.
+///
+/// Implements: rust-run/run-scope-audit
+pub(crate) fn audit(
+    root: &Path,
+    entry: &ChangeEntry,
+    task_file: &TaskFile,
+    before: &Snapshot,
+    after: &Snapshot,
+) -> Vec<Disallowed> {
+    let changes = changed(before, after);
+    let test_folders = test_folders(root, &changes);
+    audit_scope(&ScopeAudit {
+        scope: task_file.scope.clone(),
+        tests_modify: task_file.tests_modify,
+        change_folder: relative(root, &entry.path),
+        test_folders,
+        lock_rules: lock_rules(),
+        changes,
+    })
+}
+
+/// Every path whose code or hash differs between the two snapshots.
+fn changed(before: &Snapshot, after: &Snapshot) -> Vec<ChangedPath> {
+    let mut paths: BTreeSet<&String> = before.keys().collect();
+    paths.extend(after.keys());
+    let mut changes = Vec::new();
+    for path in paths {
+        let old = before.get(path);
+        let new = after.get(path);
+        if old == new {
+            continue;
+        }
+        changes.push(ChangedPath {
+            path: path.clone(),
+            change: kind(old, new),
+        });
+    }
+    changes
+}
+
+/// How a path changed, from its old and new entries.
+fn kind(old: Option<&Entry>, new: Option<&Entry>) -> PathChange {
+    let Some(new) = new else {
+        return PathChange::Deleted;
+    };
+    if new.hash.is_none() {
+        return PathChange::Deleted;
+    }
+    if old.is_none() && is_new(new) {
+        return PathChange::Added;
+    }
+    PathChange::Modified
+}
+
+/// Whether a new entry is untracked or staged as added.
+fn is_new(entry: &Entry) -> bool {
+    entry.code == "??" || entry.code.starts_with('A')
+}
+
+/// The test folders beside the nearest `Cargo.toml` of each changed path.
+fn test_folders(root: &Path, changes: &[ChangedPath]) -> Vec<String> {
+    let mut folders = BTreeSet::new();
+    for change in changes {
+        if let Some(dir) = nearest_manifest(root, &change.path) {
+            folders.insert(join(&dir, "tests"));
+            folders.insert(join(&dir, "benches"));
+        }
+    }
+    folders.into_iter().collect()
+}
+
+/// The folder of the nearest `Cargo.toml` at or above `path`, if any.
+fn nearest_manifest(root: &Path, path: &str) -> Option<String> {
+    let mut dir = path.rsplit_once('/').map_or("", |(folder, _)| folder);
+    loop {
+        if root.join(dir).join("Cargo.toml").is_file() {
+            return Some(dir.to_owned());
+        }
+        if dir.is_empty() {
+            return None;
+        }
+        dir = dir.rsplit_once('/').map_or("", |(folder, _)| folder);
+    }
+}
+
+/// Joins a folder and a name, with no leading slash for the project root.
+fn join(folder: &str, name: &str) -> String {
+    if folder.is_empty() {
+        name.to_owned()
+    } else {
+        format!("{folder}/{name}")
+    }
+}
+
+/// The lock rules Rust's and TypeScript's manifests follow.
+fn lock_rules() -> Vec<LockRule> {
+    vec![
+        LockRule {
+            manifests: vec!["Cargo.toml".to_owned()],
+            lock_files: vec!["Cargo.lock".to_owned()],
+        },
+        LockRule {
+            manifests: vec!["package.json".to_owned()],
+            lock_files: vec![
+                "package-lock.json".to_owned(),
+                "pnpm-lock.yaml".to_owned(),
+                "yarn.lock".to_owned(),
+            ],
+        },
+    ]
+}
+
+/// One path's POSIX form relative to the project root.
+fn relative(root: &Path, path: &Path) -> String {
+    path.strip_prefix(root)
+        .unwrap_or(path)
+        .to_string_lossy()
+        .replace('\\', "/")
+}
diff --git a/crates/features/run/src/feature/start.rs b/crates/features/run/src/feature/start.rs
new file mode 100644
index 00000000..749ed47c
--- /dev/null
+++ b/crates/features/run/src/feature/start.rs
@@ -0,0 +1,198 @@
+//! Starting pi once for the executor role through the runners kernel.
+
+use std::collections::BTreeMap;
+use std::path::Path;
+use std::time::Duration;
+
+use osq_core::FeatureError;
+use osq_core::event::{Event, ExitContinuedData, ExitedData, StartedData, VerifyRanData};
+use osq_kernel_config::Config;
+use osq_kernel_harnesses::PiHarness;
+use osq_kernel_runners::{
+    Harness, HarnessExit, Role, RoleSettings, RunOutcome, RunnerSettings, SystemClock, TaskRequest,
+    run_task,
+};
+use osq_kernel_storage::ChangeEntry;
+
+use super::events;
+
+/// How one executor start ended.
+pub(crate) enum End {
+    /// Pi ran and exited, however it ended.
+    Exited(HarnessExit),
+    /// Pi could not be started at all.
+    StartFailed,
+    /// A usage limit stopped the run; the caller writes no marker.
+    Paused,
+}
+
+/// The starting attempt, the first attempt every run makes.
+const ATTEMPT: u64 = 1;
+
+/// The harness name every Rust run starts.
+const HARNESS: &str = "pi";
+
+/// The caller's inherited environment, as the processes osq starts read it.
+#[must_use]
+pub(crate) fn source_env() -> BTreeMap<String, String> {
+    std::env::vars().collect()
+}
+
+/// Starts pi once with `prompt`, forwarding every harness event to the stream.
+///
+/// # Errors
+///
+/// Returns a `Failed` error with the command `run` when an event cannot be
+/// written or the runners kernel cannot find the harness.
+///
+/// Implements: rust-run/executor-start
+pub(crate) fn start(
+    root: &Path,
+    entry: &ChangeEntry,
+    task: &str,
+    config: &Config,
+    prompt: &str,
+    source_env: &BTreeMap<String, String>,
+) -> Result<End, FeatureError> {
+    events::append(&entry.path, task, started_event(config))?;
+    let settings = settings(config);
+    let mut harnesses: BTreeMap<String, Box<dyn Harness>> = BTreeMap::new();
+    harnesses.insert(
+        HARNESS.to_owned(),
+        Box::new(PiHarness::from_config(config, source_env)),
+    );
+    let request = TaskRequest {
+        role: Role::Executor,
+        task: task.to_owned(),
+        prompt: prompt.to_owned(),
+        cwd: root.to_path_buf(),
+        source_env: source_env.clone(),
+        extra_env: BTreeMap::new(),
+    };
+    let mut failure = None;
+    let outcome = run_task(
+        &settings,
+        &request,
+        &mut harnesses,
+        &mut SystemClock,
+        &mut |event| {
+            if let Err(error) = events::append(&entry.path, task, event) {
+                failure.get_or_insert(error);
+            }
+        },
+    );
+    if let Some(error) = failure {
+        return Err(error);
+    }
+    match outcome.map_err(|error| failed(error.to_string()))? {
+        RunOutcome::Exited(exit) => {
+            events::append(&entry.path, task, exited_event(&exit))?;
+            Ok(End::Exited(exit))
+        }
+        RunOutcome::StartFailed { .. } => Ok(End::StartFailed),
+        RunOutcome::Paused(_) => Ok(End::Paused),
+    }
+}
+
+/// Appends the `exit_continued` event for an exit that wrote its result.
+///
+/// Implements: rust-run/executor-start
+pub(crate) fn record_continued(
+    entry: &ChangeEntry,
+    task: &str,
+    code: i32,
+) -> Result<(), FeatureError> {
+    events::append(
+        &entry.path,
+        task,
+        Event::ExitContinued(ExitContinuedData {
+            exit_code: i64::from(code),
+        }),
+    )
+}
+
+/// Appends one `verify_ran` event for a verify the verdict ran.
+///
+/// Implements: rust-run/run-verdict
+pub(crate) fn record_verify(
+    entry: &ChangeEntry,
+    target: &str,
+    command: &str,
+    exit_code: i32,
+    output: &str,
+) -> Result<(), FeatureError> {
+    let output = (!output.trim().is_empty()).then(|| output.to_owned());
+    events::append(
+        &entry.path,
+        target,
+        Event::VerifyRan(VerifyRanData {
+            command: command.to_owned(),
+            exit_code: Some(i64::from(exit_code)),
+            duration: None,
+            log: None,
+            verify_command: None,
+            output,
+            phase: None,
+            expected: None,
+            mismatch: None,
+            missing_paths: None,
+            task: Some(target.to_owned()),
+        }),
+    )
+}
+
+/// The runner settings one run uses: the executor role, no retries.
+fn settings(config: &Config) -> RunnerSettings {
+    let executor = RoleSettings {
+        harness: config.executor.harness.as_str().to_owned(),
+        model: config.executor.model.clone(),
+        timeout: Some(config.timeouts.task_timeout),
+    };
+    RunnerSettings {
+        executor: executor.clone(),
+        planner: executor.clone(),
+        validator: executor,
+        agent_env: Vec::new(),
+        start_retries: 0,
+        retry_delay: Duration::ZERO,
+        usage_limit_wait: Duration::ZERO,
+    }
+}
+
+/// The `started` event every run writes before its first harness event.
+fn started_event(config: &Config) -> Event {
+    Event::Started(StartedData {
+        harness: Some(HARNESS.to_owned()),
+        model: config.executor.model.clone(),
+        osq_version: None,
+        attempt: Some(ATTEMPT),
+        project_commit: None,
+        commit: None,
+        pid: None,
+        timeout_seconds: Some(config.timeouts.task_timeout.as_secs()),
+        version: None,
+        harness_version: None,
+        harness_auth: None,
+        task_title: None,
+        tier: None,
+        scope: None,
+        entry: None,
+        skills: None,
+    })
+}
+
+/// The `exited` event every run writes after its last harness event.
+fn exited_event(exit: &HarnessExit) -> Event {
+    Event::Exited(ExitedData {
+        exit_code: i64::from(exit.exit_code),
+        pid: None,
+        signal: None,
+        timed_out: Some(exit.timed_out),
+        elapsed_seconds: None,
+    })
+}
+
+/// Builds the failed error for a start step.
+fn failed(message: String) -> FeatureError {
+    FeatureError::failed("run", message)
+}
diff --git a/crates/features/run/src/feature/verdict.rs b/crates/features/run/src/feature/verdict.rs
new file mode 100644
index 00000000..3c307b92
--- /dev/null
+++ b/crates/features/run/src/feature/verdict.rs
@@ -0,0 +1,156 @@
+//! Judging a started task: its result, its verify and the change's verify.
+
+use std::collections::BTreeMap;
+use std::fs;
+use std::path::{Path, PathBuf};
+use std::time::Duration;
+
+use osq_core::FeatureError;
+use osq_core::event::DeadReason;
+use osq_kernel_config::Config;
+use osq_kernel_harnesses::{PiHarness, VerifyOutcome, VerifyRequest, run_verify};
+use osq_kernel_runners::Harness;
+use osq_kernel_specs::{TaskFile, read_proposal};
+use osq_kernel_storage::{ChangeEntry, parse_result_sections};
+
+use super::{dead, done, events, markers, start};
+
+/// Everything the verdict needs from the run that started the task.
+pub(crate) struct Verdict<'a> {
+    /// The project root every command runs in.
+    pub(crate) root: &'a Path,
+    /// The change folder the task belongs to.
+    pub(crate) entry: &'a ChangeEntry,
+    /// The task number, as it is written.
+    pub(crate) task: &'a str,
+    /// The settings the timeouts and the harness come from.
+    pub(crate) config: &'a Config,
+    /// The task's parsed file, for its verify command.
+    pub(crate) task_file: &'a TaskFile,
+    /// The caller's inherited environment.
+    pub(crate) source_env: &'a BTreeMap<String, String>,
+}
+
+impl Verdict<'_> {
+    /// Judges the task and writes its done record, or records its death.
+    ///
+    /// # Errors
+    ///
+    /// Returns a `Failed` error with the command `run` for every reason the run
+    /// verdict names, and when a marker or event cannot be written.
+    ///
+    /// Implements: rust-run/run-verdict
+    /// Implements: rust-run/done-record
+    pub(crate) fn judge(&self) -> Result<String, FeatureError> {
+        let Some(text) = self.result_text() else {
+            return dead::die(
+                self.entry,
+                self.task,
+                DeadReason::NoResult,
+                &markers::no_result(self.task),
+            );
+        };
+        if let Some(need) = parse_result_sections(&text).blocked {
+            return dead::die(
+                self.entry,
+                self.task,
+                DeadReason::Blocked,
+                &markers::blocked(&need),
+            );
+        }
+        self.verify_task()?;
+        self.verify_change()?;
+        done::finish(self.entry, self.task)
+    }
+
+    /// The result file's text, or none when the executor wrote no file.
+    fn result_text(&self) -> Option<String> {
+        fs::read_to_string(self.result_path()).ok()
+    }
+
+    /// The `.run/results/<task>.md` path of the change folder.
+    fn result_path(&self) -> PathBuf {
+        self.entry
+            .path
+            .join(".run")
+            .join("results")
+            .join(format!("{}.md", self.task))
+    }
+
+    /// Runs the task's own verify and kills the task when it is red.
+    fn verify_task(&self) -> Result<(), FeatureError> {
+        let command = self.task_file.verify.clone();
+        let timeout = self.config.timeouts.task_timeout;
+        let outcome = self.verify(&command, timeout, self.task)?;
+        if outcome.exit_code == 0 && !outcome.timed_out {
+            return Ok(());
+        }
+        let marker = markers::verify_red(&command, outcome.timed_out, &outcome.output);
+        dead::die(self.entry, self.task, DeadReason::VerifyRed, &marker)
+    }
+
+    /// Runs the proposal's verify and kills the task when it is red.
+    fn verify_change(&self) -> Result<(), FeatureError> {
+        let proposal_path = self.entry.path.join("proposal.md");
+        let proposal = read_proposal(&proposal_path)
+            .map_err(|error| FeatureError::failed("run", error.to_string()))?;
+        let timeout = self.config.timeouts.verify_timeout;
+        let outcome = self.verify(&proposal.verify, timeout, events::CHANGE)?;
+        if outcome.exit_code == 0 && !outcome.timed_out {
+            return Ok(());
+        }
+        let marker = markers::change_verify_red(
+            &proposal.verify,
+            outcome.exit_code,
+            outcome.timed_out,
+            &outcome.output,
+        );
+        dead::die(self.entry, self.task, DeadReason::ChangeVerifyRed, &marker)
+    }
+
+    /// Runs one verify command and appends its `verify_ran` event.
+    fn verify(
+        &self,
+        command: &str,
+        timeout: Duration,
+        target: &str,
+    ) -> Result<VerifyOutcome, FeatureError> {
+        let outcome = run_verify(&self.request(command, timeout))
+            .map_err(|error| FeatureError::failed("run", error.to_string()))?;
+        start::record_verify(
+            self.entry,
+            target,
+            command,
+            outcome.exit_code,
+            &outcome.output,
+        )?;
+        Ok(outcome)
+    }
+
+    /// Builds the request one verify command runs with.
+    fn request(&self, command: &str, timeout: Duration) -> VerifyRequest {
+        let harness = PiHarness::from_config(self.config, self.source_env);
+        VerifyRequest {
+            command: command.to_owned(),
+            cwd: self.root.to_path_buf(),
+            source_env: self.source_env.clone(),
+            configured_env: Vec::new(),
+            agent_env: harness.agent_env(),
+            change: Some(self.change_folder()),
+            diff: None,
+            extra_env: BTreeMap::new(),
+            timeout: Some(timeout),
+            kill_grace: self.config.timeouts.harness_kill_grace,
+        }
+    }
+
+    /// The change folder's POSIX form relative to the project root.
+    fn change_folder(&self) -> String {
+        self.entry
+            .path
+            .strip_prefix(self.root)
+            .unwrap_or(&self.entry.path)
+            .to_string_lossy()
+            .replace('\\', "/")
+    }
+}
diff --git a/crates/features/run/tests/fixtures/fake-pi/run.sh b/crates/features/run/tests/fixtures/fake-pi/run.sh
new file mode 100755
index 00000000..d1051902
--- /dev/null
+++ b/crates/features/run/tests/fixtures/fake-pi/run.sh
@@ -0,0 +1,79 @@
+#!/bin/sh
+# A fake pi for the run feature's tests: acts out `fake-pi-mode` in its folder.
+[ -n "${HOME:-}" ] || exit 4
+mode=$(cat fake-pi-mode 2>/dev/null || true)
+result=openspec/changes/001-a/.run/results/1.md
+mkdir -p openspec/changes/001-a/.run
+for argument in "$@"; do
+    printf '%s\n' "$argument"
+done > openspec/changes/001-a/.run/fake-pi-args.txt
+
+write_result() {
+    mkdir -p "$(dirname "$result")"
+    printf '%s\n' '## Changed' '' '- the fake pi' '' 'Touched: src/a.txt' > "$result"
+}
+
+write_blocked_result() {
+    mkdir -p "$(dirname "$result")"
+    printf '%s\n' '## Changed' '' '- the fake pi' '' '## Blocked' '' 'need a key' > "$result"
+}
+
+case "$mode" in
+    done)
+        mkdir -p src && printf 'a\n' > src/a.txt
+        write_result
+        ;;
+    no-file)
+        write_result
+        ;;
+    breaks-change)
+        mkdir -p src && printf 'a\n' > src/a.txt
+        printf 'broken\n' > src/broken.txt
+        write_result
+        ;;
+    no-result)
+        mkdir -p src && printf 'a\n' > src/a.txt
+        ;;
+    blocked)
+        mkdir -p src && printf 'a\n' > src/a.txt
+        write_blocked_result
+        ;;
+    outside)
+        mkdir -p src && printf 'a\n' > src/a.txt
+        printf 'outside\n' > other.txt
+        write_result
+        ;;
+    frozen)
+        mkdir -p src && printf 'a\n' > src/a.txt
+        printf '//! changed\n' > src/tests/old.rs
+        write_result
+        ;;
+    added-test)
+        mkdir -p src tests && printf 'a\n' > src/a.txt
+        printf '//! new\n' > tests/new.rs
+        write_result
+        ;;
+    lock)
+        mkdir -p src && printf 'a\n' > src/a.txt
+        printf '# changed\n' >> src/Cargo.toml
+        printf '# lock\n' > Cargo.lock
+        write_result
+        ;;
+    change-file)
+        mkdir -p src openspec/changes/001-a && printf 'a\n' > src/a.txt
+        printf 'notes\n' > openspec/changes/001-a/notes.txt
+        write_result
+        ;;
+    hang)
+        sleep 30
+        ;;
+    crash)
+        exit 3
+        ;;
+    crash-after-result)
+        mkdir -p src && printf 'a\n' > src/a.txt
+        write_result
+        exit 3
+        ;;
+esac
+exit 0
diff --git a/crates/features/run/tests/run_outcomes.rs b/crates/features/run/tests/run_outcomes.rs
new file mode 100644
index 00000000..b0c28b8a
--- /dev/null
+++ b/crates/features/run/tests/run_outcomes.rs
@@ -0,0 +1,455 @@
+//! Proves the run feature's start, scope audit, verdict and done record.
+
+mod support;
+
+use std::fs;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use osq_core::event::{DeadReason, Event, ExitedData, ScopeViolationData, StartedData};
+use osq_core::{Envelope, parse_event_line};
+
+use support::{FOLDER, TASK};
+
+/// Every "Run outcomes" row: its mode, and its dead reason or `None` for done.
+const ROWS: [(&str, Option<DeadReason>); 9] = [
+    ("done", None),
+    ("no-file", Some(DeadReason::VerifyRed)),
+    ("breaks-change", Some(DeadReason::ChangeVerifyRed)),
+    ("no-result", Some(DeadReason::NoResult)),
+    ("blocked", Some(DeadReason::Blocked)),
+    ("outside", Some(DeadReason::ScopeViolation)),
+    ("frozen", Some(DeadReason::UndeclaredTestChange)),
+    ("crash", Some(DeadReason::Crashed)),
+    ("crash-after-result", None),
+];
+
+/// The fake pi's absolute path.
+fn fake_pi() -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("tests")
+        .join("fixtures")
+        .join("fake-pi")
+        .join("run.sh")
+}
+
+/// A fresh run fixture with `timeouts` and the fake pi's absolute path.
+fn repo_with(test: &str, mode: &str, timeouts: &str) -> PathBuf {
+    let root = support::repo(&format!("{test}-{mode}"));
+    let config = format!(
+        "{timeouts}[executor]\nharness = \"pi\"\n\n[pi]\nbin = \"{}\"\n",
+        fake_pi().display()
+    );
+    support::write(&root, "osq.toml", config);
+    support::write(&root, "fake-pi-mode", format!("{mode}\n"));
+    root
+}
+
+/// A fresh run fixture with the row's mode.
+fn repo(test: &str, mode: &str) -> PathBuf {
+    repo_with(test, mode, "")
+}
+
+/// The change folder's path beneath `root`.
+fn change(root: &Path) -> PathBuf {
+    root.join("openspec").join("changes").join(FOLDER)
+}
+
+/// One file's path under the change folder.
+fn inside(root: &Path, relative: &str) -> PathBuf {
+    change(root).join(relative)
+}
+
+/// Every parsed event of one stream, `change` included.
+fn events(root: &Path, target: &str) -> Vec<Envelope> {
+    let path = inside(root, &format!(".run/events/{target}.jsonl"));
+    let text = fs::read_to_string(path).expect("the event file reads");
+    text.lines()
+        .filter(|line| !line.trim().is_empty())
+        .map(|line| parse_event_line(line).expect("the event line parses"))
+        .collect()
+}
+
+/// The task's dead marker text.
+fn dead_marker(root: &Path) -> String {
+    fs::read_to_string(inside(root, &format!(".run/dead/{TASK}.md"))).expect("the marker reads")
+}
+
+/// The first `started` event's data.
+fn started(list: &[Envelope]) -> StartedData {
+    list.iter()
+        .find_map(|envelope| match &envelope.event {
+            Event::Started(data) => Some(data.clone()),
+            _ => None,
+        })
+        .expect("the stream holds a started event")
+}
+
+/// The first `exited` event's data.
+fn exited(list: &[Envelope]) -> ExitedData {
+    list.iter()
+        .find_map(|envelope| match &envelope.event {
+            Event::Exited(data) => Some(data.clone()),
+            _ => None,
+        })
+        .expect("the stream holds an exited event")
+}
+
+/// Rewrites the task file's verify command and re-seals the change.
+fn set_task_verify(root: &Path, command: &str) {
+    let text = format!(
+        "---\ntitle: When run, it works\nverify: \"{command}\"\nverify_starts: red\nscope:\n  - src/**\nentry: []\n---\n## Acceptance\n\n- [ ] When run, it works\n"
+    );
+    support::write(
+        root,
+        &format!("openspec/changes/{FOLDER}/tasks/{TASK}.md"),
+        text,
+    );
+    support::write_seal(root);
+}
+
+/// Rewrites the proposal's verify command and re-seals the change.
+fn set_change_verify(root: &Path, command: &str) {
+    let old = "verify: \"test ! -f src/broken.txt\"";
+    let text = support::read_text(root, &format!("openspec/changes/{FOLDER}/proposal.md"));
+    let updated = text.replace(old, &format!("verify: \"{command}\""));
+    support::write(
+        root,
+        &format!("openspec/changes/{FOLDER}/proposal.md"),
+        updated,
+    );
+    support::write_seal(root);
+}
+
+/// Proves every row of "Run outcomes".
+///
+/// Covers: rust-run/run-outcomes
+#[test]
+fn run_outcomes() {
+    let test = "run-outcomes";
+    for (mode, reason) in ROWS {
+        let root = repo(test, mode);
+        let result = support::run(&root, &["1", "1"]);
+        match reason {
+            None => {
+                let output = result.expect("the row is done");
+                assert_eq!(output.text, "Task 1 of 001-a done\n", "{mode}");
+            }
+            Some(reason) => {
+                let error = result.expect_err("the row dies");
+                assert_eq!(
+                    error.to_string(),
+                    format!("run failed: task 1 of 001-a died: {}", reason.as_str()),
+                    "{mode}"
+                );
+            }
+        }
+    }
+}
+
+/// Proves the last event and the marker of every row that dies.
+///
+/// Covers: rust-run/dead-event
+#[test]
+fn dead_event() {
+    let test = "dead-event";
+    for (mode, reason) in ROWS {
+        let Some(reason) = reason else {
+            continue;
+        };
+        let root = repo(test, mode);
+        support::run(&root, &["1", "1"]).expect_err("the row dies");
+        let line = support::last_event(&root, TASK);
+        let envelope = parse_event_line(&line).expect("the last event parses");
+        match envelope.event {
+            Event::Dead(data) => {
+                assert_eq!(data.task, TASK, "{mode}: the dead task");
+                assert_eq!(data.reason, reason, "{mode}: the reason");
+            }
+            other => panic!("{mode}: expected a dead event, got {other:?}"),
+        }
+        let marker = dead_marker(&root);
+        assert!(
+            marker.starts_with(&format!("---\nreason: {}\n", reason.as_str())),
+            "{mode}: the marker reason: {marker}"
+        );
+        assert!(
+            marker.contains(&task_verify(mode)),
+            "{mode}: the marker body: {marker}"
+        );
+    }
+}
+
+/// The command a row's marker names, or its exit code when it has no verify.
+fn task_verify(mode: &str) -> String {
+    match mode {
+        "no-file" => "command: \"test -f src/a.txt\"".to_owned(),
+        "breaks-change" => "command: \"test ! -f src/broken.txt\"".to_owned(),
+        "crash" => "exit_code: 3".to_owned(),
+        "blocked" => "need a key".to_owned(),
+        "no-result" => "results/1.md".to_owned(),
+        _ => "reason:".to_owned(),
+    }
+}
+
+/// Proves the lock is gone after every row.
+///
+/// Covers: rust-run/lock-removed-after-a-run
+#[test]
+fn lock_removed_after_a_run() {
+    let test = "lock-removed";
+    for (mode, _) in ROWS {
+        let root = repo(test, mode);
+        let _ = support::run(&root, &["1", "1"]);
+        assert!(
+            !support::exists(
+                &root,
+                &format!("openspec/changes/{FOLDER}/.run/running/{TASK}.pid")
+            ),
+            "{mode}: the lock is removed"
+        );
+    }
+}
+
+/// Proves the started and exited events of the two crashing rows.
+///
+/// Covers: rust-run/executor-exits
+#[test]
+fn executor_exits() {
+    let test = "executor-exits";
+    for mode in ["crash", "crash-after-result"] {
+        let root = repo(test, mode);
+        let result = support::run(&root, &["1", "1"]);
+        let list = events(&root, TASK);
+        let start = started(&list);
+        assert_eq!(start.harness.as_deref(), Some("pi"), "{mode}: the harness");
+        assert_eq!(start.attempt, Some(1), "{mode}: the attempt");
+        let end = exited(&list);
+        assert_eq!(end.exit_code, 3, "{mode}: the exit code");
+        let exited_at = list
+            .iter()
+            .position(|envelope| matches!(&envelope.event, Event::Exited(_)))
+            .expect("the stream holds an exited event");
+        if mode == "crash" {
+            let error = result.expect_err("the row dies");
+            assert_eq!(
+                error.to_string(),
+                "run failed: task 1 of 001-a died: crashed",
+                "{mode}"
+            );
+        } else {
+            let output = result.expect("the row is done");
+            assert_eq!(output.text, "Task 1 of 001-a done\n", "{mode}");
+            let continued = list
+                .iter()
+                .position(|envelope| matches!(&envelope.event, Event::ExitContinued(_)))
+                .expect("the stream holds an exit_continued event");
+            assert!(continued > exited_at, "{mode}: continued after exited");
+        }
+    }
+}
+
+/// Proves the two scope rows.
+///
+/// Covers: rust-run/scope-outcomes
+#[test]
+fn scope_outcomes() {
+    let test = "scope-outcomes";
+    let outside = repo(test, "outside");
+    let error = support::run(&outside, &["1", "1"]).expect_err("the row dies");
+    assert_eq!(
+        error.to_string(),
+        "run failed: task 1 of 001-a died: scope_violation"
+    );
+    let files = events(&outside, TASK)
+        .into_iter()
+        .find_map(|envelope| match envelope.event {
+            Event::ScopeViolation(ScopeViolationData { files }) => Some(files),
+            _ => None,
+        })
+        .expect("the stream holds a scope_violation event");
+    assert_eq!(files, vec!["other.txt".to_owned()]);
+    assert_eq!(
+        dead_marker(&outside),
+        "---\nreason: scope_violation\n---\nother.txt\n"
+    );
+
+    let frozen = repo(test, "frozen");
+    let error = support::run(&frozen, &["1", "1"]).expect_err("the row dies");
+    assert_eq!(
+        error.to_string(),
+        "run failed: task 1 of 001-a died: undeclared_test_change"
+    );
+    assert!(
+        dead_marker(&frozen).contains("\n- src/tests/old.rs\n"),
+        "the marker lists the frozen test"
+    );
+}
+
+/// Proves the paths the audit lets through, and one only a hash catches.
+///
+/// Covers: rust-run/scope-outcomes
+#[test]
+fn audit_allowed_paths() {
+    let test = "audit-allowed";
+    for mode in ["added-test", "lock", "change-file"] {
+        let root = repo(test, mode);
+        let output = support::run(&root, &["1", "1"]).expect("the path is allowed");
+        assert_eq!(output.text, "Task 1 of 001-a done\n", "{mode}");
+    }
+
+    let root = repo(test, "outside");
+    support::write(&root, "other.txt", "before\n");
+    let error = support::run(&root, &["1", "1"]).expect_err("the content changed");
+    assert_eq!(
+        error.to_string(),
+        "run failed: task 1 of 001-a died: scope_violation"
+    );
+}
+
+/// Proves a result file older than the start does not continue the run.
+///
+/// Covers: rust-run/executor-exits
+#[test]
+fn old_result_is_not_during_the_start() {
+    let root = repo("old-result", "crash");
+    let result = inside(&root, &format!(".run/results/{TASK}.md"));
+    support::write(
+        &root,
+        &format!("openspec/changes/{FOLDER}/.run/results/{TASK}.md"),
+        "## Changed\n",
+    );
+    let status = Command::new("touch")
+        .args(["-t", "202001010000"])
+        .arg(&result)
+        .status()
+        .expect("touch runs");
+    assert!(status.success(), "the result file is made old");
+    let error = support::run(&root, &["1", "1"]).expect_err("the row dies");
+    assert_eq!(
+        error.to_string(),
+        "run failed: task 1 of 001-a died: crashed"
+    );
+}
+
+/// Proves the timeout markers of the executor and of both verifies.
+///
+/// Covers: rust-run/executor-exits
+/// Covers: rust-run/run-outcomes
+#[test]
+fn timed_out_runs() {
+    let test = "timeouts";
+    let root = repo_with(test, "hang", "[timeouts]\ntaskTimeoutSeconds = 1\n\n");
+    let error = support::run(&root, &["1", "1"]).expect_err("the executor times out");
+    assert_eq!(
+        error.to_string(),
+        "run failed: task 1 of 001-a died: timeout"
+    );
+    assert!(dead_marker(&root).starts_with("---\nreason: timeout\n"));
+
+    let root = repo_with(test, "done", "[timeouts]\ntaskTimeoutSeconds = 1\n\n");
+    set_task_verify(&root, "sleep 5");
+    let error = support::run(&root, &["1", "1"]).expect_err("the task verify times out");
+    assert_eq!(
+        error.to_string(),
+        "run failed: task 1 of 001-a died: verify_red"
+    );
+    let marker = dead_marker(&root);
+    assert!(marker.contains("timed_out: true"), "{marker}");
+
+    let root = repo_with(test, "done", "[timeouts]\nverifyTimeoutSeconds = 1\n\n");
+    set_change_verify(&root, "sleep 5");
+    let error = support::run(&root, &["1", "1"]).expect_err("the change verify times out");
+    assert_eq!(
+        error.to_string(),
+        "run failed: task 1 of 001-a died: change_verify_red"
+    );
+    let marker = dead_marker(&root);
+    assert!(marker.contains("timed_out: true"), "{marker}");
+    assert!(marker.contains("exit_code: 1"), "{marker}");
+}
