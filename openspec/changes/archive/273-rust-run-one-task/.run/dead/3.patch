+//! Recording a task whose verdict passed: its marker, its event and its tick.
+
+use std::fs;
+
+use osq_core::FeatureError;
+use osq_core::event::{DoneData, Event};
+use osq_kernel_storage::ChangeEntry;
+
+use super::{events, time};
+use crate::tick_task_checkbox;
+
+/// Writes the done marker, appends the `done` event and ticks `tasks.md`.
+///
+/// # Errors
+///
+/// Returns a `Failed` error with the command `run` when the marker, the event
+/// or the ticked `tasks.md` cannot be written.
+///
+/// Implements: rust-run/done-record
+pub(crate) fn finish(entry: &ChangeEntry, task: &str) -> Result<String, FeatureError> {
+    write_marker(entry, task)?;
+    events::append(
+        &entry.path,
+        task,
+        Event::Done(DoneData {
+            task: task.to_owned(),
+        }),
+    )?;
+    tick(entry, task)?;
+    Ok(format!("Task {task} of {} done\n", entry.folder))
+}
+
+/// Writes `.run/done/<task>` holding the UTC time and a newline.
+fn write_marker(entry: &ChangeEntry, task: &str) -> Result<(), FeatureError> {
+    let dir = entry.path.join(".run").join("done");
+    fs::create_dir_all(&dir).map_err(|error| failed(&dir, &error))?;
+    let path = dir.join(task);
+    let stamp = format!("{}\n", time::format_utc(time::now_ms()));
+    fs::write(&path, stamp).map_err(|error| failed(&path, &error))
+}
+
+/// Ticks the task's checkbox in `tasks.md`, leaving a missing file alone.
+fn tick(entry: &ChangeEntry, task: &str) -> Result<(), FeatureError> {
+    let path = entry.path.join("tasks.md");
+    let Ok(content) = fs::read_to_string(&path) else {
+        return Ok(());
+    };
+    let updated = tick_task_checkbox(&content, task);
+    if updated == content {
+        return Ok(());
+    }
+    fs::write(&path, updated).map_err(|error| failed(&path, &error))
+}
+
+/// Builds the failed error for a path that could not be written.
+fn failed(path: &std::path::Path, error: &std::io::Error) -> FeatureError {
+    FeatureError::failed("run", format!("cannot write {}: {error}", path.display()))
+}
