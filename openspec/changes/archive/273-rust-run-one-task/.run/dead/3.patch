-+/// Reads the result, then runs the task's verify and the proposal's verify.
-+///
-+/// # Errors
-+///
-+/// Returns a `Failed` error with the command `run` for a missing result, a
-+/// blocked task, a red verify, and a file or command that cannot be read.
-+///
-+/// Implements: rust-run/run-verdict
-+pub(crate) fn judge(
-+    root: &Path,
-+    change: &Path,
-+    task: &str,
-+    config: &Config,
-+) -> Result<(), FeatureError> {
-+    let task_file = read_task_file(&change.join("tasks").join(format!("{task}.md")))
-+        .map_err(|error| FeatureError::failed("run", error.to_string()))?;
-+    let result = read_result(change, task)?;
-+    let Some(result) = result else {
-+        return dead::die(change, task, DeadReason::NoResult, &text::no_result(task));
-+    };
-+    if let Some(need) = parse_result_sections(&result).blocked {
-+        return dead::die(change, task, DeadReason::Blocked, &text::blocked(&need));
-+    }
-+    verify_task(root, change, task, config, &task_file)?;
-+    verify_change(root, change, task, config)?;
-+    Ok(())
-+}
-+
-+/// Reads the task's result file, or none when it does not exist.
-+fn read_result(change: &Path, task: &str) -> Result<Option<String>, FeatureError> {
-+    let path = change
-+        .join(".run")
-+        .join("results")
-+        .join(format!("{task}.md"));
-+    match fs::read_to_string(&path) {
-+        Ok(text) => Ok(Some(text)),
-+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(None),
