+//! Appending typed events to a task's stream or to the change's own stream.
+
+use std::fs::{self, OpenOptions};
+use std::io::Write;
+use std::path::Path;
+
+use osq_core::FeatureError;
+use osq_core::event::{Envelope, Event, event_line};
+
+use super::time;
+
+/// The stream name the whole change's events go to, `change`.
+pub(crate) const CHANGE: &str = "change";
+
+/// Appends one event to `.run/events/<target>.jsonl` with the UTC time now.
+///
+/// # Errors
+///
+/// Returns a `Failed` error with the command `run` when the events folder or
+/// the stream file cannot be created or written.
+///
+/// Implements: rust-run/executor-start
+/// Implements: rust-run/dead-record
+/// Implements: rust-run/done-record
+pub(crate) fn append(folder: &Path, target: &str, event: Event) -> Result<(), FeatureError> {
+    let dir = folder.join(".run").join("events");
+    fs::create_dir_all(&dir).map_err(|error| failed(&dir, &error))?;
+    let path = dir.join(format!("{target}.jsonl"));
+    let envelope = Envelope {
+        timestamp: time::format_utc(time::now_ms()),
+        event,
+    };
+    let line = format!("{}\n", event_line(&envelope));
+    let mut file = OpenOptions::new()
+        .append(true)
+        .create(true)
+        .open(&path)
+        .map_err(|error| failed(&path, &error))?;
+    file.write_all(line.as_bytes())
+        .map_err(|error| failed(&path, &error))
+}
+
+/// Builds the failed error for a stream path that could not be written.
+fn failed(path: &Path, error: &std::io::Error) -> FeatureError {
+    FeatureError::failed("run", format!("cannot write {}: {error}", path.display()))
+}
