-+    task: &str,
-+    config: &Config,
-+    task_file: &TaskFile,
-+) -> Result<(), FeatureError> {
-+    let outcome = run(
-+        root,
-+        change,
-+        config,
-+        &task_file.verify,
-+        config.timeouts.task_timeout,
-+    )?;
-+    record(change, task, &task_file.verify, &outcome)?;
