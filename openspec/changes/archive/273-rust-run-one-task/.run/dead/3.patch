+///
+/// Covers: rust-run/run-outcomes
+#[test]
+fn change_verify_sees_the_change_folder() {
+    let root = repo("change-env", "done");
+    set_change_verify(&root, "test $OSQ_CHANGE = openspec/changes/001-a");
+    let output = support::run(&root, &["1", "1"]).expect("the change folder is passed");
