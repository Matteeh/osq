diff --git a/src/watcher/usage-pause.ts b/src/watcher/usage-pause.ts
new file mode 100644
index 00000000..2ad5dec0
--- /dev/null
+++ b/src/watcher/usage-pause.ts
@@ -0,0 +1,180 @@
+/**
+ * The watcher side of the usage-limit pause: records `.run/paused.md` and the
+ * `paused` event, finds and clears the pauses active changes hold, and throws
+ * away a paused worktree task's edits outside the change folder.
+ */
+
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import { DEFAULT_GATES_CONFIG } from '../core/foundation/config-gates.js';
+import type { OsqConfig } from '../core/foundation/config.js';
+import { type Logger, resolveSymbol } from '../core/foundation/logger.js';
+import {
+  type UsagePause,
+  findUsageLimit,
+  formatPauseUntil,
+  pauseUntil,
+  readActivePause,
+  readUsagePause,
+  usagePausePath,
+  writeUsagePause,
+} from '../core/run/usage-pause.js';
+import type { LocatedChange } from '../core/status/change-locations.js';
+import { selectVcs } from '../core/vcs/select.js';
+import { asRecord } from '../harness/stream.js';
+import { appendHarnessEvent } from '../harness/types.js';
+
+/** The leading number of a folder's name, else the whole name. */
+function changeId(folderPath: string): string {
+  const base = path.basename(folderPath);
+  return /^(\d+)/.exec(base)?.[1] ?? base;
+}
+
+/** A change folder and the pause it holds, for the loop's cycle-wide checks. */
+type PausedChange = Pick<LocatedChange, 'folderPath'>;
+
+/**
+ * Write `.run/paused.md`, append the `paused` event to the task's stream, and
+ * log one line. The prefix is the pause symbol, as every watcher line's is.
+ *
+ * @scenario watcher-and-harness: Limit with a reset time
+ * @scenario watcher-and-harness: Limit without a reset time
+ */
+export async function recordUsagePause(
+  folderPath: string,
+  stream: string,
+  pause: UsagePause,
+  logger?: Logger,
+): Promise<void> {
+  await writeUsagePause(folderPath, pause);
+  await appendHarnessEvent(folderPath, stream, {
+    type: 'paused',
+    timestamp: new Date().toISOString(),
+    data: {
+      task: pause.task,
+      until: pause.until,
+      source: pause.source,
+      ...(pause.error !== undefined ? { error: pause.error } : {}),
+    },
+  });
+  const prefix = resolveSymbol('⏸', '[paused]', logger?.symbols === true);
+  logger?.info(
+    `${prefix} task ${pause.task} of ${changeId(folderPath)} paused until ${formatPauseUntil(pause.until)} (usage limit)`,
+  );
+}
+
+/** Read a task's events, skipping malformed lines. */
+async function readEvents(specFolderPath: string, taskNumber: string): Promise<unknown[]> {
+  const raw = await fs
+    .readFile(path.join(specFolderPath, '.run', 'events', `${taskNumber}.jsonl`), 'utf8')
+    .catch(() => '');
+  const events: unknown[] = [];
+  for (const line of raw.split('\n')) {
+    if (!line.trim()) continue;
+    try {
+      events.push(JSON.parse(line));
+    } catch {
+      // A malformed line never hides a later valid event.
+    }
+  }
+  return events;
+}
+
+/** The events after the last `started`, as `findOpenProviderRetry` reads them. */
+function afterLastStarted(events: readonly unknown[]): unknown[] {
+  let start = -1;
+  for (let index = 0; index < events.length; index += 1) {
+    if (asRecord(events[index])?.type === 'started') start = index;
+  }
+  return events.slice(start + 1);
+}
+
+/**
+ * Pause the attempt that just ran when its events hold a `usage_limit`: write
+ * the marker, append the event, and return the pause, or undefined without one.
+ * Called by the spawn right after the `exited` event, whatever the exit code.
+ *
+ * @scenario watcher-and-harness: Limit with a reset time
+ * @scenario watcher-and-harness: Limit without a reset time
+ * @scenario watcher-and-harness: Limit from an earlier attempt
+ */
+export async function pauseTaskAfterRun(
+  specFolderPath: string,
+  taskNumber: string,
+  config: OsqConfig,
+  logger?: Logger,
+): Promise<UsagePause | undefined> {
+  const limit = findUsageLimit(afterLastStarted(await readEvents(specFolderPath, taskNumber)));
+  if (limit === undefined) return undefined;
+  const waitSeconds =
+    config.gates?.usageLimitWaitSeconds ?? DEFAULT_GATES_CONFIG.usageLimitWaitSeconds ?? 1800;
+  const { until, source } = pauseUntil(limit, Date.now(), waitSeconds);
+  const pause: UsagePause = {
+    task: taskNumber,
+    until,
+    source,
+    ...(limit.error !== undefined ? { error: limit.error } : {}),
+  };
+  await recordUsagePause(specFolderPath, taskNumber, pause, logger);
+  return pause;
+}
+
+/**
+ * Remove the `.run/paused.md` of every change whose `until` has passed.
+ *
+ * @scenario watcher-and-harness: Task runs after the reset
+ */
+export async function removePassedPauses(
+  changes: readonly PausedChange[],
+  now: number,
+): Promise<void> {
+  for (const change of changes) {
+    const pause = await readUsagePause(change.folderPath);
+    if (pause !== null && Date.parse(pause.until) <= now) {
+      await fs.rm(usagePausePath(change.folderPath), { force: true });
+    }
+  }
+}
+
+/**
+ * The first active pause any change holds whose `until` is later than `now`,
+ * or null. The loop checks this before it starts a task or the planner.
+ *
+ * @scenario watcher-and-harness: Another change waits
+ */
+export async function findActivePause(
+  changes: readonly PausedChange[],
+  now: number,
+): Promise<UsagePause | null> {
+  for (const change of changes) {
+    const pause = await readActivePause(change.folderPath, now);
+    if (pause !== null) return pause;
+  }
+  return null;
+}
+
+/**
+ * Discard what a paused worktree task changed outside its change folder, the
+ * way `commitDeadTask` does, but write no patch and make no commit.
+ *
+ * @scenario watcher-and-harness: Limit with a reset time
+ */
+export async function discardWorktreeEdits(
+  change: LocatedChange,
+  config: OsqConfig,
+): Promise<void> {
+  const vcs = await selectVcs(change.tree.root, config);
+  if (vcs.kind !== 'git') return;
+  const root = await vcs.root();
+  if (root === null) return;
+  const changeRel = path.relative(root, change.folderPath).split(path.sep).join('/');
+  const outside = new Set<string>();
+  for (const entry of await vcs.status()) {
+    for (const candidate of [entry.path, entry.from]) {
+      if (candidate === undefined) continue;
+      if (candidate === changeRel || candidate.startsWith(`${changeRel}/`)) continue;
+      outside.add(candidate);
+    }
+  }
+  await vcs.discard([...outside].sort());
+}
