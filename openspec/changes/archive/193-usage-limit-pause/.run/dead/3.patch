+/** Adapter that pauses after editing a file outside the change folder. */
+class PausedEditAdapter implements HarnessAdapter {
+  readonly name = 'paused-edit';
+
+  async setup(): Promise<void> {}
+
+  async spawn(options: SpawnTaskOptions): Promise<SpawnResult> {
+    await options.onSpawn?.(4321);
+    await appendHarnessEvent(options.specFolderPath, options.taskNumber, {
+      type: 'usage_limit',
+      timestamp: new Date().toISOString(),
+      data: { resetsAt: new Date(Date.now() + 3600_000).toISOString() },
+    });
+    await fs.writeFile(path.join(options.projectRoot, OUT_SCOPE), 'agent edit\n', 'utf8');
+    return { exitCode: 0, pid: 4321 };
+  }
+}
+
+describe('usage pause in a worktree', () => {
+  it('discards edits outside the change folder and makes no commit', async () => {
+    const project = await setupWorktree();
+    const head = await git(['rev-parse', 'HEAD'], project.worktree);
+
+    await runWatcherCycle(project.repo, project.config, new PausedEditAdapter());
+
+    const pause = await readUsagePause(project.worktreeFolder);
+    assert.equal(pause?.source, 'harness');
+    assert.equal(await fs.readFile(path.join(project.worktree, OUT_SCOPE), 'utf8'), 'out\n');
+    assert.equal(await git(['rev-parse', 'HEAD'], project.worktree), head);
+    assert.equal(await exists(path.join(project.worktreeFolder, '.run', 'done', '1')), false);
+  });
+});
