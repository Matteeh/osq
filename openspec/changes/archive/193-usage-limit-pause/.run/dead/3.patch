+async function readEvents(specFolder: string, target = '1'): Promise<Record<string, unknown>[]> {
+  const raw = await fs
+    .readFile(path.join(specFolder, '.run', 'events', `${target}.jsonl`), 'utf8')
+    .catch(() => '');
+  return raw
+    .split('\n')
+    .filter((line) => line.trim().length > 0)
+    .map((line) => JSON.parse(line) as Record<string, unknown>);
+}
+
+const TASK_DATA = parseTaskMd(
+  [
+    '---',
+    'title: Usage pause',
+    'verify: node --version',
+    'scope: []',
+    'entry: []',
+    'skills: []',
+    '---',
+    '## Acceptance',
+    '- [ ] pauses',
+    '',
+  ].join('\n'),
+);
+
+interface Limit {
+  readonly resetsAt?: string;
+  readonly error?: string;
+}
+
+/** Adapter that appends one `usage_limit` event after `started`, then exits. */
+class PauseAdapter implements HarnessAdapter {
+  readonly name = 'pause-stub';
+  readonly calls: string[] = [];
+
+  constructor(
+    private readonly limit: Limit | null,
+    private readonly result: SpawnResult = { exitCode: 0 },
+  ) {}
+
+  async setup(): Promise<void> {}
+
+  async spawn(options: SpawnTaskOptions): Promise<SpawnResult> {
+    this.calls.push(options.taskNumber);
+    await options.onSpawn?.(1234);
+    if (this.limit) {
+      await appendHarnessEvent(options.specFolderPath, options.taskNumber, {
+        type: 'usage_limit',
+        timestamp: new Date().toISOString(),
+        data: {
+          ...(this.limit.resetsAt ? { resetsAt: this.limit.resetsAt } : {}),
+          ...(this.limit.error ? { error: this.limit.error } : {}),
+        },
+      });
+    }
+    return { ...this.result, pid: 1234 };
+  }
+}
+
+async function runSpawn(
+  specFolder: string,
+  adapter: HarnessAdapter,
+  config: OsqConfig = DEFAULT_CONFIG,
+): Promise<Awaited<ReturnType<typeof spawnTaskAgent>>> {
+  return spawnTaskAgent({
+    projectRoot: path.dirname(specFolder),
+    specFolderPath: specFolder,
+    taskNumber: '1',
+    taskData: TASK_DATA,
+    config,
+    adapter,
+    logOutcome: () => {},
+  });
+}
+
+describe('usage pause through spawnTaskAgent', () => {
+  let root: string;
+  let specFolder: string;
+
+  afterEach(async () => {
+    if (root) await fs.rm(root, { recursive: true, force: true });
+  });
+
+  async function setup(): Promise<void> {
+    root = await fs.mkdtemp(path.join(os.tmpdir(), 'osq-usage-pause-spawn-'));
+    specFolder = path.join(root, 'change');
+    await fs.mkdir(path.join(specFolder, '.run'), { recursive: true });
+  }
+
+  it('Limit with a reset time: pauses with source harness and writes no dead marker', async () => {
+    await setup();
+    const resetsAt = new Date(Date.now() + 3600_000).toISOString();
+
+    const outcome = await runSpawn(specFolder, new PauseAdapter({ resetsAt }, { exitCode: 1 }));
+
+    assert.equal(outcome.ok, false);
+    if (outcome.ok) return;
+    assert.deepEqual(outcome.result.paused, { until: resetsAt });
+    assert.equal(outcome.result.reason, undefined);
+
+    const pause = await readUsagePause(specFolder);
+    assert.equal(pause?.task, '1');
+    assert.equal(pause?.until, resetsAt);
+    assert.equal(pause?.source, 'harness');
+
+    const paused = (await readEvents(specFolder)).filter((event) => event.type === 'paused');
+    assert.equal(paused.length, 1);
+    assert.deepEqual(paused[0]?.data, { task: '1', until: resetsAt, source: 'harness' });
+
+    assert.equal(await exists(path.join(specFolder, '.run', 'dead', '1.md')), false);
+    const events = await readEvents(specFolder);
+    assert.equal(events.filter((event) => event.type === 'dead').length, 0);
+    assert.equal(events.filter((event) => event.type === 'retry').length, 0);
+  });
+
+  it('Limit without a reset time: waits the configured seconds and does not die no_result', async () => {
+    await setup();
+    const before = Date.now();
+    const config: OsqConfig = {
+      ...DEFAULT_CONFIG,
+      gates: { ...DEFAULT_GATES_CONFIG, usageLimitWaitSeconds: 600 },
+    };
+
+    const outcome = await runSpawn(specFolder, new PauseAdapter({}), config);
+    const after = Date.now();
+
+    assert.equal(outcome.ok, false);
+    if (outcome.ok) return;
+    const until = outcome.result.paused?.until;
+    assert.ok(until, 'the result carries the pause until');
+    const parsed = Date.parse(until as string);
+    assert.ok(parsed >= before + 600_000 && parsed <= after + 600_000);
+
+    const pause = await readUsagePause(specFolder);
+    assert.equal(pause?.source, 'wait');
+    assert.equal(pause?.until, until);
+
+    assert.equal(await exists(path.join(specFolder, '.run', 'dead', '1.md')), false);
+    const events = await readEvents(specFolder);
+    assert.equal(
+      events.filter(
+        (event) => (event.data as Record<string, unknown> | undefined)?.reason === 'no_result',
+      ).length,
+      0,
+    );
+  });
+
+  it('Limit from an earlier attempt: a limit before the last started does not pause', async () => {
+    await setup();
+    await appendHarnessEvent(specFolder, '1', {
+      type: 'usage_limit',
+      timestamp: new Date(Date.now() - 60_000).toISOString(),
+      data: { resetsAt: new Date(Date.now() + 3600_000).toISOString() },
+    });
+
+    const outcome = await runSpawn(specFolder, new PauseAdapter(null, { exitCode: 1 }));
+
+    assert.equal(outcome.ok, false);
+    if (outcome.ok) return;
+    assert.equal(outcome.result.reason, 'crashed');
+    assert.equal(await exists(usagePausePath(specFolder)), false);
+    const events = await readEvents(specFolder);
+    assert.equal(events.filter((event) => event.type === 'paused').length, 0);
+  });
+});
+
+/* ---------------------------------------------------------------- cycles -- */
+
+const VERIFY = 'node verify.cjs';
+
+function taskMarkdown(title: string): string {
+  return [
+    '---',
+    `title: ${title}`,
+    `verify: ${VERIFY}`,
+    'scope: []',
+    'entry: []',
+    'skills: []',
+    '---',
+    '## Acceptance',
+    '- [ ] does the thing',
+    '',
+  ].join('\n');
+}
+
+function proposalMarkdown(title: string): string {
+  return [
+    '---',
+    `title: ${title}`,
+    'depends_on: []',
+    `verify: ${VERIFY}`,
+    'features:',
+    '  reads: []',
+    '---',
+    '## Goal',
+    'Run the tasks.',
+    '',
+    '## Surface',
+    'None.',
+    '',
+    '## Human steps',
+    'None',
+    '',
+  ].join('\n');
+}
+
+/** One scaffolded project with its verify script, ready for approved changes. */
+async function setupProject(): Promise<{ root: string; config: OsqConfig }> {
+  const root = await fs.mkdtemp(path.join(os.tmpdir(), 'osq-usage-pause-cycle-'));
+  tmpDirs.push(root);
+  await installFakeValidator(root);
+  await scaffoldProject(root);
+  await fs.writeFile(path.join(root, 'verify.cjs'), 'process.exit(0);\n', 'utf8');
+  const config = defineConfig({
+    gates: { ...DEFAULT_GATES_CONFIG, preSpawnVerify: 'off' },
+  });
+  return { root, config };
+}
+
+async function addChange(root: string, title: string, tasks: number): Promise<string> {
+  const spec = await createNewSpec(root, title);
+  const folder = spec.folderPath;
+  await fs.writeFile(path.join(folder, 'proposal.md'), proposalMarkdown(title), 'utf8');
+  for (let index = 1; index <= tasks; index += 1) {
+    await fs.writeFile(
+      path.join(folder, 'tasks', `${index}.md`),
+      taskMarkdown(`${title} task ${index}`),
+      'utf8',
+    );
+  }
+  await approveSpec(root, path.basename(folder).match(/^(\d+)/)?.[1] ?? folder, DEFAULT_CONFIG);
+  return folder;
+}
+
+/** Every file under `dir`, relative and sorted, for an unchanged-folder check. */
+async function listFiles(dir: string): Promise<string[]> {
+  const found: string[] = [];
+  async function walk(current: string, prefix: string): Promise<void> {
+    const entries = await fs.readdir(current, { withFileTypes: true }).catch(() => []);
+    for (const entry of entries) {
+      const relative = prefix ? `${prefix}/${entry.name}` : entry.name;
+      if (entry.isDirectory()) {
+        await walk(path.join(current, entry.name), relative);
+      } else {
+        found.push(relative);
+      }
+    }
+  }
+  await walk(dir, '');
+  return found.sort();
+}
+
+class CountingAdapter implements HarnessAdapter {
+  readonly name = 'counting';
+  readonly calls: string[] = [];
+  private readonly delegate = new MockAdapter();
+
+  async setup(): Promise<void> {}
+
+  async spawn(options: SpawnTaskOptions): Promise<SpawnResult> {
+    this.calls.push(options.taskNumber);
+    return this.delegate.spawn(options);
+  }
+}
+
+describe('usage pause wait across changes', () => {
+  it('Another change waits: an active pause stops every change from spawning', async () => {
+    const { root, config } = await setupProject();
+    const first = await addChange(root, 'Paused One', 2);
+    const second = await addChange(root, 'Waiting Two', 2);
+
+    await writeUsagePause(first, {
+      task: '1',
+      until: new Date(Date.now() + 3600_000).toISOString(),
+      source: 'harness',
+    });
+    const secondBefore = await listFiles(second);
+    const adapter = new CountingAdapter();
+
+    const summary = await runWatcherCycle(root, config, adapter);
+
+    assert.equal(summary.tasksRun, 0);
+    assert.deepEqual(adapter.calls, []);
+    assert.deepEqual(await listFiles(second), secondBefore);
+    assert.equal(await exists(path.join(second, '.run', 'done', '1')), false);
+    assert.equal(await exists(path.join(second, '.run', 'events', '1.jsonl')), false);
+  });
+
+  it('Task runs after the reset: a passed pause is removed and the task runs as attempt 1', async () => {
+    const { root, config } = await setupProject();
+    const folder = await addChange(root, 'Reset One', 2);
+    await writeUsagePause(folder, {
+      task: '1',
+      until: '2000-01-01T00:00:00.000Z',
+      source: 'wait',
+    });
+    const adapter = new CountingAdapter();
+
+    const summary = await runWatcherCycle(root, config, adapter);
+
+    assert.equal(summary.tasksRun, 1);
+    assert.deepEqual(adapter.calls, ['1']);
+    assert.equal(await exists(usagePausePath(folder)), false);
+
+    const started = (await readEvents(folder)).filter((event) => event.type === 'started');
+    assert.equal(started.length, 1);
+    assert.equal((started[0]?.data as Record<string, unknown> | undefined)?.attempt, 1);
+  });
+});
