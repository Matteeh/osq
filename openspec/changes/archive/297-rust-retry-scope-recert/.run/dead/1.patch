+/// Writes task 4 with the row's scope and reseals the change folder.
+fn write_scope(folder: &std::path::Path, entries: &[&str]) {
+    let mut text = String::from("---\ntitle: t\nverify: sh checks/pass.sh\nscope:\n");
+    for entry in entries {
+        let json = serde_json::to_string(entry).expect("the entry is a JSON string");
+        let _ = writeln!(text, "  - {json}");
+    }
+    text.push_str("---\n");
+    write(folder, "tasks/4.md", text);
+    let seal = change_folder_seal(folder).expect("the folder is sealed");
+    write(folder, ".run/approved", format!("{}\n", seal.as_str()));
+}
+
+/// The `scope_files` line and its indented lines from a marker.
+fn scope_files(lines: &[String]) -> Vec<String> {
+    let start = lines
+        .iter()
+        .position(|line| line.starts_with("scope_files:"))
+        .expect("the marker holds scope_files");
+    if lines[start] == "scope_files: {}" {
+        return vec![lines[start].clone()];
+    }
+    let mut found = vec![lines[start].clone()];
+    for line in &lines[start + 1..] {
+        if !line.starts_with("  ") {
+            break;
+        }
+        found.push(line.clone());
+    }
+    found
+}
+
+/// Proves every row of "Recertified scope files".
+///
+/// Covers: rust-retry/recertified-scope-files
+#[test]
+fn recertified_scope_files() {
+    for row in &SCOPE_ROWS {
+        let root = scratch_recert(row.name);
+        let folder = change_folder(&root, "001-recert");
+        if row.name.starts_with("outside") {
+            let parent = root.parent().expect("the scratch root has a parent");
+            write(parent, "outside.txt", "outside\n");
+        }
+        write_scope(&folder, row.entries);
+        run(&root, ["1", "4"]).expect("the retry recertifies");
+        let marker = fs::read_to_string(folder.join(".run/done/4")).expect("the marker reads");
+        let lines: Vec<String> = marker.lines().map(str::to_owned).collect();
+        assert!(
+            lines.contains(&format!("scope_hash: {}", row.hash)),
+            "{}: scope_hash",
+            row.name
+        );
+        let expected: Vec<String> = row.files.iter().map(|line| (*line).to_owned()).collect();
+        assert_eq!(scope_files(&lines), expected, "{}: scope_files", row.name);
+    }
+}
