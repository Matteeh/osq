diff --git a/crates/features/retry/src/retry/recertify.rs b/crates/features/retry/src/retry/recertify.rs
new file mode 100644
index 000000000..144e6c331
--- /dev/null
+++ b/crates/features/retry/src/retry/recertify.rs
@@ -0,0 +1,197 @@
+//! Rerunning a scope-regressed task's verify and recertifying or requeueing it.
+
+mod fields;
+
+use std::collections::BTreeMap;
+use std::fs;
+use std::path::Path;
+
+use osq_core::FeatureError;
+use osq_core::event::{Event, RecertificationData, RecertificationOutcome, RequeueReason};
+use osq_kernel_config::{Config, load_config};
+use osq_kernel_harnesses::{VerifyOutcome, VerifyRequest, run_verify};
+use osq_kernel_specs::{parse_frontmatter, read_task_file};
+
+use super::marker::Failure;
+use super::{args, excerpt, record, scope, text};
+
+/// Recertifies a task's scope regression by rerunning its verify.
+///
+/// # Errors
+///
+/// Returns a `Failed` error with the command `retry` when the task file or
+/// config cannot be read, when the verify cannot start, or when the done
+/// marker, a retained file or the event cannot be written.
+///
+/// Implements: rust-retry/scope-recertification
+pub(crate) fn run(
+    root: &Path,
+    folder: &Path,
+    folder_name: &str,
+    target: &str,
+    failure: &Failure,
+    recorded: &str,
+) -> Result<String, FeatureError> {
+    let task = read_task_file(&folder.join("tasks").join(format!("{target}.md")))
+        .map_err(|error| text::failed(error.to_string()))?;
+    let config = load_config(root).map_err(|error| text::failed(error.to_string()))?;
+    let regressed = folder
+        .join(".run")
+        .join("regressed")
+        .join(format!("{target}.md"));
+    let marker = read_marker(&regressed)?;
+    let outcome = verify(root, folder, &task.verify, &config)?;
+    let current = scope::hash(root, &task.scope);
+    let passed = outcome.exit_code == 0;
+    if passed {
+        fields::rewrite(folder, target, recorded, &current)?;
+    }
+    let mut retained = Vec::new();
+    retain(folder, target, failure.ordinal, passed, &mut retained)?;
+    record::append(
+        folder,
+        target,
+        Event::Recertification(data(Facts {
+            target,
+            failure,
+            recorded,
+            command: &task.verify,
+            marker: &marker,
+            outcome: &outcome,
+            current_hash: current.hash.clone(),
+            config: &config,
+            passed,
+        })),
+    )?;
+    let id = args::id(folder_name);
+    Ok(if passed {
+        text::recertified(id, target, &retained)
+    } else {
+        text::requeued(id, target, failure.ordinal + 1, &retained)
+    })
+}
+
+/// Reads a regression marker's frontmatter and body.
+///
+/// Implements: rust-retry/scope-recertification
+fn read_marker(path: &Path) -> Result<osq_kernel_specs::Frontmatter, FeatureError> {
+    let text = fs::read_to_string(path)
+        .map_err(|error| text::failed(format!("cannot read {}: {error}", path.display())))?;
+    parse_frontmatter(&text)
+        .map_err(|error| text::failed(format!("{}: {}", path.display(), error.message)))
+}
+
+/// Runs the task's verify in the root with the change folder's absolute path.
+///
+/// Implements: rust-retry/scope-recertification
+fn verify(
+    root: &Path,
+    folder: &Path,
+    command: &str,
+    config: &Config,
+) -> Result<VerifyOutcome, FeatureError> {
+    let change = fs::canonicalize(folder).unwrap_or_else(|_| folder.to_path_buf());
+    let request = VerifyRequest {
+        command: command.to_owned(),
+        cwd: root.to_path_buf(),
+        source_env: std::env::vars().collect::<BTreeMap<_, _>>(),
+        configured_env: Vec::new(),
+        agent_env: Vec::new(),
+        change: Some(change.to_string_lossy().into_owned()),
+        diff: None,
+        extra_env: BTreeMap::new(),
+        timeout: Some(config.timeouts.verify_timeout),
+        kill_grace: config.timeouts.harness_kill_grace,
+    };
+    run_verify(&request).map_err(|error| text::failed(error.to_string()))
+}
+
+/// Retains the regressed marker and, unless the verify passed, the done marker.
+///
+/// Implements: rust-retry/scope-recertification
+fn retain(
+    folder: &Path,
+    target: &str,
+    ordinal: u64,
+    passed: bool,
+    retained: &mut Vec<String>,
+) -> Result<(), FeatureError> {
+    let run = folder.join(".run");
+    record::retain(
+        &run.join("regressed").join(format!("{target}.md")),
+        &run.join("regressed").join(format!("{target}.{ordinal}.md")),
+        folder,
+        retained,
+    )?;
+    if passed {
+        return Ok(());
+    }
+    let done = run.join("done").join(target);
+    if done.exists() {
+        record::retain(
+            &done,
+            &run.join("done").join(format!("{target}.{ordinal}")),
+            folder,
+            retained,
+        )?;
+    }
+    Ok(())
+}
+
+/// Everything one `recertification` event records.
+struct Facts<'a> {
+    /// The recertified task.
+    target: &'a str,
+    /// The active failure facts, for the attempt number.
+    failure: &'a Failure,
+    /// The done marker's recorded scope hash.
+    recorded: &'a str,
+    /// The verify command that ran.
+    command: &'a str,
+    /// The regression marker's frontmatter and body.
+    marker: &'a osq_kernel_specs::Frontmatter,
+    /// The verify's outcome.
+    outcome: &'a VerifyOutcome,
+    /// The task's current scope hash.
+    current_hash: String,
+    /// The root's config, for the output limits.
+    config: &'a Config,
+    /// Whether the verify passed.
+    passed: bool,
+}
+
+/// Builds the one `recertification` event's data.
+///
+/// Implements: rust-retry/scope-recertification
+fn data(facts: Facts<'_>) -> RecertificationData {
+    let outcome = if facts.passed {
+        RecertificationOutcome::Passed
+    } else {
+        RecertificationOutcome::Requeued
+    };
+    RecertificationData {
+        task: facts.target.to_owned(),
+        outcome,
+        differing_paths: fields::differing_paths(&facts.marker.body),
+        attribution: fields::attribution(&facts.marker.data),
+        command: facts.command.to_owned(),
+        exit_code: i64::from(facts.outcome.exit_code),
+        output: Some(excerpt::tail(&facts.outcome.output, limits(facts.config))),
+        timed_out: facts.outcome.timed_out,
+        recorded_hash: facts.recorded.to_owned(),
+        current_hash: facts.current_hash,
+        attempt: (!facts.passed).then_some(facts.failure.ordinal + 1),
+        reason: (!facts.passed).then_some(RequeueReason::ScopeRegression),
+        automatic: None,
+    }
+}
+
+/// The configured output limits one recertification event reads.
+///
+/// Implements: rust-retry/scope-recertification
+fn limits(config: &Config) -> excerpt::Limits {
+    excerpt::Limits {
+        lines: usize::try_from(config.limits.marker_output_lines).unwrap_or(usize::MAX),
+        chars: usize::try_from(config.limits.marker_line_chars).unwrap_or(usize::MAX),
+    }
+}
diff --git a/crates/features/retry/src/retry/recertify/fields.rs b/crates/features/retry/src/retry/recertify/fields.rs
new file mode 100644
index 000000000..a792f01da
--- /dev/null
+++ b/crates/features/retry/src/retry/recertify/fields.rs
@@ -0,0 +1,154 @@
+//! Reading a regression marker's facts and rewriting the recertified done marker.
+
+use std::fs;
+use std::path::Path;
+
+use osq_core::FeatureError;
+use osq_kernel_specs::{js_trim, parse_frontmatter};
+use serde_json::{Map, Number, Value};
+use yaml_rust2::yaml::{Hash, Yaml};
+
+use super::super::scope::ScopeHash;
+use super::super::text;
+use super::super::time;
+use super::super::yaml;
+
+/// The differing paths in a regression marker's first body paragraph.
+///
+/// Implements: rust-retry/scope-recertification
+pub(super) fn differing_paths(body: &str) -> Vec<String> {
+    let first = body.split("\n\n").next().unwrap_or_default();
+    first
+        .split('\n')
+        .filter_map(|line| line.strip_prefix("- "))
+        .map(|path| js_trim(path).to_owned())
+        .collect()
+}
+
+/// The marker's `attribution` list as JSON, or an empty list for any other value.
+///
+/// Implements: rust-retry/scope-recertification
+pub(super) fn attribution(data: &Hash) -> Value {
+    match data.get(&Yaml::String("attribution".to_owned())) {
+        Some(Yaml::Array(items)) => Value::Array(items.iter().map(json).collect()),
+        _ => Value::Array(Vec::new()),
+    }
+}
+
+/// Rewrites `.run/done/<task>` with the current scope evidence.
+///
+/// Implements: rust-retry/recertified-done-marker
+pub(super) fn rewrite(
+    folder: &Path,
+    task: &str,
+    recorded: &str,
+    current: &ScopeHash,
+) -> Result<(), FeatureError> {
+    let path = folder.join(".run").join("done").join(task);
+    let text = fs::read_to_string(&path)
+        .map_err(|error| text::failed(format!("cannot read {}: {error}", path.display())))?;
+    let mut frontmatter = parse_frontmatter(&text)
+        .map_err(|error| text::failed(format!("{}: {}", path.display(), error.message)))?;
+    let data = &mut frontmatter.data;
+    if !keeps_original(data) {
+        data.replace(
+            key("original_scope_hash"),
+            Yaml::String(recorded.to_owned()),
+        );
+    }
+    data.replace(key("scope_hash"), Yaml::String(current.hash.clone()));
+    data.replace(key("scope_files"), files(&current.files));
+    data.replace(key("scope_resolver"), Yaml::Integer(2));
+    data.replace(
+        key("recertified_at"),
+        Yaml::String(time::format_utc(time::now_ms())),
+    );
+    data.replace(
+        key("recertification_count"),
+        Yaml::Integer(next_count(data)),
+    );
+    let marker = format!("---\n{}---\n{}", yaml::stringify(data), frontmatter.body);
+    fs::write(&path, marker)
+        .map_err(|error| text::failed(format!("cannot write {}: {error}", path.display())))
+}
+
+/// A frontmatter key as the YAML mapping holds it.
+///
+/// Implements: rust-retry/recertified-done-marker
+fn key(name: &str) -> Yaml {
+    Yaml::String(name.to_owned())
+}
+
+/// Whether the marker already keeps a non-empty `original_scope_hash` string.
+///
+/// Implements: rust-retry/recertified-done-marker
+fn keeps_original(data: &Hash) -> bool {
+    matches!(
+        data.get(&key("original_scope_hash")),
+        Some(Yaml::String(text)) if !text.is_empty()
+    )
+}
+
+/// The marker's next recertification count.
+///
+/// Implements: rust-retry/recertified-done-marker
+fn next_count(data: &Hash) -> i64 {
+    match data.get(&key("recertification_count")) {
+        Some(Yaml::Integer(count)) if *count >= 1 => count.saturating_add(1),
+        _ => 1,
+    }
+}
+
+/// The `scope_files` mapping of every resolved path to its hash or null.
+///
+/// Implements: rust-retry/recertified-done-marker
+fn files(entries: &[(String, Option<String>)]) -> Yaml {
+    let mut map = Hash::new();
+    for (path, hash) in entries {
+        let value = match hash {
+            Some(hash) => Yaml::String(hash.clone()),
+            None => Yaml::Null,
+        };
+        map.insert(Yaml::String(path.clone()), value);
+    }
+    Yaml::Hash(map)
+}
+
+/// One YAML value as the JSON a `recertification` event carries.
+///
+/// Implements: rust-retry/scope-recertification
+fn json(value: &Yaml) -> Value {
+    match value {
+        Yaml::String(text) => Value::String(text.clone()),
+        Yaml::Integer(number) => Value::Number(Number::from(*number)),
+        Yaml::Boolean(flag) => Value::Bool(*flag),
+        Yaml::Array(items) => Value::Array(items.iter().map(json).collect()),
+        Yaml::Hash(mapping) => {
+            let mut object = Map::new();
+            for (key, value) in mapping {
+                object.insert(text_value(key), json(value));
+            }
+            Value::Object(object)
+        }
+        Yaml::Real(text) => text
+            .parse::<f64>()
+            .ok()
+            .and_then(Number::from_f64)
+            .map_or_else(|| Value::String(text.clone()), Value::Number),
+        Yaml::Null | Yaml::BadValue | Yaml::Alias(_) => Value::Null,
+    }
+}
+
+/// A YAML key as the text a JSON object key uses.
+///
+/// Implements: rust-retry/scope-recertification
+fn text_value(value: &Yaml) -> String {
+    match value {
+        Yaml::String(text) | Yaml::Real(text) => text.clone(),
+        Yaml::Integer(number) => number.to_string(),
+        Yaml::Boolean(flag) => (if *flag { "true" } else { "false" }).to_owned(),
+        Yaml::Null | Yaml::BadValue | Yaml::Alias(_) | Yaml::Array(_) | Yaml::Hash(_) => {
+            String::new()
+        }
+    }
+}
