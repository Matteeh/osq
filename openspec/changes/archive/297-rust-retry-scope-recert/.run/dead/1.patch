+/// Writes task 4's done marker with the row's frontmatter line.
+fn write_marker(folder: &std::path::Path, line: &str) {
+    write(
+        folder,
+        ".run/done/4",
+        format!("---\nscope_hash: {RECORDED}\n{line}\n---\n2026-10-01T10:00:00.000Z\n"),
+    );
+}
+
+/// Proves every row of "Recertified marker text".
+///
+/// Covers: rust-retry/recertified-marker-text
+#[test]
+fn recertified_marker_text() {
+    for row in &TEXT_ROWS {
+        let root = scratch_recert(row.name);
+        let folder = change_folder(&root, "001-recert");
+        write_marker(&folder, row.line);
+        run(&root, ["1", "4"]).expect("the retry recertifies");
+        let marker = fs::read_to_string(folder.join(".run/done/4")).expect("the marker reads");
+        let lines: Vec<&str> = marker.lines().collect();
+        assert_eq!(lines[0], "---", "{}: opening", row.name);
+        assert_eq!(
+            lines[1],
+            format!("scope_hash: {CURRENT}"),
+            "{}: scope_hash",
+            row.name
+        );
+        assert_eq!(
+            &lines[2..2 + row.expected.len()],
+            row.expected,
+            "{}: frontmatter",
+            row.name
+        );
+    }
+}
