+//! The tail a `recertification` event keeps of one verify output.
+
+/// The configured output limits a recertification event reads.
+#[derive(Clone, Copy)]
+pub(crate) struct Limits {
+    /// The most lines the tail keeps.
+    pub(crate) lines: usize,
+    /// The most characters one kept line holds.
+    pub(crate) chars: usize,
+}
+
+/// The output unchanged within both limits, or its last lines cut to the limit.
+///
+/// Implements: rust-retry/scope-recertification
+pub(crate) fn tail(output: &str, limits: Limits) -> String {
+    let trimmed = output.trim_end();
+    if trimmed.is_empty() {
+        return String::new();
+    }
+    let lines: Vec<&str> = trimmed.split('\n').collect();
+    if lines.len() <= limits.lines && lines.iter().all(|line| count(line) <= limits.chars) {
+        return output.to_owned();
+    }
+    let start = lines.len().saturating_sub(limits.lines);
+    lines[start..]
+        .iter()
+        .map(|line| cut(line, limits.chars))
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+/// One line, cut to `chars` characters with the rest counted.
+///
+/// Implements: rust-retry/scope-recertification
+fn cut(line: &str, chars: usize) -> String {
+    if count(line) <= chars {
+        return (*line).to_owned();
+    }
+    let kept: String = line.chars().take(chars).collect();
+    format!("{kept}… ({} more characters)", count(line) - chars)
+}
+
+/// The number of Unicode scalar values in one line.
+///
+/// Implements: rust-retry/scope-recertification
+fn count(line: &str) -> usize {
+    line.chars().count()
+}
