+//! Writing frontmatter as the `yaml` package's `stringify` does.
+
+use yaml_rust2::yaml::{Hash, Yaml};
+
+/// The indentation one nesting level adds.
+const INDENT: usize = 2;
+
+/// Writes one frontmatter mapping, ending with a newline.
+///
+/// Implements: rust-retry/recertified-done-marker
+pub(crate) fn stringify(mapping: &Hash) -> String {
+    let mut lines = Vec::new();
+    for (key, value) in mapping {
+        lines.extend(entry(&key_text(key), value, 0));
+    }
+    lines.push(String::new());
+    lines.join("\n")
+}
+
+/// One mapping key, its value and any nested block.
+///
+/// Implements: rust-retry/recertified-done-marker
+fn entry(key: &str, value: &Yaml, indent: usize) -> Vec<String> {
+    let base = " ".repeat(indent);
+    let name = format!("{base}{}:", scalar(key));
+    match value {
+        Yaml::Hash(mapping) if mapping.is_empty() => vec![format!("{name} {{}}")],
+        Yaml::Hash(mapping) => {
+            let mut lines = vec![name];
+            lines.extend(block(mapping, indent + INDENT));
+            lines
+        }
+        Yaml::Array(items) if items.is_empty() => vec![format!("{name} []")],
+        Yaml::Array(items) => {
+            let mut lines = vec![name];
+            lines.extend(sequence(items, indent + INDENT));
+            lines
+        }
+        other => vec![format!("{name} {}", render(other))],
+    }
+}
+
+/// A non-empty mapping's entries, one per line group.
+///
+/// Implements: rust-retry/recertified-done-marker
+fn block(mapping: &Hash, indent: usize) -> Vec<String> {
+    let mut lines = Vec::new();
+    for (key, value) in mapping {
+        lines.extend(entry(&key_text(key), value, indent));
+    }
+    lines
+}
+
+/// A non-empty sequence's items, starting each on its dash line.
+///
+/// Implements: rust-retry/recertified-done-marker
+fn sequence(items: &[Yaml], indent: usize) -> Vec<String> {
+    let base = " ".repeat(indent);
+    let mut lines = Vec::new();
+    for item in items {
+        match item {
+            Yaml::Hash(mapping) if mapping.is_empty() => lines.push(format!("{base}- {{}}")),
+            Yaml::Hash(mapping) => {
+                let nested = block(mapping, indent + INDENT);
+                lines.push(join_dash(&base, &nested[0], indent + INDENT));
+                lines.extend(nested.into_iter().skip(1));
+            }
+            Yaml::Array(values) if values.is_empty() => lines.push(format!("{base}- []")),
+            Yaml::Array(values) => {
+                let nested = sequence(values, indent + INDENT);
+                lines.push(join_dash(&base, &nested[0], indent + INDENT));
+                lines.extend(nested.into_iter().skip(1));
+            }
+            other => lines.push(format!("{base}- {}", render(other))),
+        }
+    }
+    lines
+}
+
+/// Puts a nested item's first line after the parent dash.
+///
+/// Implements: rust-retry/recertified-done-marker
+fn join_dash(base: &str, line: &str, indent: usize) -> String {
+    let rest = line.get(indent..).unwrap_or(line);
+    format!("{base}- {rest}")
+}
+
+/// A YAML key's text, as an integer key's decimal text for an integer.
+///
+/// Implements: rust-retry/recertified-done-marker
+fn key_text(key: &Yaml) -> String {
+    value_text(key)
+}
+
+/// A YAML value's text, as the YAML writer reads it.
+///
+/// Implements: rust-retry/recertified-done-marker
+fn value_text(value: &Yaml) -> String {
+    match value {
+        Yaml::String(text) | Yaml::Real(text) => text.clone(),
+        Yaml::Integer(number) => number.to_string(),
+        Yaml::Boolean(flag) => (if *flag { "true" } else { "false" }).to_owned(),
+        Yaml::Null | Yaml::BadValue | Yaml::Alias(_) => "null".to_owned(),
+        Yaml::Array(_) | Yaml::Hash(_) => String::new(),
+    }
+}
+
+/// Writes one non-string scalar as its own text, without string quoting.
+///
+/// Implements: rust-retry/recertified-done-marker
+fn render(value: &Yaml) -> String {
+    match value {
+        Yaml::String(text) => scalar(text),
+        Yaml::Integer(number) => number.to_string(),
+        Yaml::Real(text) => text.clone(),
+        Yaml::Boolean(flag) => (if *flag { "true" } else { "false" }).to_owned(),
+        Yaml::Null | Yaml::BadValue | Yaml::Alias(_) | Yaml::Array(_) | Yaml::Hash(_) => {
+            "null".to_owned()
+        }
+    }
+}
+
+/// Writes one string, plain when the YAML writer may and JSON-quoted otherwise.
+///
+/// Implements: rust-retry/recertified-done-marker
+fn scalar(text: &str) -> String {
+    if plain(text) {
+        return text.to_owned();
+    }
+    serde_json::to_string(text).unwrap_or_else(|_| format!("\"{text}\""))
+}
+
+/// Whether a string is written without quotes.
+///
+/// Implements: rust-retry/recertified-done-marker
+fn plain(text: &str) -> bool {
+    let Some(first) = text.chars().next() else {
+        return false;
+    };
+    let start = first.is_ascii_alphanumeric() || matches!(first, '.' | '_' | '/');
+    let body = text.chars().all(|character| {
+        character.is_ascii_alphanumeric()
+            || matches!(character, '.' | '_' | '/' | '-' | '+' | ':' | '@')
+    });
+    start && body && !text.ends_with(':') && !reserved(text)
+}
+
+/// Whether a plain string would read back as another YAML kind.
+///
+/// Implements: rust-retry/recertified-done-marker
+fn reserved(text: &str) -> bool {
+    matches!(
+        text,
+        "null"
+            | "Null"
+            | "NULL"
+            | "true"
+            | "True"
+            | "TRUE"
+            | "false"
+            | "False"
+            | "FALSE"
+            | ".inf"
+            | ".Inf"
+            | ".INF"
+            | ".nan"
+            | ".NaN"
+            | ".NAN"
+    ) || integer(text)
+        || float(text)
+}
+
+/// Whether a string is an integer in decimal, octal or hexadecimal.
+///
+/// Implements: rust-retry/recertified-done-marker
+fn integer(text: &str) -> bool {
+    let unsigned = text.strip_prefix(['-', '+']).unwrap_or(text);
+    let decimal = !unsigned.is_empty() && unsigned.bytes().all(|byte| byte.is_ascii_digit());
+    let octal = unsigned.strip_prefix("0o").is_some_and(|digits| {
+        !digits.is_empty() && digits.bytes().all(|byte| matches!(byte, b'0'..=b'7'))
+    });
+    let hex = unsigned.strip_prefix("0x").is_some_and(|digits| {
+        !digits.is_empty() && digits.bytes().all(|byte| byte.is_ascii_hexdigit())
+    });
+    decimal || octal || hex
+}
+
+/// Whether a string is a float the YAML writer resolves.
+///
+/// Implements: rust-retry/recertified-done-marker
+fn float(text: &str) -> bool {
+    let unsigned = text.strip_prefix(['-', '+']).unwrap_or(text);
+    let (mantissa, exponent) = match unsigned.split_once(['e', 'E']) {
+        Some((mantissa, exponent)) => (mantissa, Some(exponent)),
+        None => (unsigned, None),
+    };
+    if exponent.is_some_and(|digits| {
+        let digits = digits.strip_prefix(['-', '+']).unwrap_or(digits);
+        digits.is_empty() || !digits.bytes().all(|byte| byte.is_ascii_digit())
+    }) {
+        return false;
+    }
+    let (whole, fraction) = match mantissa.split_once('.') {
+        Some((whole, fraction)) => (whole, Some(fraction)),
+        None => (mantissa, None),
+    };
+    let number = |part: &str| part.bytes().all(|byte| byte.is_ascii_digit());
+    let has_digits = !whole.is_empty() || fraction.is_some_and(|part| !part.is_empty());
+    if !number(whole) || !fraction.is_none_or(number) || !has_digits {
+        return false;
+    }
+    fraction.is_some() || exponent.is_some()
+}
