+
+/// The done marker's recorded hash every scope-files row starts from.
+const RECORDED: &str = "sha256:2222222222222222222222222222222222222222222222222222222222222222";
+
+/// The marker every recertified task 4 carries as its current scope hash.
+const CURRENT: &str = "sha256:3cfb4fa0947b1fa72f558e0825b1115022423a0aeea283d1bef4ae6536db3a06";
+
+/// One row of "Recertification equals TypeScript's".
+struct GoldenRow {
+    /// The row's golden and scratch folder name.
+    name: &'static str,
+    /// The two literal retry arguments.
+    args: [&'static str; 2],
+}
+
+/// Every row of "Recertification equals TypeScript's", in table order.
+const GOLDEN_ROWS: [GoldenRow; 4] = [
+    GoldenRow {
+        name: "passed-1",
+        args: ["1", "1"],
+    },
+    GoldenRow {
+        name: "requeued-2",
+        args: ["1", "2"],
+    },
+    GoldenRow {
+        name: "long-3",
+        args: ["001", "3"],
+    },
+    GoldenRow {
+        name: "again-4",
+        args: ["1", "4"],
+    },
+];
+
+/// A fresh scratch copy of the recertification fixture.
+fn scratch_recert(name: &str) -> std::path::PathBuf {
+    let root = scratch("retry_recert", name);
+    copy_tree(&fixture("recert-project"), &root);
+    root
+}
+
+/// Writes a golden's `recertified_at` line as the script blanks it.
+fn blank_stamp(dump: &str) -> String {
+    dump.lines()
+        .map(|line| {
+            if line.starts_with("recertified_at: ") {
+                "recertified_at: <timestamp>"
+            } else {
+                line
+            }
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+/// Proves every row of "Recertification equals TypeScript's".
+///
+/// Covers: rust-retry/recertification-equals-typescript-s
+#[test]
+fn recertification_equals_typescript() {
+    for row in &GOLDEN_ROWS {
+        let root = scratch_recert(row.name);
+        let folder = change_folder(&root, "001-recert");
+        let result = run(&root, row.args).expect("the retry recertifies");
+        let text = fs::read_to_string(fixture("recert-golden").join(format!("{}.txt", row.name)))
+            .expect("the golden reads");
+        let (outcome, body, tree) = parse_golden(&text);
+        assert_eq!(outcome, "output", "{}: outcome", row.name);
+        assert_eq!(result.text, body, "{}: output", row.name);
+        assert_eq!(
+            format!("{}\n", blank_stamp(&dump(&folder))),
+            tree,
+            "{}: tree",
+            row.name
+        );
+    }
+}
+
+/// Proves a config that does not load refuses before any write.
+///
+/// Covers: rust-retry/recertification-refusals
+#[test]
+fn recertification_refusals() {
+    let root = scratch_recert("refusal");
+    let before = tree(&root);
+    write(&root, "osq.toml", "bogus = 1\n");
+    let error = run(&root, ["1", "1"]).expect_err("the config is refused");
+    assert_eq!(failed_message(error), "bogus is not an osq.toml key");
+    let mut after = tree(&root);
+    after.remove("osq.toml");
+    assert_eq!(after, before, "every file apart from osq.toml is unchanged");
+}
+
