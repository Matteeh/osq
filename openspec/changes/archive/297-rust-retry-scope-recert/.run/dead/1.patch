+//! Resolving a task's scope and hashing its files, as TypeScript's `resolveScope` does.
+
+use std::collections::BTreeMap;
+use std::fmt::Write as _;
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use osq_kernel_specs::{js_trim, scope_covers_path};
+use sha2::{Digest, Sha256};
+
+/// One resolved scope path and the regular file it names, when one exists.
+struct Resolved {
+    /// The normalized project-relative or declared path.
+    path: String,
+    /// The readable file, or none for a missing or out-of-project entry.
+    file: Option<PathBuf>,
+}
+
+/// A task's current per-file hashes and their combined digest.
+pub(crate) struct ScopeHash {
+    /// The `sha256:` digest of every `<path>:<hash>` line.
+    pub(crate) hash: String,
+    /// Each resolved path and its file hash, in path order.
+    pub(crate) files: Vec<(String, Option<String>)>,
+}
+
+/// Resolves and hashes one task scope below `root`.
+///
+/// Implements: rust-retry/recertified-done-marker
+pub(crate) fn hash(root: &Path, scope: &[String]) -> ScopeHash {
+    let resolved = resolve(root, scope);
+    let mut lines = Vec::with_capacity(resolved.len());
+    let mut files = Vec::with_capacity(resolved.len());
+    for entry in resolved {
+        let file_hash = entry.file.as_deref().and_then(file_hash);
+        let suffix = file_hash.clone().unwrap_or_default();
+        lines.push(format!("{}:{suffix}", entry.path));
+        files.push((entry.path, file_hash));
+    }
+    ScopeHash {
+        hash: digest(&lines.join("\n")),
+        files,
+    }
+}
+
+/// Resolves every scope entry, keeping the first result for one path.
+///
+/// Implements: rust-retry/recertified-done-marker
+fn resolve(root: &Path, scope: &[String]) -> Vec<Resolved> {
+    let mut results: BTreeMap<String, Option<PathBuf>> = BTreeMap::new();
+    for raw in scope {
+        let normalized = normalize(raw);
+        if is_pattern(&normalized) {
+            resolve_pattern(root, &normalized, &mut results);
+        } else {
+            resolve_exact(root, &normalized, &mut results);
+        }
+    }
+    results
+        .into_iter()
+        .map(|(path, file)| Resolved { path, file })
+        .collect()
+}
+
+/// Adds every file a pattern matches below its search root.
+///
+/// Implements: rust-retry/recertified-done-marker
+fn resolve_pattern(root: &Path, entry: &str, results: &mut BTreeMap<String, Option<PathBuf>>) {
+    let scope = [entry.to_owned()];
+    for relative in files_under(root) {
+        if !scope_covers_path(&scope, &relative) || results.contains_key(&relative) {
+            continue;
+        }
+        results.insert(relative.clone(), Some(root.join(&relative)));
+    }
+}
+
+/// Adds one exact entry, with a file only for an in-project regular file.
+///
+/// Implements: rust-retry/recertified-done-marker
+fn resolve_exact(root: &Path, entry: &str, results: &mut BTreeMap<String, Option<PathBuf>>) {
+    if results.contains_key(entry) {
+        return;
+    }
+    if entry == ".." || entry.starts_with("../") || Path::new(entry).is_absolute() {
+        results.insert(entry.to_owned(), None);
+        return;
+    }
+    let path = root.join(entry);
+    let file = fs::symlink_metadata(&path)
+        .is_ok_and(|metadata| metadata.file_type().is_file())
+        .then_some(path);
+    results.insert(entry.to_owned(), file);
+}
+
+/// Every regular file below `root`, as paths relative to the project root.
+///
+/// Implements: rust-retry/recertified-done-marker
+fn files_under(root: &Path) -> Vec<String> {
+    let mut files = Vec::new();
+    walk(root, "", &mut files);
+    files.sort();
+    files
+}
+
+/// Walks one folder without following symbolic links, adding its files.
+///
+/// Implements: rust-retry/recertified-done-marker
+fn walk(dir: &Path, prefix: &str, files: &mut Vec<String>) {
+    let Ok(entries) = fs::read_dir(dir) else {
+        return;
+    };
+    let mut names: Vec<String> = entries
+        .flatten()
+        .filter_map(|entry| entry.file_name().into_string().ok())
+        .collect();
+    names.sort();
+    for name in names {
+        let path = dir.join(&name);
+        let Ok(kind) = fs::symlink_metadata(&path) else {
+            continue;
+        };
+        let relative = if prefix.is_empty() {
+            name
+        } else {
+            format!("{prefix}/{name}")
+        };
+        if kind.file_type().is_dir() {
+            walk(&path, &relative, files);
+        } else if kind.file_type().is_file() {
+            files.push(normalize(&relative));
+        }
+    }
+}
+
+/// Trims an entry, turns its backslashes into `/` and drops leading `./`.
+///
+/// Implements: rust-retry/recertified-done-marker
+fn normalize(value: &str) -> String {
+    js_trim(value)
+        .replace('\\', "/")
+        .trim_start_matches("./")
+        .to_string()
+}
+
+/// Whether an entry is a glob or a trailing-directory pattern.
+///
+/// Implements: rust-retry/recertified-done-marker
+fn is_pattern(entry: &str) -> bool {
+    entry.contains('*') || entry.contains('?') || entry.ends_with('/')
+}
+
+/// The `sha256:` hash of one regular file read as UTF-8 with replacement.
+///
+/// Implements: rust-retry/recertified-done-marker
+fn file_hash(path: &Path) -> Option<String> {
+    let bytes = fs::read(path).ok()?;
+    Some(digest(&String::from_utf8_lossy(&bytes)))
+}
+
+/// The `sha256:` digest of `content` as lowercase hexadecimal.
+///
+/// Implements: rust-retry/recertified-done-marker
+fn digest(content: &str) -> String {
+    let hash = Sha256::digest(content.as_bytes());
+    let mut hex = String::with_capacity(64);
+    for byte in hash {
+        let _ = write!(hex, "{byte:02x}");
+    }
+    format!("sha256:{hex}")
+}
