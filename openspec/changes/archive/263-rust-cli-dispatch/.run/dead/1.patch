@@ -0,0 +1,128 @@
+//! Helpers shared by the CLI crate's tests: a feature double and fixture copies.
+//!
+//! Each test binary compiles this module on its own, so some helpers are
+//! unused in a given binary even though another test uses them.
+#![allow(dead_code)]
+
+use std::fs;
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+use osq_cli::features;
+use osq_core::{Command, Feature, FeatureError, Invocation, Output};
+
+/// A counter shared with a feature double after it is boxed.
+pub type Counter = Arc<AtomicUsize>;
+
+/// A feature double that records how often its `run` is called.
+pub struct TestFeature {
+    /// The feature's name.
+    name: &'static str,
+    /// The commands the feature lists.
+    commands: Vec<Command>,
+    /// What `run` returns.
+    result: Result<Output, FeatureError>,
+    /// How many times `run` was called.
+    calls: Counter,
+}
+
+impl TestFeature {
+    /// Builds a feature double from its name, commands and result.
+    pub fn new(
+        name: &'static str,
+        commands: Vec<Command>,
+        result: Result<Output, FeatureError>,
+    ) -> Self {
+        Self {
+            name,
+            commands,
+            result,
+            calls: Arc::new(AtomicUsize::new(0)),
+        }
+    }
+
+    /// A handle on the call counter that outlives the box.
+    pub fn counter(&self) -> Counter {
+        Arc::clone(&self.calls)
+    }
+}
+
+impl Feature for TestFeature {
+    /// The feature's name.
+    fn name(&self) -> &str {
+        self.name
+    }
+
+    /// The commands the feature lists.
+    fn commands(&self) -> Vec<Command> {
+        self.commands.clone()
+    }
+
+    /// Records the call and returns the configured result.
+    fn run(&self, _invocation: &Invocation) -> Result<Output, FeatureError> {
+        self.calls.fetch_add(1, Ordering::SeqCst);
+        self.result.clone()
+    }
+}
+
+/// The number of calls a counter has recorded.
+pub fn calls(counter: &Counter) -> usize {
+    counter.load(Ordering::SeqCst)
+}
+
+/// Wraps test features in the boxes `run_cli` takes.
+pub fn boxed(features: Vec<TestFeature>) -> Vec<Box<dyn Feature>> {
+    features
+        .into_iter()
+        .map(|feature| Box::new(feature) as Box<dyn Feature>)
+        .collect()
+}
+
+/// A fresh copy of the crate's fixture project under `CARGO_TARGET_TMPDIR`.
+pub fn fixture_copy(name: &str) -> PathBuf {
+    let source = Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/fixtures/project");
+    let target = Path::new(env!("CARGO_TARGET_TMPDIR")).join(name);
+    let _ = fs::remove_dir_all(&target);
+    fs::create_dir_all(&target).unwrap();
+    copy_dir(&source, &target);
+    fs::canonicalize(target).unwrap()
+}
+
+/// Copies every file and folder of `source` into `target`.
+fn copy_dir(source: &Path, target: &Path) {
+    for entry in fs::read_dir(source).unwrap() {
+        let entry = entry.unwrap();
+        let destination = target.join(entry.file_name());
+        if entry.file_type().unwrap().is_dir() {
+            fs::create_dir_all(&destination).unwrap();
+            copy_dir(&entry.path(), &destination);
+        } else {
+            fs::copy(entry.path(), destination).unwrap();
+        }
+    }
+}
+
+/// The registered feature that lists a command, built fresh from `features()`.
+pub fn feature_for(command: &str) -> Box<dyn Feature> {
+    features()
+        .into_iter()
+        .find(|feature| {
+            feature
+                .commands()
+                .iter()
+                .any(|listed| listed.name == command)
+        })
+        .unwrap_or_else(|| panic!("no feature lists {command}"))
+}
+
+/// The text the feature that lists `command` returns for one invocation.
+pub fn feature_text(root: &Path, command: &str, args: &[&str]) -> String {
+    let feature = feature_for(command);
+    let invocation = Invocation::new(
+        root,
+        command,
+        args.iter().map(|arg| (*arg).to_owned()).collect(),
+    );
+    feature.run(&invocation).expect("the feature succeeds").text
+}
