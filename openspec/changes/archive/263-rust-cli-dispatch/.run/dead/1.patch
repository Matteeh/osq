+//! Proves the registry, the help texts and the dispatch of one command line.
+
+mod support;
+
+use std::fs;
+use std::path::Path;
+
+use osq_cli::{CliResult, features, run_cli};
+use osq_core::{Command, Feature, Output};
+
+/// Runs `run_cli` on literal arguments against an unused root.
+fn run(features: &[Box<dyn Feature>], args: &[&str]) -> CliResult {
+    let args: Vec<String> = args.iter().map(|arg| (*arg).to_owned()).collect();
+    run_cli(features, Path::new("/unused"), &args)
+}
+
+/// The `alpha` test feature, whose one command has a usage.
+fn alpha() -> support::TestFeature {
+    support::TestFeature::new(
+        "alpha",
+        vec![Command::new("one", "does one", "<id>")],
+        Ok(Output::text("one ran")),
+    )
+}
+
+/// The `beta` test feature, whose one command has no usage.
+fn beta() -> support::TestFeature {
+    support::TestFeature::new(
+        "beta",
+        vec![Command::new("two", "does two", "")],
+        Ok(Output::text("two ran")),
+    )
+}
+
+/// Proves that the CLI crate's files sit under `crates/apps/cli`.
+///
+/// Covers: rust-cli/cli-crate-ownership
+#[test]
+fn cli_crate_ownership() {
+    let manifest = Path::new(env!("CARGO_MANIFEST_DIR"));
+    assert_eq!(manifest.file_name().unwrap(), "cli");
+    assert_eq!(manifest.parent().unwrap().file_name().unwrap(), "apps");
+    assert_eq!(
+        manifest
+            .parent()
+            .unwrap()
+            .parent()
+            .unwrap()
+            .file_name()
+            .unwrap(),
+        "crates"
+    );
+    for file in ["Cargo.toml", "src/lib.rs", "src/main.rs"] {
+        assert!(manifest.join(file).is_file(), "{file}");
+    }
+    let manifest_text = fs::read_to_string(manifest.join("Cargo.toml")).unwrap();
+    assert!(manifest_text.contains("name = \"osq-cli\""));
+    assert!(manifest_text.contains("name = \"osq-rs\""));
+}
+
+/// Proves the registered feature names and their order.
+///
+/// Covers: rust-cli/registered-features
+#[test]
+fn registered_features() {
+    let features = features();
+    let names: Vec<&str> = features.iter().map(|feature| feature.name()).collect();
+    assert_eq!(
+        names,
+        ["plan", "approve", "archive", "land", "inbox", "report"]
+    );
+}
+
+/// Proves the top-level and command help rows built from `Command` data.
+///
+/// Covers: rust-cli/help-from-the-features-data
+#[test]
+fn help_from_the_features_data() {
+    let top =
+        "Usage: osq-rs <command> [args]\n\nCommands:\n  one <id>  does one\n  two  does two\n";
+    let cases: [(&[&str], &str); 5] = [
+        (&[], top),
+        (&["--help"], top),
+        (&["-h"], top),
+        (&["one", "--help"], "Usage: osq-rs one <id>\n\ndoes one\n"),
+        (&["two", "-h"], "Usage: osq-rs two\n\ndoes two\n"),
+    ];
+    for (args, expected) in cases {
+        let features = support::boxed(vec![alpha(), beta()]);
+        let result = run(&features, args);
+        assert_eq!(result.stdout, expected, "{args:?}");
+        assert_eq!(result.stderr, "", "{args:?}");
+        assert_eq!(result.code, 0, "{args:?}");
+    }
+}
+
+/// Proves that the top-level help holds every registered command and no other.
+///
+/// Covers: rust-cli/help-lists-every-registered-command
+#[test]
+fn help_lists_every_registered_command() {
+    let features = features();
+    let result = run(&features, &["--help"]);
+    let commands: Vec<Command> = features
+        .iter()
+        .flat_map(|feature| feature.commands())
+        .collect();
+    let mut expected = vec![
+        "Usage: osq-rs <command> [args]".to_owned(),
+        String::new(),
+        "Commands:".to_owned(),
+    ];
+    for command in &commands {
+        let usage = if command.usage.is_empty() {
+            String::new()
+        } else {
+            format!(" {}", command.usage)
+        };
+        expected.push(format!("  {}{}  {}", command.name, usage, command.summary));
+    }
+    expected.push(String::new());
+    assert_eq!(result.stdout, expected.join("\n"));
+    assert_eq!(result.stdout.lines().count(), commands.len() + 3);
+    assert_eq!(result.stderr, "");
+    assert_eq!(result.code, 0);
+}
+
+/// Proves that an unlisted command refuses and calls no feature.
+///
+/// Covers: rust-cli/unknown-command
+#[test]
+fn unknown_command() {
+    let alpha = alpha();
+    let beta = beta();
+    let alpha_calls = alpha.counter();
+    let beta_calls = beta.counter();
+    let features = support::boxed(vec![alpha, beta]);
+    let result = run(&features, &["nope"]);
+    assert_eq!(result.stdout, "");
+    assert_eq!(result.stderr, "unknown command: nope\n");
+    assert_eq!(result.code, 1);
+    assert_eq!(support::calls(&alpha_calls), 0);
+    assert_eq!(support::calls(&beta_calls), 0);
+}
+
+/// Proves that dispatch picks the first feature that lists the command.
+///
+/// Covers: rust-cli/first-feature-wins
+#[test]
+fn first_feature_wins() {
+    let first = support::TestFeature::new(
+        "first",
+        vec![Command::new("same", "runs first", "")],
+        Ok(Output::text("first")),
+    );
+    let second = support::TestFeature::new(
+        "second",
+        vec![Command::new("same", "runs second", "")],
+        Ok(Output::text("second")),
+    );
+    let first_calls = first.counter();
+    let second_calls = second.counter();
+    let features = support::boxed(vec![first, second]);
+    let result = run(&features, &["same"]);
+    assert_eq!(result.stdout, "first");
+    assert_eq!(result.stderr, "");
+    assert_eq!(result.code, 0);
+    assert_eq!(support::calls(&first_calls), 1);
+    assert_eq!(support::calls(&second_calls), 0);
+}
