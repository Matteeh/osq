@@ -1,4 +1,58 @@
-//! The osq command line: parses arguments, dispatches to the registered features and prints.
+//! The `osq-rs` entry point: the process's IO around [`osq_cli::run_cli`].
 
-/// Entry point; no feature is registered yet.
-fn main() {}
+use std::env;
+use std::io::{self, Write as _};
+use std::process::ExitCode;
+
+use osq_cli::CliResult;
+
+/// Runs the process's command line and exits with its code.
+///
+/// Implements: rust-cli/cli-entry-point
+fn main() -> ExitCode {
+    let root = match env::current_dir() {
+        Ok(root) => root,
+        Err(error) => return refuse(&format!("cannot read the current directory: {error}")),
+    };
+    let Some(args) = arguments() else {
+        return ExitCode::from(1);
+    };
+    let features = osq_cli::features();
+    let result = osq_cli::run_cli(&features, &root, &args);
+    write(&result);
+    ExitCode::from(result.code)
+}
+
+/// The process's arguments after the program name, or `None` after an error.
+fn arguments() -> Option<Vec<String>> {
+    let mut args = Vec::new();
+    for argument in env::args_os().skip(1) {
+        match argument.into_string() {
+            Ok(argument) => args.push(argument),
+            Err(argument) => {
+                refuse(&format!(
+                    "argument is not valid UTF-8: {}",
+                    argument.to_string_lossy()
+                ));
+                return None;
+            }
+        }
+    }
+    Some(args)
+}
+
+/// Writes one error line to stderr and returns exit code 1.
+fn refuse(message: &str) -> ExitCode {
+    let _ = writeln!(io::stderr(), "{message}");
+    ExitCode::from(1)
+}
+
+/// Writes the result's stdout and stderr to the process's streams.
+fn write(result: &CliResult) {
+    let mut stdout = io::stdout();
+    let mut stderr = io::stderr();
+    let _ = stdout.write_all(result.stdout.as_bytes());
+    let _ = stdout.flush();
+    let _ = stderr.write_all(result.stderr.as_bytes());
+    let _ = stderr.flush();
+}
