diff --git a/crates/apps/cli/src/lib.rs b/crates/apps/cli/src/lib.rs
new file mode 100644
index 00000000..47bf7fa9
--- /dev/null
+++ b/crates/apps/cli/src/lib.rs
@@ -0,0 +1,165 @@
+//! The osq command line: the feature registry and one command line's dispatch.
+
+use std::path::Path;
+
+use osq_core::{Command, Feature, FeatureError, Invocation};
+use osq_feature_approve::ApproveFeature;
+use osq_feature_archive::ArchiveFeature;
+use osq_feature_inbox::InboxFeature;
+use osq_feature_land::LandFeature;
+use osq_feature_plan::PlanFeature;
+use osq_feature_report::ReportFeature;
+
+/// The first line of the top-level help.
+const TOP_USAGE: &str = "Usage: osq-rs <command> [args]";
+
+/// One command line's result: its two streams and its exit code.
+///
+/// Implements: rust-cli/command-line-result
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct CliResult {
+    /// The text to write to the process's stdout.
+    ///
+    /// Implements: rust-cli/command-line-result
+    pub stdout: String,
+    /// The text to write to the process's stderr.
+    ///
+    /// Implements: rust-cli/command-line-result
+    pub stderr: String,
+    /// The process exit code, 0 for success and 1 for a refusal.
+    ///
+    /// Implements: rust-cli/command-line-result
+    pub code: u8,
+}
+
+/// Every feature the binary registers, in dispatch order.
+///
+/// Implements: rust-cli/feature-registry
+#[must_use]
+pub fn features() -> Vec<Box<dyn Feature>> {
+    vec![
+        Box::new(PlanFeature::new()),
+        Box::new(ApproveFeature),
+        Box::new(ArchiveFeature),
+        Box::new(LandFeature),
+        Box::new(InboxFeature::new()),
+        Box::new(ReportFeature),
+    ]
+}
+
+/// Runs one command line, without the program name, and returns its result.
+///
+/// Implements: rust-cli/command-line-result
+/// Implements: rust-cli/cli-help
+/// Implements: rust-cli/command-dispatch
+#[must_use]
+pub fn run_cli(features: &[Box<dyn Feature>], root: &Path, args: &[String]) -> CliResult {
+    match args.split_first() {
+        None => ok(top_help(features)),
+        Some((first, _rest)) if is_help(first) => ok(top_help(features)),
+        Some((name, rest)) => {
+            if rest.first().is_some_and(|second| is_help(second)) {
+                if let Some(text) = command_help(features, name) {
+                    return ok(text);
+                }
+            }
+            dispatch(features, root, name, rest)
+        }
+    }
+}
+
+/// Whether an argument asks for help.
+fn is_help(argument: &str) -> bool {
+    argument == "--help" || argument == "-h"
+}
+
+/// A successful result with its stdout text and an empty stderr.
+fn ok(stdout: String) -> CliResult {
+    CliResult {
+        stdout,
+        stderr: String::new(),
+        code: 0,
+    }
+}
+
+/// The top-level help built from every feature's commands.
+fn top_help(features: &[Box<dyn Feature>]) -> String {
+    let mut text = format!("{TOP_USAGE}\n\nCommands:\n");
+    for feature in features {
+        for command in feature.commands() {
+            text.push_str("  ");
+            text.push_str(&command_usage(&command));
+            text.push_str("  ");
+            text.push_str(&command.summary);
+            text.push('\n');
+        }
+    }
+    text
+}
+
+/// One command's help built from its `Command` data.
+fn command_help(features: &[Box<dyn Feature>], name: &str) -> Option<String> {
+    let command = find_command(features, name)?;
+    Some(format!(
+        "Usage: osq-rs {}\n\n{}\n",
+        command_usage(&command),
+        command.summary
+    ))
+}
+
+/// The first command any feature lists with a name.
+fn find_command(features: &[Box<dyn Feature>], name: &str) -> Option<Command> {
+    features
+        .iter()
+        .flat_map(|feature| feature.commands())
+        .find(|command| command.name == name)
+}
+
+/// A command's name followed by its usage when it has one.
+fn command_usage(command: &Command) -> String {
+    let mut text = command.name.clone();
+    if !command.usage.is_empty() {
+        text.push(' ');
+        text.push_str(&command.usage);
+    }
+    text
+}
+
+/// Runs the command through the first feature that lists it.
+fn dispatch(features: &[Box<dyn Feature>], root: &Path, name: &str, args: &[String]) -> CliResult {
+    for feature in features {
+        if lists_command(feature.as_ref(), name) {
+            return run_feature(feature.as_ref(), root, name, args);
+        }
+    }
+    CliResult {
+        stdout: String::new(),
+        stderr: format!("unknown command: {name}\n"),
+        code: 1,
+    }
+}
+
+/// Whether a feature lists a command with a name.
+fn lists_command(feature: &dyn Feature, name: &str) -> bool {
+    feature
+        .commands()
+        .iter()
+        .any(|command| command.name == name)
+}
+
+/// Runs one feature's command and turns its result into a CLI result.
+fn run_feature(feature: &dyn Feature, root: &Path, name: &str, args: &[String]) -> CliResult {
+    match feature.run(&Invocation::new(root, name, args.to_vec())) {
+        Ok(output) => ok(output.text),
+        Err(error) => refusal(&error),
+    }
+}
+
+/// A refused command: its error text and code 1.
+fn refusal(error: &FeatureError) -> CliResult {
+    CliResult {
+        stdout: String::new(),
+        stderr: format!("{error}\n"),
+        code: 1,
+    }
+}
