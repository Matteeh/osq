@@ -0,0 +1,125 @@
+//! Proves the built `osq-rs` binary's output, errors and exit codes.
+
+mod support;
+
+use std::fs;
+use std::path::Path;
+use std::process::{Command, Output};
+
+/// The path of the built `osq-rs` binary.
+const BINARY: &str = env!("CARGO_BIN_EXE_osq-rs");
+
+/// Runs the binary in `root` with literal arguments.
+fn run_binary(root: &Path, args: &[&str]) -> Output {
+    Command::new(BINARY)
+        .current_dir(root)
+        .args(args)
+        .output()
+        .expect("the binary runs")
+}
+
+/// The text of one captured stream.
+fn text(bytes: &[u8]) -> String {
+    String::from_utf8(bytes.to_vec()).expect("the stream is UTF-8")
+}
+
+/// Proves that each command prints what its feature returns on a fresh copy.
+///
+/// Covers: rust-cli/commands-through-the-binary
+#[test]
+fn commands_through_the_binary() {
+    let cases: [(&[&str], &str); 3] = [
+        (&["inbox"], "inbox"),
+        (&["queue"], "queue"),
+        (&["query", "SELECT 1 AS one"], "query"),
+    ];
+    for (args, command) in cases {
+        let actual = support::fixture_copy(&format!("cli-binary-actual-{command}"));
+        let expected = support::fixture_copy(&format!("cli-binary-expected-{command}"));
+        let output = run_binary(&actual, args);
+        assert_eq!(
+            text(&output.stdout),
+            support::feature_text(&expected, command, &args[1..]),
+            "{command}"
+        );
+        assert_eq!(text(&output.stderr), "", "{command}");
+        assert_eq!(output.status.code(), Some(0), "{command}");
+    }
+}
+
+/// Proves that a feature's refusal reaches stderr with exit code 1.
+///
+/// Covers: rust-cli/feature-error-through-the-binary
+#[test]
+fn feature_error_through_the_binary() {
+    let root = support::fixture_copy("cli-binary-feature-error");
+    let output = run_binary(&root, &["inbox", "extra"]);
+    assert_eq!(text(&output.stdout), "");
+    assert_eq!(text(&output.stderr), "usage of inbox: takes no arguments\n");
+    assert_eq!(output.status.code(), Some(1));
+}
+
+/// Proves that an unknown command exits 1 with its one-line error.
+///
+/// Covers: rust-cli/binary-exit-code
+#[test]
+fn binary_exit_code() {
+    let root = support::fixture_copy("cli-binary-exit-code");
+    let output = run_binary(&root, &["nope"]);
+    assert_eq!(text(&output.stdout), "");
+    assert_eq!(text(&output.stderr), "unknown command: nope\n");
+    assert_eq!(output.status.code(), Some(1));
+}
+
+/// Proves that a non-UTF-8 argument is a one-line error and code 1.
+///
+/// Covers: rust-cli/binary-exit-code
+#[cfg(unix)]
+#[test]
+fn binary_refuses_a_non_utf8_argument() {
+    use std::ffi::OsString;
+    use std::os::unix::ffi::OsStringExt;
+
+    let root = support::fixture_copy("cli-binary-non-utf8");
+    let output = Command::new(BINARY)
+        .current_dir(&root)
+        .arg(OsString::from_vec(vec![0xff]))
+        .output()
+        .expect("the binary runs");
+    let stderr = text(&output.stderr);
+    assert_eq!(text(&output.stdout), "");
+    assert!(
+        stderr.starts_with("argument is not valid UTF-8: "),
+        "{stderr}"
+    );
+    assert!(stderr.contains('\u{fffd}'), "{stderr}");
+    assert_eq!(stderr.lines().count(), 1, "{stderr}");
+    assert_eq!(output.status.code(), Some(1));
+}
+
+/// Proves that an unreadable current directory is a one-line error and code 1.
+///
+/// Covers: rust-cli/binary-exit-code
+#[cfg(unix)]
+#[test]
+fn binary_refuses_an_unreadable_current_directory() {
+    let root = Path::new(env!("CARGO_TARGET_TMPDIR")).join("cli-binary-unreadable-cwd");
+    let _ = fs::remove_dir_all(&root);
+    fs::create_dir_all(&root).unwrap();
+    let output = Command::new("sh")
+        .arg("-c")
+        .arg("cd \"$1\" && rmdir \"$1\" && exec \"$2\"")
+        .arg("sh")
+        .arg(&root)
+        .arg(BINARY)
+        .output()
+        .expect("the shell runs");
+    let stderr = text(&output.stderr);
+    assert_eq!(text(&output.stdout), "");
+    assert!(
+        stderr.starts_with("cannot read the current directory: "),
+        "{stderr}"
+    );
+    assert_eq!(stderr.lines().count(), 1, "{stderr}");
+    assert_eq!(output.status.code(), Some(1));
+}
