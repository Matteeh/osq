index 000000000..189fc57ee
--- /dev/null
+++ b/crates/features/lint/src/lint/entry.rs
@@ -0,0 +1,358 @@
+//! TypeScript's entry paths: each task `entry` the change cannot provide.
+
+use std::env;
+use std::fs;
+use std::path::{Component, Path, PathBuf};
+
+use osq_core::scope_covers_path;
+use osq_kernel_config::Config;
+use osq_kernel_loop::scope_files;
+use osq_kernel_specs::{js_trim, parse_frontmatter, parse_task_file};
+use osq_kernel_storage::{ChangeEntry, Location, list_changes};
+use osq_kernel_vcs::{GitVcs, Vcs, stacked_root};
+
+use super::finding::{Finding, Severity};
+use super::tasks::task_order;
+
+/// The folder of the living specs and changes.
+const OPENSPEC: &str = "openspec";
+/// The changes folder below the openspec folder.
+const CHANGES: &str = "changes";
+/// The archive folder below the changes folder.
+const ARCHIVE: &str = "archive";
+/// The task files folder below a change folder.
+const TASKS: &str = "tasks";
+/// The marker a human's approval writes.
+const APPROVED: &str = ".run/approved";
+/// The fallback default branch.
+const MAIN: &str = "main";
+
+/// One task whose frontmatter parses, with the entries the rule reads.
+struct Task {
+    /// The task's number, its file name without `.md`.
+    number: String,
+    /// The task file's path from the root.
+    path: String,
+    /// The task's declared scope entries.
+    scope: Vec<String>,
+    /// The task's declared entry paths.
+    entry: Vec<String>,
+}
+
+/// The entry findings for one change, in task and entry order.
+///
+/// Implements: rust-lint/lint-entry-paths
+pub(crate) fn findings(root: &Path, change: &Path, folder: &str, config: &Config) -> Vec<Finding> {
+    let rule = Rule::read(root, change, folder, config);
+    let tasks = tasks(change);
+    let mut findings = Vec::new();
+    let mut earlier: Vec<Vec<String>> = Vec::new();
+    for task in &tasks {
+        let mut scopes = earlier.clone();
+        scopes.push(task.scope.clone());
+        for entry in &task.entry {
+            if rule.provides(&scopes, entry) {
+                continue;
+            }
+            findings.push(Finding::new(
+                Severity::Error,
+                task.path.clone(),
+                None,
+                format!(
+                    "Task {} entry names {entry}, which is not in {} and no task up to this one \
+                     creates",
+                    task.number,
+                    rule.tree()
+                ),
+            ));
+        }
+        earlier.push(task.scope.clone());
+    }
+    findings
+}
+
+/// The project tree and the git facts provider 3 and provider 4 read.
+struct Rule<'a> {
+    /// The project root.
+    root: &'a Path,
+    /// The change folder being linted.
+    change: &'a Path,
+    /// The change folder's name.
+    folder: &'a str,
+    /// The loaded project config.
+    config: &'a Config,
+    /// The git port rooted at the project.
+    vcs: GitVcs,
+    /// The default branch when git is on.
+    git: Option<String>,
+}
+
+impl<'a> Rule<'a> {
+    /// Reads the tree the entries are checked against.
+    fn read(root: &'a Path, change: &'a Path, folder: &'a str, config: &'a Config) -> Self {
+        let vcs = GitVcs::new(root);
+        let on = config.vcs.enabled
+            && vcs
+                .root()
+                .ok()
+                .flatten()
+                .is_some_and(|found| same_root(root, &found));
+        let git = on.then(|| {
+            let fallback = config.vcs.default_branch.as_deref().unwrap_or(MAIN);
+            vcs.default_branch(fallback)
+                .unwrap_or_else(|_| fallback.to_owned())
+        });
+        Self {
+            root,
+            change,
+            folder,
+            config,
+            vcs,
+            git,
+        }
+    }
+
+    /// The tree's name as the finding writes it.
+    fn tree(&self) -> &str {
+        self.git.as_deref().unwrap_or("the project")
+    }
+
+    /// True when any provider supplies one entry.
+    fn provides(&self, scopes: &[Vec<String>], entry: &str) -> bool {
+        self.inside_change(entry)
+            || scope_covers_path(&scopes.concat(), entry)
+            || self.in_tree(entry)
+            || self.by_approved_change(entry)
+    }
+
+    /// True when the entry names an existing path inside the change folder.
+    fn inside_change(&self, entry: &str) -> bool {
+        let Some(rest) = self.change_relative(entry) else {
+            return false;
+        };
+        if is_pattern(&rest) {
+            return scope_files(self.change, &[rest])
+                .iter()
+                .any(|path| regular_file(self.change, path));
+        }
+        fs::metadata(self.change.join(rest)).is_ok()
+    }
+
+    /// The part of an entry inside the change folder, or none when it names no
+    /// path there.
+    fn change_relative(&self, entry: &str) -> Option<String> {
+        let prefix = format!("{OPENSPEC}/{CHANGES}/{}/", self.folder);
+        let normalized = entry.trim().replace('\\', "/");
+        if let Some(rest) = normalized.strip_prefix(&prefix) {
+            return Some(rest.to_owned());
+        }
+        let change = resolve(self.root, &format!("{OPENSPEC}/{CHANGES}/{}", self.folder));
+        let absolute = resolve(self.root, entry);
+        let rest = absolute.strip_prefix(&change).ok()?;
+        Some(rest.to_string_lossy().replace('\\', "/"))
+    }
+
+    /// True when the entry is in the tree the task runs in.
+    fn in_tree(&self, entry: &str) -> bool {
+        if is_pattern(entry) {
+            return scope_files(self.root, &[entry.to_owned()])
+                .iter()
+                .any(|path| regular_file(self.root, path));
+        }
+        if let Some(branch) = &self.git {
+            return self.vcs.path_exists(branch, entry).unwrap_or(false);
+        }
+        fs::metadata(self.root.join(entry)).is_ok()
+    }
+
+    /// True when an approved or archived other change covers the entry.
+    fn by_approved_change(&self, entry: &str) -> bool {
+        list_changes(self.root)
+            .into_iter()
+            .filter(|change| change.folder != self.folder)
+            .any(|change| self.change_approved(&change) && covers(&change.path, entry))
+    }
+
+    /// True when one other change reads approved or archived.
+    fn change_approved(&self, change: &ChangeEntry) -> bool {
+        if let Some(branch) = &self.git {
+            if self
+                .vcs
+                .path_exists(branch, &archive(&change.folder))
+                .unwrap_or(false)
+            {
+                return false;
+            }
+            let own = format!("osq/{}", change.folder);
+            if self.branch_exists(&own) {
+                return self.branch_holds(&own, &format!("{}/{APPROVED}", archive(&change.folder)))
+                    || self.branch_holds(
+                        &own,
+                        &format!("{OPENSPEC}/{CHANGES}/{}/{APPROVED}", change.folder),
+                    );
+            }
+            if self.stacked_approved(&change.folder) {
+                return true;
+            }
+        }
+        matches!(change.location, Location::Active | Location::Archived)
+            && change.path.join(APPROVED).is_file()
+    }
+
+    /// True when a branch exists by its exact name.
+    fn branch_exists(&self, branch: &str) -> bool {
+        self.vcs
+            .list_branches(branch)
+            .unwrap_or_default()
+            .iter()
+            .any(|found| found == branch)
+    }
+
+    /// True when a branch holds a file at `path`.
+    fn branch_holds(&self, branch: &str, path: &str) -> bool {
+        self.vcs.show(branch, path).ok().flatten().is_some()
+    }
+
+    /// True when the change's stacked copy holds an approval marker.
+    fn stacked_approved(&self, folder: &str) -> bool {
+        let home = PathBuf::from(env::var("HOME").unwrap_or_default());
+        let repo = self
+            .vcs
+            .root()
+            .ok()
+            .flatten()
+            .unwrap_or_else(|| self.root.to_path_buf());
+        stacked_root(&self.config.vcs, &repo, &home)
+            .join(folder)
+            .join(OPENSPEC)
+            .join(CHANGES)
+            .join(folder)
+            .join(APPROVED)
+            .is_file()
+    }
+}
+
+/// The archive folder of a change.
+fn archive(folder: &str) -> String {
+    format!("{OPENSPEC}/{CHANGES}/{ARCHIVE}/{folder}")
+}
+
+/// True when one change covers an entry with one task's scope.
+fn covers(change: &Path, entry: &str) -> bool {
+    let Ok(entries) = fs::read_dir(change.join(TASKS)) else {
+        return false;
+    };
+    entries.flatten().any(|item| {
+        let name = item.file_name();
+        let name = name.to_string_lossy();
+        if !name.as_bytes().ends_with(b".md") {
+            return false;
+        }
+        let Ok(text) = fs::read_to_string(item.path()) else {
+            return false;
+        };
+        parse_task_file(&text).is_ok_and(|task| scope_covers_path(&task.scope, entry))
+    })
+}
+
+/// The tasks whose frontmatter parses, in the warnings' numeric order.
+fn tasks(change: &Path) -> Vec<Task> {
+    let folder = change.join(TASKS);
+    let Ok(entries) = fs::read_dir(&folder) else {
+        return Vec::new();
+    };
+    let mut names: Vec<String> = entries
+        .filter_map(Result::ok)
+        .filter(|entry| entry.file_type().is_ok_and(|kind| kind.is_file()))
+        .map(|entry| entry.file_name().to_string_lossy().into_owned())
+        .filter(|name| name.as_bytes().ends_with(b".md"))
+        .collect();
+    names.sort_by(|left, right| task_order(left, right));
+    let change_name = folder_name(change);
+    names
+        .into_iter()
+        .filter_map(|name| read_task(&folder, &name, change_name))
+        .collect()
+}
+
+/// Reads one task file, or none when its frontmatter does not parse.
+fn read_task(folder: &Path, name: &str, folder_name: &str) -> Option<Task> {
+    let text = fs::read_to_string(folder.join(name)).ok()?;
+    parse_frontmatter(&text).ok()?;
+    let file = parse_task_file(&text).ok()?;
+    if file
+        .scope
+        .iter()
+        .chain(file.entry.iter())
+        .any(|entry| holds_brace_group(js_trim(entry)))
+    {
+        return None;
+    }
+    Some(Task {
+        number: name.strip_suffix(".md").unwrap_or(name).to_owned(),
+        path: format!("{OPENSPEC}/{CHANGES}/{folder_name}/{TASKS}/{name}"),
+        scope: file.scope,
+        entry: file.entry,
+    })
+}
+
+/// The change folder's name.
+fn folder_name(change: &Path) -> &str {
+    change
+        .file_name()
+        .and_then(|name| name.to_str())
+        .unwrap_or_default()
+}
+
+/// True when an entry is a glob or trailing-directory form.
+fn is_pattern(entry: &str) -> bool {
+    let trimmed = js_trim(entry);
+    trimmed.contains('*') || trimmed.contains('?') || trimmed.ends_with('/')
+}
+
+/// True when a project-relative path names an existing regular file.
+fn regular_file(root: &Path, path: &str) -> bool {
+    root.join(path)
+        .symlink_metadata()
+        .is_ok_and(|metadata| metadata.file_type().is_file())
+}
+
+/// Resolves a path against `base` without touching the filesystem.
+fn resolve(base: &Path, path: &str) -> PathBuf {
+    let mut parts = PathBuf::new();
+    for component in base.join(path).components() {
+        match component {
+            Component::ParentDir => {
+                parts.pop();
+            }
+            Component::CurDir => {}
+            other => parts.push(other.as_os_str()),
+        }
+    }
+    parts
+}
+
+/// True when a text holds `{...}` with at least one comma and no other brace.
+fn holds_brace_group(text: &str) -> bool {
+    for (start, _) in text.match_indices('{') {
+        let rest = &text[start + 1..];
+        let Some(end) = rest.find(['{', '}']) else {
+            continue;
+        };
+        if rest.as_bytes()[end] != b'}' {
+            continue;
+        }
+        if rest[..end].contains(',') {
+            return true;
+        }
+    }
+    false
+}
+
+/// True when two roots name the same folder once both resolve.
+fn same_root(root: &Path, found: &Path) -> bool {
+    match (fs::canonicalize(root), fs::canonicalize(found)) {
+        (Ok(left), Ok(right)) => left == right,
+        _ => false,
+    }
+}
