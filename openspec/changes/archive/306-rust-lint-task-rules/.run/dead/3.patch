+}
+
+/// A task file whose scope and entry are the given lists.
+fn tasked(scope: &[&str], entry: &[&str]) -> String {
+    let mut text = format!("---\ntitle: T\n{VERIFY}\nscope:\n");
+    for item in scope {
+        text.push_str("  - ");
+        text.push_str(item);
+        text.push('\n');
+    }
+    if !entry.is_empty() {
+        text.push_str("entry:\n");
+        for item in entry {
+            text.push_str("  - ");
+            text.push_str(item);
+            text.push('\n');
+        }
+    }
+    text.push_str("---\n- [ ] a\n");
+    text
+}
