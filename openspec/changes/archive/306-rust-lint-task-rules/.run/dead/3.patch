+/// The per-task errors, then the entry errors, then the cross-task warnings.
+fn task_findings(root: &Path, change: &Path, folder: &str, config: &Config) -> Vec<Finding> {
+    let mut errors = Vec::new();
+    let mut warnings = Vec::new();
+    for finding in tasks::findings(root, change, folder, config) {
