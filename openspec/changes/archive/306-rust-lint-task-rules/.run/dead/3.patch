+//! Proves the entry rule against a scratch git repository's default branch.
+
+mod copy;
+mod support;
+
+use std::path::PathBuf;
+use std::process::Command;
+
+use osq_core::FeatureError;
+
+use support::{run, write};
+
+/// The task file every row writes.
+const TASK: &str = "openspec/changes/001-clean/tasks/1.md";
+/// The fixture's clean verify command.
+const VERIFY: &str = "verify: cargo test -p delta";
+/// A tagged Rust file the link gates accept.
+const SAMPLE: &str = "//! A scratch module.\n\n/// Adds nothing.\n///\n/// Implements: delta/adds-numbers\npub fn scratch() {}\n";
+/// The other change the provider rows use.
+const OTHER: &str = "openspec/changes/007-other";
+/// One scratch repository made from the lint fixture.
+struct Repo {
+    /// The repository's root.
+    root: PathBuf,
+}
+
+impl Repo {
+    /// Copies the fixture into a fresh repository whose first commit is `main`.
+    fn new(name: &str) -> Self {
+        let root = copy::fixture(name);
+        let repo = Self { root };
+        repo.git(&["init", "-q", "-b", "main"]);
+        repo.git(&["config", "commit.gpgSign", "false"]);
+        write(
+            &repo.root,
+            "osq.toml",
+            "[vcs]\nenabled = true\nauthor = \"osq <osq@example.com>\"\n",
+        );
+        repo.commit_all("initial");
+        repo
+    }
+
+    /// Runs git in the repository with isolated settings and a fixed identity.
+    fn git(&self, args: &[&str]) -> String {
+        let mut command = Command::new("git");
+        command.args(args).current_dir(&self.root);
+        command
+            .env("GIT_CONFIG_GLOBAL", "/dev/null")
+            .env("GIT_CONFIG_NOSYSTEM", "1")
+            .env("GIT_CEILING_DIRECTORIES", &self.root)
+            .env("GIT_CONFIG_COUNT", "1")
+            .env("GIT_CONFIG_KEY_0", "maintenance.auto")
+            .env("GIT_CONFIG_VALUE_0", "false")
+            .env("GIT_AUTHOR_NAME", "Osq Test")
+            .env("GIT_AUTHOR_EMAIL", "osq@example.com")
+            .env("GIT_AUTHOR_DATE", "2000-01-01T00:00:00+0000")
+            .env("GIT_COMMITTER_NAME", "Osq Test")
+            .env("GIT_COMMITTER_EMAIL", "osq@example.com")
+            .env("GIT_COMMITTER_DATE", "2000-01-01T00:00:00+0000");
+        let output = command.output().expect("git starts");
+        assert!(
+            output.status.success(),
+            "git {} failed: {}",
+            args.join(" "),
+            String::from_utf8_lossy(&output.stderr)
+        );
+        String::from_utf8_lossy(&output.stdout).into_owned()
+    }
+
+    /// Stages everything and commits it.
+    fn commit_all(&self, message: &str) {
+        self.git(&["add", "-A"]);
+        self.git(&["commit", "-q", "-m", message]);
+    }
+
+    /// Writes one file under the repository.
+    fn write(&self, path: &str, contents: impl AsRef<[u8]>) {
+        write(&self.root, path, contents);
+    }
+
+    /// The task file with the clean scope and one entry.
+    fn task(&self, entry: &str) {
+        self.write(
+            TASK,
+            format!(
+                "---\ntitle: T\n{VERIFY}\nscope:\n  - crates/delta/src/lib.rs\nentry:\n  - \
+                 {entry}\n---\n- [ ] a\n"
+            ),
+        );
+    }
+
+    /// Adds the other change with the given task scope, without a marker.
+    fn other(&self, scope: &str) {
+        self.write(
+            &format!("{OTHER}/tasks/1.md"),
+            format!("---\ntitle: T\n{VERIFY}\nscope:\n  - {scope}\n---\n- [ ] a\n"),
+        );
+    }
+
+    /// Checks the lint result against the expected output or message.
+    fn assert(&self, result: Result<&str, &str>) {
+        match (run(&self.root, "1"), result) {
+            (Ok(output), Ok(text)) => assert_eq!(output.text, text),
+            (Err(error), Err(text)) => match error {
+                FeatureError::Failed {
+                    command, message, ..
+                } => {
+                    assert_eq!(command, "lint");
+                    assert_eq!(message, text);
+                }
+                other => panic!("expected a failed error, got {other:?}"),
+            },
+            (result, _) => panic!("unexpected result {result:?}"),
+        }
+    }
+}
+
+/// Proves every row of "Entry paths with git on".
+///
+/// Covers: rust-lint/entry-paths-with-git-on
+#[test]
+fn lint_entry_git() {
+    let repo = Repo::new("lint_entry_git/rows");
+    repo.task("crates/delta/Cargo.toml");
+    repo.assert(Ok("001-clean: valid\n"));
+
+    repo.write("crates/delta/src/local.rs", SAMPLE);
+    repo.task("crates/delta/src/local.rs");
+    repo.assert(Err("001-clean: 1 finding\n\
+         001-clean: error openspec/changes/001-clean/tasks/1.md: Task 1 entry names \
+         crates/delta/src/local.rs, which is not in main and no task up to this one creates"));
+}
+
+/// Proves a provider change's branch and stacked approval provide entries.
+///
+/// Covers: rust-lint/entry-paths-with-git-on
+#[test]
+fn lint_entry_git_provider_states() {
+    let approved = Repo::new("lint_entry_git/approved");
+    approved.other("crates/delta/src/made.rs");
+    approved.commit_all("other change");
+    approved.git(&["checkout", "-q", "-b", "osq/007-other"]);
+    approved.write(&format!("{OTHER}/.run/approved"), "abc\n");
+    approved.commit_all("approve other");
+    approved.git(&["checkout", "-q", "main"]);
+    approved.write("crates/delta/src/made.rs", SAMPLE);
+    approved.task("crates/delta/src/made.rs");
+    approved.assert(Ok("001-clean: valid\n"));
+
+    let archived = Repo::new("lint_entry_git/archived");
+    archived.other("crates/delta/src/made.rs");
+    archived.commit_all("other change");
+    archived.git(&["checkout", "-q", "-b", "osq/007-other"]);
+    archived.write("openspec/changes/archive/007-other/.run/approved", "abc\n");
+    archived.commit_all("archive other");
+    archived.git(&["checkout", "-q", "main"]);
+    archived.write("crates/delta/src/made.rs", SAMPLE);
+    archived.task("crates/delta/src/made.rs");
+    archived.assert(Ok("001-clean: valid\n"));
+
+    let stacked = Repo::new("lint_entry_git/stacked");
+    let worktrees = stacked
+        .root
+        .parent()
+        .expect("the repository has a parent")
+        .join("worktrees");
+    let repo_name = stacked
+        .root
+        .file_name()
+        .expect("the repository has a name")
+        .to_string_lossy()
+        .into_owned();
+    write(
+        &stacked.root,
+        "osq.toml",
+        format!(
+            "[vcs]\nenabled = true\nauthor = \"osq <osq@example.com>\"\nworktreeRoot = \"{}\"\n",
+            worktrees.display()
+        ),
+    );
+    stacked.other("crates/delta/src/made.rs");
+    stacked.commit_all("other change with worktree root");
+    stacked.write(
+        &format!(
+            "{}/{repo_name}/.stacked/007-other/{OTHER}/.run/approved",
+            worktrees.display()
+        ),
+        "abc\n",
+    );
+    stacked.write("crates/delta/src/made.rs", SAMPLE);
+    stacked.task("crates/delta/src/made.rs");
+    stacked.assert(Ok("001-clean: valid\n"));
+}
+
+/// Proves a branch without approval, a landed change and a rejected change do
+/// not provide an entry through their checkout markers.
+///
+/// Covers: rust-lint/entry-paths-with-git-on
+#[test]
+fn lint_entry_git_provider_refusals() {
+    let branch = Repo::new("lint_entry_git/branch_unapproved");
+    branch.other("crates/delta/src/made.rs");
+    branch.commit_all("other change");
+    branch.git(&["checkout", "-q", "-b", "osq/007-other"]);
+    branch.write("branch.txt", "x\n");
+    branch.commit_all("branch without approval");
+    branch.git(&["checkout", "-q", "main"]);
+    branch.write(&format!("{OTHER}/.run/approved"), "abc\n");
+    branch.write("crates/delta/src/made.rs", SAMPLE);
+    branch.task("crates/delta/src/made.rs");
+    branch.assert(Err("001-clean: 1 finding\n\
+         001-clean: error openspec/changes/001-clean/tasks/1.md: Task 1 entry names \
+         crates/delta/src/made.rs, which is not in main and no task up to this one creates"));
+
+    let landed = Repo::new("lint_entry_git/landed");
