diff --git a/tests/recovery-restart-remove-fails.test.ts b/tests/recovery-restart-remove-fails.test.ts
new file mode 100644
index 00000000..25c9a3b1
--- /dev/null
+++ b/tests/recovery-restart-remove-fails.test.ts
@@ -0,0 +1,155 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { after, afterEach, before } from 'node:test';
+import { fileURLToPath } from 'node:url';
+import { scenario } from '@matteeh/osq/testing';
+import {
+  type CommandResult,
+  type RecoveryProject,
+  ScriptedAdapter,
+  assertOk,
+  commitMain,
+  createRecoveryProject,
+  exists,
+  git,
+  reviseTask,
+} from './recovery-support.js';
+
+const CHANGE_SLUG = '341-worktree-remove-not-timed-out';
+const REPO_ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const tmpDirs: string[] = [];
+let lookupRoot: string | null = null;
+let previousChange: string | undefined;
+
+/** Rename every repeated scenario header after its first, for a clean lookup root. */
+function dedupeScenarioNames(content: string): string {
+  const seen = new Set<string>();
+  return content
+    .split('\n')
+    .map((line) => {
+      const match = /^#### Scenario: (.+)$/.exec(line);
+      if (match === null) return line;
+      const name = match[1] ?? '';
+      if (!seen.has(name)) {
+        seen.add(name);
+        return line;
+      }
+      return `#### Scenario: ${name} (variant)`;
+    })
+    .join('\n');
+}
+
+/** Point scenario lookup at the deduped living spec merged with this change's delta. */
+async function makeLookupRoot(): Promise<string> {
+  const root = await fs.mkdtemp(path.join(os.tmpdir(), 'osq-restart-remove-lookup-'));
+  const openspec = path.join(root, 'openspec');
+  const specDir = path.join(openspec, 'specs', 'spec-lint-and-approve');
+  await fs.mkdir(specDir, { recursive: true });
+  const living = await fs.readFile(
+    path.join(REPO_ROOT, 'openspec', 'specs', 'spec-lint-and-approve', 'spec.md'),
+    'utf8',
+  );
+  await fs.writeFile(path.join(specDir, 'spec.md'), dedupeScenarioNames(living), 'utf8');
+  const deltaDir = path.join(openspec, 'changes', CHANGE_SLUG, 'specs', 'spec-lint-and-approve');
+  await fs.mkdir(deltaDir, { recursive: true });
+  await fs.copyFile(
+    path.join(
+      REPO_ROOT,
+      'openspec',
+      'changes',
+      CHANGE_SLUG,
+      'specs',
+      'spec-lint-and-approve',
+      'spec.md',
+    ),
+    path.join(deltaDir, 'spec.md'),
+  );
+  return path.join(openspec, 'changes', CHANGE_SLUG);
+}
+
+before(async () => {
+  previousChange = process.env.OSQ_CHANGE;
+  lookupRoot = await makeLookupRoot();
+  process.env.OSQ_CHANGE = lookupRoot;
+});
+
+afterEach(async () => {
+  for (const dir of tmpDirs.splice(0)) {
+    await fs.rm(dir, { recursive: true, force: true });
+  }
+});
+
+after(async () => {
+  if (previousChange === undefined) Reflect.deleteProperty(process.env, 'OSQ_CHANGE');
+  else process.env.OSQ_CHANGE = previousChange;
+  if (lookupRoot !== null) await fs.rm(lookupRoot, { recursive: true, force: true });
+});
+
+let project: RecoveryProject;
+
+/** The scenario project's `approve`, the function under test through `run`. */
+function approve(): Promise<CommandResult> {
+  return project.approve();
+}
+
+scenario(
+  'spec-lint-and-approve',
+  'Worktree removal fails during a restart',
+  { covers: approve },
+  async ({ run, then }) => {
+    project = await createRecoveryProject(tmpDirs, {
+      tasks: [{ title: 'First task', scope: 'src/one.txt' }],
+      autoRetries: 0,
+    });
+    assertOk(await project.approve(), 'approve');
+
+    // The first spawn moves main onto the task's file, so the sync conflicts.
+    const adapter = new ScriptedAdapter(async (_options, call) => {
+      if (call === 1) {
+        await commitMain(project.repo, { 'src/one.txt': 'main\n' });
+        return 'task\n';
+      }
+      return 'main\ntask\n';
+    });
+    await project.watchOnce(adapter);
+    assert.equal(adapter.calls.length, 1);
+
+    const regressionPath = path.join(project.changeFolder, '.run', 'regressed', 'change.md');
+    assert.equal(await exists(regressionPath), true);
+    const regressionBefore = await fs.readFile(regressionPath);
+
+    await reviseTask(project.changeFolder, 1, { title: 'First task', scope: 'src/one.txt' });
+    await git(['worktree', 'lock', project.worktree], project.repo);
+
+    const failed = await run();
+    const regressionAfter = await fs.readFile(regressionPath);
+    const branchesAfterFailure = await git(['branch', '--list'], project.repo);
+
+    await git(['worktree', 'unlock', project.worktree], project.repo);
+    const approved = await run();
+
+    await then(
+      "it exits 1 with an error naming the worktree's path, `cannot remove a locked working tree`, `run git worktree prune` and `restart osq watch`, `.run/regressed/change.md` is byte for byte what it was, `osq/<folder>` still exists and no `osq/<folder>-restarted-1` does; after `git worktree unlock`, a second `osq approve <id>` exits 0 and prints `Restarted from main; kept the old branch as osq/<folder>-restarted-1`",
+      async () => {
+        assert.equal(failed.exitCode, 1, failed.stderr);
+        assert.ok(failed.stderr.includes(project.worktree), failed.stderr);
+        assert.ok(failed.stderr.includes('cannot remove a locked working tree'), failed.stderr);
+        assert.ok(failed.stderr.includes('run git worktree prune'), failed.stderr);
+        assert.ok(failed.stderr.includes('restart osq watch'), failed.stderr);
+        assert.deepEqual(regressionAfter, regressionBefore);
+        assert.ok(branchesAfterFailure.includes('osq/001-order-flow'), branchesAfterFailure);
+        assert.ok(
+          !branchesAfterFailure.includes('osq/001-order-flow-restarted-1'),
+          branchesAfterFailure,
+        );
+        assertOk(approved, 'second approve');
+        assert.match(
+          approved.stdout,
+          /Restarted from main; kept the old branch as osq\/001-order-flow-restarted-1/,
+        );
+      },
+    );
+  },
+);
