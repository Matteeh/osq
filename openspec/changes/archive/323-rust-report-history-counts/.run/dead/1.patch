@@ -0,0 +1,22 @@
+//! Collecting the reason of every `dead` event in a task stream.
+//!
+//! Implements: rust-storage/task-history
+
+use super::stream::Event;
+
+/// Collects one trimmed reason per `dead` event in file order.
+pub(super) fn collect(events: &[Event]) -> Vec<String> {
+    let mut reasons = Vec::new();
+    for event in events {
+        if event.kind() != Some("dead") {
+            continue;
+        }
+        let reason = event
+            .text("reason")
+            .map(str::trim)
+            .filter(|reason| !reason.is_empty())
+            .unwrap_or("unknown");
+        reasons.push(reason.to_owned());
+    }
+    reasons
+}
diff --git a/crates/kernel/storage/src/read/task_history/mod.rs b/crates/kernel/storage/src/read/task_history/mod.rs
new file mode 100644
index 000000000..b62528d84
--- /dev/null
+++ b/crates/kernel/storage/src/read/task_history/mod.rs
@@ -0,0 +1,151 @@
+//! Reading a task stream's history as TypeScript's report counts it.
+//!
+//! Implements: rust-storage/task-history
+
+use std::fs;
+use std::path::Path;
+
+mod attempts;
+mod costs;
+mod dead_reasons;
+mod pre_spawn;
+mod retries;
+mod scope;
+mod stream;
+mod verify_codes;
+
+/// The attempts, verify runs, retries, costs and scope regressions of one task stream.
+///
+/// Implements: rust-storage/task-history
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct TaskHistory {
+    /// The number of `started` events.
+    pub attempts: u64,
+    /// The `started` events that follow an earlier unexplained one.
+    pub unexplained: u64,
+    /// One reason per `dead` event, trimmed, or `unknown`.
+    pub dead_reasons: Vec<String>,
+    /// One exit code per post-spawn `verify_ran` event, or `None`.
+    pub verify_codes: Vec<Option<f64>>,
+    /// The pre-spawn verify runs and their declared starts.
+    pub pre_spawn: PreSpawnHistory,
+    /// Every finite event `cost`, in file order.
+    pub costs: Vec<f64>,
+    /// The attempts holding at least one finite cost.
+    pub cost_reported_attempts: u64,
+    /// The attempts opened by an automatic `retry` event.
+    pub automatic: RetryGroup,
+    /// The attempts opened by a manual `retry` event.
+    pub manual: RetryGroup,
+    /// The number of `stuck` events.
+    pub stuck: u64,
+    /// The scope regressions and recertifications.
+    pub scope: ScopeHistory,
+}
+
+/// The pre-spawn verify runs of one task stream.
+///
+/// Implements: rust-storage/task-history
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct PreSpawnHistory {
+    /// Every pre-spawn run.
+    pub runs: u64,
+    /// The runs whose data's `mismatch` is exactly true.
+    pub mismatches: u64,
+    /// The runs whose data's `missingPaths` is a non-empty array.
+    pub missing_path_runs: u64,
+    /// The runs whose declared start is `red`.
+    pub red: StartCount,
+    /// The runs whose declared start is `green`.
+    pub green: StartCount,
+    /// The runs whose declared start is `any`.
+    pub any: StartCount,
+}
+
+/// The runs and zero-exit passes of one declared pre-spawn start.
+///
+/// Implements: rust-storage/task-history
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct StartCount {
+    /// The runs declaring this start.
+    pub runs: u64,
+    /// The runs that exited with the number 0.
+    pub passed: u64,
+}
+
+/// One side of the retry split, automatic or manual.
+///
+/// Implements: rust-storage/task-history
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct RetryGroup {
+    /// The retry-opened attempts.
+    pub count: u64,
+    /// The attempts whose first `done` event was reached.
+    pub reached_done: u64,
+    /// The sum of the costs inside its attempts.
+    pub cost: f64,
+    /// The attempts holding at least one finite cost.
+    pub cost_reported_attempts: u64,
+}
+
+/// The scope-regression detections and recertifications of one task stream.
+///
+/// Implements: rust-storage/task-history
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct ScopeHistory {
+    /// The `scope_regression` detections.
+    pub detected: u64,
+    /// The detections whose exit code is the number 0.
+    pub passed_at_detection: u64,
+    /// The detections whose exit code is any other number.
+    pub failed_at_detection: u64,
+    /// The passed recertifications that were not automatic.
+    pub recertified_by_human: u64,
+    /// The passed recertifications whose `automatic` is exactly true.
+    pub recertified_automatically: u64,
+    /// The recertifications whose outcome is `requeued`.
+    pub requeued_for_agent: u64,
+}
+
+/// Reads `task`'s event stream in `folder` as TypeScript's report counts it.
+///
+/// A missing or unreadable event file gives an all-zero history.
+///
+/// Implements: rust-storage/task-history
+#[must_use]
+pub fn read_task_history(folder: &Path, task: &str) -> TaskHistory {
+    let path = folder
+        .join(".run")
+        .join("events")
+        .join(format!("{task}.jsonl"));
+    let content = fs::read_to_string(path).unwrap_or_default();
+    build_history(&content)
+}
+
+/// Folds one task stream's parsed lines into its history.
+fn build_history(content: &str) -> TaskHistory {
+    let events = stream::parse(content);
+    let counted_attempts = attempts::count(&events);
+    let costs = costs::collect(&events);
+    let retries = retries::count(&events);
+    TaskHistory {
+        attempts: counted_attempts.total,
+        unexplained: counted_attempts.unexplained,
+        dead_reasons: dead_reasons::collect(&events),
+        verify_codes: verify_codes::collect(&events),
+        pre_spawn: pre_spawn::count(&events),
+        costs: costs.values,
+        cost_reported_attempts: costs.reported_attempts,
+        automatic: retries.automatic,
+        manual: retries.manual,
+        stuck: retries.stuck,
+        scope: scope::count(&events),
+    }
+}
+
+/// Whether `content` holds a JSON object line whose `type` is `rejected`.
+pub(super) fn has_rejected_line(content: &str) -> bool {
+    stream::parse(content)
+        .iter()
+        .any(|event| event.kind() == Some("rejected"))
+}
diff --git a/crates/kernel/storage/src/read/task_history/pre_spawn.rs b/crates/kernel/storage/src/read/task_history/pre_spawn.rs
new file mode 100644
index 000000000..93eefbcfa
--- /dev/null
+++ b/crates/kernel/storage/src/read/task_history/pre_spawn.rs
@@ -0,0 +1,45 @@
+//! Counting a task stream's pre-spawn verify runs and their declared starts.
+//!
+//! Implements: rust-storage/task-history
+
+use super::stream::Event;
+use super::{PreSpawnHistory, StartCount};
+
+/// Counts the pre-spawn runs, mismatches, missing paths and declared starts.
+pub(super) fn count(events: &[Event]) -> PreSpawnHistory {
+    let mut history = PreSpawnHistory::default();
+    for event in events {
+        if event.kind() != Some("verify_ran") || event.text("phase") != Some("pre_spawn") {
+            continue;
+        }
+        history.runs += 1;
+        if event.is_true("mismatch") {
+            history.mismatches += 1;
+        }
+        if event.is_non_empty_array("missingPaths") {
+            history.missing_path_runs += 1;
+        }
+        let start = start(&mut history, event.text("expected"));
+        let Some(start) = start else {
+            continue;
+        };
+        start.runs += 1;
+        if event.number("exitCode") == Some(0.0) {
+            start.passed += 1;
+        }
+    }
+    history
+}
+
+/// The start counter a declared `expected` names, or `None` for any other value.
+fn start<'a>(
+    history: &'a mut PreSpawnHistory,
+    expected: Option<&str>,
+) -> Option<&'a mut StartCount> {
+    match expected {
+        Some("red") => Some(&mut history.red),
+        Some("green") => Some(&mut history.green),
+        Some("any") => Some(&mut history.any),
+        _ => None,
+    }
+}
diff --git a/crates/kernel/storage/src/read/task_history/retries.rs b/crates/kernel/storage/src/read/task_history/retries.rs
new file mode 100644
index 000000000..d575bcca0
--- /dev/null
+++ b/crates/kernel/storage/src/read/task_history/retries.rs
@@ -0,0 +1,98 @@
+//! Counting the automatic and manual retry attempts of a task stream.
+//!
+//! Implements: rust-storage/task-history
+
+use super::RetryGroup;
+use super::stream::Event;
+
+/// The two retry groups and the number of stuck events.
+pub(super) struct Retries {
+    /// The attempts opened by an automatic `retry` event.
+    pub(super) automatic: RetryGroup,
+    /// The attempts opened by a manual `retry` event.
+    pub(super) manual: RetryGroup,
+    /// The number of `stuck` events.
+    pub(super) stuck: u64,
+}
+
+/// One retry group under construction and its per-attempt flags.
+#[derive(Default)]
+struct Group {
+    /// The group's finished counts.
+    history: RetryGroup,
+    /// Whether the active attempt already counted a `done`.
+    done_this_attempt: bool,
+    /// Whether the active attempt already counted a cost.
+    reported_this_attempt: bool,
+}
+
+/// Which retry group is the active attempt.
+#[derive(Clone, Copy)]
+enum Side {
+    /// The automatic group.
+    Automatic,
+    /// The manual group.
+    Manual,
+}
+
+/// Counts both retry groups and the stuck events in file order.
+pub(super) fn count(events: &[Event]) -> Retries {
+    let mut automatic = Group::default();
+    let mut manual = Group::default();
+    let mut stuck = 0;
+    let mut active = None;
+    for event in events {
+        match event.kind() {
+            Some("retry") => {
+                let side = if event.is_true("automatic") {
+                    Side::Automatic
+                } else {
+                    Side::Manual
+                };
+                let group = group(&mut automatic, &mut manual, side);
+                group.history.count += 1;
+                group.done_this_attempt = false;
+                group.reported_this_attempt = false;
+                active = Some(side);
+                continue;
+            }
+            Some("stuck") => {
+                stuck += 1;
+                continue;
+            }
+            _ => {}
+        }
+        let Some(side) = active else {
+            continue;
+        };
+        let group = group(&mut automatic, &mut manual, side);
+        if event.kind() == Some("done") {
+            if !group.done_this_attempt {
+                group.done_this_attempt = true;
+                group.history.reached_done += 1;
+            }
+            continue;
+        }
+        let Some(cost) = event.number("cost") else {
+            continue;
+        };
+        group.history.cost += cost;
+        if !group.reported_this_attempt {
+            group.reported_this_attempt = true;
+            group.history.cost_reported_attempts += 1;
+        }
+    }
+    Retries {
+        automatic: automatic.history,
+        manual: manual.history,
+        stuck,
+    }
+}
+
+/// The group under construction for a retry attempt's side.
+fn group<'a>(automatic: &'a mut Group, manual: &'a mut Group, side: Side) -> &'a mut Group {
+    match side {
+        Side::Automatic => automatic,
+        Side::Manual => manual,
+    }
+}
diff --git a/crates/kernel/storage/src/read/task_history/scope.rs b/crates/kernel/storage/src/read/task_history/scope.rs
new file mode 100644
index 000000000..7f66fc6e5
--- /dev/null
+++ b/crates/kernel/storage/src/read/task_history/scope.rs
@@ -0,0 +1,50 @@
+//! Counting a task stream's scope-regression detections and recertifications.
+//!
+//! Implements: rust-storage/task-history
+
+use super::ScopeHistory;
+use super::stream::Event;
+
+/// Counts scope detections, their verify outcomes and the recertifications.
+pub(super) fn count(events: &[Event]) -> ScopeHistory {
+    let mut history = ScopeHistory::default();
+    for event in events {
+        match event.kind() {
+            Some("regressed") => detect(&mut history, event),
+            Some("recertification") => recertify(&mut history, event),
+            _ => {}
+        }
+    }
+    history
+}
+
+/// Counts one `regressed` event when its reason is `scope_regression`.
+fn detect(history: &mut ScopeHistory, event: &Event) {
+    if event.text("reason") != Some("scope_regression") {
+        return;
+    }
+    history.detected += 1;
+    let Some(code) = event.number("exitCode") else {
+        return;
+    };
+    if code == 0.0 {
+        history.passed_at_detection += 1;
+    } else {
+        history.failed_at_detection += 1;
+    }
+}
+
+/// Counts one `recertification` event by its outcome and automatic flag.
+fn recertify(history: &mut ScopeHistory, event: &Event) {
+    match event.text("outcome") {
+        Some("passed") => {
+            if event.is_true("automatic") {
+                history.recertified_automatically += 1;
+            } else {
+                history.recertified_by_human += 1;
+            }
+        }
+        Some("requeued") => history.requeued_for_agent += 1,
+        _ => {}
+    }
+}
diff --git a/crates/kernel/storage/src/read/task_history/stream.rs b/crates/kernel/storage/src/read/task_history/stream.rs
new file mode 100644
index 000000000..4af1c0f29
--- /dev/null
+++ b/crates/kernel/storage/src/read/task_history/stream.rs
@@ -0,0 +1,70 @@
+//! Parsing one task event stream into the events the history folds count.
+//!
+//! Implements: rust-storage/task-history
+
+use serde_json::{Map, Value};
+
+/// One parsed event line: its `type` and its object `data`.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub(super) struct Event {
+    /// The event's `type` member when it is a string.
+    kind: Option<String>,
+    /// The event's `data` member when it is a JSON object.
+    data: Option<Map<String, Value>>,
+}
+
+impl Event {
+    /// The event's `type` string, or `None` without one.
+    pub(super) fn kind(&self) -> Option<&str> {
+        self.kind.as_deref()
+    }
+
+    /// A data member's string value, or `None` without one.
+    pub(super) fn text(&self, key: &str) -> Option<&str> {
+        self.data.as_ref()?.get(key)?.as_str()
+    }
+
+    /// A data member's finite numeric value, or `None` without one.
+    pub(super) fn number(&self, key: &str) -> Option<f64> {
+        self.data
+            .as_ref()?
+            .get(key)?
+            .as_f64()
+            .filter(|number| number.is_finite())
+    }
+
+    /// Whether a data member is exactly the boolean `true`.
+    pub(super) fn is_true(&self, key: &str) -> bool {
+        self.data
+            .as_ref()
+            .and_then(|data| data.get(key))
+            .and_then(Value::as_bool)
+            == Some(true)
+    }
+
+    /// Whether a data member is a non-empty array.
+    pub(super) fn is_non_empty_array(&self, key: &str) -> bool {
+        matches!(
+            self.data.as_ref().and_then(|data| data.get(key)),
+            Some(Value::Array(items)) if !items.is_empty()
+        )
+    }
+}
+
+/// Parses a stream's lines in file order, skipping blank and non-object lines.
+pub(super) fn parse(content: &str) -> Vec<Event> {
+    content.split('\n').filter_map(parse_line).collect()
+}
+
+/// Parses one line into an event, or `None` when it is not a JSON object.
+fn parse_line(line: &str) -> Option<Event> {
+    let value = serde_json::from_str::<Value>(line.trim()).ok()?;
+    let object = value.as_object()?;
+    Some(Event {
+        kind: object
+            .get("type")
+            .and_then(Value::as_str)
+            .map(ToOwned::to_owned),
+        data: object.get("data").and_then(Value::as_object).cloned(),
+    })
+}
diff --git a/crates/kernel/storage/src/read/task_history/verify_codes.rs b/crates/kernel/storage/src/read/task_history/verify_codes.rs
new file mode 100644
index 000000000..7dea54eef
--- /dev/null
+++ b/crates/kernel/storage/src/read/task_history/verify_codes.rs
@@ -0,0 +1,17 @@
+//! Collecting the exit codes of a task stream's post-spawn verify runs.
+//!
+//! Implements: rust-storage/task-history
+
+use super::stream::Event;
+
+/// Collects the exit code of every non-pre-spawn `verify_ran` event.
+pub(super) fn collect(events: &[Event]) -> Vec<Option<f64>> {
+    let mut codes = Vec::new();
+    for event in events {
+        if event.kind() != Some("verify_ran") || event.text("phase") == Some("pre_spawn") {
+            continue;
+        }
+        codes.push(event.number("exitCode"));
+    }
+    codes
+}
diff --git a/crates/kernel/storage/tests/reading_rejection_planner.rs b/crates/kernel/storage/tests/reading_rejection_planner.rs
new file mode 100644
index 000000000..6113926f5
--- /dev/null
+++ b/crates/kernel/storage/tests/reading_rejection_planner.rs
@@ -0,0 +1,122 @@
+//! Proves the rejection planner reader matches TypeScript's report input.
+
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use osq_kernel_storage::read_rejection_planner;
+
+/// A change stream holding only an archived event.
+const ARCHIVED: &str = r#"{"type":"archived","timestamp":"2026-10-21T08:00:00.000Z","data":{}}"#;
+
+/// A change stream holding a rejected event.
+const REJECTED: &str =
+    r#"{"type":"rejected","timestamp":"2026-10-21T08:00:00.000Z","data":{"reason":"x"}}"#;
+
+/// A change stream holding a rejected event with no data.
+const REJECTED_BARE: &str = r#"{"type":"rejected"}"#;
+
+/// A brief whose planner is a plain name.
+const BRIEF: &str = "---\nplanner: claude-opus\n---\n";
+
+/// A brief whose planner is quoted with surrounding spaces.
+const BRIEF_SPACES: &str = "---\nplanner: \" claude-opus \"\n---\n";
+
+/// A brief whose planner is a number.
+const BRIEF_NUMBER: &str = "---\nplanner: 7\n---\n";
+
+/// A brief whose planner is quoted whitespace.
+const BRIEF_BLANK: &str = "---\nplanner: \"  \"\n---\n";
+
+/// One row of the "Rejection planners" table.
+struct Row {
+    /// The scratch folder's suffix and the assertion's label.
+    name: &'static str,
+    /// The `change.jsonl` lines, in order; empty for no event file.
+    lines: &'static [&'static str],
+    /// The brief to write, or no brief file.
+    brief: Option<&'static str>,
+    /// The planner the row expects.
+    expected: Option<&'static str>,
+}
+
+/// Every "Rejection planners" row, in the table's order.
+const ROWS: &[Row] = &[
+    Row {
+        name: "no-event-file",
+        lines: &[],
+        brief: Some(BRIEF),
+        expected: None,
+    },
+    Row {
+        name: "archived",
+        lines: &[ARCHIVED],
+        brief: Some(BRIEF),
+        expected: None,
+    },
+    Row {
+        name: "rejected",
+        lines: &[REJECTED],
+        brief: Some(BRIEF_SPACES),
+        expected: Some("claude-opus"),
+    },
+    Row {
+        name: "loose-lines",
+        lines: &["not json", REJECTED_BARE],
+        brief: None,
+        expected: Some("unknown"),
+    },
+    Row {
+        name: "numeric-planner",
+        lines: &[REJECTED_BARE],
+        brief: Some(BRIEF_NUMBER),
+        expected: Some("unknown"),
+    },
+    Row {
+        name: "blank-planner",
+        lines: &[REJECTED_BARE],
+        brief: Some(BRIEF_BLANK),
+        expected: Some("unknown"),
+    },
+];
+
+/// A fresh change folder under `CARGO_TARGET_TMPDIR`.
+fn scratch(name: &str) -> PathBuf {
+    let folder = Path::new(env!("CARGO_TARGET_TMPDIR"))
+        .join("reading_rejection_planner")
+        .join("rejection_planners")
+        .join(name);
+    let _ = fs::remove_dir_all(&folder);
+    fs::create_dir_all(&folder).expect("the scratch change folder is created");
+    folder
+}
+
+/// Writes the row's change stream and brief into `folder`.
+fn write_row(folder: &Path, row: &Row) {
+    if !row.lines.is_empty() {
+        let events = folder.join(".run").join("events");
+        fs::create_dir_all(&events).expect("the events folder is created");
+        let mut content = row.lines.join("\n");
+        content.push('\n');
+        fs::write(events.join("change.jsonl"), content).expect("the event file is written");
+    }
+    if let Some(brief) = row.brief {
+        fs::write(folder.join("brief.md"), brief).expect("the brief is written");
+    }
+}
+
+/// Proves every row of the "Rejection planners" table.
+///
+/// Covers: rust-storage/rejection-planners
+#[test]
+fn rejection_planners() {
+    for row in ROWS {
+        let folder = scratch(row.name);
+        write_row(&folder, row);
+        assert_eq!(
+            read_rejection_planner(&folder).as_deref(),
+            row.expected,
+            "{}",
+            row.name
+        );
+    }
+}
