@@ -0,0 +1,59 @@
+//! Proves that `run_cli` returns the exit code of a feature's output.
+
+use std::path::Path;
+
+use osq_cli::{CliResult, run_cli};
+use osq_core::{Command, Feature, FeatureError, Invocation, Output};
+
+/// A small feature that lists one command and returns a fixed output.
+struct OutputFeature {
+    /// The output its `run` returns.
+    output: Output,
+}
+
+impl Feature for OutputFeature {
+    /// The feature's name.
+    fn name(&self) -> &'static str {
+        "check"
+    }
+
+    /// The one command the feature lists.
+    fn commands(&self) -> Vec<Command> {
+        vec![Command::new("check", "Checks things", "")]
+    }
+
+    /// Returns the fixed output.
+    fn run(&self, _invocation: &Invocation) -> Result<Output, FeatureError> {
+        Ok(self.output.clone())
+    }
+}
+
+/// A command line's arguments as owned strings.
+fn args(values: &[&str]) -> Vec<String> {
+    values.iter().map(|value| (*value).to_owned()).collect()
+}
+
+/// Proves every row of "Output code through `run_cli`".
+///
+/// Covers: rust-cli/output-code-through-run-cli
+#[test]
+fn output_code_through_run_cli() {
+    let cases: [(Output, &str, i32); 3] = [
+        (Output::text("fine\n"), "fine\n", 0),
+        (Output::with_code("bad\n", 1), "bad\n", 1),
+        (Output::with_code("odd\n", 3), "odd\n", 3),
+    ];
+    for (output, stdout, code) in cases {
+        let registry: Vec<Box<dyn Feature>> = vec![Box::new(OutputFeature { output })];
+        let result = run_cli(&registry, Path::new("/project"), &args(&["check"]));
+        assert_eq!(
+            result,
+            CliResult {
+                stdout: stdout.to_owned(),
+                stderr: String::new(),
+                code,
+            },
+            "{stdout:?}"
+        );
+    }
+}
