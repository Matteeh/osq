diff --git a/crates/core/tests/feature_output_code.rs b/crates/core/tests/feature_output_code.rs
new file mode 100644
index 000000000..3a4775da5
--- /dev/null
+++ b/crates/core/tests/feature_output_code.rs
@@ -0,0 +1,19 @@
+//! Proves the exit code each `Output` constructor gives.
+
+use osq_core::Output;
+
+/// Proves every row of "Output exit codes".
+///
+/// Covers: rust-core/output-exit-codes
+#[test]
+fn output_exit_codes() {
+    let cases: [(Output, &str, i32); 3] = [
+        (Output::text("a b"), "a b", 0),
+        (Output::with_code("bad", 1), "bad", 1),
+        (Output::with_code("odd", 3), "odd", 3),
+    ];
+    for (output, text, code) in cases {
+        assert_eq!(output.text, text, "{text}");
+        assert_eq!(output.code, code, "{text}");
+    }
+}
