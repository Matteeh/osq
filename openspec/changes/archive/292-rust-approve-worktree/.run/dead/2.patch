+//! Proves worktree approvals against the goldens TypeScript printed.
+
+mod worktree_support;
+
+use std::fs;
+use std::path::Path;
+
+use osq_core::FeatureError;
+
+use worktree_support::{
+    approve, base, checkout, config_text, golden, record_lines, render, repository, write,
+};
+
+/// The seal `approve-repo`'s `001-alpha-twice` folder has.
+const ALPHA_SEAL: &str = "sha256:9aee5f041660ed83152089fd3d7880dd5fb428427af3e27e1aa995cd95b34ad1";
+
+/// The message block of a failed golden, with `<root>` put back.
+fn failed_message(name: &str, root: &Path) -> String {
+    let text = golden(name);
+    let start = "outcome: failed\n";
+    let body = text
+        .strip_prefix(start)
+        .expect("the golden is a failed outcome");
+    let end = body.find("\nbranches:").expect("the golden has branches");
+    body[..end].replace("<root>", &root.display().to_string())
+}
+
+/// The message of a `Failed` error without its `approve failed: ` prefix.
+fn message(error: &FeatureError) -> String {
+    let display = error.to_string();
+    display
+        .strip_prefix("approve failed: ")
+        .unwrap_or(&display)
+        .trim_end()
+        .to_owned()
+}
+
+/// Proves every row of "Worktree approvals equal TypeScript's".
+///
+/// Covers: rust-approve/worktree-approvals-equal-typescript-s
+#[test]
+fn worktree_approvals_equal_typescripts() {
+    let rows: Vec<(&str, &str, Vec<&str>, &str, &str)> = vec![
+        ("draft-001", "1", vec![], "001-alpha-twice", "draft-001.txt"),
+        (
+            "committed-002",
+            "2",
+            vec![],
+            "002-gamma",
+            "committed-002.txt",
+        ),
+        (
+            "prepare-passes-001",
+            "1",
+            vec!["prepare = \"echo prepared > prepared.txt\""],
+            "001-alpha-twice",
+            "prepare-passes-001.txt",
+        ),
+    ];
+    for (name, query, settings, folder, golden_name) in rows {
+        let root = repository(name, &settings, |_| {});
+        let repo = root.join("repo");
+        let base = base(&root);
+        let result = approve(&repo, &[query]);
+        assert!(result.is_ok(), "{name}: {result:?}");
+        let text = render(&root, &repo, &base, &result, folder);
+        assert_eq!(text, golden(golden_name), "{name}");
+    }
+}
+
+/// Proves that the worktree copy replaces the committed copy, so a file the
+/// checkout lacks does not survive.
+///
+/// Covers: rust-approve/worktree-approvals-equal-typescript-s
+#[test]
+fn worktree_copy_replaces_the_committed_copy() {
+    let root = repository("copy-replaces-committed", &[], |repo| {
+        write(repo, "openspec/changes/002-gamma/extra.txt", "extra\n");
+        worktree_support::git(repo, &["add", "-A"]);
+        worktree_support::git(repo, &["commit", "-q", "-m", "extra"]);
+        fs::remove_file(repo.join("openspec/changes/002-gamma/extra.txt"))
+            .expect("the checkout's extra file is removed");
+    });
+    let result = approve(&root.join("repo"), &["2"]).expect("the change approves");
+    assert!(
+        result.text.starts_with("Approved 002 (002-gamma)"),
+        "output"
+    );
+    let copy = root.join("worktrees/repo/002-gamma/openspec/changes/002-gamma");
+    assert!(!copy.join("extra.txt").exists(), "the stale file is gone");
+}
+
+/// Proves the rollback of a failed prepare, then a second approval.
+///
+/// Covers: rust-approve/prepare-failure-rolls-back
+#[test]
+fn prepare_failure_rolls_back() {
+    let settings = ["prepare = \"echo prepare said no; exit 3\""];
+    let root = repository("prepare-fails-001", &settings, |_| {});
+    let repo = root.join("repo");
+    let base = base(&root);
+    let worktree = root.join("worktrees/repo/001-alpha-twice");
+    let checkout = repo.join("openspec/changes/001-alpha-twice");
+
+    let error = approve(&repo, &["1"]).expect_err("the prepare command fails");
+    assert_eq!(
+        message(&error),
+        failed_message("prepare-fails-001.txt", &root)
+    );
+    assert!(!record_lines(&repo).is_empty(), "the rollback is recorded");
+    assert!(
+        worktree_support::git(&repo, &["branch", "--list", "osq/*"])
+            .trim()
+            .is_empty(),
+        "no osq branch remains"
+    );
+    assert!(
+        worktree_support::git(&repo, &["worktree", "list", "--porcelain"])
+            .lines()
+            .all(|line| !line.ends_with("001-alpha-twice")),
+        "no osq worktree remains"
+    );
+    assert!(!worktree.exists(), "the worktree folder is removed");
+    assert!(checkout.exists(), "the checkout copy stays");
+    let root_text = repo.display().to_string();
+    let add = format!("{{\"at\":\"<at>\",\"op\":\"worktree-add\",\"root\":\"{root_text}\"}}");
+    let prune = format!("{{\"at\":\"<at>\",\"op\":\"worktree-prune\",\"root\":\"{root_text}\"}}");
+    assert_eq!(
+        record_lines(&repo),
+        vec![add, prune],
+        "the rollback's record"
+    );
+
+    write(
+        &repo,
+        "osq.toml",
+        &config_text(
+            &root.join("worktrees"),
+            &["prepare = \"echo prepared > prepared.txt\""],
+        ),
+    );
+    let result = approve(&repo, &["1"]);
+    assert!(result.is_ok(), "the second approval succeeds: {result:?}");
+    let text = render(&root, &repo, &base, &result, "001-alpha-twice");
+    let golden = golden("prepare-passes-001.txt");
+    let (before, after) = golden
+        .split_once("record:\n")
+        .expect("the golden has a record section");
+    let record_add = "{\"at\":\"<at>\",\"op\":\"worktree-add\",\"root\":\"<root>/repo\"}";
+    let record_prune = "{\"at\":\"<at>\",\"op\":\"worktree-prune\",\"root\":\"<root>/repo\"}";
+    let expected = format!("{before}record:\n{record_add}\n{record_prune}\n{after}");
+    assert_eq!(text, expected, "the second approval matches the golden");
+}
+
+/// Proves that git off approves in the checkout.
+///
+/// Covers: rust-approve/git-off-approves-in-the-checkout
+#[test]
+fn git_off_approves_in_the_checkout() {
+    let config = "[vcs]\nenabled = true\nauthor = \"Osq Bot <bot@example.com>\"\n";
+    let root = checkout("git-off-approves-in-the-checkout", config);
+    let result = approve(&root, &["1"]).expect("the change approves in the checkout");
+    assert_eq!(
+        result.text,
+        format!("Approved 001 (001-alpha-twice)\n  Hash: {ALPHA_SEAL}\n"),
+        "the output"
+    );
+    let marker = root.join("openspec/changes/001-alpha-twice/.run/approved");
+    assert_eq!(
+        fs::read_to_string(marker).expect("the marker reads"),
+        format!("{ALPHA_SEAL}\n"),
+        "the checkout marker"
+    );
+}
+
+/// Proves that an approval removes the change's stacked copy.
+///
+/// Covers: rust-approve/stacked-copy-removed
+#[test]
+fn stacked_copy_removed() {
+    let root = repository("stacked-copy-removed", &[], |_| {});
+    let stacked = root.join("worktrees/repo/.stacked/001-alpha-twice");
+    write(&stacked, "note.txt", "note\n");
+    let result = approve(&root.join("repo"), &["1"]).expect("the change approves");
+    assert!(!stacked.exists(), "the stacked copy is removed");
+    assert!(!result.text.is_empty(), "the approval prints its lines");
+}
+
+/// Proves that an unreadable config refuses before any write.
+///
+/// Covers: rust-approve/unreadable-config
+#[test]
+fn unreadable_config() {
+    let root = checkout("unreadable-config", "[vcs]\nenabled = \"yes\"\n");
+    let error = approve(&root, &["1"]).expect_err("the config is refused");
+    assert_eq!(
+        error.to_string(),
+        "approve failed: vcs.enabled must be a boolean",
+        "the config error"
+    );
+    assert!(
+        !root.join("openspec/changes/001-alpha-twice/.run").exists(),
+        "no marker is written"
+    );
+}
