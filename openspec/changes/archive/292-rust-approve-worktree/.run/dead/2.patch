diff --git a/crates/features/approve/src/approve/worktree.rs b/crates/features/approve/src/approve/worktree.rs
new file mode 100644
index 000000000..e57272c89
--- /dev/null
+++ b/crates/features/approve/src/approve/worktree.rs
@@ -0,0 +1,222 @@
+//! Approving a change into its own branch and linked worktree.
+
+mod copy;
+mod markers;
+mod path;
+mod prepare;
+mod provenance;
+mod text;
+
+use std::fmt::Write as _;
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use osq_core::FeatureError;
+use osq_kernel_config::{Config, Timeouts};
+use osq_kernel_storage::ChangeEntry;
+use osq_kernel_vcs::{GitVcs, Vcs, append_tree_record, stacked_root};
+
+use crate::reject::time;
+
+/// The repository root when git is on, or none when it is off.
+///
+/// Implements: rust-approve/worktree-approval
+pub(crate) fn repository(root: &Path, config: &Config) -> Option<PathBuf> {
+    if !config.vcs.enabled {
+        return None;
+    }
+    let vcs = git_vcs(root, &config.timeouts);
+    let found = vcs.root().ok().flatten()?;
+    let root_real = fs::canonicalize(root).unwrap_or_else(|_| root.to_path_buf());
+    let found_real = fs::canonicalize(&found).unwrap_or(found);
+    (root_real == found_real).then_some(found_real)
+}
+
+/// Approves the change into a new branch and worktree under `repo`.
+///
+/// # Errors
+///
+/// Returns a `Failed` error with the command `approve` for every git or file
+/// failure, and for a prepare command that does not exit 0.
+///
+/// Implements: rust-approve/worktree-approval
+pub(crate) fn approve(
+    root: &Path,
+    repo: &Path,
+    config: &Config,
+    entry: &ChangeEntry,
+    seal: &str,
+) -> Result<String, FeatureError> {
+    let vcs = git_vcs(root, &config.timeouts);
+    let record_path = vcs
+        .tree_record_path()
+        .map_err(|error| failed(error.to_string()))?;
+    let branch = text::branch(&entry.folder);
+    let worktree = path::worktree(&config.vcs, repo, &entry.folder);
+    let worktree_text = worktree.to_string_lossy().into_owned();
+    let base = vcs.head().map_err(|error| failed(error.to_string()))?.sha;
+
+    start(&vcs, &worktree, &branch, base.as_deref())?;
+    record(record_path.as_deref(), "worktree-add", root);
+    prepare(
+        &vcs,
+        root,
+        config,
+        &worktree,
+        &branch,
+        record_path.as_deref(),
+    )?;
+    copy::replace(&entry.path, &copy::target(&worktree, &entry.folder))
+        .map_err(|error| failed(error.to_string()))?;
+    write_markers(&vcs, &worktree, &entry.folder, seal, base.as_deref())?;
+    commit(&worktree, config, &entry.folder)?;
+    record(record_path.as_deref(), "commit", &worktree);
+    remove_stacked(config, repo, &entry.folder)?;
+    remove_checkout(&vcs, &entry.path, &entry.folder)?;
+    Ok(text::approved(&entry.folder, seal, &worktree_text, &branch))
+}
+
+/// Creates the worktree's folders, its branch and the worktree itself.
+///
+/// Implements: rust-approve/worktree-approval
+fn start(
+    vcs: &GitVcs,
+    worktree: &Path,
+    branch: &str,
+    base: Option<&str>,
+) -> Result<(), FeatureError> {
+    let parent = worktree
+        .parent()
+        .ok_or_else(|| failed(format!("{} has no parent folder", worktree.display())))?;
+    fs::create_dir_all(parent).map_err(|error| failed(error.to_string()))?;
+    vcs.create_branch(branch, base.unwrap_or("HEAD"))
+        .map_err(|error| failed(error.to_string()))?;
+    vcs.worktree_add(&worktree.to_string_lossy(), branch)
+        .map_err(|error| failed(error.to_string()))
+}
+
+/// Runs `vcs.prepare` and rolls the branch and worktree back when it fails.
+///
+/// Implements: rust-approve/worktree-approval
+fn prepare(
+    vcs: &GitVcs,
+    root: &Path,
+    config: &Config,
+    worktree: &Path,
+    branch: &str,
+    record_path: Option<&Path>,
+) -> Result<(), FeatureError> {
+    let Some(command) = config.vcs.prepare.as_deref() else {
+        return Ok(());
+    };
+    let Some(output) = prepare::run(command, worktree, &config.timeouts) else {
+        return Ok(());
+    };
+    let mut message = text::prepare_failed(worktree, branch, &output);
+    if let Err(error) = rollback(vcs, root, worktree, branch, record_path) {
+        let _ = write!(message, "\nrollback failed: {error}");
+    }
+    Err(failed(message))
+}
+
+/// Removes the worktree, prunes it, records the prune and deletes the branch.
+///
+/// Implements: rust-approve/worktree-approval
+fn rollback(
+    vcs: &GitVcs,
+    root: &Path,
+    worktree: &Path,
+    branch: &str,
+    record_path: Option<&Path>,
+) -> Result<(), String> {
+    fs::remove_dir_all(worktree).map_err(|error| error.to_string())?;
+    vcs.worktree_prune().map_err(|error| error.to_string())?;
+    record(record_path, "worktree-prune", root);
+    vcs.delete_branch(branch).map_err(|error| error.to_string())
+}
+
+/// Writes the worktree copy's seal, base and approver markers.
+///
+/// Implements: rust-approve/worktree-approval
+fn write_markers(
+    vcs: &GitVcs,
+    worktree: &Path,
+    folder: &str,
+    seal: &str,
+    base: Option<&str>,
+) -> Result<(), FeatureError> {
+    let name = vcs
+        .config_value("user.name")
+        .map_err(|error| failed(error.to_string()))?;
+    let email = vcs
+        .config_value("user.email")
+        .map_err(|error| failed(error.to_string()))?;
+    let target = copy::target(worktree, folder);
+    markers::write(
+        &target,
+        seal,
+        base,
+        &provenance::approver(name.as_deref(), email.as_deref()),
+    )
+    .map_err(|error| failed(error.to_string()))
+}
+
+/// Commits the worktree copy with the change's approval message and author.
+///
+/// Implements: rust-approve/worktree-approval
+fn commit(worktree: &Path, config: &Config, folder: &str) -> Result<(), FeatureError> {
+    let vcs = git_vcs(worktree, &config.timeouts);
+    let relative = format!("openspec/changes/{folder}");
+    let author = config.vcs.author.clone().unwrap_or_default();
+    let message = text::commit_message(folder);
+    vcs.commit(&[relative.as_str()], &message, &author)
+        .map(|_| ())
+        .map_err(|error| failed(error.to_string()))
+}
+
+/// Removes the change's stacked approval folder when it exists.
+///
+/// Implements: rust-approve/worktree-approval
+fn remove_stacked(config: &Config, repo: &Path, folder: &str) -> Result<(), FeatureError> {
+    let home = std::env::var("HOME").unwrap_or_default();
+    let stacked = stacked_root(&config.vcs, repo, Path::new(&home)).join(folder);
+    if !stacked.exists() {
+        return Ok(());
+    }
+    fs::remove_dir_all(&stacked).map_err(|error| failed(error.to_string()))
+}
+
+/// Removes the checkout's change folder unless HEAD holds it.
+///
+/// Implements: rust-approve/worktree-approval
+fn remove_checkout(vcs: &GitVcs, folder: &Path, name: &str) -> Result<(), FeatureError> {
+    let relative = format!("openspec/changes/{name}");
+    let held = vcs
+        .path_exists("HEAD", &relative)
+        .map_err(|error| failed(error.to_string()))?;
+    if held {
+        return Ok(());
+    }
+    fs::remove_dir_all(folder).map_err(|error| failed(error.to_string()))
+}
+
+/// Appends one tree record line when the repository has a record path.
+///
+/// Implements: rust-approve/worktree-approval
+fn record(record_path: Option<&Path>, op: &str, root: &Path) {
+    if let Some(record_path) = record_path {
+        append_tree_record(record_path, &time::now(), op, root);
+    }
+}
+
+/// A `GitVcs` at `root` bounded by `timeouts`.
+///
+/// Implements: rust-approve/worktree-approval
+fn git_vcs(root: &Path, timeouts: &Timeouts) -> GitVcs {
+    GitVcs::new(root).with_timeouts(timeouts)
+}
+
+/// Builds the failed approve error for `message`.
+fn failed(message: impl Into<String>) -> FeatureError {
+    FeatureError::failed("approve", message)
+}
