+//! Running `vcs.prepare` once in a new worktree.
+
+use std::collections::BTreeMap;
+use std::path::Path;
+
+use osq_kernel_config::Timeouts;
+use osq_kernel_harnesses::{VerifyRequest, run_verify};
+
+/// Runs `command` in `cwd`, giving the output when it does not exit 0.
+///
+/// Implements: rust-approve/worktree-approval
+pub(crate) fn run(command: &str, cwd: &Path, timeouts: &Timeouts) -> Option<String> {
+    let request = VerifyRequest {
+        command: command.to_owned(),
+        cwd: cwd.to_path_buf(),
+        source_env: std::env::vars().collect::<BTreeMap<_, _>>(),
+        configured_env: Vec::new(),
+        agent_env: Vec::new(),
+        change: None,
+        diff: None,
+        extra_env: BTreeMap::new(),
+        timeout: Some(timeouts.verify_timeout),
+        kill_grace: timeouts.harness_kill_grace,
+    };
+    match run_verify(&request) {
+        Ok(outcome) if outcome.exit_code == 0 => None,
+        Ok(outcome) => Some(outcome.output),
+        Err(error) => Some(error.to_string()),
+    }
+}
