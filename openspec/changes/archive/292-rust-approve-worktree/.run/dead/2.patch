new file mode 100644
index 000000000..edcb1ce29
--- /dev/null
+++ b/crates/features/approve/src/approve/worktree/copy.rs
@@ -0,0 +1,52 @@
+//! Replacing a worktree's change folder with a copy of the checkout's.
+
+use std::fs;
+use std::io;
+use std::path::{Path, PathBuf};
+
+/// The change folder inside `worktree`.
+///
+/// Implements: rust-approve/worktree-approval
+pub(crate) fn target(worktree: &Path, folder: &str) -> PathBuf {
+    worktree.join("openspec").join("changes").join(folder)
+}
+
+/// Replaces `to` with a recursive copy of `from`, dot folders included.
+///
+/// Implements: rust-approve/worktree-approval
+pub(crate) fn replace(from: &Path, to: &Path) -> io::Result<()> {
+    remove(to)?;
+    fs::create_dir_all(to)?;
+    copy_tree(from, to)
+}
+
+/// Removes `path` when it exists, whether it is a file or a folder.
+///
+/// Implements: rust-approve/worktree-approval
+fn remove(path: &Path) -> io::Result<()> {
+    let Ok(metadata) = fs::symlink_metadata(path) else {
+        return Ok(());
+    };
+    if metadata.is_dir() {
+        fs::remove_dir_all(path)
+    } else {
+        fs::remove_file(path)
+    }
+}
+
+/// Copies every file of `from` into `to`, descending into its folders.
+///
+/// Implements: rust-approve/worktree-approval
+fn copy_tree(from: &Path, to: &Path) -> io::Result<()> {
+    for entry in fs::read_dir(from)? {
+        let entry = entry?;
+        let target = to.join(entry.file_name());
+        if entry.file_type()?.is_dir() {
+            fs::create_dir_all(&target)?;
+            copy_tree(&entry.path(), &target)?;
+        } else {
+            fs::copy(entry.path(), target)?;
+        }
+    }
+    Ok(())
+}
