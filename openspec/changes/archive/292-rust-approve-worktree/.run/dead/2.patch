-+//! Running `vcs.prepare` and rolling the worktree and branch back on failure.
-+
-+use std::collections::BTreeMap;
-+use std::path::Path;
-+
-+use osq_core::FeatureError;
-+use osq_kernel_config::Config;
-+use osq_kernel_harnesses::{VerifyRequest, run_verify};
-+use osq_kernel_vcs::{GitVcs, Vcs};
-+
-+use super::record::Records;
-+use super::{copy, failed, text};
-+
-+/// Runs the configured prepare command in the new worktree.
-+///
-+/// # Errors
-+///
-+/// Returns the prepare failure after the rollback, or with the rollback's own
-+/// failure when a rollback step fails.
-+///
-+/// Implements: rust-approve/worktree-approval
-+pub(super) fn run(
-+    repo: &Path,
-+    root_vcs: &GitVcs,
-+    records: &Records,
-+    worktree: &Path,
-+    branch: &str,
-+    config: &Config,
-+) -> Result<(), FeatureError> {
-+    let Some(command) = config.vcs.prepare.clone() else {
-+        return Ok(());
-+    };
-+    let request = VerifyRequest {
-+        command,
-+        cwd: worktree.to_path_buf(),
-+        source_env: std::env::vars().collect::<BTreeMap<_, _>>(),
-+        configured_env: Vec::new(),
-+        agent_env: Vec::new(),
-+        change: None,
-+        diff: None,
-+        extra_env: BTreeMap::new(),
-+        timeout: Some(config.timeouts.verify_timeout),
-+        kill_grace: config.timeouts.harness_kill_grace,
-+    };
-+    let failure = match run_verify(&request) {
-+        Ok(outcome) if outcome.exit_code == 0 => return Ok(()),
-+        Ok(outcome) => outcome.output,
-+        Err(error) => error.to_string(),
-+    };
-+    let mut message = text::prepare_failed(worktree, branch, &failure);
-+    if let Err(error) = rollback(repo, root_vcs, records, worktree, branch) {
-+        message = text::rollback_failed(&message, &error);
-+    }
-+    Err(failed(message))
-+}
-+
-+/// Removes the worktree, prunes it, records the prune and deletes the branch.
-+///
-+/// # Errors
-+///
-+/// Returns the display of the first step that fails, stopping there.
-+///
-+/// Implements: rust-approve/worktree-approval
-+fn rollback(
-+    repo: &Path,
-+    root_vcs: &GitVcs,
-+    records: &Records,
-+    worktree: &Path,
-+    branch: &str,
-+) -> Result<(), String> {
-+    copy::remove(worktree).map_err(|error| error.to_string())?;
-+    root_vcs
-+        .worktree_prune()
-+        .map_err(|error| error.to_string())?;
-+    records.append("worktree-prune", repo);
-+    root_vcs
-+        .delete_branch(branch)
-+        .map_err(|error| error.to_string())
-+}
