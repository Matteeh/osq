+//! Where a change's worktree and branch live.
+
+use std::path::{Path, PathBuf};
+
+use osq_kernel_config::VcsConfig;
+use osq_kernel_vcs::stacked_root;
+
+/// The worktree of `folder`: the parent of the stacked approvals root, joined
+/// with `folder`.
+///
+/// Implements: rust-approve/worktree-approval
+pub(crate) fn worktree(vcs: &VcsConfig, repo: &Path, folder: &str) -> PathBuf {
+    let home = std::env::var("HOME").unwrap_or_default();
+    let stacked = stacked_root(vcs, repo, Path::new(&home));
+    stacked
+        .parent()
+        .unwrap_or_else(|| Path::new(""))
+        .join(folder)
+}
