+}
+
+/// The message of the worktree's approval commit.
+///
+/// Implements: rust-approve/worktree-approval
+pub(crate) fn commit_message(folder: &str) -> String {
+    format!("osq: {} approved", id(folder))
+}
+
+/// The refusal for a prepare command that did not pass.
+///
+/// Implements: rust-approve/worktree-approval
