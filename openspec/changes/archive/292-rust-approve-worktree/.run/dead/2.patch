-+//! Helpers that build the git repositories the worktree scenarios name.
-+//!
-+//! Each test binary compiles this module on its own, so some helpers are
-+//! unused in a given binary even though another test uses them.
-+#![allow(dead_code)]
-+
-+use std::fs;
-+use std::path::{Path, PathBuf};
-+use std::process::Command;
-+
-+use osq_core::{Feature, FeatureError, Invocation, Output};
-+use osq_feature_approve::ApproveFeature;
-+use serde_json::Value;
-+
-+/// The date every repository commit carries.
-+const DATE: &str = "2026-10-22T10:00:00Z";
-+
-+/// The author every repository commit carries.
-+const AUTHOR_NAME: &str = "Osq Tester";
-+/// The email every repository commit carries.
-+const AUTHOR_EMAIL: &str = "tester@example.com";
-+
-+/// The `.run/` files a golden leaves out.
-+const LEFT_OUT: [&str; 2] = [".run/manifest.json", ".run/plan.jsonl"];
-+
-+/// The output line prefixes a golden keeps.
-+const KEPT_LINES: [&str; 5] = [
-+    "Approved ",
-+    "  Hash: ",
-+    "  Kept rejected branch: ",
-+    "  Worktree: ",
-+    "  Branch: ",
-+];
-+
-+/// The prefix of the display of an approve `Failed` error.
-+const FAILED_PREFIX: &str = "approve failed: ";
-+
-+/// A fresh, canonical scratch root under `CARGO_TARGET_TMPDIR`.
-+pub fn scratch(name: &str) -> PathBuf {
-+    let root = Path::new(env!("CARGO_TARGET_TMPDIR"))
-+        .join("approve_worktree")
-+        .join(name);
-+    let _ = fs::remove_dir_all(&root);
-+    fs::create_dir_all(&root).expect("the scratch root is created");
-+    fs::canonicalize(&root).expect("the scratch root canonicalizes")
-+}
-+
-+/// Copies the crate's `approve-repo` fixture to `to`, dot files included.
-+pub fn copy_fixture(to: &Path) {
-+    let from = Path::new(env!("CARGO_MANIFEST_DIR"))
-+        .join("tests")
-+        .join("fixtures")
-+        .join("approve-repo");
-+    copy_tree(&from, to);
-+}
-+
-+/// Copies a folder tree, dot folders and files included.
-+fn copy_tree(from: &Path, to: &Path) {
-+    fs::create_dir_all(to).expect("the target folder is created");
-+    for entry in fs::read_dir(from).expect("the source folder is read") {
-+        let entry = entry.expect("the folder entry is read");
-+        let target = to.join(entry.file_name());
-+        if entry.file_type().expect("the entry type is read").is_dir() {
-+            copy_tree(&entry.path(), &target);
-+        } else {
-+            fs::copy(entry.path(), target).expect("the file is copied");
-+        }
-+    }
-+}
