+//! Writing the worktree copy's `.run` provenance markers.
+
+use std::fs;
+use std::io;
+use std::path::Path;
+
+use super::provenance;
+
+/// Writes `.run/approved`, `.run/base` and `.run/approver` into `folder`.
+///
+/// Implements: rust-approve/worktree-approval
+pub(crate) fn write(
+    folder: &Path,
+    seal: &str,
+    base: Option<&str>,
+    approver: &str,
+) -> io::Result<()> {
+    let run = folder.join(".run");
+    fs::create_dir_all(&run)?;
+    fs::write(run.join("approved"), format!("{seal}\n"))?;
+    fs::write(run.join("base"), provenance::base(base))?;
+    fs::write(run.join("approver"), approver)
+}
