diff --git a/crates/features/approve/tests/worktree_support/mod.rs b/crates/features/approve/tests/worktree_support/mod.rs
new file mode 100644
index 000000000..cc5e0a04f
--- /dev/null
+++ b/crates/features/approve/tests/worktree_support/mod.rs
@@ -0,0 +1,359 @@
+//! Helpers for the worktree approval tests: scratch git repositories and the
+//! text `print-goldens.mjs` writes.
+//!
+//! Each test binary compiles this module on its own, so some helpers are
+//! unused in a given binary even though another test uses them.
+#![allow(dead_code)]
+
+use std::fs;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use osq_core::{Feature, FeatureError, Invocation, Output};
+use osq_feature_approve::ApproveFeature;
+use serde_json::Value;
+
+/// The author and committer date every setup command carries.
+const DATE: &str = "2026-10-22T10:00:00Z";
+
+/// The git identity the setup commands carry.
+const NAME: &str = "Osq Tester";
+/// The git email the setup commands carry.
+const EMAIL: &str = "tester@example.com";
+
+/// The lines a golden keeps from a successful output.
+const KEPT_LINES: [&str; 5] = [
+    "Approved ",
+    "  Hash: ",
+    "  Kept rejected branch: ",
+    "  Worktree: ",
+    "  Branch: ",
+];
+
+/// The `.run` files the goldens leave out.
+const LEFT_OUT: [&str; 2] = [".run/manifest.json", ".run/plan.jsonl"];
+
+/// The path of one fixture folder under the crate's `tests/fixtures`.
+pub fn fixture(name: &str) -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("tests")
+        .join("fixtures")
+        .join(name)
+}
+
+/// A fresh canonical scratch root under `CARGO_TARGET_TMPDIR`, named after the
+/// test row.
+pub fn scratch(name: &str) -> PathBuf {
+    let root = Path::new(env!("CARGO_TARGET_TMPDIR"))
+        .join("approve_worktree")
+        .join(name);
+    let _ = fs::remove_dir_all(&root);
+    fs::create_dir_all(&root).expect("the scratch root is created");
+    fs::canonicalize(&root).expect("the scratch root canonicalizes")
+}
+
+/// Runs git in `cwd` with the golden printer's identity and dates.
+pub fn git(cwd: &Path, args: &[&str]) -> String {
+    let output = Command::new("git")
+        .args(args)
+        .current_dir(cwd)
+        .env("GIT_AUTHOR_DATE", DATE)
+        .env("GIT_COMMITTER_DATE", DATE)
+        .env("GIT_AUTHOR_NAME", NAME)
+        .env("GIT_AUTHOR_EMAIL", EMAIL)
+        .env("GIT_COMMITTER_NAME", NAME)
+        .env("GIT_COMMITTER_EMAIL", EMAIL)
+        .output()
+        .expect("git starts");
+    assert!(
+        output.status.success(),
+        "git {args:?}: {}{}",
+        String::from_utf8_lossy(&output.stdout),
+        String::from_utf8_lossy(&output.stderr)
+    );
+    String::from_utf8(output.stdout).expect("git writes UTF-8")
+}
+
+/// Copies a folder tree, dot folders and files included.
+fn copy_tree(from: &Path, to: &Path) {
+    fs::create_dir_all(to).expect("the target folder is created");
+    for entry in fs::read_dir(from).expect("the source folder is read") {
+        let entry = entry.expect("the folder entry is read");
+        let target = to.join(entry.file_name());
+        if entry.file_type().expect("the entry type is read").is_dir() {
+            copy_tree(&entry.path(), &target);
+        } else {
+            fs::copy(entry.path(), target).expect("the file is copied");
+        }
+    }
+}
+
+/// Writes one file under `root`, creating its folders.
+pub fn write(root: &Path, relative: &str, text: &str) {
+    let path = root.join(relative);
+    if let Some(parent) = path.parent() {
+        fs::create_dir_all(parent).expect("the file's folders are created");
+    }
+    fs::write(path, text).expect("the file is written");
+}
+
+/// The `[vcs]` table the repository's `osq.toml` holds, with extra lines.
+pub fn config_text(worktrees: &Path, settings: &[&str]) -> String {
+    let mut text = format!(
+        "[vcs]\nenabled = true\nauthor = \"Osq Bot <bot@example.com>\"\nworktreeRoot = \"{}\"\n",
+        worktrees.display()
+    );
+    for setting in settings {
+        text.push_str(setting);
+        text.push('\n');
+    }
+    text
+}
+
+/// Builds `<root>/repo` as `buildRepo` in `print-goldens.mjs.txt` does, runs
+/// the row's setup, and gives `<root>`.
+pub fn repository(name: &str, settings: &[&str], setup: impl FnOnce(&Path)) -> PathBuf {
+    let root = scratch(name);
+    let repo = root.join("repo");
+    copy_tree(&fixture("approve-repo"), &repo);
+    git(&repo, &["init", "-q", "-b", "main"]);
+    git(&repo, &["config", "user.name", NAME]);
+    git(&repo, &["config", "user.email", EMAIL]);
+    git(&repo, &["config", "commit.gpgsign", "false"]);
+    let exclude = repo.join(".git").join("info").join("exclude");
+    let mut excluded = fs::read_to_string(&exclude).expect("the exclude file reads");
+    excluded.push_str("osq.toml\n");
+    fs::write(exclude, excluded).expect("the exclude file is written");
+    write(
+        &repo,
+        "osq.toml",
+        &config_text(&root.join("worktrees"), settings),
+    );
+    git(
+        &repo,
+        &["add", "-A", "--", ".", ":!openspec/changes/001-alpha-twice"],
+    );
+    git(&repo, &["commit", "-q", "-m", "fixture"]);
+    setup(&repo);
+    root
+}
+
+/// A fresh scratch copy of the fixture with an `osq.toml` holding `text`.
+pub fn checkout(name: &str, text: &str) -> PathBuf {
+    let root = scratch(name);
+    copy_tree(&fixture("approve-repo"), &root);
+    write(&root, "osq.toml", text);
+    root
+}
+
+/// Runs `approve` with literal `arguments` at `root`.
+pub fn approve(root: &Path, arguments: &[&str]) -> Result<Output, FeatureError> {
+    let args = arguments.iter().map(|arg| (*arg).to_owned()).collect();
+    ApproveFeature.run(&Invocation::new(root, "approve", args))
+}
+
+/// The base commit of the repository at `root`.
+pub fn base(root: &Path) -> String {
+    git(&root.join("repo"), &["rev-parse", "HEAD"])
+        .trim()
+        .to_owned()
+}
+
+/// The git lines of one command, blank lines left out.
+fn lines(cwd: &Path, args: &[&str]) -> Vec<String> {
+    git(cwd, args)
+        .lines()
+        .map(str::trim)
+        .filter(|line| !line.is_empty())
+        .map(str::to_owned)
+        .collect()
+}
+
+/// The `osq/` branches, sorted.
+fn branches(repo: &Path) -> Vec<String> {
+    let mut branches = lines(
+        repo,
+        &["branch", "--list", "osq/*", "--format=%(refname:short)"],
+    );
+    branches.sort();
+    branches
+}
+
+/// The osq worktrees, as `<path> <branch>`, sorted.
+fn worktrees(repo: &Path) -> Vec<String> {
+    let mut found = Vec::new();
+    let mut current: Option<(String, String)> = None;
+    for line in git(repo, &["worktree", "list", "--porcelain"]).split('\n') {
+        if let Some(path) = line.strip_prefix("worktree ") {
+            current = Some((path.to_owned(), String::new()));
+        }
+        if let Some(branch) = line.strip_prefix("branch refs/heads/") {
+            if let Some(worktree) = current.as_mut() {
+                branch.clone_into(&mut worktree.1);
+            }
+        }
+        if line.is_empty() {
+            if let Some((path, branch)) = current.take() {
+                if branch.starts_with("osq/") {
+                    found.push(format!("{path} {branch}"));
+                }
+            }
+        }
+    }
+    found.sort();
+    found
+}
+
+/// The approval commit's lines, or `none`.
+fn commit_lines(repo: &Path, branch: &str, base: &str) -> Vec<String> {
+    if git(repo, &["branch", "--list", branch]).trim().is_empty() {
+        return vec!["none".to_owned()];
+    }
+    let tip = git(repo, &["rev-parse", branch]).trim().to_owned();
+    if tip == base {
+        return vec!["none".to_owned()];
+    }
+    let log = git(repo, &["log", "-1", "--format=%s%n%an <%ae>%n%P", &tip]);
+    let mut fields = log.lines();
+    let subject = fields.next().unwrap_or_default().to_owned();
+    let author = fields.next().unwrap_or_default().to_owned();
+    let parents = fields.next().unwrap_or_default().to_owned();
+    let mut changed: Vec<String> = git(
+        repo,
+        &["diff-tree", "--no-commit-id", "--name-status", "-r", &tip],
+    )
+    .lines()
+    .map(str::trim)
+    .filter(|line| !line.is_empty())
+    .filter(|line| {
+        line.split('\t')
+            .nth(1)
+            .is_none_or(|path| !LEFT_OUT.iter().any(|left| path.ends_with(left)))
+    })
+    .map(str::to_owned)
+    .collect();
+    changed.sort();
+    let mut lines = vec![subject, author, format!("parent {parents}")];
+    lines.extend(changed);
+    lines
+}
+
+/// The tree record's lines, with every `at` written as `<at>`.
+pub fn record_lines(repo: &Path) -> Vec<String> {
+    let path = repo.join(".git").join("osq-trees.jsonl");
+    let Ok(text) = fs::read_to_string(path) else {
+        return Vec::new();
+    };
+    text.lines()
+        .filter(|line| !line.is_empty())
+        .map(|line| {
+            let mut value: Value = serde_json::from_str(line).expect("the record line is JSON");
+            value["at"] = Value::String("<at>".to_owned());
+            serde_json::to_string(&value).expect("the record line serializes")
+        })
+        .collect()
+}
+
+/// Every file under `folder`, as relative paths.
+fn files(folder: &Path, base: &Path, found: &mut Vec<String>) {
+    for entry in fs::read_dir(folder).expect("the folder is read") {
+        let entry = entry.expect("the folder entry is read");
+        let path = entry.path();
+        if path.is_dir() {
+            files(&path, base, found);
+        } else {
+            found.push(
+                path.strip_prefix(base)
+                    .expect("the file sits under the base")
+                    .to_string_lossy()
+                    .replace('\\', "/"),
+            );
+        }
+    }
+}
+
+/// The worktree copy's `.run` files, as the golden printer writes them.
+fn run_tree(folder: &Path) -> String {
+    let run = folder.join(".run");
+    if !run.exists() {
+        return String::new();
+    }
+    let mut paths = Vec::new();
+    files(&run, folder, &mut paths);
+    paths.sort();
+    let mut lines = Vec::new();
+    for relative in paths {
+        if LEFT_OUT.contains(&relative.as_str()) {
+            continue;
+        }
+        let text = fs::read_to_string(folder.join(&relative)).expect("the run file is text");
+        lines.push(format!("--- {relative}"));
+        lines.push(text.strip_suffix('\n').unwrap_or(&text).to_owned());
+    }
+    lines.join("\n")
+}
+
+/// The outcome block: the kept output lines or the error's message.
+fn outcome(result: &Result<Output, FeatureError>) -> String {
+    match result {
+        Ok(output) => {
+            let kept: Vec<&str> = output
+                .text
+                .split('\n')
+                .filter(|line| KEPT_LINES.iter().any(|prefix| line.starts_with(prefix)))
+                .collect();
+            format!("outcome: output\n{}", kept.join("\n"))
+        }
+        Err(error) => {
+            let display = error.to_string();
+            let message = display.strip_prefix("approve failed: ").unwrap_or(&display);
+            format!("outcome: failed\n{}", message.trim_end())
+        }
+    }
+}
+
+/// A run's golden text, with `<root>` and `<base>` put back.
+pub fn render(
+    root: &Path,
+    repo: &Path,
+    base: &str,
+    result: &Result<Output, FeatureError>,
+    folder: &str,
+) -> String {
+    let branch = format!("osq/{folder}");
+    let worktree_folder = root
+        .join("worktrees")
+        .join("repo")
+        .join(folder)
+        .join("openspec")
+        .join("changes")
+        .join(folder);
+    let mut lines = vec![outcome(result), "branches:".to_owned()];
+    lines.extend(branches(repo));
+    lines.push("worktrees:".to_owned());
+    lines.extend(worktrees(repo));
+    lines.push(format!(
+        "checkout copy: {}",
+        if repo.join("openspec/changes").join(folder).exists() {
+            "present"
+        } else {
+            "absent"
+        }
+    ));
+    lines.push("commit:".to_owned());
+    lines.extend(commit_lines(repo, &branch, base));
+    lines.push("record:".to_owned());
+    lines.extend(record_lines(repo));
+    lines.push("tree:".to_owned());
+    lines.push(run_tree(&worktree_folder));
+    let mut text = lines.join("\n");
+    text = text
+        .replace(&root.display().to_string(), "<root>")
+        .replace(base, "<base>");
+    format!("{}\n", text.trim_end_matches('\n'))
+}
+
+/// Reads one golden's text.
+pub fn golden(name: &str) -> String {
+    fs::read_to_string(fixture("approve-worktree").join(name)).expect("the golden reads")
+}
