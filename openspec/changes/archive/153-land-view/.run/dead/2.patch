+interface WorktreeRepo {
+  /** The checkout, which is the project root. */
+  readonly root: string;
+  readonly wt: string;
+  readonly config: ReturnType<typeof defineConfig>;
+}
+
+/**
+ * A temporary repository whose archived `042-pricing` change lives in an
+ * `osq/042-pricing` worktree, with a code commit there and two commits on the
+ * default branch after the branch was cut.
+ */
+async function makeArchivedInWorktree(): Promise<WorktreeRepo> {
+  const root = await tempDir('osq-land-worktree-');
+  const repo = path.join(root, 'repo');
+  const wtRoot = path.join(root, 'wt');
+  await fs.mkdir(repo, { recursive: true });
+  await fs.mkdir(wtRoot, { recursive: true });
+  await initRepo(repo);
+  await writeAt(repo, 'README.md', 'init\n');
+  await git(['add', '-A'], repo);
+  await git(['commit', '-qm', 'init'], repo);
+
+  const branch = worktreeBranch('042-pricing');
+  await git(['branch', branch], repo);
+  const wt = path.join(wtRoot, '042-pricing');
+  await git(['worktree', 'add', wt, branch], repo);
+
+  const folderPath = await createArchivedChange(wt, '042-pricing');
+  await writeEvents(folderPath, 'change.jsonl', [
+    event('verify_ran', 'change', '2026-10-01T11:00:00.000Z', {
+      command: 'node verify.cjs',
+      exitCode: 0,
+      duration: 3,
+    }),
+    archivedEvent(),
+  ]);
+  await writeAt(wt, 'src/one.txt', 'one\n');
+  await git(['add', '-A'], wt);
+  await git(['commit', '-qm', 'archive 042'], wt);
+
+  await writeAt(repo, 'src/two.txt', 'two\n');
+  await git(['add', '-A'], repo);
+  await git(['commit', '-qm', 'second'], repo);
+  await writeAt(repo, 'src/three.txt', 'three\n');
+  await git(['add', '-A'], repo);
+  await git(['commit', '-qm', 'third'], repo);
+
+  const config = defineConfig({
+    vcs: { enabled: true, author: 'osq <osq@example.invalid>', worktreeRoot: wtRoot },
+  });
+  return { root: repo, wt, config };
+}
