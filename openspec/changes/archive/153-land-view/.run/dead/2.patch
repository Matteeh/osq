@@ -0,0 +1,225 @@
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import type { OsqConfig } from '../foundation/config.js';
+import { readArchivedChange } from '../report/archive-record.js';
+import { readChangeDisclosures } from '../report/result-sections.js';
+import { readCheckCommand } from '../spec/human-steps.js';
+import { parseFrontmatter, parseSpecMdFromFolder } from '../spec/parser.js';
+import { readDependencyState } from '../spec/stack-dependencies.js';
+import { selectVcs } from '../vcs/select.js';
+import type { Vcs } from '../vcs/vcs.js';
+import { worktreeBranch } from '../vcs/worktree.js';
+import { listChanges } from './change-locations.js';
+import { readLastSync } from './last-sync.js';
+import type { LandDisclosure, LandGate, LandView } from './show-land-types.js';
+import type { SpecDetails, TimelineEvent } from './show-types.js';
+
+/** A finite number, else null. */
+function finiteOrNull(value: unknown): number | null {
+  return typeof value === 'number' && Number.isFinite(value) ? value : null;
+}
+/** A trimmed non-empty string, else null. */
+function stringOrNull(value: unknown): string | null {
+  return typeof value === 'string' && value.trim() ? value.trim() : null;
+}
+/** Whether `timestamp` falls at or before `cutoff`; malformed values compare literally. */
+function atOrBefore(timestamp: string, cutoff: string): boolean {
+  const a = Date.parse(timestamp);
+  const b = Date.parse(cutoff);
+  if (Number.isFinite(a) && Number.isFinite(b)) return a <= b;
+  return timestamp <= cutoff;
+}
+/** The timeline up to and including the last `archived` event, or null. */
+function archiveWindow(timeline: readonly TimelineEvent[]): TimelineEvent[] | null {
+  let cutoff: string | null = null;
+  for (const event of timeline) if (event.type === 'archived') cutoff = event.timestamp;
+  if (cutoff === null) return null;
+  const boundary = cutoff;
+  return timeline.filter((event) => atOrBefore(event.timestamp, boundary));
+}
+/** The last event matching `match`, scanning backwards. */
+function lastEvent(
+  events: readonly TimelineEvent[],
+  match: (event: TimelineEvent) => boolean,
+): TimelineEvent | undefined {
+  for (let index = events.length - 1; index >= 0; index -= 1) {
+    const event = events[index];
+    if (event && match(event)) return event;
+  }
+  return undefined;
+}
+/** One verify/check gate from a `verify_ran` event. */
+function verifyGate(
+  kind: 'task' | 'verify' | 'check',
+  task: string | null,
+  event: TimelineEvent,
+): LandGate {
+  const data = event.data ?? {};
+  const exitCode = finiteOrNull(data.exitCode);
+  return {
+    kind,
+    task,
+    command: typeof data.command === 'string' ? data.command : '',
+    outcome: exitCode === 0 ? 'passed' : 'failed',
+    exitCode,
+    durationSeconds: finiteOrNull(data.duration),
+    timestamp: event.timestamp,
+    findings: null,
+  };
+}
+/** The validator gate from a `validator_ran` event. */
+function validatorGate(event: TimelineEvent): LandGate {
+  const data = event.data ?? {};
+  const harness = typeof data.harness === 'string' ? data.harness : '';
+  const model = typeof data.model === 'string' ? data.model : '';
+  return {
+    kind: 'validator',
+    task: null,
+    command: `${harness}/${model}`,
+    outcome: typeof data.outcome === 'string' ? data.outcome : 'failed',
+    exitCode: finiteOrNull(data.exitCode),
+    durationSeconds: finiteOrNull(data.duration),
+    timestamp: event.timestamp,
+    findings: Array.isArray(data.findings) ? data.findings.length : 0,
+  };
+}
+/** The archived change's gate runs at or before its last `archived` event. */
+function buildGates(
+  timeline: readonly TimelineEvent[],
+  proposalVerify: string,
+  check: string | null,
+): LandGate[] {
+  const window = archiveWindow(timeline);
+  if (window === null) return [];
+
+  const gates: LandGate[] = [];
+  const taskNumbers = [
+    ...new Set(window.filter((event) => /^\d+$/.test(event.taskNumber)).map((e) => e.taskNumber)),
+  ].sort((a, b) => Number(a) - Number(b));
+  for (const task of taskNumbers) {
+    const event = lastEvent(
+      window,
+      (entry) =>
+        entry.taskNumber === task && entry.type === 'verify_ran' && entry.data?.phase === undefined,
+    );
+    if (event) gates.push(verifyGate('task', task, event));
+  }
+
+  const changeEvent = (command: string | null): TimelineEvent | undefined =>
+    command === null
+      ? undefined
+      : lastEvent(
+          window,
+          (entry) =>
+            entry.taskNumber === 'change' &&
+            entry.type === 'verify_ran' &&
+            entry.data?.command === command,
+        );
+  const verifyEvent = changeEvent(proposalVerify || null);
+  if (verifyEvent) gates.push(verifyGate('verify', null, verifyEvent));
+  const checkEvent = changeEvent(check);
+  if (checkEvent) gates.push(verifyGate('check', null, checkEvent));
+
+  const validator = lastEvent(window, (entry) => entry.type === 'validator_ran');
+  if (validator) gates.push(validatorGate(validator));
+  return gates;
+}
+type ProposalCommands = { readonly verify: string; readonly check: string | null };
+/** The proposal's change-level `verify` and optional `check` commands. */
+async function readProposalCommands(folderPath: string): Promise<ProposalCommands> {
+  const spec = await parseSpecMdFromFolder(folderPath).catch(() => null);
+  if (!spec) return { verify: '', check: null };
+  const { data } = parseFrontmatter(spec.raw);
+  return { verify: spec.verify, check: readCheckCommand(data) };
+}
+/** The `capabilities` of `readArchivedChange` for this change. */
+async function readCapabilities(
+  projectRoot: string,
+  config: OsqConfig,
+  folderPath: string,
+): Promise<LandView['capabilities']> {
+  const target = path.resolve(folderPath);
+  const archived = (await listChanges(projectRoot, config, ['archived'])).find(
+    (change) => path.resolve(change.folderPath) === target,
+  );
+  if (!archived) return [];
+  return (await readArchivedChange(archived)).capabilities;
+}
+/** Each task with a real `## Deviated` or `## Outside scope` section. */
+async function readDisclosures(folderPath: string): Promise<LandDisclosure[]> {
+  const tasks = await readChangeDisclosures(folderPath);
+  return tasks
+    .filter((task) => task.deviated !== null || task.outsideScope !== null)
+    .map((task) => ({
+      task: task.task,
+      deviated: task.deviated,
+      outsideScope: task.outsideScope,
+    }));
+}
+/** The change-level `.run/regressed/change.md` halt, or null without one. */
+async function readHalt(folderPath: string): Promise<LandView['halt']> {
+  const raw = await fs
+    .readFile(path.join(folderPath, '.run', 'regressed', 'change.md'), 'utf8')
+    .catch(() => null);
+  if (raw === null) return null;
+  const { data, body } = parseFrontmatter(raw);
+  return { reason: stringOrNull(data.reason), message: body.trim() };
+}
+/** The four git-derived fields; all null when git is off. */
+type GitLandState = Pick<LandView, 'landed' | 'defaultBranch' | 'mainCommits' | 'diff'>;
+/** Default-branch movement and the branch's diff, read only when git is on. */
+async function readGitLandState(
+  projectRoot: string,
+  config: OsqConfig,
+  vcs: Vcs,
+  folderName: string,
+): Promise<GitLandState> {
+  if (vcs.kind !== 'git' || config.vcs?.enabled !== true) {
+    return { landed: null, defaultBranch: null, mainCommits: null, diff: null };
+  }
+  const defaultBranch = await vcs.defaultBranch();
+  const landed =
+    (await readDependencyState(projectRoot, config, vcs, folderName)).state === 'landed';
+  const branch = worktreeBranch(folderName);
+  const branchExists = (await vcs.listBranches('osq/')).includes(branch);
+  if (landed || !branchExists) return { landed, defaultBranch, mainCommits: null, diff: null };
+  const mainCommits = await vcs.countCommits(branch, defaultBranch);
+  const diff = await vcs.diffStat(defaultBranch, branch, [config.paths.openspecRoot]);
+  return { landed, defaultBranch, mainCommits, diff };
+}
+/**
+ * Everything a human needs before landing an archived change, read from files
+ * and refs osq already writes. Returns null for every other change and writes
+ * nothing.
+ */
+export async function readLandView(
+  projectRoot: string,
+  details: SpecDetails,
+  config: OsqConfig,
+): Promise<LandView | null> {
+  if (details.location !== 'archived') return null;
+
+  const [commands, capabilities, disclosures, halt, sync, vcs] = await Promise.all([
+    readProposalCommands(details.folderPath),
+    readCapabilities(projectRoot, config, details.folderPath),
+    readDisclosures(details.folderPath),
+    readHalt(details.folderPath),
+    readLastSync(details.folderPath),
+    selectVcs(projectRoot, config),
+  ]);
+  const git = await readGitLandState(projectRoot, config, vcs, details.folderName);
+
+  return {
+    folderName: details.folderName,
+    landed: git.landed,
+    defaultBranch: git.defaultBranch,
+    mainCommits: git.mainCommits,
+    gates: buildGates(details.timeline, commands.verify, commands.check),
+    diff: git.diff,
+    capabilities,
+    disclosures,
+    halt,
+    lastSync: sync.lastSync ?? null,
+    lastSyncStop: sync.lastSyncStop ?? null,
+  };
+}
