+  await git(['config', 'user.name', 'osq'], dir);
+  await git(['config', 'user.email', 'osq@example.invalid'], dir);
+}
+
+async function writeAt(root: string, relative: string, content: string): Promise<void> {
+  const target = path.join(root, relative);
+  await fs.mkdir(path.dirname(target), { recursive: true });
+  await fs.writeFile(target, content, 'utf8');
+}
+
+function proposalMd(title: string): string {
+  return [
+    '---',
+    `title: ${title}`,
+    'verify: node verify.cjs',
+    'depends_on: []',
+    'features:',
+    '  reads: []',
+    '---',
+    '## Goal',
+    `${title} goal.`,
+    '',
+  ].join('\n');
+}
+
+function taskMd(): string {
+  return [
+    '---',
+    'title: A task',
+    'verify: node verify.cjs',
+    'scope: []',
+    'entry: []',
+    'skills: []',
+    '---',
+    '## Acceptance',
+    '- [ ] does work',
+    '',
+  ].join('\n');
