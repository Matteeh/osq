+
+async function writeEvents(folderPath: string, file: string, events: unknown[]): Promise<void> {
+  const body = `${events.map((event) => JSON.stringify(event)).join('\n')}\n`;
+  await fs
+    .writeFile(path.join(folderPath, '.run', 'events', file), body, 'utf8')
+    .catch(async (error: NodeJS.ErrnoException) => {
+      if (error.code !== 'ENOENT') throw error;
+      await fs.mkdir(path.join(folderPath, '.run', 'events'), { recursive: true });
+      await fs.writeFile(path.join(folderPath, '.run', 'events', file), body, 'utf8');
+    });
+}
