@@ -0,0 +1,93 @@
+import type { SpecDetails } from './show-types.js';
+
+/** The land view and gate shape the model carries on the detail. */
+type LandView = NonNullable<SpecDetails['land']>;
+type LandGate = LandView['gates'][number];
+
+/** `task <n>`, `verify`, `check` or `validator`. */
+function gateName(gate: LandGate): string {
+  switch (gate.kind) {
+    case 'task':
+      return `task ${gate.task ?? ''}`.trim();
+    case 'verify':
+      return 'verify';
+    case 'check':
+      return 'check';
+    default:
+      return 'validator';
+  }
+}
+
+/** One `Gates at archive:` entry. */
+function gateLine(gate: LandGate): string {
+  const seconds = Math.round(gate.durationSeconds ?? 0);
+  let outcome = gate.outcome;
+  if (gate.outcome === 'failed' && gate.exitCode !== null) outcome += ` exit ${gate.exitCode}`;
+  if (gate.kind === 'validator') outcome += `, ${gate.findings ?? 0} findings`;
+  return `    ${gateName(gate)}: ${outcome} in ${seconds}s (${gate.command})`;
+}
+
+/** The `Land:` headline for the change's landed state. */
+function headline(land: LandView): string {
+  if (land.landed === null) return 'Land: git is off';
+  if (land.landed) return 'Land: landed';
+
+  const branch = `osq/${land.folderName}`;
+  const commits = land.mainCommits;
+  if (commits === null) return `Land: not landed; branch ${branch} not found`;
+  const defaultBranch = land.defaultBranch ?? 'the default branch';
+  if (commits === 0) return `Land: not landed; ${defaultBranch} has not moved since archive`;
+  const noun = commits === 1 ? 'commit' : 'commits';
+  return `Land: not landed; ${defaultBranch} has ${commits} new ${noun} since archive, so osq land will sync and verify again`;
+}
+
+/** The first line of a multi-line message, or an empty string. */
+function firstLine(message: string): string {
+  return message.split('\n')[0] ?? '';
+}
+
+/** Every narrative part below the headline. */
+function detailLines(land: LandView): string[] {
+  const lines: string[] = [];
+  if (land.gates.length === 0) {
+    lines.push('  Gates at archive: none recorded');
+  } else {
+    lines.push('  Gates at archive:');
+    for (const gate of land.gates) lines.push(gateLine(gate));
+  }
+  if (land.diff) {
+    lines.push(`  Diff: ${land.diff.files} files, +${land.diff.added} -${land.diff.removed}`);
+  }
+  if (land.capabilities.length > 0) {
+    lines.push('  Spec changes:');
+    for (const capability of land.capabilities) {
+      lines.push(
+        `    ${capability.name}: ${capability.added.length} added, ${capability.modified.length} modified, ${capability.removed.length} removed, ${capability.renamed.length} renamed`,
+      );
+    }
+  }
+  const disclosures: string[] = [];
+  for (const disclosure of land.disclosures) {
+    if (disclosure.deviated !== null) disclosures.push(`task ${disclosure.task} deviated`);
+    if (disclosure.outsideScope !== null) disclosures.push(`task ${disclosure.task} outside scope`);
+  }
+  if (disclosures.length > 0) lines.push(`  Disclosures: ${disclosures.join(', ')}`);
+  if (land.halt)
+    lines.push(`  Halted: ${land.halt.reason ?? 'unknown'}: ${firstLine(land.halt.message)}`);
+  if (land.lastSyncStop) {
+    lines.push(
+      `  Sync stopped: ${land.lastSyncStop.reason}: ${firstLine(land.lastSyncStop.message)}`,
+    );
+  }
+  return lines;
+}
+
+/**
+ * The `Land:` section lines for a change whose detail carries a land view, or
+ * no lines when it does not. It reads no files.
+ */
+export function landLines(details: SpecDetails): string[] {
+  const land = details.land;
+  if (!land) return [];
+  return ['', headline(land), ...detailLines(land)];
+}
