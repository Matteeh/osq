diff --git a/crates/features/doctor/src/doctor/changes.rs b/crates/features/doctor/src/doctor/changes.rs
new file mode 100644
index 00000000..0557bac6
--- /dev/null
+++ b/crates/features/doctor/src/doctor/changes.rs
@@ -0,0 +1,187 @@
+//! Building doctor's locks, archives and done-marker lines from the storage
+//! read model.
+//!
+//! Only this module reads files, `/proc`, `HOME` and git; the line builders stay
+//! pure (ADR 023). Doctor reads the change folders through storage alone
+//! (ADR 022) and writes no file (ADR 025).
+
+use std::fs;
+use std::path::{Component, Path, PathBuf};
+
+use osq_kernel_config::{Config, VcsConfig};
+use osq_kernel_storage::{
+    ChangeEntry, Location, TreeCandidate, change_trees, list_changes, list_tree_changes,
+    read_change_files,
+};
+use osq_kernel_vcs::{GitVcs, Vcs, Worktree, stacked_root};
+
+/// The paths each check found, in listing order.
+#[derive(Default)]
+struct Found {
+    /// Every orphaned lock path, relative to the root.
+    orphaned: Vec<String>,
+    /// Every invalid archive folder path, relative to the root.
+    invalid_archives: Vec<String>,
+    /// Every unverified done marker path, relative to the root.
+    unverified: Vec<String>,
+}
+
+/// Builds the locks, archives and done-marker lines for one root and config.
+///
+/// Implements: rust-doctor/doctor-change-checks
+pub(super) fn change_lines(root: &Path, config: &Config) -> Vec<String> {
+    let root = real_path(root);
+    let mut found = Found::default();
+    for entry in change_folders(&root, config) {
+        collect_entry(&root, &entry, &mut found);
+    }
+    vec![
+        locks_line(&found.orphaned),
+        archives_line(&found.invalid_archives),
+        done_markers_line(&found.unverified),
+    ]
+}
+
+/// Appends one change folder's problems to the checks' findings.
+///
+/// Implements: rust-doctor/doctor-change-checks
+fn collect_entry(root: &Path, entry: &ChangeEntry, found: &mut Found) {
+    let files = read_change_files(&entry.path);
+    match entry.location {
+        Location::Active => {
+            for lock in files.locks {
+                if !is_live(lock.pid) {
+                    found.orphaned.push(relative(root, &lock.path));
+                }
+            }
+            for marker in files.done_markers {
+                if !marker.verified {
+                    found.unverified.push(relative(root, &marker.path));
+                }
+            }
+        }
+        Location::Archived => {
+            if !files.has_proposal || !files.has_tasks {
+                found.invalid_archives.push(relative(root, &entry.path));
+            }
+        }
+        Location::Rejected => {}
+    }
+}
+
+/// Lists the root's change folders, across worktrees when git allows it.
+///
+/// Implements: rust-doctor/doctor-change-checks
+fn change_folders(root: &Path, config: &Config) -> Vec<ChangeEntry> {
+    if config.vcs.enabled {
+        if let Some(entries) = worktree_changes(root, config) {
+            return entries;
+        }
+    }
+    list_changes(root)
+}
+
+/// Lists the changes across the worktrees and stacked folders, or none when a
+/// git call fails.
+///
+/// Implements: rust-doctor/doctor-change-checks
+fn worktree_changes(root: &Path, config: &Config) -> Option<Vec<ChangeEntry>> {
+    let vcs = GitVcs::new(root).with_timeouts(&config.timeouts);
+    let repo_root = vcs.root().ok().flatten()?;
+    let worktrees = vcs.worktree_list().ok()?;
+    let candidates: Vec<TreeCandidate> = worktrees.into_iter().map(candidate).collect();
+    let stacked = stacked_folders(&config.vcs, &repo_root);
+    let trees = change_trees(root, &candidates, &stacked);
+    Some(list_tree_changes(&trees))
+}
+
+/// Turns one git worktree into a tree candidate.
+fn candidate(worktree: Worktree) -> TreeCandidate {
+    TreeCandidate {
+        path: PathBuf::from(worktree.path),
+        branch: worktree.branch,
+    }
+}
+
+/// The folders directly under the stacked approvals root, or none when the
+/// home is unset or the root cannot be read.
+fn stacked_folders(config: &VcsConfig, repo_root: &Path) -> Vec<PathBuf> {
+    let Some(home) = std::env::var_os("HOME") else {
+        return Vec::new();
+    };
+    let stacked = stacked_root(config, repo_root, Path::new(&home));
+    let Ok(entries) = fs::read_dir(&stacked) else {
+        return Vec::new();
+    };
+    entries
+        .flatten()
+        .filter(|entry| entry.file_type().is_ok_and(|kind| kind.is_dir()))
+        .map(|entry| entry.path())
+        .collect()
+}
+
+/// Resolves a path's symlinks, falling back to the path as given.
+fn real_path(path: &Path) -> PathBuf {
+    fs::canonicalize(path).unwrap_or_else(|_| path.to_path_buf())
+}
+
+/// Whether a lock pid names a live process, as `/proc` knows it.
+fn is_live(pid: Option<i64>) -> bool {
+    let Some(pid) = pid.and_then(|pid| u32::try_from(pid).ok()) else {
+        return false;
+    };
+    pid >= 1 && Path::new("/proc").join(pid.to_string()).exists()
+}
+
+/// Writes a path relative to the root as Node's `path.relative` does.
+#[must_use]
+fn relative(root: &Path, path: &Path) -> String {
+    let root_parts: Vec<Component> = root.components().collect();
+    let path_parts: Vec<Component> = path.components().collect();
+    let shared = root_parts
+        .iter()
+        .zip(&path_parts)
+        .take_while(|(left, right)| left == right)
+        .count();
+    let mut parts: Vec<String> = Vec::new();
+    for _ in shared..root_parts.len() {
+        parts.push("..".to_owned());
+    }
+    for component in &path_parts[shared..] {
+        parts.push(component.as_os_str().to_string_lossy().into_owned());
+    }
+    parts.join("/")
+}
+
+/// Formats the locks line from the orphaned lock paths.
+#[must_use]
+fn locks_line(orphaned: &[String]) -> String {
+    if orphaned.is_empty() {
+        return "[ok] locks: no orphaned locks".to_owned();
+    }
+    format!("[fail] locks: orphaned lock(s): {}", orphaned.join(", "))
+}
+
+/// Formats the archives line from the invalid archive folder paths.
+#[must_use]
+fn archives_line(invalid: &[String]) -> String {
+    if invalid.is_empty() {
+        return "[ok] archives: all archives valid".to_owned();
+    }
+    format!(
+        "[fail] archives: invalid archive(s): {}",
+        invalid.join(", ")
+    )
+}
+
+/// Formats the done-markers line from the unverified marker paths.
+#[must_use]
+fn done_markers_line(unverified: &[String]) -> String {
+    if unverified.is_empty() {
+        return "[ok] done-markers: all done markers verified".to_owned();
+    }
+    format!(
+        "[fail] done-markers: unverified done marker placed by hand: {}",
+        unverified.join(", ")
+    )
+}
