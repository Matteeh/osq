index 00000000..2b9104c1
--- /dev/null
+++ b/crates/features/doctor/tests/doctor_changes.rs
@@ -0,0 +1,298 @@
+//! Proves doctor's locks, archives and done-marker lines and its worktree scan.
+
+use std::fs;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use osq_core::{Feature, FeatureError, Invocation, Output};
+use osq_feature_doctor::DoctorFeature;
+
+/// The lock text a dead pid writes.
+const DEAD: &str = r#"{"pid":2147483647,"startedAt":1}"#;
+
+/// The result one change-lines row expects.
+enum Expected {
+    /// Success with exactly this text.
+    Output(&'static str),
+    /// Failure with exactly this message.
+    Failed(&'static str),
+}
+
+/// One row of "Doctor change lines".
+struct Row {
+    /// The row's name and its scratch folder.
+    name: &'static str,
+    /// Files written in the root, folder-relative, with their exact text.
+    files: Vec<(&'static str, String)>,
+    /// What doctor returns for the row.
+    expected: Expected,
+}
+
+/// Creates a fresh scratch root under `CARGO_TARGET_TMPDIR`.
+fn scratch(name: &str) -> PathBuf {
+    let root = Path::new(env!("CARGO_TARGET_TMPDIR")).join(name);
+    let _ = fs::remove_dir_all(&root);
+    fs::create_dir_all(&root).expect("the scratch root is created");
+    root
+}
+
+/// Writes one file, creating its parent folders.
+fn write(path: &Path, text: &str) {
+    fs::create_dir_all(path.parent().expect("a file has a parent")).expect("the parent exists");
+    fs::write(path, text).expect("the file is written");
+}
+
+/// Runs doctor with no arguments on a root.
+fn run(root: &Path) -> Result<Output, FeatureError> {
+    DoctorFeature.run(&Invocation::new(root, "doctor", Vec::new()))
+}
+
+/// Checks that doctor succeeded with exactly `expected`.
+fn check_output(result: Result<Output, FeatureError>, expected: &str, name: &str) {
+    let output = result.unwrap_or_else(|error| panic!("row {name} failed: {error}"));
+    assert_eq!(expected, output.text, "row {name}");
+}
+
+/// Checks that doctor failed for `doctor` with exactly `expected`.
+fn check_failed(result: Result<Output, FeatureError>, expected: &str, name: &str) {
+    let error = result.expect_err("the row's check fails");
+    match &error {
+        FeatureError::Failed {
+            command, message, ..
+        } => {
+            assert_eq!("doctor", command, "row {name}");
+            assert_eq!(expected, *message, "row {name}");
+        }
+        other => panic!("row {name} returned {other:?}"),
+    }
+}
+
+/// The healthy result every passing row ends with.
+const HEALTHY_OUTPUT: &str = concat!(
+    "[ok] config: loaded (harness: agy)\n",
+    "[ok] locks: no orphaned locks\n",
+    "[ok] archives: all archives valid\n",
+    "[ok] done-markers: all done markers verified\n",
+);
+
+/// Builds one row from its parts.
+fn row(name: &'static str, files: Vec<(&'static str, String)>, expected: Expected) -> Row {
+    Row {
+        name,
+        files,
+        expected,
+    }
+}
+
+/// The rows of "Doctor change lines", in table order.
+fn rows() -> Vec<Row> {
+    let live = format!(r#"{{"pid":{},"startedAt":1}}"#, std::process::id());
+    vec![
+        row("none", Vec::new(), Expected::Output(HEALTHY_OUTPUT)),
+        row(
+            "live-lock",
+            vec![("openspec/changes/001-a/.run/running/1.pid", live)],
+            Expected::Output(HEALTHY_OUTPUT),
+        ),
+        orphaned_locks_row(),
+        invalid_archives_row(),
+        done_markers_row(),
+    ]
+}
+
+/// The row with orphaned locks, an invalid-looking archive lock and a rejected
+/// lock that neither check reads.
+fn orphaned_locks_row() -> Row {
+    row(
+        "orphaned-locks",
+        vec![
+            ("openspec/changes/001-a/.run/running/1.pid", DEAD.to_owned()),
+            (
+                "openspec/changes/001-a/.run/locks/2.pid",
+                "not json".to_owned(),
+            ),
+            (
+                "openspec/changes/001-a/.run/running/notes.txt",
+                DEAD.to_owned(),
+            ),
+            (
+                "openspec/changes/002-b/.run/running/1.pid",
+                r#"{"pid":0}"#.to_owned(),
+            ),
+            ("openspec/changes/archive/003-c/proposal.md", "x".to_owned()),
+            ("openspec/changes/archive/003-c/tasks.md", "x".to_owned()),
+            (
+                "openspec/changes/archive/003-c/.run/running/1.pid",
+                DEAD.to_owned(),
+            ),
+            (
+                "openspec/changes/rejected/004-d/.run/running/1.pid",
+                DEAD.to_owned(),
+            ),
+        ],
+        Expected::Failed(concat!(
+            "[ok] config: loaded (harness: agy)\n",
+            "[fail] locks: orphaned lock(s): ",
+            "openspec/changes/001-a/.run/running/1.pid, ",
+            "openspec/changes/001-a/.run/locks/2.pid, ",
+            "openspec/changes/002-b/.run/running/1.pid\n",
+            "[ok] archives: all archives valid\n",
+            "[ok] done-markers: all done markers verified",
+        )),
+    )
+}
+
+/// The row with one archive missing tasks and one missing a proposal.
+fn invalid_archives_row() -> Row {
+    row(
+        "invalid-archives",
+        vec![
+            ("openspec/changes/archive/002-b/proposal.md", "x".to_owned()),
+            ("openspec/changes/archive/003-c/spec.md", "x".to_owned()),
+            ("openspec/changes/archive/003-c/tasks/1.md", "x".to_owned()),
+            ("openspec/changes/archive/004-d/tasks.md", "x".to_owned()),
+            ("openspec/changes/rejected/005-e/x.md", "x".to_owned()),
+        ],
+        Expected::Failed(concat!(
+            "[ok] config: loaded (harness: agy)\n",
+            "[ok] locks: no orphaned locks\n",
+            "[fail] archives: invalid archive(s): ",
+            "openspec/changes/archive/002-b, openspec/changes/archive/004-d\n",
+            "[ok] done-markers: all done markers verified",
+        )),
+    )
+}
+
+/// The row with one hand-placed active done marker and one archived marker.
+fn done_markers_row() -> Row {
+    row(
+        "done-markers",
+        vec![
+            (
+                "openspec/changes/001-a/.run/done/1.md",
+                "---\nscope_hash: abc\n---\n".to_owned(),
+            ),
+            ("openspec/changes/001-a/.run/done/2.md", "done\n".to_owned()),
+            (
+                "openspec/changes/001-a/.run/done/3.md",
+                "---\nmanual: true\nreason: checked by hand\n---\n".to_owned(),
+            ),
+            ("openspec/changes/archive/002-b/proposal.md", "x".to_owned()),
+            ("openspec/changes/archive/002-b/tasks.md", "x".to_owned()),
+            (
+                "openspec/changes/archive/002-b/.run/done/1.md",
+                "done\n".to_owned(),
+            ),
+        ],
+        Expected::Failed(concat!(
+            "[ok] config: loaded (harness: agy)\n",
+            "[ok] locks: no orphaned locks\n",
+            "[ok] archives: all archives valid\n",
+            "[fail] done-markers: unverified done marker placed by hand: ",
+            "openspec/changes/001-a/.run/done/2.md",
+        )),
+    )
+}
+
+/// Proves every row of "Doctor change lines", each in its own scratch root.
+///
+/// Covers: rust-doctor/doctor-change-lines
+#[test]
+fn doctor_change_lines() {
+    for row in rows() {
+        let root = scratch(&format!("doctor_change_{}", row.name));
+        for (relative, text) in &row.files {
+            write(&root.join(relative), text);
+        }
+        let result = run(&root);
+        match row.expected {
+            Expected::Output(expected) => check_output(result, expected, row.name),
+            Expected::Failed(expected) => check_failed(result, expected, row.name),
+        }
+    }
+}
+
+/// Runs git in a folder, failing with both streams when it refuses.
+fn git(repo: &Path, args: &[&str]) {
+    let output = Command::new("git")
+        .args(args)
+        .current_dir(repo)
+        .output()
+        .expect("git starts");
+    assert!(
+        output.status.success(),
+        "git {args:?}: {}{}",
+        String::from_utf8_lossy(&output.stdout),
+        String::from_utf8_lossy(&output.stderr)
+    );
+}
+
+/// Builds the scratch repository with one commit on `main`.
+fn repository(base: &Path, worktrees: &Path) -> PathBuf {
+    let repo = base.join("repo");
+    fs::create_dir_all(&repo).expect("the repository exists");
+    git(&repo, &["init", "-b", "main"]);
+    git(&repo, &["config", "user.name", "osq"]);
+    git(&repo, &["config", "user.email", "osq@example.com"]);
+    write(
+        &repo.join("osq.toml"),
+        &format!(
+            "[vcs]\nenabled = true\nauthor = \"osq <osq@example.com>\"\nworktreeRoot = \"{}\"\n",
+            worktrees.display()
+        ),
+    );
+    git(&repo, &["add", "-A"]);
+    git(&repo, &["commit", "-m", "main commit"]);
+    repo
+}
+
+/// Adds one worktree on `osq/<folder>` and returns its path.
+fn worktree(repo: &Path, worktrees: &Path, folder: &str) -> PathBuf {
+    let path = worktrees.join(folder);
+    fs::create_dir_all(worktrees).expect("the worktree root exists");
+    let branch = format!("osq/{folder}");
+    git(
+        repo,
+        &[
+            "worktree",
+            "add",
+            "-b",
+            &branch,
+            path.to_str().expect("the path is text"),
+            "main",
+        ],
+    );
+    path
+}
+
+/// Proves doctor finds a lock left in a worktree and names it from the root.
+///
+/// Covers: rust-doctor/doctor-reads-every-worktree
+#[test]
+fn doctor_reads_every_worktree() {
+    let base = scratch("doctor_reads_every_worktree");
+    let worktrees = base.join("worktrees");
+    let repo = repository(&base, &worktrees);
+    let tree = worktree(&repo, &worktrees, "002-run");
+    let change = tree.join("openspec/changes/002-run");
+    write(&change.join(".run/approved"), "sha256:0001\n");
+    write(&change.join(".run/running/1.pid"), DEAD);
+    write(
+        &repo.join("openspec/changes/002-run/.run/running/1.pid"),
+        DEAD,
+    );
+    git(&tree, &["add", "-A"]);
+    git(&tree, &["commit", "-m", "002-run"]);
+    let result = run(&repo);
+    check_failed(
+        result,
+        concat!(
+            "[ok] config: loaded (harness: agy)\n",
+            "[fail] locks: orphaned lock(s): ",
+            "../worktrees/002-run/openspec/changes/002-run/.run/running/1.pid\n",
+            "[ok] archives: all archives valid\n",
+            "[ok] done-markers: all done markers verified",
+        ),
+        "every-worktree",
+    );
+}
