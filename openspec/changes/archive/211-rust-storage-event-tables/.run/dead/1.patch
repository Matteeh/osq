+++ b/crates/kernel/storage/src/read/snapshot/table_events.rs
@@ -0,0 +1,35 @@
+//! The events the read model's event tables are built from.
+//!
+//! An event is kept only for the stream the table draws it from: a task
+//! stream's pauses, recertifications, focused and mutation runs, and the
+//! change stream's validator runs (rust-storage "Table events").
+//!
+//! Implements: rust-storage/table-events
+
+use osq_core::{Event, Stream};
+
+/// One kept event, with the stream it came from and its timestamp.
+#[derive(Clone, Debug, PartialEq)]
+pub struct TableEvent {
+    /// The stream whose file holds the event.
+    pub stream: Stream,
+    /// The event's timestamp, as written.
+    pub timestamp: String,
+    /// The typed event.
+    pub event: Event,
+}
+
+/// Whether one event of one stream belongs in the event tables.
+pub(super) fn keep(stream: &Stream, event: &Event) -> bool {
+    match stream {
+        Stream::Task(_) => matches!(
+            event,
+            Event::Paused(_)
+                | Event::Recertification(_)
+                | Event::FocusedRan(_)
+                | Event::MutationRan(_)
+        ),
+        Stream::Change => matches!(event, Event::ValidatorRan(_)),
+        Stream::Validator => false,
+    }
+}
