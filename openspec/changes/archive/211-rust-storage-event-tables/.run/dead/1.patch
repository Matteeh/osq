diff --git a/crates/kernel/storage/src/read/snapshot/records.rs b/crates/kernel/storage/src/read/snapshot/records.rs
new file mode 100644
index 00000000..2a7f0f9c
--- /dev/null
+++ b/crates/kernel/storage/src/read/snapshot/records.rs
@@ -0,0 +1,157 @@
+//! Reading `.run/plan.jsonl` records and the manifest's `notices` record.
+//!
+//! Both are read as TypeScript reads them (ADR 025): a line or an entry that
+//! does not fit the shape is left out, never refused, and a missing or
+//! unreadable file reads as nothing.
+//!
+//! Implements: rust-storage/plan-records
+//! Implements: rust-storage/manifest-notices
+
+use std::fs;
+use std::path::Path;
+
+use serde_json::Value;
+
+/// The severities a recorded notice may carry.
+const SEVERITIES: [&str; 3] = ["red", "amber", "grey"];
+
+/// One notice: its id and severity.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Notice {
+    /// The notice's id.
+    pub id: String,
+    /// The notice's severity, `red`, `amber` or `grey`.
+    pub severity: String,
+}
+
+/// One link finding of a plan record.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct LinkEntry {
+    /// The finding's severity.
+    pub severity: String,
+    /// The file the finding names.
+    pub file: String,
+    /// The finding's message.
+    pub message: String,
+}
+
+/// One `plan_ready` record storage keeps from `.run/plan.jsonl`.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct PlanRecord {
+    /// The record's notices, in order.
+    pub notices: Vec<Notice>,
+    /// The record's link findings, present only when the record had them.
+    pub traceability: Option<Vec<LinkEntry>>,
+}
+
+/// The manifest's `notices` record.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ManifestNotices {
+    /// The kept notice items, in order.
+    pub items: Vec<Notice>,
+    /// The ids the approver opened, absent without an `opened` array.
+    pub opened: Option<Vec<String>>,
+}
+
+/// Reads a change's `.run/plan.jsonl` records, in file order.
+///
+/// Implements: rust-storage/plan-records
+pub(super) fn read_plan_records(folder: &Path) -> Vec<PlanRecord> {
+    let path = folder.join(".run").join("plan.jsonl");
+    let Some(text) = fs::read_to_string(path).ok() else {
+        return Vec::new();
+    };
+    text.lines().filter_map(parse_line).collect()
+}
+
+/// Reads one line as a record, leaving out a blank or malformed one.
+fn parse_line(line: &str) -> Option<PlanRecord> {
+    if line.trim().is_empty() {
+        return None;
+    }
+    parse_record(&serde_json::from_str(line).ok()?)
+}
+
+/// Reads one JSON value as a `plan_ready` record, or `None`.
+fn parse_record(value: &Value) -> Option<PlanRecord> {
+    let object = value.as_object()?;
+    if object.get("type")?.as_str()? != "plan_ready" {
+        return None;
+    }
+    if object.get("timestamp")?.as_str()?.is_empty() {
+        return None;
+    }
+    let data = object.get("data")?.as_object()?;
+    data.get("hash")?.as_str()?;
+    let notices: Vec<Notice> = data
+        .get("notices")?
+        .as_array()?
+        .iter()
+        .map(parse_notice)
+        .collect::<Option<Vec<Notice>>>()?;
+    let traceability = data
+        .get("traceability")
+        .and_then(Value::as_array)
+        .map(|entries| entries.iter().filter_map(parse_link).collect());
+    Some(PlanRecord {
+        notices,
+        traceability,
+    })
+}
+
+/// Reads one notice, or `None` for an entry that is not a recorded notice.
+fn parse_notice(value: &Value) -> Option<Notice> {
+    let object = value.as_object()?;
+    let id = object.get("id")?.as_str()?;
+    let severity = object.get("severity")?.as_str()?;
+    if !SEVERITIES.contains(&severity) || !object.get("folded")?.is_boolean() {
+        return None;
+    }
+    Some(Notice {
+        id: id.to_owned(),
+        severity: severity.to_owned(),
+    })
+}
+
+/// Reads one manifest notice item, or `None` without a string id and severity.
+fn parse_manifest_item(value: &Value) -> Option<Notice> {
+    let object = value.as_object()?;
+    Some(Notice {
+        id: object.get("id")?.as_str()?.to_owned(),
+        severity: object.get("severity")?.as_str()?.to_owned(),
+    })
+}
+
+/// Reads one link finding, or `None` without all three strings.
+fn parse_link(value: &Value) -> Option<LinkEntry> {
+    let object = value.as_object()?;
+    Some(LinkEntry {
+        severity: object.get("severity")?.as_str()?.to_owned(),
+        file: object.get("file")?.as_str()?.to_owned(),
+        message: object.get("message")?.as_str()?.to_owned(),
+    })
+}
+
+/// Reads the manifest's `notices` record, or `None` when it has none.
+///
+/// Implements: rust-storage/manifest-notices
+pub(super) fn manifest_notices(manifest: Option<&Value>) -> Option<ManifestNotices> {
+    let record = manifest?.as_object()?.get("notices")?.as_object()?;
+    let items = record
+        .get("items")?
+        .as_array()?
+        .iter()
+        .filter_map(parse_manifest_item)
+        .collect();
+    let opened = record
+        .get("opened")
+        .and_then(Value::as_array)
+        .map(|entries| {
+            entries
+                .iter()
+                .filter_map(Value::as_str)
+                .map(ToOwned::to_owned)
+                .collect()
+        });
+    Some(ManifestNotices { items, opened })
+}
