+//! Proves the reading shapes the history fixture does not hold: which stream
+//! and type pairs are kept, which `plan.jsonl` lines and manifest entries are
+//! left out, and an unreadable plan file.
+//!
+//! These are the fast counterparts `cargo-mutants` runs for the selection and
+//! parsing leaves; `reading_history.rs` proves the history fixture itself.
+
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use osq_core::{Event, Stream, TaskId};
+use osq_kernel_storage::{
+    ChangeEntry, ChangeSnapshot, EventFacts, LinkEntry, Location, ManifestNotices, Notice,
+    PlanRecord, read_change,
+};
+
+/// A change entry of a project root.
+fn entry(root: &Path, folder: &str, location: Location) -> ChangeEntry {
+    let changes = root.join("openspec").join("changes");
+    let path = match location {
+        Location::Archived => changes.join("archive").join(folder),
+        Location::Rejected => changes.join("rejected").join(folder),
+        Location::Active => changes.join(folder),
+    };
+    ChangeEntry {
+        folder: folder.to_owned(),
+        location,
+        path,
+    }
+}
+
+/// A fresh temporary project root, with anything at that name removed.
+fn temp_root(name: &str) -> PathBuf {
+    let root = Path::new(env!("CARGO_TARGET_TMPDIR")).join(name);
+    let _ = fs::remove_dir_all(&root);
+    root
+}
+
+/// Writes a file, creating its parent folders.
+fn write(path: &Path, text: &str) {
+    fs::create_dir_all(path.parent().unwrap()).unwrap();
+    fs::write(path, text).unwrap();
+}
+
+/// Reads one change built under a fresh root from the given relative files.
+fn snapshot_of(name: &str, files: &[(&str, &str)]) -> ChangeSnapshot {
+    let root = temp_root(name);
+    let dir = root.join("openspec/changes/archive/001-x");
+    write(&dir.join("proposal.md"), "---\ntitle: \"X\"\n---\n");
+    for (relative, text) in files {
+        write(&dir.join(relative), text);
+    }
+    read_change(&entry(&root, "001-x", Location::Archived)).unwrap()
+}
+
+/// The manifest notices of a change whose `.run/manifest.json` holds `text`.
+fn notices_from(name: &str, manifest: &str) -> Option<ManifestNotices> {
+    snapshot_of(name, &[(".run/manifest.json", manifest)]).manifest_notices
+}
+
+/// A task stream.
+fn task(id: &str) -> Stream {
+    Stream::Task(TaskId::new(id))
+}
+
+/// The event type name of a kept event.
+fn label(event: &Event) -> &'static str {
+    match event {
+        Event::Paused(_) => "paused",
+        Event::FocusedRan(_) => "focused_ran",
+        Event::MutationRan(_) => "mutation_ran",
+        Event::Recertification(_) => "recertification",
+        Event::ValidatorRan(_) => "validator_ran",
+        _ => "other",
+    }
+}
+
+/// The stream, type name and timestamp of every kept event.
+fn kept(facts: &EventFacts) -> Vec<(Stream, &'static str, &str)> {
+    facts
+        .table_events
+        .iter()
+        .map(|event| {
+            (
+                event.stream.clone(),
+                label(&event.event),
+                event.timestamp.as_str(),
+            )
+        })
+        .collect()
+}
+
+/// One notice.
+fn notice(id: &str, severity: &str) -> Notice {
+    Notice {
+        id: id.to_owned(),
+        severity: severity.to_owned(),
+    }
+}
+
+/// A task stream holding kept and not-kept types.
+const TASK_STREAM: &str = "{\"type\":\"started\",\"timestamp\":\"2026-10-01T10:00:00.000Z\",\"data\":{}}\n\
+{\"type\":\"paused\",\"timestamp\":\"2026-10-01T10:01:00.000Z\",\"data\":{\"task\":\"1\",\"until\":\"u\",\"source\":\"harness\"}}\n\
+{\"type\":\"focused_ran\",\"timestamp\":\"2026-10-01T10:02:00.000Z\",\"data\":{\"command\":\"c\",\"files\":[],\"scenarios\":[],\"outcome\":\"passed\",\"exitCode\":0,\"duration\":1,\"timedOut\":false,\"output\":\"\"}}\n\
+{\"type\":\"validator_ran\",\"timestamp\":\"2026-10-01T10:03:00.000Z\",\"data\":{\"outcome\":\"passed\",\"harness\":\"claude\",\"model\":\"m\",\"duration\":1,\"exitCode\":0,\"scenarios\":0,\"findings\":[],\"restored\":[]}}\n";
+
+/// A change stream holding a kept and a not-kept type.
+const CHANGE_STREAM: &str = "{\"type\":\"paused\",\"timestamp\":\"2026-10-01T10:04:00.000Z\",\"data\":{\"task\":\"1\",\"until\":\"u\",\"source\":\"harness\"}}\n\
+{\"type\":\"validator_ran\",\"timestamp\":\"2026-10-01T10:05:00.000Z\",\"data\":{\"outcome\":\"passed\",\"harness\":\"claude\",\"model\":\"m\",\"duration\":1,\"exitCode\":0,\"scenarios\":0,\"findings\":[],\"restored\":[]}}\n";
+
+/// A validator stream whose events no table keeps.
+const VALIDATOR_STREAM: &str = "{\"type\":\"validator_ran\",\"timestamp\":\"2026-10-01T10:06:00.000Z\",\"data\":{\"outcome\":\"passed\",\"harness\":\"claude\",\"model\":\"m\",\"duration\":1,\"exitCode\":0,\"scenarios\":0,\"findings\":[],\"restored\":[]}}\n";
+
+/// Proves an event is kept only for a stream and type pair of the tables.
+///
+/// Covers: rust-storage/kept-events-of-the-history-fixture
+#[test]
+fn kept_events_follow_stream_and_type() {
+    let snapshot = snapshot_of(
+        "kept_stream_and_type",
+        &[
+            (".run/events/1.jsonl", TASK_STREAM),
+            (".run/events/change.jsonl", CHANGE_STREAM),
+            (".run/events/validator.jsonl", VALIDATOR_STREAM),
+        ],
+    );
+    let facts = snapshot.facts.as_ref().unwrap();
+    assert_eq!(
+        kept(facts),
+        [
+            (task("1"), "paused", "2026-10-01T10:01:00.000Z"),
+            (task("1"), "focused_ran", "2026-10-01T10:02:00.000Z"),
+            (Stream::Change, "validator_ran", "2026-10-01T10:05:00.000Z"),
+        ]
+    );
+}
+
+/// `plan.jsonl` lines that exercise every rule of "Plan records".
+const PLAN_LINES: &str = "not json\n\
+[1,2]\n\
+{\"type\":\"other\",\"timestamp\":\"t\",\"data\":{\"hash\":\"h\",\"notices\":[]}}\n\
+{\"type\":\"plan_ready\",\"timestamp\":\"\",\"data\":{\"hash\":\"h\",\"notices\":[]}}\n\
+{\"type\":\"plan_ready\",\"timestamp\":\"t\",\"data\":\"x\"}\n\
+{\"type\":\"plan_ready\",\"timestamp\":\"t\",\"data\":{\"hash\":7,\"notices\":[]}}\n\
+{\"type\":\"plan_ready\",\"timestamp\":\"t\",\"data\":{\"hash\":\"h\"}}\n\
+{\"type\":\"plan_ready\",\"timestamp\":\"t\",\"data\":{\"hash\":\"h\",\"notices\":[\"x\"]}}\n\
+{\"type\":\"plan_ready\",\"timestamp\":\"t\",\"data\":{\"hash\":\"h\",\"notices\":[{\"id\":7,\"severity\":\"red\",\"folded\":true}]}}\n\
+{\"type\":\"plan_ready\",\"timestamp\":\"t\",\"data\":{\"hash\":\"h\",\"notices\":[{\"id\":\"a\",\"severity\":\"purple\",\"folded\":true}]}}\n\
+{\"type\":\"plan_ready\",\"timestamp\":\"t\",\"data\":{\"hash\":\"h\",\"notices\":[{\"id\":\"a\",\"severity\":\"red\",\"folded\":\"yes\"}]}}\n\
+{\"type\":\"plan_ready\",\"timestamp\":\"t\",\"data\":{\"hash\":\"h\",\"notices\":[{\"id\":\"a\",\"severity\":\"amber\",\"folded\":false}],\"traceability\":\"x\"}}\n\
+{\"type\":\"plan_ready\",\"timestamp\":\"t\",\"data\":{\"hash\":\"h\",\"notices\":[],\"traceability\":[1,{\"severity\":\"w\"},{\"severity\":\"w\",\"file\":\"f\",\"message\":\"m\"}]}}\n\
+\n";
+
+/// Proves a line that is not a record is left out without an error.
+///
+/// Covers: rust-storage/plan-records-of-the-history-fixture
+#[test]
+fn plan_records_skip_lines_that_are_not_records() {
+    let snapshot = snapshot_of("plan_lines", &[(".run/plan.jsonl", PLAN_LINES)]);
+    assert_eq!(
+        snapshot.plan_records,
+        [
+            PlanRecord {
+                notices: vec![notice("a", "amber")],
+                traceability: None,
+            },
+            PlanRecord {
+                notices: Vec::new(),
+                traceability: Some(vec![LinkEntry {
+                    severity: String::from("w"),
+                    file: String::from("f"),
+                    message: String::from("m"),
+                }]),
+            },
+        ]
+    );
+}
+
+/// Proves an unreadable or missing `plan.jsonl` reads as no records.
+///
+/// Covers: rust-storage/no-plan-file
+#[test]
+fn plan_records_read_nothing_without_a_readable_file() {
+    let missing = snapshot_of("plan_missing", &[]);
+    assert!(missing.plan_records.is_empty(), "expected no plan records");
+
+    let root = temp_root("plan_unreadable");
+    let dir = root.join("openspec/changes/archive/001-x");
+    write(&dir.join("proposal.md"), "---\ntitle: \"X\"\n---\n");
+    fs::create_dir_all(dir.join(".run/plan.jsonl")).unwrap();
+    let unreadable = read_change(&entry(&root, "001-x", Location::Archived)).unwrap();
+    assert!(
+        unreadable.plan_records.is_empty(),
+        "expected no plan records"
+    );
+}
+
+/// Proves only well-shaped manifest notice entries and opened ids are kept.
+///
+/// Covers: rust-storage/manifest-notices-of-the-history-fixture
+#[test]
+fn manifest_notices_keep_only_well_shaped_entries() {
+    assert_eq!(notices_from("manifest_none", "{}"), None);
+    assert_eq!(notices_from("manifest_text", "{\"notices\":\"x\"}"), None);
+    assert_eq!(
+        notices_from("manifest_items_text", "{\"notices\":{\"items\":\"x\"}}"),
+        None
+    );
+    assert_eq!(
+        notices_from("manifest_empty", "{\"notices\":{\"items\":[]}}"),
+        Some(ManifestNotices {
+            items: Vec::new(),
+            opened: None,
+        })
+    );
+    assert_eq!(
+        notices_from(
+            "manifest_filtered",
+            "{\"notices\":{\"items\":[{\"id\":\"a\",\"severity\":\"red\"},7,\"junk\",\
+             {\"id\":3,\"severity\":\"x\"},{\"id\":\"b\"}],\"opened\":[\"a\",5]}}"
+        ),
+        Some(ManifestNotices {
+            items: vec![notice("a", "red")],
+            opened: Some(vec![String::from("a")]),
+        })
+    );
+    assert_eq!(
+        notices_from(
+            "manifest_opened_text",
+            "{\"notices\":{\"items\":[],\"opened\":\"x\"}}"
+        ),
+        Some(ManifestNotices {
+            items: Vec::new(),
+            opened: None,
+        })
+    );
+}
