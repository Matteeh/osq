@@ -0,0 +1,206 @@
+//! Proves reading the history fixture's table events, plan records and
+//! manifest notices, and the archived-then-rejected history order.
+//!
+//! The fixture project and its expected rows were printed by TypeScript's
+//! `osq query --json`; task 2 compares the rows. This binary pins the reading
+//! they are built from. `reading_history_edges.rs` adds the shapes the
+//! fixture does not hold, for the mutation check.
+
+use std::path::{Path, PathBuf};
+
+use osq_core::{Event, Stream, TaskId};
+use osq_kernel_storage::{
+    ChangeEntry, EventFacts, LinkEntry, Location, ManifestNotices, Notice, PlanRecord, TableEvent,
+    read_change, read_history,
+};
+
+/// The history fixture project root.
+fn history() -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/fixtures/history")
+}
+
+/// A change entry of a project root.
+fn entry(root: &Path, folder: &str, location: Location) -> ChangeEntry {
+    let changes = root.join("openspec").join("changes");
+    let path = match location {
+        Location::Archived => changes.join("archive").join(folder),
+        Location::Rejected => changes.join("rejected").join(folder),
+        Location::Active => changes.join(folder),
+    };
+    ChangeEntry {
+        folder: folder.to_owned(),
+        location,
+        path,
+    }
+}
+
+/// A task stream.
+fn task(id: &str) -> Stream {
+    Stream::Task(TaskId::new(id))
+}
+
+/// The event type name of a kept event.
+fn label(event: &Event) -> &'static str {
+    match event {
+        Event::Paused(_) => "paused",
+        Event::FocusedRan(_) => "focused_ran",
+        Event::MutationRan(_) => "mutation_ran",
+        Event::Recertification(_) => "recertification",
+        Event::ValidatorRan(_) => "validator_ran",
+        _ => "other",
+    }
+}
+
+/// The stream, type name and timestamp of every kept event.
+fn kept(facts: &EventFacts) -> Vec<(Stream, &'static str, &str)> {
+    facts
+        .table_events
+        .iter()
+        .map(|event| {
+            (
+                event.stream.clone(),
+                label(&event.event),
+                event.timestamp.as_str(),
+            )
+        })
+        .collect()
+}
+
+/// One notice.
+fn notice(id: &str, severity: &str) -> Notice {
+    Notice {
+        id: id.to_owned(),
+        severity: severity.to_owned(),
+    }
+}
+
+/// Proves the fixture's kept events, by stream, type and timestamp.
+///
+/// Covers: rust-storage/kept-events-of-the-history-fixture
+#[test]
+fn kept_events_of_the_history_fixture() {
+    let snapshot = read_change(&entry(&history(), "001-run", Location::Archived)).unwrap();
+    let facts = snapshot.facts.as_ref().unwrap();
+    assert_eq!(
+        kept(facts),
+        [
+            (task("1"), "paused", "2026-10-01T10:02:00.000Z"),
+            (task("1"), "focused_ran", "2026-10-01T10:03:00.000Z"),
+            (task("1"), "mutation_ran", "2026-10-01T10:04:00.000Z"),
+            (task("1"), "recertification", "2026-10-01T10:05:00.000Z"),
+            (task("2"), "focused_ran", "2026-10-01T10:07:00.000Z"),
+            (task("2"), "mutation_ran", "2026-10-01T10:08:00.000Z"),
+            (task("2"), "recertification", "2026-10-01T10:09:00.000Z"),
+            (task("2"), "recertification", "2026-10-01T10:10:00.000Z"),
+            (task("10"), "paused", "2026-10-01T10:12:00.000Z"),
+            (Stream::Change, "validator_ran", "2026-10-01T10:14:00.000Z"),
+            (Stream::Change, "validator_ran", "2026-10-01T10:15:00.000Z"),
+        ]
+    );
+}
+
+/// Proves a kept event carries the typed event, stream and timestamp.
+///
+/// Covers: rust-storage/kept-events-of-the-history-fixture
+#[test]
+fn kept_event_carries_its_parts() {
+    let snapshot = read_change(&entry(&history(), "001-run", Location::Archived)).unwrap();
+    let first = &snapshot.facts.as_ref().unwrap().table_events[0];
+    assert!(matches!(first.event, Event::Paused(_)));
+    assert_eq!(
+        TableEvent {
+            stream: task("1"),
+            timestamp: String::from("2026-10-01T10:02:00.000Z"),
+            event: first.event.clone(),
+        },
+        *first
+    );
+}
+
+/// Proves the fixture's two plan records and their kept notices and links.
+///
+/// Covers: rust-storage/plan-records-of-the-history-fixture
+#[test]
+fn plan_records_of_the_history_fixture() {
+    let snapshot = read_change(&entry(&history(), "001-run", Location::Archived)).unwrap();
+    assert_eq!(
+        snapshot.plan_records,
+        [
+            PlanRecord {
+                notices: vec![notice("draft-only", "amber")],
+                traceability: None,
+            },
+            PlanRecord {
+                notices: vec![notice("scope-wide", "red")],
+                traceability: Some(vec![LinkEntry {
+                    severity: String::from("warning"),
+                    file: String::from("src/a.rs"),
+                    message: String::from("src/a.rs:3: tag is not valid"),
+                }]),
+            },
+        ]
+    );
+}
+
+/// Proves a change without a `plan.jsonl` holds no plan records.
+///
+/// Covers: rust-storage/no-plan-file
+#[test]
+fn no_plan_file() {
+    let snapshot = read_change(&entry(&history(), "002-quiet", Location::Archived)).unwrap();
+    assert!(snapshot.plan_records.is_empty(), "expected no plan records");
+}
+
+/// Proves the fixture's manifest notices for each of its four changes.
+///
+/// Covers: rust-storage/manifest-notices-of-the-history-fixture
+#[test]
+fn manifest_notices_of_the_history_fixture() {
+    let run = read_change(&entry(&history(), "001-run", Location::Archived)).unwrap();
+    assert_eq!(
+        run.manifest_notices,
+        Some(ManifestNotices {
+            items: vec![notice("scope-wide", "red"), notice("no-tests", "grey")],
+            opened: Some(vec![String::from("scope-wide")]),
+        })
+    );
+    let quiet = read_change(&entry(&history(), "002-quiet", Location::Archived)).unwrap();
+    assert_eq!(
+        quiet.manifest_notices,
+        Some(ManifestNotices {
+            items: vec![notice("no-tests", "amber")],
+            opened: None,
+        })
+    );
+    let dropped = read_change(&entry(&history(), "003-dropped", Location::Rejected)).unwrap();
+    assert_eq!(dropped.manifest_notices, None);
+    let noted = read_change(&entry(&history(), "004-noted", Location::Rejected)).unwrap();
+    assert_eq!(
+        noted.manifest_notices,
+        Some(ManifestNotices {
+            items: vec![notice("scope-wide", "grey")],
+            opened: Some(Vec::new()),
+        })
+    );
+}
+
+/// Proves `read_history` returns the archived changes then the rejected ones.
+///
+/// Covers: rust-storage/history-of-the-history-fixture
+#[test]
+fn history_of_the_history_fixture() {
+    let snapshots = read_history(&history()).unwrap();
+    let observed: Vec<(&str, Location)> = snapshots
+        .iter()
+        .map(|snapshot| (snapshot.folder.as_str(), snapshot.location))
+        .collect();
+    assert_eq!(
+        observed,
+        [
+            ("001-run", Location::Archived),
+            ("002-quiet", Location::Archived),
+            ("003-dropped", Location::Rejected),
+            ("004-noted", Location::Rejected),
+        ]
+    );
+}
