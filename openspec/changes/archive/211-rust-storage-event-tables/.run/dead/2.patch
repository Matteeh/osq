@@ -0,0 +1,85 @@
+//! Mapping a change snapshot to the `notices` rows of its plans and manifest.
+
+use crate::read::{ChangeSnapshot, Location, ManifestNotices, PlanRecord};
+
+/// One row of the `notices` table.
+pub(super) struct NoticeRow {
+    /// The change folder.
+    pub(super) change: String,
+    /// The notice id.
+    pub(super) notice: String,
+    /// The severity, as written.
+    pub(super) severity: String,
+    /// 1 when opened, 0 when not, null without an opened list.
+    pub(super) opened: Option<i64>,
+    /// What the change did about the notice.
+    pub(super) outcome: String,
+}
+
+/// The notices rows of every archived and rejected snapshot, by folder name.
+pub(super) fn all_notice_rows(snapshots: &[ChangeSnapshot]) -> Vec<NoticeRow> {
+    let mut subjects: Vec<&ChangeSnapshot> = snapshots
+        .iter()
+        .filter(|snapshot| matches!(snapshot.location, Location::Archived | Location::Rejected))
+        .collect();
+    subjects.sort_by(|left, right| left.folder.cmp(&right.folder));
+    subjects.into_iter().flat_map(notice_rows).collect()
+}
+
+/// Every notice row one change contributes, in order.
+pub(super) fn notice_rows(snapshot: &ChangeSnapshot) -> Vec<NoticeRow> {
+    let mut rows = Vec::new();
+    if let Some((last, rest)) = snapshot.plan_records.split_last() {
+        for record in rest {
+            push_plan(&mut rows, snapshot, record, "planned_again");
+        }
+        if let Some(record) = &snapshot.manifest_notices {
+            push_manifest(&mut rows, snapshot, record);
+        } else if snapshot.location == Location::Rejected {
+            push_plan(&mut rows, snapshot, last, "rejected");
+        }
+    } else if let Some(record) = &snapshot.manifest_notices {
+        push_manifest(&mut rows, snapshot, record);
+    }
+    rows
+}
+
+/// Appends the notices of one plan record, with no opened list.
+fn push_plan(
+    rows: &mut Vec<NoticeRow>,
+    snapshot: &ChangeSnapshot,
+    record: &PlanRecord,
+    outcome: &str,
+) {
+    for notice in &record.notices {
+        rows.push(NoticeRow {
+            change: snapshot.folder.clone(),
+            notice: notice.id.clone(),
+            severity: notice.severity.clone(),
+            opened: None,
+            outcome: outcome.to_owned(),
+        });
+    }
+}
+
+/// Appends the manifest's notice items, with the change's outcome.
+fn push_manifest(rows: &mut Vec<NoticeRow>, snapshot: &ChangeSnapshot, record: &ManifestNotices) {
+    let outcome = match snapshot.location {
+        Location::Rejected => "rejected",
+        _ if snapshot.facts.as_ref().is_some_and(|facts| facts.halts > 0) => "halted",
+        _ => "approved",
+    };
+    for item in &record.items {
+        let opened = record
+            .opened
+            .as_ref()
+            .map(|ids| i64::from(ids.iter().any(|id| id == &item.id)));
+        rows.push(NoticeRow {
+            change: snapshot.folder.clone(),
+            notice: item.id.clone(),
+            severity: item.severity.clone(),
+            opened,
+            outcome: outcome.to_owned(),
+        });
+    }
+}
