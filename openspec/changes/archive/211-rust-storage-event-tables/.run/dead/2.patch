@@ -0,0 +1,108 @@
+//! Mapping a change snapshot to the `pauses` and `recertifications` rows.
+
+use osq_core::{Event, Stream};
+use serde_json::Value;
+
+use crate::read::ChangeSnapshot;
+
+use super::rows::{entry_string, table_events};
+
+/// One row of the `pauses` table.
+pub(super) struct PauseRow {
+    /// The change folder.
+    pub(super) change: String,
+    /// The paused task.
+    pub(super) task: String,
+    /// The event's timestamp.
+    pub(super) paused_at: String,
+    /// The time the pause lasts until.
+    pub(super) until: String,
+    /// Where the reset time came from.
+    pub(super) source: String,
+}
+
+/// One row of the `recertifications` table.
+pub(super) struct RecertificationRow {
+    /// The change folder.
+    pub(super) change: String,
+    /// The recertified task.
+    pub(super) task: String,
+    /// The event's timestamp.
+    pub(super) recertified_at: String,
+    /// The event's outcome.
+    pub(super) outcome: String,
+    /// 1 when the watcher recertified on its own, else 0.
+    pub(super) automatic: i64,
+    /// The entry's path, or null.
+    pub(super) path: Option<String>,
+    /// The entry's attribution, or null.
+    pub(super) credited_to: Option<String>,
+    /// `measures`, `file_changed`, or null.
+    pub(super) source: Option<String>,
+}
+
+/// Every `pauses` row of one snapshot, in fold order.
+pub(super) fn pause_rows(snapshot: &ChangeSnapshot) -> Vec<PauseRow> {
+    let mut rows = Vec::new();
+    for table_event in table_events(snapshot) {
+        let (Stream::Task(_), Event::Paused(data)) = (&table_event.stream, &table_event.event)
+        else {
+            continue;
+        };
+        rows.push(PauseRow {
+            change: snapshot.folder.clone(),
+            task: data.task.clone(),
+            paused_at: table_event.timestamp.clone(),
+            until: data.until.clone(),
+            source: data.source.clone(),
+        });
+    }
+    rows
+}
+
+/// Every `recertifications` row of one snapshot, one per attribution entry.
+pub(super) fn recertification_rows(snapshot: &ChangeSnapshot) -> Vec<RecertificationRow> {
+    let mut rows = Vec::new();
+    for table_event in table_events(snapshot) {
+        let (Stream::Task(_), Event::Recertification(data)) =
+            (&table_event.stream, &table_event.event)
+        else {
+            continue;
+        };
+        let Value::Array(entries) = &data.attribution else {
+            continue;
+        };
+        for entry in entries {
+            if !entry.is_object() {
+                continue;
+            }
+            rows.push(RecertificationRow {
+                change: snapshot.folder.clone(),
+                task: data.task.clone(),
+                recertified_at: table_event.timestamp.clone(),
+                outcome: data.outcome.clone(),
+                automatic: i64::from(data.automatic == Some(true)),
+                path: entry_string(entry, "path"),
+                credited_to: entry_string(entry, "attribution"),
+                source: entry_source(entry),
+            });
+        }
+    }
+    rows
+}
+
+/// An entry's source: `measures`, `file_changed` for a task number, else null.
+fn entry_source(entry: &Value) -> Option<String> {
+    if entry.get("source").and_then(Value::as_str) == Some("measures") {
+        return Some(String::from("measures"));
+    }
+    let attributed = entry.get("attribution").and_then(Value::as_str);
+    attributed
+        .filter(|text| is_task_number(text))
+        .map(|_| String::from("file_changed"))
+}
+
+/// Whether a string is one or more digits, as TypeScript's `/^\d+$/` reads.
+fn is_task_number(text: &str) -> bool {
+    !text.is_empty() && text.bytes().all(|byte| byte.is_ascii_digit())
+}
