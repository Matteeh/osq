+//! Proves the notice, link and finding rules the history fixture does not hold.
+
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use osq_kernel_storage::build_read_model;
+use rusqlite::Connection;
+use rusqlite::types::Value;
+
+/// The columns of each table this test reads, in table order.
+const NOTICES: [&str; 5] = ["change", "notice", "severity", "opened", "outcome"];
+/// The `focused_runs` columns, in table order.
+const FOCUSED: [&str; 9] = [
+    "change",
+    "task",
+    "run",
+    "outcome",
+    "exit_code",
+    "duration",
+    "timed_out",
+    "scenarios",
+    "files",
+];
+/// The `validator_runs` columns, in table order.
+const RUNS: [&str; 11] = [
+    "change",
+    "run",
+    "outcome",
+    "harness",
+    "model",
+    "duration",
+    "exit_code",
+    "scenarios",
+    "findings",
+    "reason",
+    "output",
+];
+/// The `validator_findings` columns, in table order.
+const FINDING_ROWS: [&str; 10] = [
+    "id",
+    "change",
+    "run",
+    "finding",
+    "capability",
+    "requirement",
+    "scenario",
+    "problem",
+    "detail",
+    "label",
+];
+/// The `link_findings` columns, in table order.
+const LINKS: [&str; 6] = ["id", "change", "severity", "file", "message", "label"];
+
+/// A fresh temporary project root, with anything at that name removed.
+fn temp_root(name: &str) -> PathBuf {
+    let root = Path::new(env!("CARGO_TARGET_TMPDIR")).join(name);
+    let _ = fs::remove_dir_all(&root);
+    root
+}
+
+/// A database path for one test, under the target's temp directory.
+fn db_path(name: &str) -> PathBuf {
+    Path::new(env!("CARGO_TARGET_TMPDIR")).join(name)
+}
+
+/// Writes a file, creating its parent folders.
+fn write(path: &Path, text: &str) {
+    fs::create_dir_all(path.parent().unwrap()).unwrap();
+    fs::write(path, text).unwrap();
+}
+
+/// A text column value.
+fn text(value: &str) -> Value {
+    Value::Text(value.to_owned())
+}
+
+/// A null column value.
+fn null() -> Value {
+    Value::Null
+}
+
+/// Reads one table's rows as typed values, in insertion order.
+#[rustfmt::skip]
+fn table_rows(db: &Connection, table: &str, columns: &[&str]) -> Vec<Vec<Value>> {
+    let select = format!("SELECT {} FROM {table} ORDER BY rowid", columns.join(", "));
+    let mut statement = db.prepare(&select).unwrap();
+    let mapped = statement.query_map([], |row| (0..columns.len()).map(|index| row.get::<_, Value>(index)).collect::<rusqlite::Result<Vec<Value>>>()).unwrap();
+    mapped.map(Result::unwrap).collect()
+}
+
+/// Proves the notice, link, focused and finding rules beyond the fixture.
+///
+/// Covers: rust-storage/columns-of-the-event-tables
+#[test]
+#[rustfmt::skip]
+fn model_edges() {
+    let root = temp_root("model_edges");
+    write(&root.join("openspec/changes/rejected/001-rej/proposal.md"), "---\ntitle: R\n---\n");
+    write(&root.join("openspec/changes/rejected/001-rej/.run/plan.jsonl"), "{\"type\":\"plan_ready\",\"timestamp\":\"2026-09-30T11:00:00.000Z\",\"data\":{\"hash\":\"h\",\"notices\":[{\"id\":\"only\",\"severity\":\"grey\",\"folded\":true}]}}\n");
+    write(&root.join("openspec/changes/archive/002-arch/proposal.md"), "---\ntitle: A\n---\n");
+    write(&root.join("openspec/changes/archive/002-arch/.run/plan.jsonl"), "{\"type\":\"plan_ready\",\"timestamp\":\"2026-09-30T09:00:00.000Z\",\"data\":{\"hash\":\"h\",\"notices\":[{\"id\":\"first\",\"severity\":\"amber\",\"folded\":false}]}}\n{\"type\":\"plan_ready\",\"timestamp\":\"2026-09-30T09:30:00.000Z\",\"data\":{\"hash\":\"h\",\"notices\":[{\"id\":\"last\",\"severity\":\"red\",\"folded\":false}],\"traceability\":[]}}\n");
+    write(&root.join("openspec/changes/archive/002-arch/.run/manifest.json"), "{\"notices\":{\"items\":[{\"id\":\"plain\",\"severity\":\"grey\"}]}}\n");
+    write(&root.join("openspec/changes/archive/003-empty/proposal.md"), "---\ntitle: E\n---\n");
+    write(&root.join("openspec/changes/archive/002-arch/.run/events/change.jsonl"), FINDINGS);
+    write(&root.join("openspec/changes/archive/002-arch/.run/events/1.jsonl"), FOCUSED_RUNS);
+    let path = db_path("model_edges.sqlite");
+    build_read_model(&root, &path).unwrap();
+    let db = Connection::open(&path).unwrap();
+    let notices = table_rows(&db, "notices", &NOTICES);
+    assert_eq!(notices, vec![
+        vec![text("001-rej"), text("only"), text("grey"), null(), text("rejected")],
+        vec![text("002-arch"), text("first"), text("amber"), null(), text("planned_again")],
+        vec![text("002-arch"), text("plain"), text("grey"), null(), text("approved")],
+    ]);
+    assert_eq!(table_rows(&db, "link_findings", &LINKS), Vec::<Vec<Value>>::new());
+    let focused = table_rows(&db, "focused_runs", &FOCUSED);
+    assert_eq!(focused.len(), 2);
+    assert_eq!(focused[0][2], Value::Integer(1));
+    assert_eq!(focused[1][2], Value::Integer(2));
+    let runs = table_rows(&db, "validator_runs", &RUNS);
+    assert_eq!(runs.len(), 1);
+    assert_eq!(runs[0][8], Value::Integer(1));
+    let findings = table_rows(&db, "validator_findings", &FINDING_ROWS);
+    assert_eq!(findings.len(), 1);
+    assert_eq!(findings[0][0], text("002.v1.1"));
+    assert_eq!(findings[0][8], text("good"));
+}
