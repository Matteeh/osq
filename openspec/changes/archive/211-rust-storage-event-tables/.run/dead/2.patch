+//! Proves the nine event table rows, trial labels and malformed label handling.
+
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use osq_kernel_storage::model::ReadModelError;
+use osq_kernel_storage::{TrialLabels, build_read_model, read_trial_labels};
+use rusqlite::Connection;
+use rusqlite::types::Value;
+use serde_json::Value as Json;
+
+/// The nine tables' names, columns and fixture files, in table order.
+#[rustfmt::skip]
+const TABLES: [(&str, &[&str], &str); 9] = [
+    ("pauses", &["change", "task", "paused_at", "until", "source"], "pauses.json"),
+    ("recertifications", &["change", "task", "recertified_at", "outcome", "automatic", "path", "credited_to", "source"], "recertifications.json"),
+    ("notices", &["change", "notice", "severity", "opened", "outcome"], "notices.json"),
+    ("focused_runs", &["change", "task", "run", "outcome", "exit_code", "duration", "timed_out", "scenarios", "files"], "focused_runs.json"),
+    ("mutation_picks", &["change", "task", "pick", "file", "function", "outcome", "reason", "killed", "survived", "invalid", "duration", "scenarios"], "mutation_picks.json"),
+    ("mutation_survivors", &["id", "change", "task", "pick", "file", "function", "line", "column", "mutator", "replacement", "label"], "mutation_survivors.json"),
+    ("validator_runs", &["change", "run", "outcome", "harness", "model", "duration", "exit_code", "scenarios", "findings", "reason", "output"], "validator_runs.json"),
+    ("validator_findings", &["id", "change", "run", "finding", "capability", "requirement", "scenario", "problem", "detail", "label"], "validator_findings.json"),
+    ("link_findings", &["id", "change", "severity", "file", "message", "label"], "link_findings.json"),
+];
+
+/// The directory holding every fixture project and its expected rows.
+fn fixtures() -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/fixtures")
+}
+
+/// A database path for one test, under the target's temp directory.
+fn db_path(name: &str) -> PathBuf {
+    Path::new(env!("CARGO_TARGET_TMPDIR")).join(name)
+}
+
+/// A fresh temporary project root, with anything at that name removed.
+fn temp_root(name: &str) -> PathBuf {
+    let root = Path::new(env!("CARGO_TARGET_TMPDIR")).join(name);
+    let _ = fs::remove_dir_all(&root);
+    root
+}
+
+/// Writes a file, creating its parent folders.
+fn write(path: &Path, text: &str) {
+    fs::create_dir_all(path.parent().unwrap()).unwrap();
+    fs::write(path, text).unwrap();
+}
+
+/// Reads one table's rows as typed values, in insertion order.
+#[rustfmt::skip]
+fn table_rows(db: &Connection, table: &str, columns: &[&str]) -> Vec<Vec<Value>> {
+    let select = format!("SELECT {} FROM {table} ORDER BY rowid", columns.join(", "));
+    let mut statement = db.prepare(&select).unwrap();
+    let mapped = statement.query_map([], |row| (0..columns.len()).map(|index| row.get::<_, Value>(index)).collect::<rusqlite::Result<Vec<Value>>>()).unwrap();
+    mapped.map(Result::unwrap).collect()
+}
+
+/// The expected rows of one fixture file, in order.
+fn fixture(table: &str) -> Vec<Json> {
+    let path = fixtures()
+        .join("history-rows")
+        .join(format!("{table}.json"));
+    let text = fs::read_to_string(&path).unwrap();
+    let Json::Array(rows) = serde_json::from_str(&text).unwrap() else {
+        panic!("{} is not a JSON array", path.display());
+    };
+    rows
+}
+
+/// Whether a read column equals a fixture column: text and null as written,
+/// numbers equal by value as `f64`.
+fn equal(value: &Value, want: &Json) -> bool {
+    match (value, want) {
+        (Value::Null, Json::Null) => true,
+        (Value::Text(left), Json::String(right)) => left == right,
+        (Value::Integer(_) | Value::Real(_), Json::Number(_)) => number(value) == want.as_f64(),
+        _ => false,
+    }
+}
+
+/// A column's numeric value as `f64`, or `None` for text and null.
+fn number(value: &Value) -> Option<f64> {
+    match value {
+        Value::Integer(number) => Json::from(*number).as_f64(),
+        Value::Real(number) => Some(*number),
+        _ => None,
+    }
+}
+
+/// Records every column of a row that disagrees with its fixture row.
+fn compare(
+    table: &str,
+    columns: &[&str],
+    expected: &[Json],
+    actual: &[Vec<Value>],
+    failures: &mut Vec<String>,
+) {
+    if expected.len() != actual.len() {
+        failures.push(format!(
+            "{table}: fixture holds {} rows, the read model {}",
+            expected.len(),
+            actual.len()
+        ));
+    }
+    for (index, row) in actual.iter().enumerate() {
+        let Some(want) = expected.get(index).and_then(Json::as_object) else {
+            continue;
+        };
+        for (position, value) in row.iter().enumerate() {
+            let Some(name) = columns.get(position) else {
+                continue;
+            };
+            let Some(expected) = want.get(*name) else {
+                continue;
+            };
+            if !equal(value, expected) {
+                failures.push(format!(
+                    "{table} row {index} column {name}: read {value:?}, fixture {expected:?}"
+                ));
+            }
+        }
+    }
+}
+
+/// Proves the nine event tables equal the history fixture's TypeScript rows,
+/// and that its trial labels fill the label columns by id.
+///
+/// Covers: rust-storage/history-fixture-rows
+/// Covers: rust-storage/labels-in-the-history-fixture
+#[test]
+fn history_fixture() {
+    let path = db_path("history_fixture.sqlite");
+    build_read_model(&fixtures().join("history"), &path).unwrap();
+    let db = Connection::open(&path).unwrap();
+    let mut failures = Vec::new();
+    for (table, columns, file) in TABLES {
+        compare(
+            table,
+            columns,
+            &fixture(file.trim_end_matches(".json")),
+            &table_rows(&db, table, columns),
+            &mut failures,
+        );
+    }
+    assert!(failures.is_empty(), "{}", failures.join("\n"));
+    assert_eq!(label(&db, "validator_findings", "001.v1.1"), Some(1));
+    assert_eq!(label(&db, "mutation_survivors", "001.1.m1.1"), Some(0));
+    assert_eq!(label(&db, "mutation_survivors", "001.1.m1.2"), None);
+    assert_eq!(label(&db, "link_findings", "001.l1"), Some(1));
+}
+
+/// The `label` column of one trial table row.
+fn label(db: &Connection, table: &str, id: &str) -> Option<i64> {
+    db.query_row(
+        &format!("SELECT label FROM {table} WHERE id = ?1"),
+        [id],
+        |row| row.get(0),
+    )
+    .unwrap()
+}
+
+/// Proves the label reader's missing, valid and malformed files, and that a
+/// malformed file fails the build before any database is written.
+///
+/// Covers: rust-storage/trial-labels
+/// Covers: rust-storage/malformed-label-file
+#[test]
+fn trial_labels() {
+    let root = temp_root("trial_labels");
+    assert_eq!(read_trial_labels(&root).unwrap(), TrialLabels::default());
+    write(
+        &root.join("openspec/trials/validator.json"),
+        "{\"a\":true,\"b\":false}",
+    );
+    write(
+        &root.join("openspec/trials/traceability.json"),
+        "{\"c\":true}",
+    );
+    let labels = read_trial_labels(&root).unwrap();
+    assert_eq!(labels.validator.get("a"), Some(&true));
+    assert_eq!(labels.validator.get("b"), Some(&false));
+    assert_eq!(labels.traceability.get("c"), Some(&true));
+    for malformed in ["[true]", "{not json", "7"] {
+        write(&root.join("openspec/trials/traceability.json"), malformed);
+        let error = read_trial_labels(&root).unwrap_err().to_string();
+        assert_eq!(
+            error,
+            "openspec/trials/traceability.json must be a JSON object of true or false labels"
+        );
+    }
+
+    let path = db_path("malformed_label_file.sqlite");
+    fs::remove_file(&path).ok();
+    let error = build_read_model(&fixtures().join("bad-labels"), &path).unwrap_err();
+    assert_eq!(
+        error.to_string(),
+        "openspec/trials/validator.json must be a JSON object of true or false labels"
+    );
+    assert!(matches!(error, ReadModelError::Labels(_)));
+    assert!(
+        !path.exists(),
+        "a malformed label file must write no database"
+    );
+}
