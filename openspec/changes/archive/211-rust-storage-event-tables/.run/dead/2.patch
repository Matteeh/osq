@@ -0,0 +1,93 @@
+//! Reading the committed trial label files and filling the label columns.
+
+use std::collections::BTreeMap;
+use std::fs;
+use std::path::Path;
+
+use rusqlite::{Connection, params};
+use serde_json::Value;
+
+use super::ReadModelError;
+
+/// The labels of the two trial label files, by id.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct TrialLabels {
+    /// The `openspec/trials/validator.json` labels.
+    pub validator: BTreeMap<String, bool>,
+    /// The `openspec/trials/traceability.json` labels.
+    pub traceability: BTreeMap<String, bool>,
+}
+
+/// Reads `openspec/trials/validator.json` and `openspec/trials/traceability.json`.
+///
+/// A missing or unreadable file holds no labels. A file that is not a JSON
+/// object whose values are all true or false fails with [`ReadModelError::Labels`].
+///
+/// Implements: rust-storage/trial-labels
+///
+/// # Errors
+///
+/// Returns [`ReadModelError::Labels`] naming the file when its text is not a
+/// JSON object of booleans.
+#[must_use = "the labels fill the read model's label columns"]
+pub fn read_trial_labels(project_root: &Path) -> Result<TrialLabels, ReadModelError> {
+    Ok(TrialLabels {
+        validator: read_labels(project_root, "validator")?,
+        traceability: read_labels(project_root, "traceability")?,
+    })
+}
+
+/// One label file's labels, or an error naming its kind.
+fn read_labels(project_root: &Path, kind: &str) -> Result<BTreeMap<String, bool>, ReadModelError> {
+    let path = project_root
+        .join("openspec")
+        .join("trials")
+        .join(format!("{kind}.json"));
+    let Ok(text) = fs::read_to_string(path) else {
+        return Ok(BTreeMap::new());
+    };
+    let malformed = || ReadModelError::Labels(kind.to_owned());
+    let value: Value = serde_json::from_str(&text).map_err(|_| malformed())?;
+    let Value::Object(entries) = value else {
+        return Err(malformed());
+    };
+    let mut labels = BTreeMap::new();
+    for (id, entry) in entries {
+        let Value::Bool(flag) = entry else {
+            return Err(malformed());
+        };
+        labels.insert(id, flag);
+    }
+    Ok(labels)
+}
+
+/// Sets the `label` columns of the three trial tables after the rows are in.
+pub(super) fn apply_labels(db_path: &Path, labels: &TrialLabels) -> Result<(), ReadModelError> {
+    let connection = Connection::open(db_path)?;
+    let mut validator = statement(&connection, "validator_findings")?;
+    let mut survivors = statement(&connection, "mutation_survivors")?;
+    let mut links = statement(&connection, "link_findings")?;
+    apply(&mut validator, &labels.validator)?;
+    apply(&mut survivors, &labels.traceability)?;
+    apply(&mut links, &labels.traceability)?;
+    Ok(())
+}
+
+/// One table's `label` update, prepared.
+fn statement<'a>(
+    connection: &'a Connection,
+    table: &str,
+) -> Result<rusqlite::Statement<'a>, rusqlite::Error> {
+    connection.prepare(&format!("UPDATE {table} SET label = ? WHERE id = ?"))
+}
+
+/// Runs one prepared update for each labelled id.
+fn apply(
+    statement: &mut rusqlite::Statement<'_>,
+    labels: &BTreeMap<String, bool>,
+) -> Result<(), rusqlite::Error> {
+    for (id, value) in labels {
+        statement.execute(params![i64::from(*value), id])?;
+    }
+    Ok(())
+}
