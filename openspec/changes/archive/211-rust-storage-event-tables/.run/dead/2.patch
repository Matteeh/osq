@@ -0,0 +1,176 @@
+//! Mapping a change snapshot to the focused and mutation stream rows.
+
+use std::collections::BTreeMap;
+
+use osq_core::{Event, Stream, TaskId};
+use serde_json::Value;
+
+use crate::read::ChangeSnapshot;
+
+use super::rows::{count_i64, entry_string, number, table_events};
+
+/// One row of the `focused_runs` table.
+pub(super) struct FocusedRunRow {
+    /// The change folder.
+    pub(super) change: String,
+    /// The stream's task id.
+    pub(super) task: String,
+    /// The event's 1-based position among the task's focused runs.
+    pub(super) run: i64,
+    /// The run's outcome.
+    pub(super) outcome: String,
+    /// The command's exit code.
+    pub(super) exit_code: i64,
+    /// The wall seconds the run took.
+    pub(super) duration: f64,
+    /// 1 when the run timed out, else 0.
+    pub(super) timed_out: i64,
+    /// The scenarios ran, joined by a newline.
+    pub(super) scenarios: String,
+    /// The files ran, joined by a newline.
+    pub(super) files: String,
+}
+
+/// One row of the `mutation_picks` table.
+pub(super) struct MutationPickRow {
+    /// The change folder.
+    pub(super) change: String,
+    /// The stream's task id.
+    pub(super) task: String,
+    /// The event's 1-based position among the task's mutation picks.
+    pub(super) pick: i64,
+    /// The file under test.
+    pub(super) file: String,
+    /// The function under test.
+    pub(super) function: String,
+    /// The run's outcome.
+    pub(super) outcome: String,
+    /// Why the pick was not measured, or null.
+    pub(super) reason: Option<String>,
+    /// Mutants killed.
+    pub(super) killed: i64,
+    /// Mutants survived.
+    pub(super) survived: i64,
+    /// Mutants invalid.
+    pub(super) invalid: i64,
+    /// The wall seconds the run took.
+    pub(super) duration: f64,
+    /// The scenarios the pick covers, joined by a newline.
+    pub(super) scenarios: String,
+}
+
+/// One row of the `mutation_survivors` table.
+pub(super) struct MutationSurvivorRow {
+    /// The positional id `<id>.<n>.m<pick>.<k>`.
+    pub(super) id: String,
+    /// The change folder.
+    pub(super) change: String,
+    /// The stream's task id.
+    pub(super) task: String,
+    /// The pick the survivor belongs to.
+    pub(super) pick: i64,
+    /// The entry's file, or null.
+    pub(super) file: Option<String>,
+    /// The pick's function.
+    pub(super) function: String,
+    /// The entry's line, or null.
+    pub(super) line: Option<f64>,
+    /// The entry's column, or null.
+    pub(super) column: Option<f64>,
+    /// The entry's mutator, or null.
+    pub(super) mutator: Option<String>,
+    /// The entry's replacement, or null.
+    pub(super) replacement: Option<String>,
+}
+
+/// Every `focused_runs` row of one snapshot, in fold order.
+pub(super) fn focused_rows(snapshot: &ChangeSnapshot) -> Vec<FocusedRunRow> {
+    let mut counts: BTreeMap<TaskId, i64> = BTreeMap::new();
+    let mut rows = Vec::new();
+    for table_event in table_events(snapshot) {
+        let (Stream::Task(task), Event::FocusedRan(data)) =
+            (&table_event.stream, &table_event.event)
+        else {
+            continue;
+        };
+        rows.push(FocusedRunRow {
+            change: snapshot.folder.clone(),
+            task: task.as_str().to_owned(),
+            run: next(&mut counts, task),
+            outcome: data.outcome.clone(),
+            exit_code: data.exit_code,
+            duration: number(&data.duration),
+            timed_out: i64::from(data.timed_out),
+            scenarios: data.scenarios.join("\n"),
+            files: data.files.join("\n"),
+        });
+    }
+    rows
+}
+
+/// Every `mutation_picks` row of one snapshot, in fold order.
+pub(super) fn pick_rows(snapshot: &ChangeSnapshot) -> Vec<MutationPickRow> {
+    let mut counts: BTreeMap<TaskId, i64> = BTreeMap::new();
+    let mut rows = Vec::new();
+    for table_event in table_events(snapshot) {
+        let (Stream::Task(task), Event::MutationRan(data)) =
+            (&table_event.stream, &table_event.event)
+        else {
+            continue;
+        };
+        rows.push(MutationPickRow {
+            change: snapshot.folder.clone(),
+            task: task.as_str().to_owned(),
+            pick: next(&mut counts, task),
+            file: data.file.clone(),
+            function: data.function.clone(),
+            outcome: data.outcome.clone(),
+            reason: data.reason.clone(),
+            killed: count_i64(data.killed),
+            survived: count_i64(data.survived),
+            invalid: count_i64(data.invalid),
+            duration: number(&data.duration),
+            scenarios: data.scenarios.join("\n"),
+        });
+    }
+    rows
+}
+
+/// Every `mutation_survivors` row of one snapshot, one per survivor entry.
+pub(super) fn survivor_rows(snapshot: &ChangeSnapshot) -> Vec<MutationSurvivorRow> {
+    let mut counts: BTreeMap<TaskId, i64> = BTreeMap::new();
+    let mut rows = Vec::new();
+    for table_event in table_events(snapshot) {
+        let (Stream::Task(task), Event::MutationRan(data)) =
+            (&table_event.stream, &table_event.event)
+        else {
+            continue;
+        };
+        let pick = next(&mut counts, task);
+        let Value::Array(entries) = &data.survivors else {
+            continue;
+        };
+        for (index, entry) in entries.iter().enumerate() {
+            rows.push(MutationSurvivorRow {
+                id: format!("{}.{}.m{}.{}", snapshot.id, task, pick, index + 1),
+                change: snapshot.folder.clone(),
+                task: task.as_str().to_owned(),
+                pick,
+                file: entry_string(entry, "file"),
+                function: data.function.clone(),
+                line: entry.get("line").and_then(Value::as_f64),
+                column: entry.get("column").and_then(Value::as_f64),
+                mutator: entry_string(entry, "mutator"),
+                replacement: entry_string(entry, "replacement"),
+            });
+        }
+    }
+    rows
+}
+
+/// The 1-based position of the next event of one task's stream.
+fn next(counts: &mut BTreeMap<TaskId, i64>, task: &TaskId) -> i64 {
+    let count = counts.entry(task.clone()).or_insert(0);
+    *count += 1;
+    *count
+}
