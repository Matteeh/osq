+//! Writing the read model's change, task, dead attempt and notice rows.
+
+use rusqlite::{Transaction, params};
+
+use crate::read::ChangeSnapshot;
+
+use super::insert_events::{
+    insert_focused, insert_pause, insert_pick, insert_recertification, insert_survivor,
+};
+use super::insert_trial::{insert_link_finding, insert_validator_finding, insert_validator_run};
+use super::notice_rows::NoticeRow;
+use super::rows::{ChangeRow, DeadRow, TaskRow, change_row, dead_rows, task_rows};
+
+/// Inserts one archived snapshot's rows into every table but `notices`.
+pub(super) fn insert_archived(
+    transaction: &Transaction<'_>,
+    snapshot: &ChangeSnapshot,
+) -> Result<(), rusqlite::Error> {
+    insert_change(transaction, &change_row(snapshot))?;
+    for row in task_rows(snapshot) {
+        insert_task(transaction, &row)?;
+    }
+    for row in dead_rows(snapshot) {
+        insert_dead(transaction, &row)?;
+    }
+    for row in super::event_rows::pause_rows(snapshot) {
+        insert_pause(transaction, &row)?;
+    }
+    for row in super::event_rows::recertification_rows(snapshot) {
+        insert_recertification(transaction, &row)?;
+    }
+    for row in super::stream_rows::focused_rows(snapshot) {
+        insert_focused(transaction, &row)?;
+    }
+    for row in super::stream_rows::pick_rows(snapshot) {
+        insert_pick(transaction, &row)?;
+    }
+    for row in super::stream_rows::survivor_rows(snapshot) {
+        insert_survivor(transaction, &row)?;
+    }
+    for row in super::trial_rows::validator_run_rows(snapshot) {
+        insert_validator_run(transaction, &row)?;
+    }
+    for row in super::trial_rows::validator_finding_rows(snapshot) {
+        insert_validator_finding(transaction, &row)?;
+    }
+    for row in super::trial_rows::link_finding_rows(snapshot) {
+        insert_link_finding(transaction, &row)?;
+    }
+    Ok(())
+}
+
+/// Inserts one `notices` row of an archived or rejected snapshot.
+pub(super) fn insert_notice(
+    transaction: &Transaction<'_>,
+    row: &NoticeRow,
+) -> Result<(), rusqlite::Error> {
+    transaction
+        .execute(
+            "INSERT INTO notices VALUES (?, ?, ?, ?, ?)",
+            params![
+                row.change,
+                row.notice,
+                row.severity,
+                row.opened,
+                row.outcome
+            ],
+        )
+        .map(|_| ())
+}
+
+/// Inserts one `changes` row.
+fn insert_change(transaction: &Transaction<'_>, row: &ChangeRow) -> Result<(), rusqlite::Error> {
+    transaction
+        .execute(
+            "INSERT INTO changes VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+            params![
+                row.id,
+                row.folder,
+                row.title,
+                row.archived_on,
+                row.goal,
+                row.tasks,
+                row.attempts,
+                row.halts,
+                row.elapsed_seconds,
+                row.cost,
+                row.planner,
+            ],
+        )
+        .map(|_| ())
+}
+
+/// Inserts one `tasks` row.
+fn insert_task(transaction: &Transaction<'_>, row: &TaskRow) -> Result<(), rusqlite::Error> {
+    transaction
+        .execute(
+            "INSERT INTO tasks VALUES (?, ?, ?, ?, ?)",
+            params![row.change, row.task, row.title, row.attempts, row.done],
+        )
+        .map(|_| ())
+}
+
+/// Inserts one `dead_attempts` row.
+fn insert_dead(transaction: &Transaction<'_>, row: &DeadRow) -> Result<(), rusqlite::Error> {
+    transaction
+        .execute(
+            "INSERT INTO dead_attempts VALUES (?, ?, ?)",
+            params![row.change, row.task, row.reason],
+        )
+        .map(|_| ())
+}
