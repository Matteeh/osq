@@ -0,0 +1,173 @@
+//! Mapping a change snapshot to the validator and link finding rows.
+
+use osq_core::Event;
+use serde_json::{Map, Value};
+
+use crate::read::ChangeSnapshot;
+
+use super::rows::{count_i64, len_i64, number, table_events};
+
+/// The string fields a validator finding must carry.
+const FINDING_FIELDS: [&str; 5] = ["capability", "requirement", "scenario", "problem", "detail"];
+
+/// One row of the `validator_runs` table.
+pub(super) struct ValidatorRunRow {
+    /// The change folder.
+    pub(super) change: String,
+    /// The event's 1-based position among the change's validator runs.
+    pub(super) run: i64,
+    /// The validator outcome.
+    pub(super) outcome: String,
+    /// The validator harness.
+    pub(super) harness: String,
+    /// The validator model.
+    pub(super) model: String,
+    /// The wall seconds the run took.
+    pub(super) duration: f64,
+    /// The run's exit code, or null.
+    pub(super) exit_code: Option<i64>,
+    /// How many scenarios were judged.
+    pub(super) scenarios: i64,
+    /// The number of valid findings.
+    pub(super) findings: i64,
+    /// Why the validator did not run, or null.
+    pub(super) reason: Option<String>,
+    /// The run's output, or null.
+    pub(super) output: Option<String>,
+}
+
+/// One row of the `validator_findings` table.
+pub(super) struct ValidatorFindingRow {
+    /// The positional id `<id>.v<run>.<k>`.
+    pub(super) id: String,
+    /// The change folder.
+    pub(super) change: String,
+    /// The validator run the finding belongs to.
+    pub(super) run: i64,
+    /// The finding's 1-based position among the valid findings.
+    pub(super) finding: i64,
+    /// The finding's capability.
+    pub(super) capability: String,
+    /// The finding's requirement.
+    pub(super) requirement: String,
+    /// The finding's scenario.
+    pub(super) scenario: String,
+    /// The finding's problem.
+    pub(super) problem: String,
+    /// The finding's detail.
+    pub(super) detail: String,
+}
+
+/// One row of the `link_findings` table.
+pub(super) struct LinkFindingRow {
+    /// The positional id `<id>.l<k>`.
+    pub(super) id: String,
+    /// The change folder.
+    pub(super) change: String,
+    /// The finding's severity.
+    pub(super) severity: String,
+    /// The file the finding names.
+    pub(super) file: String,
+    /// The finding's message.
+    pub(super) message: String,
+}
+
+/// Every `validator_runs` row of one snapshot, in fold order.
+pub(super) fn validator_run_rows(snapshot: &ChangeSnapshot) -> Vec<ValidatorRunRow> {
+    let mut rows = Vec::new();
+    let mut run = 0;
+    for table_event in table_events(snapshot) {
+        let Event::ValidatorRan(data) = &table_event.event else {
+            continue;
+        };
+        run += 1;
+        rows.push(ValidatorRunRow {
+            change: snapshot.folder.clone(),
+            run,
+            outcome: data.outcome.clone(),
+            harness: data.harness.clone(),
+            model: data.model.clone(),
+            duration: number(&data.duration),
+            exit_code: data.exit_code.0,
+            scenarios: count_i64(data.scenarios),
+            findings: len_i64(valid_findings(&data.findings).len()),
+            reason: data.reason.clone(),
+            output: data.output.clone(),
+        });
+    }
+    rows
+}
+
+/// Every `validator_findings` row of one snapshot, one per valid finding.
+pub(super) fn validator_finding_rows(snapshot: &ChangeSnapshot) -> Vec<ValidatorFindingRow> {
+    let mut rows = Vec::new();
+    let mut run = 0;
+    for table_event in table_events(snapshot) {
+        let Event::ValidatorRan(data) = &table_event.event else {
+            continue;
+        };
+        run += 1;
+        for (index, finding) in valid_findings(&data.findings).iter().enumerate() {
+            let position = index + 1;
+            rows.push(ValidatorFindingRow {
+                id: format!("{}.v{}.{}", snapshot.id, run, position),
+                change: snapshot.folder.clone(),
+                run,
+                finding: len_i64(position),
+                capability: field(finding, "capability"),
+                requirement: field(finding, "requirement"),
+                scenario: field(finding, "scenario"),
+                problem: field(finding, "problem"),
+                detail: field(finding, "detail"),
+            });
+        }
+    }
+    rows
+}
+
+/// Every `link_findings` row of one snapshot, from its last plan record.
+pub(super) fn link_finding_rows(snapshot: &ChangeSnapshot) -> Vec<LinkFindingRow> {
+    let Some(record) = snapshot.plan_records.last() else {
+        return Vec::new();
+    };
+    let Some(entries) = &record.traceability else {
+        return Vec::new();
+    };
+    entries
+        .iter()
+        .enumerate()
+        .map(|(index, entry)| LinkFindingRow {
+            id: format!("{}.l{}", snapshot.id, index + 1),
+            change: snapshot.folder.clone(),
+            severity: entry.severity.clone(),
+            file: entry.file.clone(),
+            message: entry.message.clone(),
+        })
+        .collect()
+}
+
+/// The valid findings of a `findings` value: objects with all five strings.
+fn valid_findings(findings: &Value) -> Vec<&Map<String, Value>> {
+    let Value::Array(entries) = findings else {
+        return Vec::new();
+    };
+    entries.iter().filter_map(valid_finding).collect()
+}
+
+/// One finding entry when it is an object with all five string fields.
+fn valid_finding(entry: &Value) -> Option<&Map<String, Value>> {
+    let object = entry.as_object()?;
+    let complete = FINDING_FIELDS
+        .iter()
+        .all(|field| object.get(*field).is_some_and(Value::is_string));
+    complete.then_some(object)
+}
+
+/// One finding's string field, empty text when it is not a string.
+fn field(finding: &Map<String, Value>, key: &str) -> String {
+    finding
+        .get(key)
+        .and_then(Value::as_str)
+        .unwrap_or("")
+        .to_owned()
+}
