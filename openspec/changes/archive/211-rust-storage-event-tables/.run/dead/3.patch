-+//! Replays this repository's live archive into the nine event tables and
-+//! compares every row with TypeScript's `osq query --json`.
-+//!
-+//! The test is a corpus test (rust-core "Corpus tests"): it reads the archive
-+//! outside this crate, so it carries the corpus ignore, runs under
-+//! `scripts/verify-rust.sh --include-ignored`, and cargo-mutants leaves it
-+//! out. `tests/read_model_history.rs` and the history fixture are its fast
-+//! counterpart.
-+
-+use std::path::{Path, PathBuf};
-+
-+use osq_kernel_storage::build_read_model;
-+use rusqlite::Connection;
-+use rusqlite::types::Value;
-+use serde_json::Value as Json;
-+
-+/// The lowest change number the golden rows cover.
-+const FIRST_GOLDEN: u32 = 14;
-+
-+/// The highest change number the golden rows cover.
-+const LAST_GOLDEN: u32 = 209;
-+
-+/// Each event table's name and its columns, in table order, space separated.
-+const TABLES: [(&str, &str); 9] = [
-+    ("pauses", "change task paused_at until source"),
-+    (
-+        "recertifications",
-+        "change task recertified_at outcome automatic path credited_to source",
-+    ),
-+    ("notices", "change notice severity opened outcome"),
-+    (
-+        "focused_runs",
-+        "change task run outcome exit_code duration timed_out scenarios files",
-+    ),
-+    (
-+        "mutation_picks",
-+        "change task pick file function outcome reason killed survived invalid duration scenarios",
-+    ),
-+    (
-+        "mutation_survivors",
-+        "id change task pick file function line column mutator replacement label",
-+    ),
-+    (
-+        "validator_runs",
-+        "change run outcome harness model duration exit_code scenarios findings reason output",
-+    ),
-+    (
-+        "validator_findings",
-+        "id change run finding capability requirement scenario problem detail label",
-+    ),
-+    ("link_findings", "id change severity file message label"),
-+];
-+
-+/// The repository root, three folders above the storage manifest.
-+fn repository_root() -> PathBuf {
-+    Path::new(env!("CARGO_MANIFEST_DIR"))
-+        .ancestors()
-+        .nth(3)
-+        .expect("the repository root is three folders above crates/kernel/storage")
-+        .to_path_buf()
-+}
-+
-+/// Proves every event table row of 014 to 209 equals TypeScript's.
-+///
-+/// Covers: rust-storage/golden-event-table-rows
-+#[ignore = "corpus test: reads the live archive"]
-+#[test]
-+fn golden_event_table_rows() {
-+    let path = Path::new(env!("CARGO_TARGET_TMPDIR")).join("history_golden.sqlite");
-+    build_read_model(&repository_root(), &path).expect("the read model builds");
-+    let connection = Connection::open(&path).expect("the read model opens");
-+    let mut failures = Vec::new();
-+    for (table, spec) in TABLES {
-+        let columns: Vec<&str> = spec.split(' ').collect();
-+        let actual = table_rows(&connection, table, &columns);
-+        compare_rows(table, &columns, &read_golden(table), &actual, &mut failures);
-+    }
-+    assert!(failures.is_empty(), "{}", failures.join("\n"));
-+}
-+
-+/// Reads a table's covered rows as typed values, in insertion order.
-+fn table_rows(connection: &Connection, table: &str, columns: &[&str]) -> Vec<Vec<Value>> {
-+    let select = format!("SELECT {} FROM {table} ORDER BY rowid", columns.join(", "));
-+    let mut statement = connection.prepare(&select).expect("the table selects");
-+    let width = columns.len();
-+    let mapped = statement
-+        .query_map([], |row| {
-+            (0..width)
-+                .map(|index| row.get::<_, Value>(index))
-+                .collect::<rusqlite::Result<Vec<Value>>>()
-+        })
-+        .expect("the rows read");
-+    let index = columns
-+        .iter()
-+        .position(|column| *column == "change")
-+        .expect("every event table has a change column");
-+    mapped
-+        .map(Result::unwrap)
-+        .filter(|row| covered(&row[index]))
-+        .collect()
-+}
-+
-+/// Whether a folder's leading digits are 014 to 209.
-+fn covered(change: &Value) -> bool {
-+    let Value::Text(folder) = change else {
-+        return false;
-+    };
-+    let digits: String = folder.chars().take_while(char::is_ascii_digit).collect();
-+    digits
-+        .parse()
-+        .is_ok_and(|number: u32| (FIRST_GOLDEN..=LAST_GOLDEN).contains(&number))
-+}
-+
-+/// Compares one table's rows, recording the table, row, column and both values.
-+fn compare_rows(
-+    table: &str,
-+    columns: &[&str],
-+    expected: &[Json],
-+    actual: &[Vec<Value>],
-+    failures: &mut Vec<String>,
-+) {
-+    if expected.len() != actual.len() {
-+        failures.push(format!(
-+            "{table}: golden holds {} rows, the read model {}",
-+            expected.len(),
-+            actual.len()
-+        ));
-+    }
-+    let change = columns
-+        .iter()
-+        .position(|name| *name == "change")
-+        .expect("every event table has a change column");
-+    for (index, row) in actual.iter().enumerate() {
-+        let Some(golden) = expected.get(index).and_then(Json::as_object) else {
-+            continue;
-+        };
-+        let context = format!("{table} change {}", text_of(row.get(change)));
-+        for (position, value) in row.iter().enumerate() {
-+            let Some(name) = columns.get(position) else {
-+                continue;
-+            };
-+            let Some(want) = golden.get(*name) else {
-+                continue;
-+            };
-+            if !equal(value, want) {
-+                failures.push(format!(
-+                    "{context} column {name}: read {value:?}, golden {want:?}"
-+                ));
-+            }
-+        }
-+    }
-+}
-+
-+/// A column's text, or its debug form for anything else.
-+fn text_of(value: Option<&Value>) -> String {
-+    match value {
-+        Some(Value::Text(text)) => text.clone(),
-+        other => format!("{other:?}"),
-+    }
-+}
-+
-+/// Whether a read column equals a golden column: text and null as written,
-+/// numbers equal by value as `f64`.
-+fn equal(value: &Value, golden: &Json) -> bool {
-+    match (value, golden) {
-+        (Value::Null, Json::Null) => true,
-+        (Value::Text(left), Json::String(right)) => left == right,
-+        _ => number_of(value) == golden.as_f64(),
-+    }
