+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { afterEach, beforeEach, describe, it } from 'node:test';
+import { CommandError } from '../src/cli/command-error.js';
+import { planCommand } from '../src/cli/plan.js';
+import { createForwardedCommands } from '../src/cli/remote-commands.js';
+import { DEFAULT_CONFIG } from '../src/core/foundation/config.js';
+import { parseFrontmatter } from '../src/core/spec/parser.js';
+import { projectQueue } from '../src/core/status/queue.js';
+
+const OPENSPEC = 'openspec';
+const QUEUE_PATH = 'openspec/queue.md';
+
+interface ItemSpec {
+  slug: string;
+  title: string;
+  depends?: string;
+}
+
+function queueContent(items: ItemSpec[]): string {
+  return items
+    .map((item) =>
+      [
+        `## [${item.slug}] ${item.title}`,
+        `Depends on: ${item.depends ?? 'nothing'}`,
+        '',
+        `Brief body for ${item.slug}.`,
+        '',
+      ].join('\n'),
+    )
+    .join('\n');
+}
+
+function sectionHash(content: string, slug: string): string {
+  const marker = `## [${slug}] `;
+  const start = content.indexOf(marker);
+  assert.ok(start >= 0, `missing queue marker for ${slug}`);
+  const next = content.indexOf('## [', start + marker.length);
+  const raw = content.slice(start, next === -1 ? content.length : next);
+  return `sha256:${createHash('sha256').update(raw, 'utf8').digest('hex')}`;
+}
+
+function proposalMd(title: string): string {
+  return [
+    '---',
+    `title: ${title}`,
+    'depends_on: []',
+    'verify: node -e "process.exit(0)"',
+    'features:',
+    '  reads: []',
+    '---',
+    '## Goal',
+    `${title} goal.`,
+    '',
+  ].join('\n');
+}
+
+function taskMd(): string {
+  return [
+    '---',
+    'title: Task 1',
+    'verify: node -e "process.exit(0)"',
+    'scope: []',
+    'entry: []',
+    'skills: []',
+    '---',
+    '## Acceptance',
+    '- [ ] done',
+    '',
+  ].join('\n');
+}
+
+async function writeAt(root: string, rel: string, content: string): Promise<void> {
+  const target = path.join(root, rel);
+  await fs.mkdir(path.dirname(target), { recursive: true });
+  await fs.writeFile(target, content, 'utf8');
+}
+
+async function writeQueue(root: string, content: string): Promise<void> {
+  await writeAt(root, QUEUE_PATH, content);
+}
+
+async function createActiveChange(root: string, folderName: string, slug: string): Promise<void> {
+  const base = path.join(root, OPENSPEC, 'changes', folderName);
+  await fs.mkdir(path.join(base, 'tasks'), { recursive: true });
+  await fs.writeFile(path.join(base, 'proposal.md'), proposalMd(folderName), 'utf8');
+  await fs.writeFile(path.join(base, 'tasks', '1.md'), taskMd(), 'utf8');
+  await fs.writeFile(
+    path.join(base, 'brief.md'),
+    ['---', `queue_item: ${slug}`, '---', `Brief body for ${slug}.`, ''].join('\n'),
+    'utf8',
+  );
+}
+
+async function activeFolders(root: string): Promise<string[]> {
+  const activeRoot = path.join(root, OPENSPEC, 'changes');
+  const entries = await fs.readdir(activeRoot, { withFileTypes: true }).catch(() => []);
+  return entries
+    .filter((entry) => entry.isDirectory() && entry.name !== 'archive' && entry.name !== 'rejected')
+    .map((entry) => entry.name)
+    .sort();
+}
+
+let tmpDir: string;
+
+beforeEach(async () => {
+  tmpDir = await fs.mkdtemp(path.join(os.tmpdir(), 'osq-queue-plan-slug-'));
+});
+
+afterEach(async () => {
+  await fs.rm(tmpDir, { recursive: true, force: true });
+});
+
+describe('named queue item', () => {
+  it('plans the item the slug names and leaves earlier items unplanned', async () => {
+    const content = queueContent([
+      { slug: 'first', title: 'First' },
+      { slug: 'second', title: 'Second' },
+    ]);
+    await writeQueue(tmpDir, content);
+    let stdout = '';
+
+    await planCommand(undefined, {
+      next: 'second',
+      print: true,
+      cwd: tmpDir,
+      stdout: (text) => {
+        stdout += text;
+      },
+    });
+
+    assert.deepEqual(await activeFolders(tmpDir), ['001-second']);
+    const folder = path.join(tmpDir, OPENSPEC, 'changes', '001-second');
+    const brief = parseFrontmatter(await fs.readFile(path.join(folder, 'brief.md'), 'utf8'));
+    assert.equal(brief.data.queue_item, 'second');
+    assert.equal(brief.data.queue_hash, sectionHash(content, 'second'));
+
+    assert.match(stdout, /# Change: 001 - Second/);
+    assert.ok(stdout.includes('Brief body for second.'), 'prompt carries the named brief');
+    assert.ok(!stdout.includes('Brief body for first.'), 'prompt must not carry another brief');
+    assert.ok(!stdout.includes('queue.md'), 'prompt must not embed the queue file');
+
+    const projection = await projectQueue(tmpDir, DEFAULT_CONFIG);
+    assert.equal(projection.items.find((item) => item.slug === 'first')?.state, 'unplanned');
+    assert.equal(projection.items.find((item) => item.slug === 'second')?.state, 'planned');
+  });
+
+  it('plans a named item whose dependencies landed', async () => {
+    const content = queueContent([
+      { slug: 'first', title: 'First' },
+      { slug: 'second', title: 'Second', depends: 'first' },
+      { slug: 'third', title: 'Third', depends: 'second' },
+    ]);
+    await writeQueue(tmpDir, content);
+    await writeAt(
+      tmpDir,
+      'openspec/changes/archive/020-first/brief.md',
+      ['---', 'queue_item: first', '---', 'Brief body for first.', ''].join('\n'),
+    );
+    await writeAt(
+      tmpDir,
+      'openspec/changes/archive/021-second/brief.md',
+      ['---', 'queue_item: second', '---', 'Brief body for second.', ''].join('\n'),
+    );
+    let stdout = '';
+
+    await planCommand(undefined, {
+      next: 'third',
+      print: true,
+      cwd: tmpDir,
+      stdout: (text) => {
+        stdout += text;
+      },
+    });
+
+    assert.deepEqual(await activeFolders(tmpDir), ['022-third']);
+    const folder = path.join(tmpDir, OPENSPEC, 'changes', '022-third');
+    const proposal = await fs.readFile(path.join(folder, 'proposal.md'), 'utf8');
+    assert.match(proposal, /^depends_on: \["021"\]$/m);
+    assert.ok(
+      stdout.includes('Landed dependencies:\n- openspec/changes/archive/021-second'),
+      'prompt carries the landed dependency archive path',
+    );
+  });
+});
+
+describe('named queue item refused', () => {
+  const rows = [
+    {
+      name: 'a missing slug',
+      slug: 'missing',
+      text: 'Queue item "missing" is not in the queue.',
+      setup: async () => writeQueue(tmpDir, queueContent([{ slug: 'first', title: 'First' }])),
+    },
+    {
+      name: 'an item that already has a change',
+      slug: 'first',
+      text: 'Queue item "first" already has change 001 (planned).',
+      setup: async () => {
+        await writeQueue(tmpDir, queueContent([{ slug: 'first', title: 'First' }]));
+        await createActiveChange(tmpDir, '001-first', 'first');
+      },
+    },
+    {
+      name: 'an item waiting on a dependency',
+      slug: 'second',
+      text: 'Queue item "second" is waiting on first.',
+      setup: async () =>
+        writeQueue(
+          tmpDir,
+          queueContent([
+            { slug: 'first', title: 'First' },
+            { slug: 'second', title: 'Second', depends: 'first' },
+          ]),
+        ),
+    },
+  ];
+
+  for (const row of rows) {
+    it(`refuses ${row.name} and creates no change folder`, async () => {
+      await row.setup();
+      const before = await activeFolders(tmpDir);
+
+      await assert.rejects(
+        () =>
+          planCommand(undefined, {
+            next: row.slug,
+            print: true,
+            cwd: tmpDir,
+          }),
+        (error: unknown) =>
+          error instanceof CommandError &&
+          error.name === 'CommandError' &&
+          error.exitCode === 1 &&
+          error.message === row.text,
+      );
+
+      assert.deepEqual(await activeFolders(tmpDir), before);
+    });
+  }
+});
+
+describe('next mode guards', () => {
+  it('keeps --run refusing --next with and without a slug', async () => {
+    await assert.rejects(
+      () => planCommand(undefined, { next: true, run: true, cwd: tmpDir }),
+      /--run.*--next/,
+    );
+    await assert.rejects(
+      () => planCommand(undefined, { next: 'second', run: true, cwd: tmpDir }),
+      /--run.*--next/,
+    );
+    assert.deepEqual(await activeFolders(tmpDir), []);
+  });
+
+  it('treats a forwarded slug as next mode instead of demanding a brief', async () => {
+    const content = queueContent([
+      { slug: 'first', title: 'First' },
+      { slug: 'second', title: 'Second' },
+    ]);
+    await writeQueue(tmpDir, content);
+    const handler = createForwardedCommands().plan;
+    assert.ok(handler, 'the server forwards plan');
+
+    await handler(
+      { command: 'plan', args: [], options: { next: 'second', print: true } },
+      () => {},
+      { cwd: tmpDir },
+    );
+
+    assert.deepEqual(await activeFolders(tmpDir), ['001-second']);
+  });
+});
