@@ -0,0 +1,71 @@
+import type { QueueItem } from './queue-parser.js';
+import type { QueueRow, QueueStateSnapshot } from './queue-state.js';
+
+/** The queue item and projected row chosen for planning. */
+export interface QueueRowChoice {
+  readonly item: QueueItem;
+  readonly row: QueueRow;
+}
+
+/** The row choice: one picked row, or the refusal that explains why none fits. */
+export type QueueRowPick =
+  | { readonly kind: 'picked'; readonly choice: QueueRowChoice }
+  | { readonly kind: 'refused'; readonly message: string };
+
+/** Render every row for the message that explains why nothing is eligible. */
+function summarizeRows(rows: readonly QueueRow[]): string {
+  return rows
+    .map((row) => {
+      const waiting =
+        row.unmetDependencies.length > 0 ? ` (waiting on ${row.unmetDependencies.join(', ')})` : '';
+      return `  - ${row.slug}: ${row.state}${waiting}`;
+    })
+    .join('\n');
+}
+
+/** The named row's refusal in not-in-queue, already-has-change, waiting order. */
+function namedRefusal(state: QueueStateSnapshot, slug: string): string | null {
+  const index = state.rows.findIndex((row) => row.slug === slug);
+  if (index === -1) return `Queue item "${slug}" is not in the queue.`;
+  const row = state.rows[index];
+  if (row.state !== 'unplanned' && row.state !== 'rejected') {
+    return `Queue item "${slug}" already has change ${row.changeId} (${row.state}).`;
+  }
+  if (row.unmetDependencies.length > 0) {
+    return `Queue item "${slug}" is waiting on ${row.unmetDependencies.join(', ')}.`;
+  }
+  return null;
+}
+
+/**
+ * Choose the queue row to plan: the first eligible row, or the row a slug names
+ * after the named-row refusals. Read only; the caller decides replan and spend.
+ * @scenario cli-foundation: Named queue item
+ * @scenario cli-foundation: Named queue item refused
+ */
+export function pickQueueRow(state: QueueStateSnapshot, slug?: string): QueueRowPick {
+  if (slug === undefined) {
+    const index = state.rows.findIndex(
+      (row) =>
+        (row.state === 'unplanned' || row.state === 'rejected') &&
+        row.unmetDependencies.length === 0,
+    );
+    if (index === -1) {
+      return {
+        kind: 'refused',
+        message: `No queue item is eligible to plan.\n${summarizeRows(state.rows)}`,
+      };
+    }
+    return {
+      kind: 'picked',
+      choice: { item: state.items[index], row: state.rows[index] },
+    };
+  }
+  const message = namedRefusal(state, slug);
+  if (message !== null) return { kind: 'refused', message };
+  const index = state.rows.findIndex((row) => row.slug === slug);
+  return {
+    kind: 'picked',
+    choice: { item: state.items[index], row: state.rows[index] },
+  };
+}
