---+//! Reading the change folders one `report` counts, across git trees when on.
---+
---+use std::path::{Path, PathBuf};
---+
---+use osq_core::FeatureError;
---+use osq_kernel_config::{VcsConfig, load_config};
---+use osq_kernel_storage::{
---+    ChangeEntry, TreeCandidate, change_trees, list_changes, list_tree_changes,
---+};
---+use osq_kernel_vcs::{GitVcs, Vcs, Worktree, stacked_root};
---+
---+/// Reads every active and archived change the root's config and git state name.
---+///
---+/// # Errors
---+///
---+/// Returns [`FeatureError::failed`] for a refused `osq.toml` and for a failing
---+/// git worktree listing.
---+///
---+/// Implements: rust-report/report-changes
---+pub(crate) fn read(root: &Path) -> Result<Vec<ChangeEntry>, FeatureError> {
---+    let config = load_config(root).map_err(|error| failed(error.to_string()))?;
---+    let vcs = GitVcs::new(root).with_timeouts(&config.timeouts);
---+    let repo_root = git_root(&vcs, root);
---+    match (repo_root, config.vcs.enabled) {
---+        (Some(repo_root), true) => across_trees(root, &config.vcs, &vcs, &repo_root),
---+        _ => Ok(list_changes(root)),
---+    }
---+}
---+
---+/// The repository root when git is on, as rust-show "Show git state" decides.
---+///
---+/// Implements: rust-report/report-changes
---+fn git_root(vcs: &GitVcs, root: &Path) -> Option<PathBuf> {
---+    let repo_root = vcs.root().ok().flatten()?;
---+    (real(root) == real(&repo_root)).then(|| real(&repo_root))
---+}
---+
---+/// The changes across the root, its git worktrees and its stacked folders.
---+///
---+/// Implements: rust-report/report-changes
---+fn across_trees(
---+    root: &Path,
---+    config: &VcsConfig,
---+    vcs: &GitVcs,
---+    repo_root: &Path,
---+) -> Result<Vec<ChangeEntry>, FeatureError> {
---+    let worktrees = vcs
---+        .worktree_list()
---+        .map_err(|error| failed(error.to_string()))?;
---+    let candidates: Vec<TreeCandidate> = worktrees.iter().map(candidate).collect();
---+    let stacked = stacked_folders(repo_root, config);
---+    Ok(list_tree_changes(&change_trees(
---+        root,
---+        &candidates,
---+        &stacked,
---+    )))
---+}
---+
---+/// Turns one git worktree into a tree candidate.
---+///
---+/// Implements: rust-report/report-changes
---+fn candidate(worktree: &Worktree) -> TreeCandidate {
---+    TreeCandidate {
---+        path: PathBuf::from(&worktree.path),
---+        branch: worktree.branch.clone(),
---+    }
---+}
---+
---+/// The folders directly under the stacked approvals root.
---+///
---+/// Implements: rust-report/report-changes
---+fn stacked_folders(repo_root: &Path, config: &VcsConfig) -> Vec<PathBuf> {
---+    let Some(home) = std::env::var_os("HOME") else {
---+        return Vec::new();
---+    };
---+    let stacked = stacked_root(config, repo_root, Path::new(&home));
---+    let Ok(entries) = std::fs::read_dir(&stacked) else {
---+        return Vec::new();
---+    };
---+    entries
---+        .flatten()
---+        .filter(|entry| entry.file_type().is_ok_and(|kind| kind.is_dir()))
---+        .map(|entry| entry.path())
---+        .collect()
---+}
---+
---+/// Resolves a path's symlinks, falling back to the path as given.
---+fn real(path: &Path) -> PathBuf {
---+    std::fs::canonicalize(path).unwrap_or_else(|_| path.to_path_buf())
---+}
---+
---+/// Builds the failed error for a report read.
---+fn failed(message: impl Into<String>) -> FeatureError {
---+    FeatureError::failed("report", message)
---+}
