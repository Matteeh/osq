----+//! Running TypeScript's report summary for one project root.
----+
----+mod counts;
----+mod entries;
----+mod output;
----+
----+use std::path::Path;
----+
----+use osq_core::{FeatureError, Output};
----+
----+/// Runs `report` over `root`, as its text or as its JSON members.
----+///
----+/// # Errors
----+///
----+/// Returns [`FeatureError::usage`] for an argument other than `--json`, and
----+/// [`FeatureError::failed`] for a refused config or a failing git read.
----+///
----+/// Implements: rust-report/report-arguments
----+/// Implements: rust-report/report-changes
----+/// Implements: rust-report/report-summary
----+pub(super) fn run(root: &Path, args: &[String]) -> Result<Output, FeatureError> {
----+    let json = arguments(args)?;
----+    let report = counts::build(&entries::list(root)?);
----+    let text = if json {
----+        output::json(&report)
----+    } else {
----+        output::text(&report)
----+    };
----+    Ok(Output::text(text))
----+}
----+
----+/// Reads the output mode from the arguments, refusing the first other one.
----+///
----+/// Implements: rust-report/report-arguments
----+fn arguments(args: &[String]) -> Result<bool, FeatureError> {
----+    let mut json = false;
----+    for argument in args {
----+        if argument == "--json" {
----+            json = true;
----+        } else {
----+            return Err(FeatureError::usage(
----+                "report",
----+                format!("expected [--json], got {argument}"),
----+            ));
----+        }
----+    }
----+    Ok(json)
----+}
