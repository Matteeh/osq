---+//! Writing the report's text and JSON exactly as TypeScript writes them.
---+
---+use super::counts::Counts;
---+
---+/// Formats TypeScript's text from the header through its completion rate.
---+///
---+/// Implements: rust-report/report-summary
---+pub(crate) fn text(report: &Counts) -> String {
---+    let specs = report.specs;
---+    let now = report.now;
---+    [
---+        "osq Delivery Metrics Report".to_owned(),
---+        String::new(),
---+        "Specs Summary:".to_owned(),
---+        format!(
---+            "  Total specs: {} ({} active, {} archived)",
---+            specs.total, specs.active, specs.archived
---+        ),
---+        String::new(),
---+        "Now:".to_owned(),
---+        format!("  Total tasks: {}", now.total),
---+        format!("  Done: {}", now.done),
---+        format!("  Verified done: {}", now.verified),
---+        format!("  Manual done: {}", now.manual),
---+        format!("  Dead: {}", now.dead),
---+        format!("  Regressed: {}", now.regressed),
---+        format!("  Running: {}", now.running),
---+        format!("  Pending: {}", now.pending),
---+        format!("  Unmarked: {}", now.unmarked),
---+        format!("  Completion rate: {}%", report.rate),
---+    ]
---+    .join("\n")
---+}
---+
---+/// Formats the `completionRate`, `now` and `specs` members as sorted JSON.
---+///
---+/// Implements: rust-report/report-summary
---+pub(crate) fn json(report: &Counts) -> String {
---+    let specs = report.specs;
---+    let now = report.now;
---+    format!(
---+        concat!(
---+            "{{\n",
---+            "  \"completionRate\": {},\n",
---+            "  \"now\": {{\n",
---+            "    \"dead\": {},\n",
---+            "    \"done\": {},\n",
---+            "    \"manual\": {},\n",
---+            "    \"pending\": {},\n",
---+            "    \"regressed\": {},\n",
---+            "    \"running\": {},\n",
---+            "    \"total\": {},\n",
---+            "    \"unmarked\": {},\n",
---+            "    \"verified\": {}\n",
---+            "  }},\n",
---+            "  \"specs\": {{\n",
---+            "    \"active\": {},\n",
---+            "    \"archived\": {},\n",
---+            "    \"total\": {}\n",
---+            "  }}\n",
---+            "}}"
---+        ),
---+        report.rate,
---+        now.dead,
---+        now.done,
---+        now.manual,
---+        now.pending,
---+        now.regressed,
---+        now.running,
---+        now.total,
---+        now.unmarked,
---+        now.verified,
---+        specs.active,
