-+//! Proves the report summary, its status order and its reads' failures.
-+
-+use std::fs;
-+use std::path::{Path, PathBuf};
-+
-+use osq_core::{Feature, FeatureError, Invocation};
-+use osq_feature_report::ReportFeature;
-+use osq_kernel_config::load_config;
-+
-+/// One golden case: its project, or none for an empty root, and its locks.
-+struct Case {
-+    /// The golden file's name without its extension.
-+    name: &'static str,
-+    /// The fixture project to copy, or none for a new empty folder.
-+    project: Option<&'static str>,
-+    /// The lock files written into `003-running/.run/running/`.
-+    locks: &'static [(&'static str, &'static str)],
-+}
-+
-+/// The five golden cases `print-goldens.mjs` writes.
-+fn cases() -> [Case; 5] {
-+    [
-+        Case {
-+            name: "empty",
-+            project: None,
-+            locks: &[],
-+        },
-+        Case {
-+            name: "report-project",
-+            project: Some("report-project"),
-+            locks: &[],
-+        },
-+        Case {
-+            name: "report-project-running",
-+            project: Some("report-project"),
-+            locks: &[
-+                ("7.pid", "not json\n"),
-+                ("8.pid", "{\"pid\":1,\"startedAt\":1}\n"),
-+            ],
-+        },
-+        Case {
-+            name: "all-done",
-+            project: Some("all-done"),
-+            locks: &[],
-+        },
-+        Case {
-+            name: "thirds",
-+            project: Some("thirds"),
-+            locks: &[],
-+        },
-+    ]
-+}
-+
-+/// Proves every text and JSON golden byte for byte, and repeated `--json`.
-+///
-+/// Covers: rust-report/report-summary-equals-typescript-s
-+#[test]
-+fn report_summary_equals_typescript() {
-+    for case in cases() {
-+        let root = match case.project {
-+            Some(project) => fixture_copy(&format!("report-summary-{}", case.name), project),
-+            None => scratch(&format!("report-summary-{}", case.name)),
-+        };
-+        for (name, text) in case.locks {
-+            write(
-+                &root
-+                    .join("openspec/changes/003-running/.run/running")
-+                    .join(name),
-+                text,
-+            );
-+        }
-+        let text = run(&root, &[]).expect("report succeeds").text;
-+        let expected = read(&golden(&format!("{}.txt", case.name)));
-+        assert_eq!(text, expected, "{} text", case.name);
-+        let json = run(&root, &["--json"]).expect("JSON report succeeds").text;
-+        let expected = read(&golden(&format!("{}.json", case.name)));
-+        assert_eq!(json, expected, "{} JSON", case.name);
-+        if case.name == "report-project" {
-+            let repeated = run(&root, &["--json", "--json"])
-+                .expect("repeated JSON report succeeds")
-+                .text;
-+            assert_eq!(repeated, json, "repeated --json is the same JSON");
-+        }
-+    }
-+}
-+
-+/// Proves every status row's counts and completion rate.
-+///
-+/// Covers: rust-report/status-order
-+#[test]
-+fn report_status_order() {
-+    let proposals = [
-+        ("proposal", Some("proposal.md"), (5, 1, 1, 1, 1, 1, 1, "20")),
-+        ("spec", Some("spec.md"), (5, 1, 1, 1, 1, 1, 1, "20")),
-+        ("none", None, (5, 0, 0, 0, 0, 0, 5, "0")),
-+    ];
-+    for (label, proposal, counts) in proposals {
-+        let root = scratch(&format!("report-summary-status-{label}"));
-+        let folder = root.join("openspec/changes/001-a");
-+        if let Some(proposal) = proposal {
-+            write(&folder.join(proposal), "# a\n");
-+        }
-+        for number in 1..=5 {
-+            write(&folder.join(format!("tasks/{number}.md")), "# task\n");
-+        }
-+        write(&folder.join(".run/regressed/1.md"), "x\n");
-+        write(&folder.join(".run/done/1"), "x\n");
-+        write(&folder.join(".run/done/2"), "x\n");
-+        write(&folder.join(".run/dead/1.md"), "x\n");
-+        write(&folder.join(".run/dead/2.md"), "x\n");
-+        write(&folder.join(".run/dead/3.md"), "x\n");
-+        for number in 1..=4 {
-+            write(&folder.join(format!(".run/running/{number}.pid")), "x\n");
-+        }
-+        let text = run(&root, &[]).expect("report succeeds").text;
-+        let (total, done, verified, dead, regressed, running, pending, rate) = counts;
-+        assert_count(&text, "Total tasks", total);
-+        assert_count(&text, "Done", done);
-+        assert_count(&text, "Verified done", verified);
-+        assert_count(&text, "Manual done", 0);
-+        assert_count(&text, "Dead", dead);
-+        assert_count(&text, "Regressed", regressed);
-+        assert_count(&text, "Running", running);
-+        assert_count(&text, "Pending", pending);
-+        assert_count(&text, "Unmarked", 0);
-+        assert_eq!(
-+            line(&text, "  Completion rate: "),
-+            format!("  Completion rate: {rate}%"),
-+            "{label}"
-+        );
-+    }
-+}
