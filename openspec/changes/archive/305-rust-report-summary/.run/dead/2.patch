-----+//! Counting the spec and current-task metrics TypeScript's report prints.
-----+
-----+use osq_kernel_storage::{ChangeEntry, Location, NowFacts, NowTask, read_now_facts};
-----+
-----+/// The `Specs Summary:` counts.
-----+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
-----+pub(crate) struct Specs {
-----+    /// Every active or archived change.
-----+    pub(crate) total: u32,
-----+    /// The changes directly under `changes/`.
-----+    pub(crate) active: u32,
-----+    /// The changes under `changes/archive/`.
-----+    pub(crate) archived: u32,
-----+}
-----+
-----+/// The `Now:` counts.
-----+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
-----+pub(crate) struct Now {
-----+    /// Every task of every counted change.
-----+    pub(crate) total: u32,
-----+    /// The tasks whose status is done.
-----+    pub(crate) done: u32,
-----+    /// The done tasks with no manual marker.
-----+    pub(crate) verified: u32,
-----+    /// The done tasks whose marker says `manual: true`.
-----+    pub(crate) manual: u32,
-----+    /// The tasks whose status is dead.
-----+    pub(crate) dead: u32,
-----+    /// The tasks whose status is regressed.
-----+    pub(crate) regressed: u32,
-----+    /// The tasks whose status is running.
-----+    pub(crate) running: u32,
-----+    /// The pending tasks of active changes.
-----+    pub(crate) pending: u32,
-----+    /// The pending tasks of archived changes.
-----+    pub(crate) unmarked: u32,
-----+}
-----+
-----+/// The three members of TypeScript's report this feature prints.
-----+#[derive(Clone, Copy, Debug, Default, PartialEq)]
-----+pub(crate) struct Metrics {
-----+    /// The spec counts.
-----+    pub(crate) specs: Specs,
-----+    /// The current-task counts.
-----+    pub(crate) now: Now,
-----+    /// The done share as JavaScript rounds it.
-----+    pub(crate) completion_rate: f64,
-----+}
-----+
-----+/// One task's status, in the order the status rule checks them.
-----+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
-----+enum Status {
-----+    /// A regression marker wins over every other marker.
-----+    Regressed,
-----+    /// A done marker comes next.
-----+    Done,
-----+    /// A dead marker comes next.
-----+    Dead,
-----+    /// A running lock comes next.
-----+    Running,
-----+    /// No marker claims the task.
-----+    Pending,
-----+}
-----+
-----+/// Counts the active and archived changes and every task they hold.
-----+///
-----+/// Implements: rust-report/report-counts
-----+pub(crate) fn build(entries: &[ChangeEntry]) -> Metrics {
-----+    let mut specs = Specs::default();
-----+    let mut now = Now::default();
-----+    for entry in entries {
-----+        let archived = match entry.location {
-----+            Location::Active => {
-----+                specs.active += 1;
-----+                false
-----+            }
-----+            Location::Archived => {
-----+                specs.archived += 1;
-----+                true
-----+            }
-----+            Location::Rejected => continue,
-----+        };
-----+        count_change(&entry.path, archived, &mut now);
-----+    }
-----+    specs.total = specs.active + specs.archived;
-----+    Metrics {
-----+        specs,
-----+        now,
-----+        completion_rate: completion_rate(now.done, now.total),
-----+    }
-----+}
-----+
-----+/// Adds one counted change's tasks to the `Now:` counts.
-----+///
-----+/// Implements: rust-report/report-counts
-----+fn count_change(folder: &std::path::Path, archived: bool, now: &mut Now) {
-----+    let facts = read_now_facts(folder);
-----+    for task in &facts.tasks {
-----+        now.total += 1;
-----+        count_status(status(&facts, task), task, archived, now);
-----+    }
-----+}
-----+
-----+/// Gives one task its status: the first marker that holds.
-----+///
-----+/// Implements: rust-report/report-counts
-----+fn status(facts: &NowFacts, task: &NowTask) -> Status {
-----+    if !facts.has_proposal {
-----+        Status::Pending
-----+    } else if task.regressed {
-----+        Status::Regressed
-----+    } else if task.done {
-----+        Status::Done
-----+    } else if task.dead {
-----+        Status::Dead
-----+    } else if task.running {
-----+        Status::Running
-----+    } else {
-----+        Status::Pending
-----+    }
-----+}
-----+
-----+/// Adds one task's status to the matching `Now:` count.
-----+///
-----+/// Implements: rust-report/report-counts
-----+fn count_status(status: Status, task: &NowTask, archived: bool, now: &mut Now) {
-----+    match status {
-----+        Status::Regressed => now.regressed += 1,
-----+        Status::Done => {
-----+            now.done += 1;
-----+            if task.manual {
-----+                now.manual += 1;
-----+            } else {
-----+                now.verified += 1;
-----+            }
-----+        }
-----+        Status::Dead => now.dead += 1,
-----+        Status::Running => now.running += 1,
-----+        Status::Pending if archived => now.unmarked += 1,
-----+        Status::Pending => now.pending += 1,
-----+    }
-----+}
-----+
-----+/// JavaScript's `Math.round(done / total * 10000) / 100`, or 0 with no tasks.
-----+///
-----+/// Implements: rust-report/report-counts
-----+fn completion_rate(done: u32, total: u32) -> f64 {
-----+    if total == 0 {
-----+        0.0
-----+    } else {
-----+        (f64::from(done) / f64::from(total) * 10_000.0).round() / 100.0
-----+    }
-----+}
