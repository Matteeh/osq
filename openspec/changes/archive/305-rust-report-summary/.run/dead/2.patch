---+//! Running `report`: read the config, count the change folders and print them.
---+
---+mod counts;
---+mod entries;
---+mod output;
---+
---+use std::path::Path;
---+
---+use osq_core::FeatureError;
---+
---+/// Parses `report`'s arguments, returning whether `--json` was asked for.
---+///
---+/// # Errors
---+///
---+/// Returns [`FeatureError::usage`] for the first argument that is not `--json`.
---+///
---+/// Implements: rust-report/report-arguments
---+pub(crate) fn arguments(args: &[String]) -> Result<bool, FeatureError> {
---+    let mut json = false;
---+    for argument in args {
---+        if argument == "--json" {
---+            json = true;
---+        } else {
---+            return Err(FeatureError::usage(
---+                "report",
---+                format!("expected [--json], got {argument}"),
---+            ));
---+        }
---+    }
---+    Ok(json)
---+}
---+
---+/// Counts every active and archived change of the root and formats them.
---+///
---+/// # Errors
---+///
---+/// Returns [`FeatureError::failed`] for a refused `osq.toml` or a failing git
---+/// worktree listing.
---+///
---+/// Implements: rust-report/report-changes
---+/// Implements: rust-report/report-summary
---+pub(crate) fn run(root: &Path, json: bool) -> Result<String, FeatureError> {
---+    let entries = entries::read(root)?;
---+    let report = counts::of(&entries);
---+    Ok(if json {
---+        output::json(&report)
---+    } else {
---+        output::text(&report)
---+    })
---+}
