---+//! Proves report counts a change once across the checkout and its worktrees.
---+
---+use std::fs;
---+use std::path::{Path, PathBuf};
---+use std::process::Command;
---+
---+use osq_core::{Feature, Invocation};
---+use osq_feature_report::ReportFeature;
---+
---+/// The marker that says the report test already runs in its own home.
---+const HOME_MARKER: &str = "OSQ_REPORT_TREES_HOME";
---+/// The author and committer name every setup commit gets.
---+const NAME: &str = "osq";
---+/// The author and committer email every setup commit gets.
---+const EMAIL: &str = "osq@example.com";
---+
---+/// A scratch repository with its own checkout and one worktree.
---+struct Repo {
---+    /// The scratch folder holding the checkout and its worktree.
---+    base: PathBuf,
---+    /// The canonical checkout on `main`.
---+    root: PathBuf,
---+}
---+
---+impl Repo {
---+    /// Builds the scenario's checkout, branch and worktree.
---+    fn new() -> Self {
---+        let base = scratch("report_across_worktrees", "repo");
---+        let root = base.join("checkout");
---+        fs::create_dir_all(&root).expect("the checkout folder is created");
---+        write(
---+            &root.join("openspec/changes/001-a/proposal.md"),
---+            "# 001-a\n",
---+        );
---+        write(&root.join("openspec/changes/001-a/tasks/1.md"), "# Task\n");
---+        write(
---+            &root.join("openspec/changes/002-b/proposal.md"),
---+            "# 002-b\n",
---+        );
---+        for task in 1..=3 {
---+            write(
---+                &root
---+                    .join("openspec/changes/002-b/tasks")
---+                    .join(format!("{task}.md")),
---+                "# Task\n",
---+            );
---+        }
---+        let repo = Self { base, root };
---+        repo.init();
---+        repo.commit_all(&repo.root, "initial");
---+        repo.worktree();
---+        repo
---+    }
---+
---+    /// Starts the repository and refuses signed commits.
---+    fn init(&self) {
---+        self.git(&self.root, &["init", "-q", "-b", "main"]);
---+        self.git(&self.root, &["config", "commit.gpgSign", "false"]);
---+    }
---+
---+    /// Adds the `osq/002-b` worktree and rewrites its change folder.
---+    fn worktree(&self) {
---+        let worktree = self.base.join("worktree");
---+        self.git(
---+            &self.root,
---+            &[
---+                "worktree",
---+                "add",
---+                "-q",
---+                "-b",
---+                "osq/002-b",
---+                worktree.to_str().expect("the worktree path is text"),
---+            ],
---+        );
---+        let change = worktree.join("openspec/changes/002-b");
---+        fs::remove_dir_all(&change).expect("the checkout's change is removed");
---+        write(&change.join("proposal.md"), "# 002-b\n");
---+        for task in 1..=2 {
---+            write(&change.join("tasks").join(format!("{task}.md")), "# Task\n");
---+        }
---+        write(&change.join(".run/approved"), "");
---+        write(
---+            &change.join(".run/done/1"),
---+            "---\nscope_hash: sha256:1\n---\n",
---+        );
---+        self.commit_all(&worktree, "archive 002-b");
---+    }
---+
---+    /// Runs `git` in `dir` with isolated settings and the fixed identity.
---+    fn git(&self, dir: &Path, args: &[&str]) {
---+        let mut command = Command::new("git");
---+        command
---+            .arg("-c")
---+            .arg(format!("user.name={NAME}"))
---+            .arg("-c")
---+            .arg(format!("user.email={EMAIL}"))
---+            .args(args)
---+            .current_dir(dir);
---+        command
---+            .env("GIT_CONFIG_GLOBAL", "/dev/null")
---+            .env("GIT_CONFIG_NOSYSTEM", "1")
---+            .env("GIT_CEILING_DIRECTORIES", &self.base)
---+            .env("GIT_CONFIG_COUNT", "1")
---+            .env("GIT_CONFIG_KEY_0", "maintenance.auto")
---+            .env("GIT_CONFIG_VALUE_0", "false");
---+        let output = command.output().expect("git starts");
---+        assert!(
---+            output.status.success(),
---+            "git {} failed in {}: {}",
---+            args.join(" "),
---+            dir.display(),
---+            String::from_utf8_lossy(&output.stderr)
---+        );
---+    }
---+
---+    /// Stages everything in `dir` and commits it.
---+    fn commit_all(&self, dir: &Path, message: &str) {
---+        self.git(dir, &["add", "-A"]);
---+        self.git(dir, &["commit", "-q", "-m", message]);
---+    }
---+}
---+
---+/// Proves the text counts the checkout and its worktree, then only the checkout.
---+///
---+/// Covers: rust-report/report-across-worktrees
---+#[test]
---+fn report_across_worktrees() {
---+    if std::env::var_os(HOME_MARKER).is_none() {
---+        spawn_home_child();
---+        return;
---+    }
---+    let repo = Repo::new();
---+    write_config(true, &repo);
---+    let text = run(&repo.root).expect("the report runs");
---+    for (label, value) in [
---+        ("Total specs", "2 (2 active, 0 archived)"),
---+        ("Total tasks", "3"),
---+        ("Done", "1"),
---+        ("Verified done", "1"),
---+        ("Manual done", "0"),
---+        ("Dead", "0"),
---+        ("Regressed", "0"),
---+        ("Running", "0"),
---+        ("Pending", "2"),
---+        ("Unmarked", "0"),
---+        ("Completion rate", "33.33%"),
---+    ] {
---+        assert_line(&text, label, value);
---+    }
---+    write_config(false, &repo);
---+    let text = run(&repo.root).expect("the report runs with git off");
---+    for (label, value) in [
---+        ("Total specs", "2 (2 active, 0 archived)"),
---+        ("Total tasks", "4"),
---+        ("Done", "0"),
---+        ("Verified done", "0"),
---+        ("Pending", "4"),
---+        ("Completion rate", "0%"),
---+    ] {
---+        assert_line(&text, label, value);
---+    }
---+    stacked(&repo);
---+    write_config(true, &repo);
---+    let text = run(&repo.root).expect("the report runs with a stacked folder");
---+    for (label, value) in [
---+        ("Total specs", "3 (3 active, 0 archived)"),
---+        ("Total tasks", "4"),
---+        ("Done", "1"),
---+        ("Pending", "3"),
---+        ("Completion rate", "25%"),
---+    ] {
---+        assert_line(&text, label, value);
---+    }
---+}
---+
---+/// Writes a stacked approval under the isolated home.
---+fn stacked(repo: &Repo) {
---+    let home = PathBuf::from(std::env::var_os(HOME_MARKER).expect("the child has a home"));
---+    let name = repo.root.file_name().expect("the checkout has a name");
---+    let change = home
---+        .join(".osq/worktrees")
---+        .join(name)
---+        .join(".stacked/003-c/openspec/changes/003-c");
---+    write(&change.join("proposal.md"), "# 003-c\n");
---+    write(&change.join("tasks/1.md"), "# Task\n");
---+}
---+
---+/// Writes the scenario's `osq.toml`, with git on or off, into the checkout.
---+fn write_config(enabled: bool, repo: &Repo) {
---+    write(
---+        &repo.root.join("osq.toml"),
---+        &format!("[vcs]\nenabled = {enabled}\nauthor = \"{NAME} <{EMAIL}>\"\n"),
---+    );
---+}
---+
---+/// Asserts one text line, such as `  Done: 1`.
---+fn assert_line(text: &str, label: &str, value: &str) {
---+    let prefix = format!("  {label}: ");
---+    let expected = format!("{prefix}{value}");
---+    let found = text
---+        .lines()
---+        .find(|line| line.starts_with(&prefix))
---+        .map(ToOwned::to_owned);
---+    assert_eq!(found, Some(expected), "{label}");
---+}
---+
---+/// Runs report on a root with no arguments.
---+fn run(root: &Path) -> Result<String, osq_core::FeatureError> {
---+    ReportFeature
---+        .run(&Invocation::new(root, "report", Vec::new()))
---+        .map(|output| output.text)
---+}
---+
---+/// Runs this test in a child whose HOME is a fresh empty folder.
---+fn spawn_home_child() {
---+    let home = scratch("report_across_worktrees", "home");
---+    let status = Command::new(std::env::current_exe().expect("the test binary is known"))
---+        .args(["--exact", "report_across_worktrees", "--nocapture"])
---+        .env(HOME_MARKER, &home)
---+        .env("HOME", &home)
---+        .status()
---+        .expect("the child starts");
---+    assert!(status.success(), "the isolated-home child fails");
---+}
---+
---+/// A new empty scratch folder named after the test and row.
---+fn scratch(test: &str, row: &str) -> PathBuf {
---+    let root = Path::new(env!("CARGO_TARGET_TMPDIR")).join(test).join(row);
---+    let _ = fs::remove_dir_all(&root);
---+    fs::create_dir_all(&root).expect("the scratch folder is created");
---+    root
---+}
---+
---+/// Writes a file, creating its parent folders.
---+fn write(path: &Path, text: &str) {
---+    fs::create_dir_all(path.parent().expect("the file has a parent"))
---+        .expect("the parent folders are created");
---+    fs::write(path, text).expect("the file is written");
---+}
