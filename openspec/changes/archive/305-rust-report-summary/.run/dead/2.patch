-+//! Counting one report's specs and current task states.
-+
-+use osq_kernel_storage::{ChangeEntry, Location, NowTask, read_now_facts};
-+
-+/// The spec counts TypeScript's `SpecMetrics` holds.
-+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
-+pub(super) struct SpecCounts {
-+    /// Every counted spec.
-+    pub(super) total: usize,
-+    /// The active changes.
-+    pub(super) active: usize,
-+    /// The archived changes.
-+    pub(super) archived: usize,
-+}
-+
-+/// The current task counts TypeScript's `NowMetrics` holds.
-+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
-+pub(super) struct NowCounts {
-+    /// Every counted task.
-+    pub(super) total: usize,
-+    /// The tasks whose first status is done.
-+    pub(super) done: usize,
-+    /// The done tasks without a manual marker.
-+    pub(super) verified: usize,
-+    /// The done tasks with a manual marker.
-+    pub(super) manual: usize,
-+    /// The tasks whose first status is dead.
-+    pub(super) dead: usize,
-+    /// The tasks whose first status is regressed.
-+    pub(super) regressed: usize,
-+    /// The tasks whose first status is running.
-+    pub(super) running: usize,
-+    /// The pending tasks of active changes.
-+    pub(super) pending: usize,
-+    /// The pending tasks of archived changes.
-+    pub(super) unmarked: usize,
-+}
-+
-+/// One report's spec counts, task counts and completion rate.
-+#[derive(Clone, Copy, Debug, Default, PartialEq)]
-+pub(super) struct Counts {
-+    /// The spec counts.
-+    pub(super) specs: SpecCounts,
-+    /// The task counts.
-+    pub(super) now: NowCounts,
-+    /// JavaScript's completion rate in hundredths of a percent.
-+    pub(super) rate_hundredths: usize,
-+}
-+
-+/// One task's first status, in TypeScript's precedence order.
-+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
-+enum Status {
-+    /// A regressed marker wins over every other marker.
-+    Regressed,
-+    /// A done marker wins over dead, running and pending.
-+    Done,
-+    /// A dead marker wins over running and pending.
-+    Dead,
-+    /// A running marker wins over pending.
-+    Running,
-+    /// No marker, or a change with no proposal.
-+    Pending,
-+}
-+
-+/// Counts every active and archived change and its tasks; rejected never count.
-+///
-+/// Implements: rust-report/report-counts
-+pub(super) fn count(entries: &[ChangeEntry]) -> Counts {
-+    let mut specs = SpecCounts::default();
-+    let mut now = NowCounts::default();
-+    for entry in entries {
-+        let archived = match entry.location {
-+            Location::Active => {
-+                specs.active += 1;
-+                false
-+            }
-+            Location::Archived => {
-+                specs.archived += 1;
-+                true
-+            }
-+            Location::Rejected => continue,
-+        };
-+        let facts = read_now_facts(&entry.path);
-+        for task in &facts.tasks {
-+            add_task(&mut now, task, facts.has_proposal, archived);
-+        }
-+    }
-+    specs.total = specs.active + specs.archived;
-+    Counts {
-+        specs,
-+        rate_hundredths: rate_hundredths(now.done, now.total),
-+        now,
-+    }
-+}
-+
-+/// Adds one task to the counts under its first status.
-+///
-+/// Implements: rust-report/report-counts
-+fn add_task(counts: &mut NowCounts, task: &NowTask, has_proposal: bool, archived: bool) {
-+    counts.total += 1;
-+    match status(task, has_proposal) {
-+        Status::Done => {
-+            counts.done += 1;
-+            if task.manual {
-+                counts.manual += 1;
-+            } else {
-+                counts.verified += 1;
-+            }
-+        }
-+        Status::Dead => counts.dead += 1,
-+        Status::Regressed => counts.regressed += 1,
-+        Status::Running => counts.running += 1,
-+        Status::Pending if archived => counts.unmarked += 1,
-+        Status::Pending => counts.pending += 1,
-+    }
-+}
-+
-+/// One task's first status, or pending for a change with no proposal.
-+///
-+/// Implements: rust-report/report-counts
-+fn status(task: &NowTask, has_proposal: bool) -> Status {
-+    if !has_proposal {
-+        Status::Pending
-+    } else if task.regressed {
-+        Status::Regressed
-+    } else if task.done {
-+        Status::Done
-+    } else if task.dead {
-+        Status::Dead
-+    } else if task.running {
-+        Status::Running
-+    } else {
-+        Status::Pending
-+    }
-+}
-+
-+/// JavaScript's `Math.round(done / total * 10000)`, and 0 with no tasks.
-+///
-+/// Implements: rust-report/report-counts
-+fn rate_hundredths(done: usize, total: usize) -> usize {
-+    if total == 0 {
-+        0
-+    } else {
-+        (done * 20000 + total) / (total * 2)
-+    }
-+}
