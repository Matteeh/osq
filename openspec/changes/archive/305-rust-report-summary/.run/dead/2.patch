----+//! Writing the report counts as TypeScript's text or JSON members.
----+
----+use super::counts::Report;
----+
----+/// The text from the report's first line through its completion rate line.
----+///
----+/// Implements: rust-report/report-summary
----+pub(super) fn text(report: &Report) -> String {
----+    let mut lines = Vec::new();
----+    lines.push("osq Delivery Metrics Report".to_owned());
----+    lines.push(String::new());
----+    lines.push("Specs Summary:".to_owned());
----+    lines.push(format!(
----+        "  Total specs: {} ({} active, {} archived)",
----+        report.specs.total, report.specs.active, report.specs.archived
----+    ));
----+    lines.push(String::new());
----+    lines.push("Now:".to_owned());
----+    lines.push(format!("  Total tasks: {}", report.now.total));
----+    lines.push(format!("  Done: {}", report.now.done));
----+    lines.push(format!("  Verified done: {}", report.now.verified));
----+    lines.push(format!("  Manual done: {}", report.now.manual));
----+    lines.push(format!("  Dead: {}", report.now.dead));
----+    lines.push(format!("  Regressed: {}", report.now.regressed));
----+    lines.push(format!("  Running: {}", report.now.running));
----+    lines.push(format!("  Pending: {}", report.now.pending));
----+    lines.push(format!("  Unmarked: {}", report.now.unmarked));
----+    lines.push(format!("  Completion rate: {}%", report.rate.decimal()));
----+    lines.join("\n")
----+}
----+
----+/// The `completionRate`, `now` and `specs` members as sorted-key JSON.
----+///
----+/// Implements: rust-report/report-summary
----+pub(super) fn json(report: &Report) -> String {
----+    let mut lines = Vec::new();
----+    lines.push("{".to_owned());
----+    lines.push(format!("  \"completionRate\": {},", report.rate.decimal()));
----+    lines.push("  \"now\": {".to_owned());
----+    lines.push(format!("    \"dead\": {},", report.now.dead));
----+    lines.push(format!("    \"done\": {},", report.now.done));
----+    lines.push(format!("    \"manual\": {},", report.now.manual));
----+    lines.push(format!("    \"pending\": {},", report.now.pending));
----+    lines.push(format!("    \"regressed\": {},", report.now.regressed));
----+    lines.push(format!("    \"running\": {},", report.now.running));
----+    lines.push(format!("    \"total\": {},", report.now.total));
----+    lines.push(format!("    \"unmarked\": {},", report.now.unmarked));
----+    lines.push(format!("    \"verified\": {}", report.now.verified));
----+    lines.push("  },".to_owned());
----+    lines.push("  \"specs\": {".to_owned());
----+    lines.push(format!("    \"active\": {},", report.specs.active));
----+    lines.push(format!("    \"archived\": {},", report.specs.archived));
----+    lines.push(format!("    \"total\": {}", report.specs.total));
----+    lines.push("  }".to_owned());
----+    lines.push("}".to_owned());
----+    lines.join("\n")
----+}
