-----+/// Proves the worktree counts with git on and the root-only counts with it off.
-----+///
-----+/// Covers: rust-report/report-across-worktrees
-----+#[test]
-----+fn report_across_worktrees() {
-----+    if std::env::var_os(HOME_MARKER).is_none() {
-----+        spawn_home_child("report_across_worktrees");
