---@@ -0,0 +1,165 @@
---+//! Counting the report's specs, task statuses and completion rate.
---+
---+use osq_kernel_storage::{ChangeEntry, Location, NowTask, read_now_facts};
---+
---+/// The active and archived spec counts.
---+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
---+pub(crate) struct Specs {
---+    /// Active and archived changes together.
---+    pub(crate) total: u32,
---+    /// The active changes.
---+    pub(crate) active: u32,
---+    /// The archived changes.
---+    pub(crate) archived: u32,
---+}
---+
---+/// Every current task count, plus the completion rate TypeScript prints.
---+#[derive(Clone, Copy, Debug, Default, PartialEq)]
---+pub(crate) struct Counts {
---+    /// The spec counts.
---+    pub(crate) specs: Specs,
---+    /// Every task's status count.
---+    pub(crate) now: Now,
---+    /// JavaScript's rounded done-out-of-total percentage.
---+    pub(crate) rate: f64,
---+}
---+
---+/// The current task counts TypeScript's report prints.
---+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
---+pub(crate) struct Now {
---+    /// Every task of every counted change.
---+    pub(crate) total: u32,
---+    /// Tasks marked done.
---+    pub(crate) done: u32,
---+    /// Done tasks whose marker is not manual.
---+    pub(crate) verified: u32,
---+    /// Done tasks whose marker is manual.
---+    pub(crate) manual: u32,
---+    /// Tasks marked dead.
---+    pub(crate) dead: u32,
---+    /// Tasks marked regressed.
---+    pub(crate) regressed: u32,
---+    /// Tasks marked running.
---+    pub(crate) running: u32,
---+    /// Pending tasks of active changes.
---+    pub(crate) pending: u32,
---+    /// Pending tasks of archived changes.
---+    pub(crate) unmarked: u32,
---+}
---+
---+/// One task's status, the first that holds in the report's order.
---+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
---+enum Status {
---+    /// The task has a regression marker.
---+    Regressed,
---+    /// The task has a done marker and is not manual.
---+    Verified,
---+    /// The task has a done marker whose frontmatter says manual.
---+    Manual,
---+    /// The task has a dead marker.
---+    Dead,
---+    /// The task has a running marker.
---+    Running,
---+    /// The task has no marker, in an active change.
---+    Pending,
---+    /// The task has no marker, in an archived change.
---+    Unmarked,
---+}
---+
---+/// Counts every active and archived change and each of its tasks.
---+///
---+/// Implements: rust-report/report-counts
---+pub(crate) fn of(entries: &[ChangeEntry]) -> Counts {
---+    let mut counts = Counts::default();
---+    for entry in entries {
---+        let archived = entry.location == Location::Archived;
---+        match entry.location {
---+            Location::Active => counts.specs.active += 1,
---+            Location::Archived => counts.specs.archived += 1,
---+            Location::Rejected => continue,
---+        }
---+        let facts = read_now_facts(&entry.path);
---+        for task in &facts.tasks {
---+            counts.add(task, facts.has_proposal, archived);
---+        }
---+    }
---+    counts.specs.total = counts.specs.active + counts.specs.archived;
---+    counts.rate = rate(counts.now.done, counts.now.total);
---+    counts
---+}
---+
---+impl Counts {
---+    /// Adds one task's status to every count that status names.
---+    ///
---+    /// Implements: rust-report/report-counts
---+    fn add(&mut self, task: &NowTask, has_proposal: bool, archived: bool) {
---+        self.now.total += 1;
---+        match status_of(task, has_proposal, archived) {
---+            Status::Regressed => self.now.regressed += 1,
---+            Status::Verified => {
---+                self.now.done += 1;
---+                self.now.verified += 1;
---+            }
---+            Status::Manual => {
---+                self.now.done += 1;
---+                self.now.manual += 1;
---+            }
---+            Status::Dead => self.now.dead += 1,
---+            Status::Running => self.now.running += 1,
---+            Status::Pending => self.now.pending += 1,
---+            Status::Unmarked => self.now.unmarked += 1,
---+        }
---+    }
---+}
---+
---+/// The one status that holds first for a task.
---+///
---+/// Implements: rust-report/report-counts
---+fn status_of(task: &NowTask, has_proposal: bool, archived: bool) -> Status {
---+    if !has_proposal {
---+        return pending(archived);
---+    }
---+    if task.regressed {
---+        Status::Regressed
---+    } else if task.done {
---+        done(task.manual)
---+    } else if task.dead {
---+        Status::Dead
---+    } else if task.running {
---+        Status::Running
---+    } else {
---+        pending(archived)
---+    }
---+}
---+
---+/// The status of a done task, split by its marker's manual flag.
---+///
---+/// Implements: rust-report/report-counts
---+fn done(manual: bool) -> Status {
---+    if manual {
---+        Status::Manual
---+    } else {
---+        Status::Verified
---+    }
---+}
---+
---+/// The status of a task with no marker: unmarked once archived.
---+///
---+/// Implements: rust-report/report-counts
---+fn pending(archived: bool) -> Status {
---+    if archived {
---+        Status::Unmarked
---+    } else {
---+        Status::Pending
---+    }
---+}
---+
---+/// JavaScript's `Math.round(done / total * 10000) / 100`, and 0 with no tasks.
---+///
---+/// Implements: rust-report/report-counts
---+fn rate(done: u32, total: u32) -> f64 {
---+    if total == 0 {
---+        return 0.0;
---+    }
---+    (f64::from(done) / f64::from(total) * 10_000.0).round() / 100.0
---+}
