----+/// Proves every status-order row.
----+///
----+/// Covers: rust-report/status-order
----+#[test]
----+fn report_status_order() {
----+    let rows = [
----+        StatusRow {
----+            proposal: Some("proposal.md"),
----+            expected: &[
----+                "  Total tasks: 5",
----+                "  Done: 1",
----+                "  Verified done: 1",
----+                "  Manual done: 0",
----+                "  Dead: 1",
----+                "  Regressed: 1",
----+                "  Running: 1",
----+                "  Pending: 1",
----+                "  Unmarked: 0",
----+                "  Completion rate: 20%",
----+            ],
----+        },
----+        StatusRow {
----+            proposal: Some("spec.md"),
----+            expected: &[
----+                "  Total tasks: 5",
----+                "  Done: 1",
----+                "  Verified done: 1",
----+                "  Manual done: 0",
----+                "  Dead: 1",
----+                "  Regressed: 1",
----+                "  Running: 1",
----+                "  Pending: 1",
----+                "  Unmarked: 0",
----+                "  Completion rate: 20%",
----+            ],
----+        },
----+        StatusRow {
----+            proposal: None,
----+            expected: &[
----+                "  Total tasks: 5",
----+                "  Done: 0",
----+                "  Verified done: 0",
----+                "  Manual done: 0",
----+                "  Dead: 0",
----+                "  Regressed: 0",
----+                "  Running: 0",
----+                "  Pending: 5",
----+                "  Unmarked: 0",
----+                "  Completion rate: 0%",
----+            ],
----+        },
----+    ];
----+    for (index, row) in rows.iter().enumerate() {
----+        let root = scratch("report_status_order", &index.to_string());
----+        let change = root.join("openspec/changes/001-a");
----+        if let Some(proposal) = row.proposal {
----+            write(&change.join(proposal), "---\ntitle: A\n---\n");
----+        }
----+        for task in 1..=5 {
----+            write(&change.join(format!("tasks/{task}.md")), "");
----+        }
----+        for task in 1..=4 {
----+            write(&change.join(format!(".run/running/{task}.pid")), "x\n");
----+        }
----+        for file in [
----+            "regressed/1.md",
----+            "done/1",
----+            "done/2",
----+            "dead/1.md",
----+            "dead/2.md",
----+            "dead/3.md",
----+        ] {
----+            write(&change.join(".run").join(file), "x\n");
----+        }
----+        let text = run(&root, &[]).expect("the report prints");
----+        for expected in row.expected {
----+            assert!(
----+                text.lines().any(|line| line == *expected),
----+                "row {index} lacks {expected}"
----+            );
----+        }
----+    }
----+}
