---+//! Proves the report summary against TypeScript's goldens and its count rules.
---+
---+use std::fs;
---+use std::path::{Path, PathBuf};
---+
---+use osq_core::{Feature, FeatureError, Invocation};
---+use osq_feature_report::ReportFeature;
---+use osq_kernel_config::load_config;
---+
---+/// One golden case, its fixture project and the lock files the case writes.
---+struct Case {
---+    /// The golden file's name without its extension.
---+    name: &'static str,
---+    /// The fixture project, or none for the empty scratch folder.
---+    project: Option<&'static str>,
---+    /// The change folder, task number and text of each running lock.
---+    locks: &'static [(&'static str, &'static str, &'static str)],
---+    /// The completion rate line's value.
---+    rate: &'static str,
---+}
---+
---+/// The five golden cases and the completion rate each prints.
---+const CASES: &[Case] = &[
---+    Case {
---+        name: "empty",
---+        project: None,
---+        locks: &[],
---+        rate: "0",
---+    },
---+    Case {
---+        name: "report-project",
---+        project: Some("report-project"),
---+        locks: &[],
---+        rate: "31.25",
---+    },
---+    Case {
---+        name: "report-project-running",
---+        project: Some("report-project"),
---+        locks: &[
---+            ("003-running", "7", "not json\n"),
---+            ("003-running", "8", "{\"pid\":1,\"startedAt\":1}\n"),
---+        ],
---+        rate: "31.25",
---+    },
---+    Case {
---+        name: "all-done",
---+        project: Some("all-done"),
---+        locks: &[],
---+        rate: "100",
---+    },
---+    Case {
---+        name: "thirds",
---+        project: Some("thirds"),
---+        locks: &[],
---+        rate: "66.67",
---+    },
---+];
---+
---+/// Proves every golden case's text and JSON, byte for byte.
---+///
---+/// Covers: rust-report/report-summary-equals-typescript-s
---+#[test]
---+fn report_summary_equals_typescript() {
---+    for case in CASES {
---+        let root = scratch("report_summary_equals_typescript", case.name);
---+        if let Some(project) = case.project {
---+            copy_dir(&fixtures().join(project), &root);
---+        }
---+        for (folder, task, text) in case.locks {
---+            write(
---+                &root
---+                    .join("openspec/changes")
---+                    .join(folder)
---+                    .join(".run/running")
---+                    .join(format!("{task}.pid")),
---+                text,
---+            );
---+        }
---+        let text = run(&root, &[]).expect("the report runs");
---+        assert_eq!(
---+            text,
---+            fs::read_to_string(golden(case.name, "txt")).expect("the text golden reads"),
---+            "{}",
---+            case.name
---+        );
---+        assert_eq!(
---+            line(&text, "  Completion rate: "),
---+            Some(format!("  Completion rate: {}%", case.rate)),
---+            "{}",
---+            case.name
---+        );
---+        let json = run(&root, &["--json"]).expect("the JSON report runs");
---+        assert_eq!(
---+            json,
---+            fs::read_to_string(golden(case.name, "json")).expect("the JSON golden reads"),
---+            "{}",
---+            case.name
---+        );
---+        if case.name == "report-project" {
---+            assert_eq!(
---+                run(&root, &["--json", "--json"]).expect("repeated --json runs"),
---+                json,
---+                "repeated --json"
---+            );
---+        }
---+    }
---+}
---+
---+/// One status-order row: its proposal entry, whether it exists, and its counts.
---+struct StatusRow {
---+    /// The proposal column's file, or none.
---+    proposal: &'static str,
---+    /// The row's expected `Now:` lines after `Total tasks:`.
---+    counts: [&'static str; 9],
---+}
---+
---+/// The three rows of rust-report "Status order".
---+const STATUS_ROWS: &[StatusRow] = &[
---+    StatusRow {
---+        proposal: "proposal.md",
---+        counts: ["5", "1", "1", "0", "1", "1", "1", "1", "0"],
---+    },
---+    StatusRow {
---+        proposal: "spec.md",
---+        counts: ["5", "1", "1", "0", "1", "1", "1", "1", "0"],
---+    },
---+    StatusRow {
---+        proposal: "",
---+        counts: ["5", "0", "0", "0", "0", "0", "0", "5", "0"],
---+    },
---+];
---+
---+/// The `Now:` line labels in the order TypeScript prints them.
---+const NOW_LABELS: [&str; 9] = [
---+    "Total tasks",
---+    "Done",
---+    "Verified done",
---+    "Manual done",
---+    "Dead",
---+    "Regressed",
---+    "Running",
---+    "Pending",
---+    "Unmarked",
---+];
---+
---+/// Proves the status order, the manual split, pending and unmarked.
---+///
---+/// Covers: rust-report/status-order
---+#[test]
---+fn report_status_order() {
---+    for (index, row) in STATUS_ROWS.iter().enumerate() {
---+        let root = scratch("report_status_order", &index.to_string());
---+        let change = root.join("openspec/changes/001-a");
---+        if !row.proposal.is_empty() {
---+            write(&change.join(row.proposal), "# Change\n");
---+        }
