----@@ -0,0 +1,193 @@
----+//! Counting the specs, task statuses and completion rate of a change listing.
----+
----+use osq_kernel_storage::{ChangeEntry, Location, NowTask, read_now_facts};
----+
----+/// The counts one report prints, before they are formatted.
----+pub(super) struct Report {
----+    /// The spec counts.
----+    pub(super) specs: Specs,
----+    /// The current task counts.
----+    pub(super) now: Now,
----+    /// The completion rate, in hundredths of a percent.
----+    pub(super) rate: Rate,
----+}
----+
----+/// The `Specs Summary:` counts.
----+pub(super) struct Specs {
----+    /// Every active and archived change.
----+    pub(super) total: usize,
----+    /// The active changes.
----+    pub(super) active: usize,
----+    /// The archived changes.
----+    pub(super) archived: usize,
----+}
----+
----+/// The `Now:` task counts.
----+#[derive(Default)]
----+pub(super) struct Now {
----+    /// Every task of every counted change.
----+    pub(super) total: usize,
----+    /// The done tasks.
----+    pub(super) done: usize,
----+    /// The done tasks with a verified marker.
----+    pub(super) verified: usize,
----+    /// The done tasks with a manual marker.
----+    pub(super) manual: usize,
----+    /// The dead tasks.
----+    pub(super) dead: usize,
----+    /// The regressed tasks.
----+    pub(super) regressed: usize,
----+    /// The running tasks.
----+    pub(super) running: usize,
----+    /// The pending tasks of active changes.
----+    pub(super) pending: usize,
----+    /// The pending tasks of archived changes.
----+    pub(super) unmarked: usize,
----+}
----+
----+/// A completion rate held as JavaScript's rounded hundredths of a percent.
----+pub(super) struct Rate {
----+    /// The rate's hundredths, such as 3125 for 31.25.
----+    hundredths: usize,
----+}
----+
----+/// The counts gathered while walking the listing.
----+#[derive(Default)]
----+struct Counts {
----+    /// The active changes seen.
----+    active: usize,
----+    /// The archived changes seen.
----+    archived: usize,
----+    /// The task counts seen.
----+    now: Now,
----+}
----+
----+/// One task's status, the first marker that holds.
----+enum Status {
----+    /// The task has a regressed marker.
----+    Regressed,
----+    /// The task is done and its marker holds `manual: true`.
----+    DoneManual,
----+    /// The task is done and its marker does not hold `manual: true`.
----+    DoneVerified,
----+    /// The task has a dead marker.
----+    Dead,
----+    /// The task has a running lock.
----+    Running,
----+    /// The task has no terminal or running marker.
----+    Pending,
----+}
----+
----+impl Rate {
----+    /// Rounds `done / total * 10000`, or 0 when there are no tasks.
----+    ///
----+    /// Implements: rust-report/report-counts
----+    fn of(done: usize, total: usize) -> Self {
----+        if total == 0 {
----+            return Self { hundredths: 0 };
----+        }
----+        Self {
----+            hundredths: (done * 10_000 + total / 2) / total,
----+        }
----+    }
----+
----+    /// The rate as JavaScript writes a number: `100`, `0`, `31.25` or `66.67`.
----+    ///
----+    /// Implements: rust-report/report-summary
----+    pub(super) fn decimal(&self) -> String {
----+        let whole = self.hundredths / 100;
----+        let fraction = self.hundredths % 100;
----+        if fraction == 0 {
----+            whole.to_string()
----+        } else {
----+            format!("{whole}.{fraction:02}")
----+                .trim_end_matches('0')
----+                .to_owned()
----+        }
----+    }
----+}
----+
----+/// Counts every active and archived change, leaving rejected changes out.
----+///
----+/// Implements: rust-report/report-changes
----+/// Implements: rust-report/report-counts
----+pub(super) fn build(entries: &[ChangeEntry]) -> Report {
----+    let mut counts = Counts::default();
----+    for entry in entries {
----+        match entry.location {
----+            Location::Active => {
----+                counts.active += 1;
----+                count_tasks(entry, false, &mut counts.now);
----+            }
----+            Location::Archived => {
----+                counts.archived += 1;
----+                count_tasks(entry, true, &mut counts.now);
----+            }
----+            Location::Rejected => {}
----+        }
----+    }
----+    let specs = Specs {
----+        total: counts.active + counts.archived,
----+        active: counts.active,
----+        archived: counts.archived,
----+    };
----+    let rate = Rate::of(counts.now.done, counts.now.total);
----+    Report {
----+        specs,
----+        now: counts.now,
----+        rate,
----+    }
----+}
----+
----+/// Adds one change folder's tasks to the counts.
----+///
----+/// Implements: rust-report/report-counts
----+fn count_tasks(entry: &ChangeEntry, archived: bool, now: &mut Now) {
----+    let facts = read_now_facts(&entry.path);
----+    for task in &facts.tasks {
----+        now.total += 1;
----+        match status(task, facts.has_proposal) {
----+            Status::Regressed => now.regressed += 1,
----+            Status::DoneManual => {
----+                now.done += 1;
----+                now.manual += 1;
----+            }
----+            Status::DoneVerified => {
----+                now.done += 1;
----+                now.verified += 1;
----+            }
----+            Status::Dead => now.dead += 1,
----+            Status::Running => now.running += 1,
----+            Status::Pending => {
----+                if archived {
----+                    now.unmarked += 1;
----+                } else {
----+                    now.pending += 1;
----+                }
----+            }
----+        }
----+    }
----+}
----+
----+/// One task's status, with every task of a change without a proposal pending.
----+///
----+/// Implements: rust-report/report-counts
----+fn status(task: &NowTask, has_proposal: bool) -> Status {
----+    if !has_proposal {
----+        Status::Pending
----+    } else if task.regressed {
----+        Status::Regressed
----+    } else if task.done {
----+        if task.manual {
----+            Status::DoneManual
----+        } else {
----+            Status::DoneVerified
----+        }
----+    } else if task.dead {
----+        Status::Dead
----+    } else if task.running {
----+        Status::Running
----+    } else {
----+        Status::Pending
----+    }
----+}
