+//! Counting the spec, task and completion figures TypeScript's report counts.
+//!
+//! Implements: rust-report/report-counts
+
+use osq_kernel_storage::{ChangeEntry, Location, read_now_facts};
+
+/// Every figure one report prints.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) struct Counts {
+    /// Active and archived change folders together.
+    pub(crate) total_specs: u64,
+    /// Change folders directly under `openspec/changes/`.
+    pub(crate) active_specs: u64,
+    /// Change folders under `openspec/changes/archive/`.
+    pub(crate) archived_specs: u64,
+    /// Every task of every counted change.
+    pub(crate) total_tasks: u64,
+    /// Tasks whose status is `done`.
+    pub(crate) done: u64,
+    /// Done tasks without a manual marker.
+    pub(crate) verified: u64,
+    /// Done tasks whose marker says `manual: true`.
+    pub(crate) manual: u64,
+    /// Tasks whose status is `dead`.
+    pub(crate) dead: u64,
+    /// Tasks whose status is `regressed`.
+    pub(crate) regressed: u64,
+    /// Tasks whose status is `running`.
+    pub(crate) running: u64,
+    /// Pending tasks of active changes.
+    pub(crate) pending: u64,
+    /// Pending tasks of archived changes.
+    pub(crate) unmarked: u64,
+    /// The completion rate in hundredths of a percent.
+    pub(crate) completion: u64,
+}
+
+/// Counts every non-rejected change entry and its tasks.
+///
+/// Implements: rust-report/report-counts
+pub(crate) fn count(entries: &[ChangeEntry]) -> Counts {
+    let mut counts = Counts::default();
+    for entry in entries {
+        if entry.location == Location::Rejected {
+            continue;
+        }
+        let archived = entry.location == Location::Archived;
+        if archived {
+            counts.archived_specs += 1;
+        } else {
+            counts.active_specs += 1;
+        }
+        add_tasks(&mut counts, entry, archived);
+    }
+    counts.total_specs = counts.active_specs + counts.archived_specs;
+    counts.completion = completion_hundredths(counts.done, counts.total_tasks);
+    counts
+}
+
+/// Adds one change folder's tasks to the counts.
+fn add_tasks(counts: &mut Counts, entry: &ChangeEntry, archived: bool) {
+    let facts = read_now_facts(&entry.path);
+    for task in &facts.tasks {
+        counts.total_tasks += 1;
+        if !facts.has_proposal {
+            add_pending(counts, archived);
+        } else if task.regressed {
+            counts.regressed += 1;
+        } else if task.done {
+            counts.done += 1;
+            if task.manual {
+                counts.manual += 1;
+            } else {
+                counts.verified += 1;
+            }
+        } else if task.dead {
+            counts.dead += 1;
+        } else if task.running {
+            counts.running += 1;
+        } else {
+            add_pending(counts, archived);
+        }
+    }
+}
+
+/// Adds one pending task as pending or unmarked for its change's place.
+fn add_pending(counts: &mut Counts, archived: bool) {
+    if archived {
+        counts.unmarked += 1;
+    } else {
+        counts.pending += 1;
+    }
+}
+
+/// JavaScript's `Math.round(done / total * 10000)`, in hundredths, or 0.
+fn completion_hundredths(done: u64, total: u64) -> u64 {
+    if total == 0 {
+        return 0;
+    }
+    (done * 20_000 + total) / (total * 2)
+}
diff --git a/crates/features/report/src/report/entries.rs b/crates/features/report/src/report/entries.rs
new file mode 100644
index 000000000..17236178c
--- /dev/null
+++ b/crates/features/report/src/report/entries.rs
@@ -0,0 +1,94 @@
+//! Reading the change folders `report` counts, across the checkout or its trees.
+//!
+//! Implements: rust-report/report-changes
+
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use osq_core::FeatureError;
+use osq_kernel_config::{Config, VcsConfig};
+use osq_kernel_storage::{
+    ChangeEntry, TreeCandidate, change_trees, list_changes, list_tree_changes,
+};
+use osq_kernel_vcs::{GitVcs, Vcs, Worktree, stacked_root};
+
+use super::failed;
+
+/// The open git reader of a root whose repository top is the root itself.
+struct Git {
+    /// The git program rooted at the project root.
+    vcs: GitVcs,
+    /// The repository's top level, symlinks resolved.
+    repo_root: PathBuf,
+}
+
+/// Lists every active and archived change entry `report` counts.
+///
+/// # Errors
+///
+/// Returns [`FeatureError::failed`] when a git-backed listing fails.
+///
+/// Implements: rust-report/report-changes
+pub(crate) fn entries(root: &Path, config: &Config) -> Result<Vec<ChangeEntry>, FeatureError> {
+    match git(root, config) {
+        Some(git) if config.vcs.enabled => across_trees(root, config, &git),
+        _ => Ok(list_changes(root)),
+    }
+}
+
+/// Opens git when it is on, as rust-show "Show git state" decides it.
+fn git(root: &Path, config: &Config) -> Option<Git> {
+    let vcs = GitVcs::new(root).with_timeouts(&config.timeouts);
+    let repo_root = vcs.root().ok().flatten()?;
+    let root = real(root);
+    let repo_root = real(&repo_root);
+    (root == repo_root).then_some(Git { vcs, repo_root })
+}
+
+/// Lists the changes across the root, its worktrees and its stacked folders.
+///
+/// # Errors
+///
+/// Returns [`FeatureError::failed`] when `git worktree list` fails.
+fn across_trees(root: &Path, config: &Config, git: &Git) -> Result<Vec<ChangeEntry>, FeatureError> {
+    let worktrees = git
+        .vcs
+        .worktree_list()
+        .map_err(|error| failed(error.to_string()))?;
+    let candidates: Vec<TreeCandidate> = worktrees.iter().map(candidate).collect();
+    let stacked = stacked_folders(&git.repo_root, &config.vcs);
+    Ok(list_tree_changes(&change_trees(
+        root,
+        &candidates,
+        &stacked,
+    )))
+}
+
+/// Turns one git worktree into a tree candidate.
+fn candidate(worktree: &Worktree) -> TreeCandidate {
+    TreeCandidate {
+        path: PathBuf::from(&worktree.path),
+        branch: worktree.branch.clone(),
+    }
+}
+
+/// The folders directly under the stacked approvals root.
+fn stacked_folders(repo_root: &Path, config: &VcsConfig) -> Vec<PathBuf> {
+    let Some(home) = std::env::var_os("HOME") else {
+        return Vec::new();
+    };
+    let stacked = stacked_root(config, repo_root, Path::new(&home));
+    let Ok(entries) = fs::read_dir(&stacked) else {
+        return Vec::new();
+    };
+    entries
+        .flatten()
+        .filter(|entry| entry.file_type().is_ok_and(|kind| kind.is_dir()))
+        .map(|entry| entry.path())
+        .collect()
+}
+
+/// Resolves a path's symlinks, falling back to the path as given.
+fn real(path: &Path) -> PathBuf {
+    fs::canonicalize(path).unwrap_or_else(|_| path.to_path_buf())
+}
