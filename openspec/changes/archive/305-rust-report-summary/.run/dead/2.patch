-----+    assert_line(&enabled, "  Verified done: 1");
-----+    assert_line(&enabled, "  Manual done: 0");
-----+    assert_line(&enabled, "  Dead: 0");
-----+    assert_line(&enabled, "  Regressed: 0");
-----+    assert_line(&enabled, "  Running: 0");
-----+    assert_line(&enabled, "  Pending: 2");
-----+    assert_line(&enabled, "  Unmarked: 0");
-----+    assert_line(&enabled, "  Completion rate: 33.33%");
-----+
-----+    write(&repo.root.join("osq.toml"), "[vcs]\nenabled = false\n");
-----+    let disabled = run(&repo.root).expect("report reads only the root");
-----+    assert_line(&disabled, "  Total specs: 2 (2 active, 0 archived)");
-----+    assert_line(&disabled, "  Total tasks: 4");
-----+    assert_line(&disabled, "  Done: 0");
-----+    assert_line(&disabled, "  Verified done: 0");
-----+    assert_line(&disabled, "  Manual done: 0");
-----+    assert_line(&disabled, "  Dead: 0");
-----+    assert_line(&disabled, "  Regressed: 0");
-----+    assert_line(&disabled, "  Running: 0");
-----+    assert_line(&disabled, "  Pending: 4");
-----+    assert_line(&disabled, "  Unmarked: 0");
-----+    assert_line(&disabled, "  Completion rate: 0%");
