----+//! Proves report counts changes across the checkout and its git worktrees.
----+
----+use std::fs;
----+use std::path::{Path, PathBuf};
----+use std::process::Command;
----+
----+use osq_core::{Feature, Invocation};
----+use osq_feature_report::ReportFeature;
----+
----+/// The marker that says the test runs in its own home.
----+const HOME_MARKER: &str = "OSQ_REPORT_TREES_HOME";
----+/// The author and committer name every setup commit gets.
----+const NAME: &str = "osq";
----+/// The author and committer email every setup commit gets.
----+const EMAIL: &str = "osq@example.com";
----+
----+/// A scratch repository: its root and a worktree beside it.
----+struct Repo {
----+    /// The row's scratch folder, holding the checkout and its worktree.
----+    base: PathBuf,
----+    /// The canonical checkout on `main`.
----+    root: PathBuf,
----+}
----+
----+impl Repo {
----+    /// Builds the repository's root, its change folders and its worktree.
----+    fn new() -> Self {
----+        let base = scratch("report_across_worktrees", "repo");
----+        let root = base.join("checkout");
----+        write(
----+            &root.join("osq.toml"),
----+            "[vcs]\nenabled = true\nauthor = \"osq <osq@example.com>\"\n",
----+        );
----+        write(
----+            &root.join("openspec/changes/001-a/proposal.md"),
----+            "---\ntitle: A\n---\n",
----+        );
----+        write(&root.join("openspec/changes/001-a/tasks/1.md"), "");
----+        write(
----+            &root.join("openspec/changes/002-b/proposal.md"),
----+            "---\ntitle: B\n---\n",
----+        );
----+        for task in 1..=3 {
----+            write(
----+                &root.join(format!("openspec/changes/002-b/tasks/{task}.md")),
----+                "",
----+            );
----+        }
----+        Self { base, root }
----+    }
----+
----+    /// Runs `git` in `dir` with fixed identity and isolated settings.
----+    fn git(&self, dir: &Path, args: &[&str]) {
----+        let mut command = Command::new("git");
----+        command
----+            .args([
----+                "-c",
----+                &format!("user.name={NAME}"),
----+                "-c",
----+                &format!("user.email={EMAIL}"),
----+                "-c",
----+                "commit.gpgSign=false",
----+                "-c",
----+                "maintenance.auto=false",
----+            ])
----+            .args(args)
----+            .current_dir(dir)
----+            .env("GIT_CONFIG_GLOBAL", "/dev/null")
----+            .env("GIT_CONFIG_NOSYSTEM", "1")
----+            .env("GIT_CEILING_DIRECTORIES", &self.base);
----+        let output = command.output().expect("git starts");
----+        assert!(
----+            output.status.success(),
----+            "git {} failed in {}: {}",
----+            args.join(" "),
----+            dir.display(),
----+            String::from_utf8_lossy(&output.stderr)
----+        );
----+    }
----+
----+    /// Commits the root, then adds the worktree branch and its markers.
----+    fn setup(&self) {
----+        self.git(&self.root, &["init", "-q", "-b", "main"]);
----+        self.git(&self.root, &["add", "-A"]);
----+        self.git(&self.root, &["commit", "-q", "-m", "all"]);
----+        let worktree = self.base.join("worktree");
----+        self.git(
----+            &self.root,
----+            &[
----+                "worktree",
----+                "add",
----+                "-q",
----+                "-b",
----+                "osq/002-b",
----+                worktree.to_str().expect("the worktree path is text"),
----+                "main",
----+            ],
----+        );
----+        let change = worktree.join("openspec/changes/002-b");
----+        fs::remove_file(change.join("tasks/3.md")).expect("task 3 is removed");
----+        write(&change.join(".run/approved"), "sha256:1\n");
----+        write(
----+            &change.join(".run/done/1"),
----+            "---\nscope_hash: sha256:1\n---\n",
----+        );
----+    }
----+}
----+
----+/// Proves the counts with git on and with it off.
----+///
----+/// Covers: rust-report/report-across-worktrees
----+#[test]
----+fn report_across_worktrees() {
----+    if std::env::var_os(HOME_MARKER).is_none() {
----+        spawn_home_child();
----+        return;
----+    }
----+    let repo = Repo::new();
----+    repo.setup();
----+    let text = run(&repo.root).expect("the report prints");
----+    for expected in [
----+        "  Total specs: 2 (2 active, 0 archived)",
----+        "  Total tasks: 3",
----+        "  Done: 1",
----+        "  Verified done: 1",
----+        "  Pending: 2",
----+        "  Completion rate: 33.33%",
----+    ] {
----+        assert!(
----+            text.lines().any(|line| line == expected),
----+            "git on lacks {expected}"
----+        );
----+    }
----+    for zero in [
----+        "  Manual done: 0",
----+        "  Dead: 0",
----+        "  Regressed: 0",
----+        "  Running: 0",
----+        "  Unmarked: 0",
----+    ] {
----+        assert!(text.lines().any(|line| line == zero), "git on lacks {zero}");
----+    }
----+    write(
----+        &repo.root.join("osq.toml"),
----+        "[vcs]\nenabled = false\nauthor = \"osq <osq@example.com>\"\n",
----+    );
----+    let text = run(&repo.root).expect("the report prints with git off");
----+    for expected in [
----+        "  Total specs: 2 (2 active, 0 archived)",
----+        "  Total tasks: 4",
----+        "  Done: 0",
----+        "  Pending: 4",
----+        "  Completion rate: 0%",
----+    ] {
----+        assert!(
----+            text.lines().any(|line| line == expected),
----+            "git off lacks {expected}"
----+        );
----+    }
----+    let home = PathBuf::from(std::env::var_os(HOME_MARKER).expect("the child has a home"));
----+    let repo_name = repo.root.file_name().expect("the checkout has a name");
----+    let stacked = home
----+        .join(".osq/worktrees")
----+        .join(repo_name)
----+        .join(".stacked/003-c");
----+    write(
----+        &stacked.join("openspec/changes/003-c/proposal.md"),
----+        "---\ntitle: C\n---\n",
----+    );
----+    write(&stacked.join("openspec/changes/003-c/tasks/1.md"), "");
----+    write(
----+        &repo.root.join("osq.toml"),
----+        "[vcs]\nenabled = true\nauthor = \"osq <osq@example.com>\"\n",
----+    );
----+    let text = run(&repo.root).expect("the report prints with a stacked change");
----+    for expected in [
----+        "  Total specs: 3 (3 active, 0 archived)",
----+        "  Total tasks: 4",
----+        "  Done: 1",
----+        "  Pending: 3",
----+        "  Completion rate: 25%",
----+    ] {
----+        assert!(
----+            text.lines().any(|line| line == expected),
----+            "stacked change lacks {expected}"
----+        );
----+    }
----+}
----+
----+/// Runs this test in a child whose HOME is a fresh empty folder.
----+fn spawn_home_child() {
----+    let home = scratch("report_across_worktrees", "home");
----+    let status = Command::new(std::env::current_exe().expect("the test binary is known"))
----+        .args(["--exact", "report_across_worktrees", "--nocapture"])
----+        .env(HOME_MARKER, &home)
----+        .env("HOME", &home)
----+        .status()
----+        .expect("the child starts");
----+    assert!(status.success(), "the isolated-home child fails");
----+}
----+
----+/// Runs report with no arguments on a root.
----+fn run(root: &Path) -> Result<String, osq_core::FeatureError> {
----+    ReportFeature
----+        .run(&Invocation::new(root, "report", Vec::new()))
----+        .map(|output| output.text)
----+}
----+
----+/// A fresh empty scratch folder for one row.
----+fn scratch(test: &str, name: &str) -> PathBuf {
----+    let root = Path::new(env!("CARGO_TARGET_TMPDIR")).join(test).join(name);
----+    let _ = fs::remove_dir_all(&root);
----+    fs::create_dir_all(&root).expect("the scratch folder is created");
----+    root
----+}
----+
----+/// Writes a file, creating its parent folders.
----+fn write(path: &Path, text: &str) {
----+    fs::create_dir_all(path.parent().expect("the file has a parent"))
----+        .expect("the parent folders are created");
----+    fs::write(path, text).expect("the file is written");
----+}
