-----+//! Running `report`: parsing its arguments and printing its summary.
-----+
-----+use std::path::Path;
-----+
-----+use osq_core::{FeatureError, Output};
-----+
-----+use crate::{changes, metrics, summary};
-----+
-----+/// Runs `report` on a root, printing TypeScript's text or JSON summary.
-----+///
-----+/// # Errors
-----+///
-----+/// Returns [`FeatureError::usage`] for an argument other than `--json`, and
-----+/// whatever [`changes::read`] returns.
-----+///
-----+/// Implements: rust-report/report-arguments
-----+/// Implements: rust-report/report-changes
-----+/// Implements: rust-report/report-summary
-----+pub(crate) fn run(root: &Path, args: &[String]) -> Result<Output, FeatureError> {
-----+    let json = wants_json(args)?;
-----+    let entries = changes::read(root)?;
-----+    let metrics = metrics::build(&entries);
-----+    let text = if json {
-----+        summary::json(&metrics)
-----+    } else {
-----+        summary::text(&metrics)
-----+    };
-----+    Ok(Output::text(text))
-----+}
-----+
-----+/// Whether the arguments ask for JSON, refusing the first unexpected one.
-----+///
-----+/// Implements: rust-report/report-arguments
-----+fn wants_json(args: &[String]) -> Result<bool, FeatureError> {
-----+    let mut json = false;
-----+    for argument in args {
-----+        if argument == "--json" {
-----+            json = true;
-----+        } else {
-----+            return Err(FeatureError::usage(
-----+                "report",
-----+                format!("expected [--json], got {argument}"),
-----+            ));
-----+        }
-----+    }
-----+    Ok(json)
-----+}
