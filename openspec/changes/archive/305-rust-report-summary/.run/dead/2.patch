-----+/// A scratch repository: its own folder, the checkout and the worktree.
-----+struct Repo {
-----+    /// The row's scratch folder, holding the checkout and its worktree.
-----+    base: PathBuf,
-----+    /// The canonical checkout on `main`.
-----+    root: PathBuf,
-----+}
-----+
-----+impl Repo {
-----+    /// Builds the checkout, its two changes and the worktree's approved copy.
-----+    fn new() -> Self {
-----+        let repo = Self::checkout("report-across-worktrees");
-----+        repo.init();
-----+        repo.commit_all(&repo.root, "all");
-----+        let worktree = repo.base.join("worktree");
-----+        repo.git(
-----+            &repo.root,
-----+            &[
-----+                "worktree",
-----+                "add",
-----+                "-q",
-----+                "-b",
-----+                "osq/002-b",
-----+                worktree.to_str().expect("the worktree path is text"),
-----+            ],
-----+        );
-----+        let changes = worktree.join("openspec/changes/002-b");
-----+        fs::remove_file(changes.join("tasks/3.md")).expect("the root-only task is removed");
-----+        write(&changes.join(".run/approved"), "sha256:2\n");
-----+        write(
-----+            &changes.join(".run/done/1"),
-----+            "---\nscope_hash: sha256:1\n---\n",
-----+        );
-----+        repo.commit_all(&worktree, "approved 002");
-----+        repo
-----+    }
-----+
-----+    /// Writes the checkout's tracked files and resolves the scratch paths.
-----+    fn checkout(name: &str) -> Self {
-----+        let base = scratch(name);
-----+        let root = base.join("checkout");
-----+        write(
-----+            &root.join("osq.toml"),
-----+            "[vcs]\nenabled = true\nauthor = \"osq <osq@example.com>\"\n",
-----+        );
-----+        let one = root.join("openspec/changes/001-a");
-----+        write(&one.join("proposal.md"), "---\ntitle: A\n---\n");
-----+        write(&one.join("tasks/1.md"), "---\ntitle: A1\n---\n");
-----+        let two = root.join("openspec/changes/002-b");
-----+        write(&two.join("proposal.md"), "---\ntitle: B\n---\n");
-----+        for number in 1..=3 {
-----+            write(
-----+                &two.join(format!("tasks/{number}.md")),
-----+                &format!("---\ntitle: B{number}\n---\n"),
-----+            );
-----+        }
-----+        Self {
-----+            base: fs::canonicalize(&base).expect("the scratch folder resolves"),
-----+            root: fs::canonicalize(&root).expect("the checkout resolves"),
-----+        }
-----+    }
-----+
-----+    /// Starts the repository on `main`.
-----+    fn init(&self) {
-----+        self.git(&self.root, &["init", "-q", "-b", "main"]);
-----+    }
