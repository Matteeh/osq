-----+            "---\ntitle: T\n---\n",
-----+        );
-----+    }
-----+    write(&change.join(".run/regressed/1.md"), "x\n");
-----+    for number in 1..=3 {
-----+        write(&change.join(format!(".run/dead/{number}.md")), "x\n");
-----+    }
-----+    for number in 1..=4 {
-----+        write(&change.join(format!(".run/running/{number}.pid")), "x\n");
-----+    }
-----+    for number in 1..=2 {
