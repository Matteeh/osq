-----+//! Printing the report's summary as TypeScript's text or sorted JSON.
-----+
-----+use crate::metrics::Metrics;
-----+
-----+/// The text TypeScript's `reportCommand` returns without `--json`, through
-----+/// its completion-rate line and with no trailing newline.
-----+///
-----+/// Implements: rust-report/report-summary
-----+pub(crate) fn text(metrics: &Metrics) -> String {
-----+    let specs = metrics.specs;
-----+    let now = metrics.now;
-----+    format!(
-----+        "osq Delivery Metrics Report
-----+
-----+Specs Summary:
-----+  Total specs: {} ({} active, {} archived)
-----+
-----+Now:
-----+  Total tasks: {}
-----+  Done: {}
-----+  Verified done: {}
-----+  Manual done: {}
-----+  Dead: {}
-----+  Regressed: {}
-----+  Running: {}
-----+  Pending: {}
-----+  Unmarked: {}
-----+  Completion rate: {}%",
-----+        specs.total,
-----+        specs.active,
-----+        specs.archived,
-----+        now.total,
-----+        now.done,
-----+        now.verified,
-----+        now.manual,
-----+        now.dead,
-----+        now.regressed,
-----+        now.running,
-----+        now.pending,
-----+        now.unmarked,
-----+        metrics.completion_rate,
-----+    )
-----+}
-----+
-----+/// The `completionRate`, `now` and `specs` members of TypeScript's report
-----+/// JSON, in sorted key order with two-space indents and no trailing newline.
-----+///
-----+/// Implements: rust-report/report-summary
-----+pub(crate) fn json(metrics: &Metrics) -> String {
-----+    let specs = metrics.specs;
-----+    let now = metrics.now;
-----+    format!(
-----+        "{{
-----+  \"completionRate\": {},
-----+  \"now\": {{
-----+    \"dead\": {},
-----+    \"done\": {},
-----+    \"manual\": {},
-----+    \"pending\": {},
-----+    \"regressed\": {},
-----+    \"running\": {},
-----+    \"total\": {},
-----+    \"unmarked\": {},
-----+    \"verified\": {}
-----+  }},
-----+  \"specs\": {{
-----+    \"active\": {},
-----+    \"archived\": {},
-----+    \"total\": {}
-----+  }}
-----+}}",
-----+        metrics.completion_rate,
-----+        now.dead,
-----+        now.done,
-----+        now.manual,
-----+        now.pending,
-----+        now.regressed,
-----+        now.running,
-----+        now.total,
-----+        now.unmarked,
-----+        now.verified,
-----+        specs.active,
-----+        specs.archived,
-----+        specs.total,
-----+    )
-----+}
