----+//! Proves the report summary, status counts and argument errors.
----+
----+use std::fs;
----+use std::path::{Path, PathBuf};
----+
----+use osq_core::{Feature, FeatureError, Invocation};
----+use osq_feature_report::ReportFeature;
----+use osq_kernel_config::load_config;
----+
----+/// One golden case: its project, lock files and completion rate.
----+struct Case {
----+    /// The golden's base name.
----+    name: &'static str,
----+    /// The fixture project to copy, or none for an empty root.
----+    project: Option<&'static str>,
----+    /// The lock files, as change folder, task id and text.
----+    locks: &'static [(&'static str, &'static str, &'static str)],
----+    /// The completion rate the text ends with.
----+    rate: &'static str,
----+}
----+
----+/// One status-order row and its expected `Now:` lines.
----+struct StatusRow {
----+    /// The proposal file to write, or none.
----+    proposal: Option<&'static str>,
----+    /// The expected task lines, from `Total tasks:` through `Completion rate:`.
----+    expected: &'static [&'static str],
----+}
----+
----+/// The fixture folder holding every project and golden.
----+fn fixtures() -> PathBuf {
----+    Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/fixtures/summary")
----+}
----+
----+/// A fresh scratch folder for one row or case.
----+fn scratch(test: &str, name: &str) -> PathBuf {
----+    let root = Path::new(env!("CARGO_TARGET_TMPDIR"))
----+        .join("report_summary")
----+        .join(test)
----+        .join(name);
----+    let _ = fs::remove_dir_all(&root);
----+    fs::create_dir_all(&root).expect("the scratch folder is created");
----+    root
----+}
----+
----+/// Copies a directory tree recursively.
----+fn copy_dir(from: &Path, to: &Path) {
----+    fs::create_dir_all(to).expect("the destination folder is created");
----+    for entry in fs::read_dir(from)
----+        .expect("the source folder reads")
----+        .flatten()
----+    {
----+        let target = to.join(entry.file_name());
----+        if entry.file_type().expect("the entry type reads").is_dir() {
----+            copy_dir(&entry.path(), &target);
----+        } else {
----+            fs::copy(entry.path(), target).expect("the file is copied");
----+        }
----+    }
----+}
----+
----+/// Writes a file, creating its parent folders.
----+fn write(path: &Path, text: &str) {
----+    fs::create_dir_all(path.parent().expect("the file has a parent"))
----+        .expect("the parent folders are created");
----+    fs::write(path, text).expect("the file is written");
----+}
----+
----+/// Runs `report` with the given arguments and gives its text or error.
----+fn run(root: &Path, args: &[&str]) -> Result<String, FeatureError> {
----+    let args = args.iter().map(|argument| (*argument).to_owned()).collect();
----+    ReportFeature
----+        .run(&Invocation::new(root, "report", args))
----+        .map(|output| output.text)
----+}
----+
----+/// The line that starts with `prefix`.
----+fn line<'a>(text: &'a str, prefix: &str) -> Option<&'a str> {
----+    text.lines().find(|line| line.starts_with(prefix))
----+}
----+
----+/// The five golden cases of "Report summary equals TypeScript's".
----+fn cases() -> [Case; 5] {
----+    [
----+        Case {
----+            name: "empty",
----+            project: None,
----+            locks: &[],
----+            rate: "0",
----+        },
----+        Case {
----+            name: "report-project",
----+            project: Some("report-project"),
----+            locks: &[],
----+            rate: "31.25",
----+        },
----+        Case {
----+            name: "report-project-running",
----+            project: Some("report-project"),
----+            locks: &[
----+                ("003-running", "7", "not json\n"),
----+                ("003-running", "8", "{\"pid\":1,\"startedAt\":1}\n"),
----+            ],
----+            rate: "31.25",
----+        },
----+        Case {
----+            name: "all-done",
----+            project: Some("all-done"),
----+            locks: &[],
----+            rate: "100",
----+        },
----+        Case {
----+            name: "thirds",
----+            project: Some("thirds"),
----+            locks: &[],
----+            rate: "66.67",
----+        },
----+    ]
----+}
----+
----+/// Proves every golden case, its text, its JSON and its completion rate.
----+///
----+/// Covers: rust-report/report-summary-equals-typescript-s
----+#[test]
----+fn report_summary_equals_typescript() {
----+    for case in cases() {
----+        let root = scratch("report_summary_equals_typescript", case.name);
----+        if let Some(project) = case.project {
----+            copy_dir(&fixtures().join(project), &root);
----+        }
----+        for (folder, task, text) in case.locks {
----+            let running = root
----+                .join("openspec/changes")
----+                .join(folder)
----+                .join(".run/running");
----+            write(&running.join(format!("{task}.pid")), text);
----+        }
----+        let text = run(&root, &[]).expect("the report prints");
----+        assert_eq!(
----+            text,
----+            fs::read_to_string(fixtures().join("golden").join(format!("{}.txt", case.name)))
----+                .expect("the golden text reads"),
----+            "{}",
----+            case.name
----+        );
----+        assert_eq!(
----+            line(&text, "  Completion rate: "),
----+            Some(format!("  Completion rate: {}%", case.rate).as_str()),
----+            "{}",
----+            case.name
----+        );
----+        let json = run(&root, &["--json"]).expect("the JSON prints");
----+        assert_eq!(
----+            json,
----+            fs::read_to_string(
----+                fixtures()
----+                    .join("golden")
----+                    .join(format!("{}.json", case.name))
----+            )
----+            .expect("the golden JSON reads"),
----+            "{}",
----+            case.name
----+        );
----+        if case.name == "report-project" {
----+            assert_eq!(
----+                run(&root, &["--json", "--json"]).expect("repeated JSON prints"),
----+                json
----+            );
----+        }
----+    }
----+}
----+
----+/// Proves that a rate whose fraction ends in zero keeps JavaScript's shortest form.
----+///
----+/// Covers: rust-report/report-summary-equals-typescript-s
----+#[test]
----+fn report_rate_drops_a_trailing_zero() {
----+    let root = scratch("report_rate_drops_a_trailing_zero", "root");
----+    let change = root.join("openspec/changes/001-a");
----+    write(&change.join("proposal.md"), "---\ntitle: A\n---\n");
----+    for task in 1..=8 {
----+        write(&change.join(format!("tasks/{task}.md")), "");
----+    }
----+    write(
----+        &change.join(".run/done/1"),
----+        "---\nscope_hash: sha256:1\n---\n",
----+    );
----+    let text = run(&root, &[]).expect("the report prints");
----+    assert_eq!(
----+        line(&text, "  Completion rate: "),
----+        Some("  Completion rate: 12.5%")
----+    );
----+}
