-+//! Reading and writing one whole event line.
-+
-+use serde_json::Value;
-+
-+use super::error::EventError;
-+use super::model::Event;
-+
-+/// One event line: the timestamp as written and the typed event.
-+#[derive(Debug, Clone, PartialEq)]
-+pub struct Envelope {
-+    /// The `timestamp` string exactly as the line holds it.
-+    pub timestamp: String,
-+    /// The typed event the line holds.
-+    pub event: Event,
-+}
-+
-+/// Reads one JSON event line into an [`Envelope`].
-+///
-+/// The line must be one JSON object with exactly the keys `type`, `timestamp`
-+/// and `data`, where `type` is an event type and `data` fits it. Nothing is
-+/// skipped or guessed.
-+///
-+/// # Errors
-+///
-+/// Returns [`EventError::NotJson`] when the line is not one JSON object,
-+/// [`EventError::InvalidEnvelope`] when its keys or `type` and `timestamp` are
-+/// wrong, [`EventError::UnknownType`] when the type is not an event type, and
-+/// [`EventError::InvalidData`] when the data does not fit the type.
-+///
-+/// Implements: rust-core/event-lines-round-trip
-+/// Implements: rust-core/event-read-errors
-+pub fn parse_event_line(line: &str) -> Result<Envelope, EventError> {
-+    let value: Value = serde_json::from_str(line).map_err(|_| EventError::NotJson)?;
-+    let object = value.as_object().ok_or(EventError::NotJson)?;
-+    let exact_keys = object.len() == 3
-+        && object.contains_key("type")
-+        && object.contains_key("timestamp")
-+        && object.contains_key("data");
-+    if !exact_keys {
-+        return Err(EventError::InvalidEnvelope);
-+    }
-+    let type_name = object
-+        .get("type")
-+        .and_then(Value::as_str)
-+        .ok_or(EventError::InvalidEnvelope)?;
-+    let timestamp = object
-+        .get("timestamp")
-+        .and_then(Value::as_str)
-+        .ok_or(EventError::InvalidEnvelope)?;
-+    let data = object
-+        .get("data")
-+        .cloned()
-+        .ok_or(EventError::InvalidEnvelope)?;
-+    let event = Event::from_type_and_data(type_name, data)?;
-+    Ok(Envelope {
-+        timestamp: timestamp.to_owned(),
-+        event,
-+    })
-+}
-+
-+/// Writes an [`Envelope`] back as one JSON line.
-+///
-+/// An optional field absent on read stays absent, a `null` stays `null`, and a
-+/// number keeps its value, so `56` stays `56` and `55.94` stays `55.94`.
-+///
-+/// # Panics
-+///
-+/// Panics when an event cannot be serialized, which the event types make
-+/// impossible: their fields are strings, numbers, arrays and JSON values.
-+///
-+/// Implements: rust-core/event-lines-round-trip
-+#[must_use]
-+pub fn event_line(envelope: &Envelope) -> String {
-+    let mut value = serde_json::to_value(&envelope.event).expect("an event always serializes");
-+    let object = value
-+        .as_object_mut()
-+        .expect("an event is always one JSON object");
-+    object.insert(
-+        "timestamp".to_owned(),
-+        Value::String(envelope.timestamp.clone()),
-+    );
-+    value.to_string()
-+}
