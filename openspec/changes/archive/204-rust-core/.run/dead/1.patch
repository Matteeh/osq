-+//! The four ways reading an event line can fail.
-+
-+use std::fmt;
-+
-+/// Why an event line could not be read exactly.
-+#[derive(Debug, Clone, PartialEq, Eq)]
-+pub enum EventError {
-+    /// The line is not one JSON object.
-+    NotJson,
-+    /// The line's keys are not exactly `type`, `timestamp` and `data`, or
-+    /// `type` or `timestamp` is not a string.
-+    InvalidEnvelope,
-+    /// The type is not one of the event types, named as written.
-+    UnknownType(String),
-+    /// The data does not fit its type: a required field is missing, a field the
-+    /// type does not list is present, or a value is of the wrong JSON kind.
-+    InvalidData(String),
-+}
-+
-+impl fmt::Display for EventError {
-+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
-+        match self {
-+            Self::NotJson => write!(formatter, "line is not one JSON object"),
-+            Self::InvalidEnvelope => write!(
-+                formatter,
-+                "line must hold exactly type, timestamp and data as strings"
-+            ),
-+            Self::UnknownType(name) => write!(formatter, "unknown event type {name}"),
-+            Self::InvalidData(name) => write!(formatter, "data does not fit event type {name}"),
-+        }
-+    }
-+}
-+
-+impl std::error::Error for EventError {}
