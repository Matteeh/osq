-+//! Proves that core depends only on `serde` and `serde_json` and names no IO module.
-+
-+use std::fs;
-+use std::path::{Path, PathBuf};
-+
-+/// The only runtime dependencies core may name.
-+const ALLOWED_DEPENDENCIES: &[&str] = &["serde", "serde_json"];
-+
-+/// Names of IO modules and time sources core source may not mention.
-+const FORBIDDEN_NAMES: &[&str] = &[
-+    "std::fs",
-+    "std::process",
-+    "std::env",
-+    "std::net",
-+    "std::thread",
-+    "SystemTime",
-+    "Instant",
-+];
-+
-+/// Covers: rust-core/core-source-names-no-io-module
-+#[test]
-+fn core_source_names_no_io_module() {
-+    let manifest_dir = Path::new(env!("CARGO_MANIFEST_DIR"));
-+    assert_eq!(dependencies(manifest_dir), ALLOWED_DEPENDENCIES);
-+    let mut files = Vec::new();
-+    collect_rust_files(&manifest_dir.join("src"), &mut files);
-+    assert!(!files.is_empty(), "no source file found");
-+    for file in &files {
-+        let text =
-+            fs::read_to_string(file).unwrap_or_else(|error| panic!("{}: {error}", file.display()));
-+        for forbidden in FORBIDDEN_NAMES {
-+            assert!(
-+                !text.contains(forbidden),
-+                "{} names {forbidden}",
-+                file.display()
-+            );
-+        }
-+    }
-+}
-+
-+/// The keys of the `[dependencies]` table of the crate manifest, in order.
-+fn dependencies(manifest_dir: &Path) -> Vec<String> {
-+    let text = fs::read_to_string(manifest_dir.join("Cargo.toml")).unwrap();
-+    let mut names = Vec::new();
-+    let mut in_dependencies = false;
-+    for line in text.lines() {
-+        let line = line.trim();
-+        if line.starts_with('[') {
-+            in_dependencies = line == "[dependencies]";
-+            continue;
-+        }
-+        if !in_dependencies || line.is_empty() || line.starts_with('#') {
-+            continue;
-+        }
-+        if let Some(name) = line.split(['=', '.']).next() {
-+            names.push(name.trim().to_owned());
-+        }
-+    }
-+    names
-+}
-+
-+/// Collects every `.rs` file under `dir` into `files`.
-+fn collect_rust_files(dir: &Path, files: &mut Vec<PathBuf>) {
-+    for entry in fs::read_dir(dir).unwrap() {
-+        let path = entry.unwrap().path();
-+        if path.is_dir() {
-+            collect_rust_files(&path, files);
-+        } else if path.extension().is_some_and(|extension| extension == "rs") {
-+            files.push(path);
-+        }
-+    }
-+}
