-+//! Proves that every archived event line parses and round-trips unchanged.
-+
-+use std::fs;
-+use std::path::{Path, PathBuf};
-+
-+use osq_core::{event_line, parse_event_line};
-+use serde_json::Value;
-+
-+/// Covers: rust-core/archived-event-logs-round-trip
-+#[test]
-+fn archived_event_logs_round_trip() {
-+    let archive = Path::new(env!("CARGO_MANIFEST_DIR"))
-+        .join("..")
-+        .join("..")
-+        .join("openspec/changes/archive");
-+    let mut files = Vec::new();
-+    collect_event_files(&archive, &mut files);
-+    assert!(
-+        !files.is_empty(),
-+        "no event file under {}",
-+        archive.display()
-+    );
-+    let mut lines_checked = 0_usize;
-+    for file in &files {
-+        let text = fs::read_to_string(file).unwrap();
-+        for (index, line) in text.lines().enumerate() {
-+            if line.trim().is_empty() {
-+                continue;
-+            }
-+            let envelope = parse_event_line(line)
-+                .unwrap_or_else(|error| panic!("{}:{}: {error}", file.display(), index + 1));
-+            let written = event_line(&envelope);
-+            assert_eq!(
-+                serde_json::from_str::<Value>(&written).unwrap(),
-+                serde_json::from_str::<Value>(line).unwrap(),
-+                "{}:{}: round trip",
-+                file.display(),
-+                index + 1
-+            );
-+            lines_checked += 1;
-+        }
-+    }
-+    assert!(
-+        lines_checked > 0,
-+        "no event line under {}",
-+        archive.display()
-+    );
-+}
-+
-+/// Collects every `.jsonl` file under an `events` directory into `files`.
-+fn collect_event_files(dir: &Path, files: &mut Vec<PathBuf>) {
-+    let Ok(entries) = fs::read_dir(dir) else {
-+        return;
-+    };
-+    for entry in entries {
-+        let path = entry.unwrap().path();
-+        if path.is_dir() {
-+            collect_event_files(&path, files);
-+        } else if is_event_file(&path) {
-+            files.push(path);
-+        }
-+    }
-+}
-+
-+/// Whether `path` is a `.jsonl` file directly inside an `events` directory.
-+fn is_event_file(path: &Path) -> bool {
-+    let is_jsonl = path
-+        .extension()
-+        .is_some_and(|extension| extension == "jsonl");
-+    let in_events = path
-+        .parent()
-+        .and_then(Path::file_name)
-+        .is_some_and(|name| name == "events");
-+    is_jsonl && in_events
-+}
