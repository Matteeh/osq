diff --git a/crates/kernel/sync/tests/default_branch_resolution.rs b/crates/kernel/sync/tests/default_branch_resolution.rs
new file mode 100644
index 000000000..c013baf24
--- /dev/null
+++ b/crates/kernel/sync/tests/default_branch_resolution.rs
@@ -0,0 +1,222 @@
+//! Proves listed conflicts resolve to the default branch's version.
+
+mod support;
+
+use std::path::Path;
+
+use osq_core::event::SyncStopReason;
+use osq_kernel_config::{Limits, Timeouts, VcsConfig};
+use osq_kernel_sync::{
+    SyncKind, SyncOptions, SyncOutcome, SyncRequest, SyncStop, sync_change_taking_default,
+};
+use support::{ChangeTree, SyncRepo};
+
+/// The folder every row uses.
+const FOLDER: &str = "001-alpha-orders";
+/// The author every sync commit carries.
+const AUTHOR: &str = "osq <osq@example.invalid>";
+
+/// The options "Conflicts resolved to the default branch" uses.
+fn options() -> SyncOptions {
+    SyncOptions {
+        records: false,
+        verify: true,
+        tasks: None,
+    }
+}
+
+/// The sync repository of "Conflicts resolved to the default branch".
+fn repository(name: &str) -> (SyncRepo, ChangeTree) {
+    let repo = SyncRepo::new(name);
+    repo.main_file("src/two.txt", "one\n", "main adds two");
+    let change = repo.add_worktree(FOLDER);
+    repo.write(&change.path, "src/one.txt", "two\n");
+    repo.write(&change.path, "src/two.txt", "two\n");
+    repo.write(
+        &change.path,
+        &format!("openspec/changes/archive/{FOLDER}/proposal.md"),
+        "---\ntitle: A\nverify: \"true\"\n---\n## Verify\n\nx\n",
+    );
+    repo.commit_all(&change.path, &format!("work on {FOLDER}"));
+    (repo, change)
+}
+
+/// Runs `sync_change_taking_default` on the row's change and paths.
+fn sync(change: &ChangeTree, paths: &[&str]) -> Result<SyncOutcome, SyncStop> {
+    let settings = VcsConfig {
+        author: Some(AUTHOR.to_owned()),
+        ..VcsConfig::default()
+    };
+    let timeouts = Timeouts::default();
+    let limits = Limits::default();
+    let paths: Vec<String> = paths.iter().map(|path| (*path).to_owned()).collect();
+    let request = SyncRequest {
+        worktree: &change.path,
+        folder: &change.folder,
+        kind: SyncKind::Archived,
+        default_branch: "main",
+        settings: &settings,
+        timeouts: &timeouts,
+        limits: &limits,
+        options: options(),
+    };
+    sync_change_taking_default(&request, &paths)
+}
+
+/// One file's text at a commit in `dir`.
+fn file_at(repo: &SyncRepo, dir: &Path, commit: &str, path: &str) -> String {
+    repo.git(dir, &["show", &format!("{commit}:{path}")])
+}
+
+/// Every file a commit holds, in git's order.
+fn tree_files(repo: &SyncRepo, dir: &Path, commit: &str) -> Vec<String> {
+    repo.git(dir, &["ls-tree", "-r", "--name-only", commit])
+        .lines()
+        .map(str::to_owned)
+        .collect()
+}
+
+/// The first row: the listed conflict takes the default branch's text.
+///
+/// Covers: rust-sync/conflicts-resolved-to-the-default-branch
+#[test]
+fn listed_conflict_takes_the_default_branch_version() {
+    let (repo, change) = repository("default_branch_resolution_row_1_listed_conflict");
+    let branch = repo.head(&change.path);
+    repo.main_file("src/one.txt", "main\n", "main edits one");
+    let main = repo.head(repo.checkout());
+
+    let result = sync(&change, &["src/one.txt"]);
+
+    let commit = match result {
+        Ok(SyncOutcome::Synced { commit }) => commit,
+        other => panic!("the sync commits: {other:?}"),
+    };
+    assert_eq!(repo.head(&change.path), commit);
+    assert_eq!(
+        repo.message(&commit),
+        "osq: 001 sync main\n\nOsq-Change: 001-alpha-orders\n"
+    );
+    assert_eq!(
+        file_at(&repo, &change.path, &commit, "src/one.txt"),
+        "main\n"
+    );
+    assert_eq!(
+        file_at(&repo, &change.path, &commit, "src/two.txt"),
+        "two\n"
+    );
+    let parents = repo.git(&change.path, &["rev-list", "--parents", "-n", "1", &commit]);
+    let parents: Vec<&str> = parents.split_whitespace().collect();
+    assert_eq!(parents.len(), 3);
+    assert_eq!(parents[1], branch);
+    assert_eq!(parents[2], main);
+    assert!(!repo.git_path(&change.path, "MERGE_HEAD").exists());
+}
+
+/// The second row: a listed conflict the default branch removed is removed.
+///
+/// Covers: rust-sync/conflicts-resolved-to-the-default-branch
+#[test]
+fn listed_conflict_removed_on_the_default_branch_is_removed() {
+    let (repo, change) = repository("default_branch_resolution_row_2_removed");
+    repo.git(repo.checkout(), &["rm", "-q", "src/one.txt"]);
+    repo.commit_all(repo.checkout(), "main removes one");
+
+    let result = sync(&change, &["src/one.txt"]);
+
+    let commit = match result {
+        Ok(SyncOutcome::Synced { commit }) => commit,
+        other => panic!("the sync commits: {other:?}"),
+    };
+    assert_eq!(repo.head(&change.path), commit);
+    assert!(!tree_files(&repo, &change.path, &commit).contains(&"src/one.txt".to_owned()));
+    assert_eq!(
+        file_at(&repo, &change.path, &commit, "src/two.txt"),
+        "two\n"
+    );
+    assert!(!repo.git_path(&change.path, "MERGE_HEAD").exists());
+}
+
+/// The third row: an unlisted conflict still stops the sync.
+///
+/// Covers: rust-sync/conflicts-resolved-to-the-default-branch
+#[test]
+fn unlisted_conflict_still_stops_the_sync() {
+    let (repo, change) = repository("default_branch_resolution_row_3_unlisted");
+    let branch = repo.head(&change.path);
+    repo.main_file("src/one.txt", "main\n", "main edits one");
+
+    let result = sync(&change, &["src/other.txt"]);
+
+    assert_eq!(
+        result,
+        Err(SyncStop {
+            reason: SyncStopReason::SyncConflict,
+            message: "001-alpha-orders: src/one.txt conflict with main; run osq plan 001, and approving the revised plan restarts osq/001-alpha-orders from main".to_owned(),
+            conflicts: vec!["src/one.txt".to_owned()],
+        })
+    );
+    assert_eq!(repo.head(&change.path), branch);
+    assert!(!repo.git_path(&change.path, "MERGE_HEAD").exists());
+}
+
+/// The fourth row: only the unlisted conflict stops the sync.
+///
+/// Covers: rust-sync/conflicts-resolved-to-the-default-branch
+#[test]
+fn only_the_unlisted_conflict_stops_the_sync() {
+    let (repo, change) = repository("default_branch_resolution_row_4_remaining");
+    let branch = repo.head(&change.path);
+    repo.write(repo.checkout(), "src/one.txt", "main\n");
+    repo.write(repo.checkout(), "src/two.txt", "main\n");
+    repo.commit(
+        repo.checkout(),
+        "main edits both",
+        &["src/one.txt", "src/two.txt"],
+    );
+
+    let result = sync(&change, &["src/one.txt"]);
+
+    assert_eq!(
+        result,
+        Err(SyncStop {
+            reason: SyncStopReason::SyncConflict,
+            message: "001-alpha-orders: src/two.txt conflict with main; run osq plan 001, and approving the revised plan restarts osq/001-alpha-orders from main".to_owned(),
+            conflicts: vec!["src/two.txt".to_owned()],
+        })
+    );
+    assert_eq!(repo.head(&change.path), branch);
+    assert!(!repo.git_path(&change.path, "MERGE_HEAD").exists());
+}
+
+/// The fifth row: every listed conflict resolves and the merge commits.
+///
+/// Covers: rust-sync/conflicts-resolved-to-the-default-branch
+#[test]
+fn every_listed_conflict_resolves() {
+    let (repo, change) = repository("default_branch_resolution_row_5_every");
+    repo.write(repo.checkout(), "src/one.txt", "main\n");
+    repo.write(repo.checkout(), "src/two.txt", "main\n");
+    repo.commit(
+        repo.checkout(),
+        "main edits both",
+        &["src/one.txt", "src/two.txt"],
+    );
+
+    let result = sync(&change, &["src/one.txt", "src/two.txt"]);
+
+    let commit = match result {
+        Ok(SyncOutcome::Synced { commit }) => commit,
+        other => panic!("the sync commits: {other:?}"),
+    };
+    assert_eq!(repo.head(&change.path), commit);
+    assert_eq!(
+        file_at(&repo, &change.path, &commit, "src/one.txt"),
+        "main\n"
+    );
+    assert_eq!(
+        file_at(&repo, &change.path, &commit, "src/two.txt"),
+        "main\n"
+    );
+    assert!(!repo.git_path(&change.path, "MERGE_HEAD").exists());
+}
