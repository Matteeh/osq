+        TaskRow {
+            text: "---\r\ntitle: CR\r\nscope: x\r\n---\r\n## Acceptance\r\n- [ ] Line.\r\n",
+            title: "CR",
+            verify: "",
+            scope: &[],
+            entry: &[],
+            skills: &[],
+            tests_modify: false,
+            verify_starts: VerifyStarts::Red,
+            acceptance: &["Line."],
