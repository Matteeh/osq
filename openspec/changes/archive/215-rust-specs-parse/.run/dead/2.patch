+            text: "---\ntitle: T\ntests:\n  modify: \"yes\"\ntests.modify: true\n---\n",
+            title: "T",
+            verify: "",
+            scope: &[],
+            entry: &[],
+            skills: &[],
+            tests_modify: true,
+            verify_starts: VerifyStarts::Red,
+            acceptance: &[],
