al: Vec<String> = folders(&repository_root().join(FIXTURES))\\n        .iter()\\n        .map(|path| name_of(path))\\n        .collect();\\n    let expected: Vec<String> = CASE_NAMES.iter().map(|name| (*name).to_string()).collect();\\n    assert_eq!(expected, actual, \\\"the differential case folders\\\");\\n}\\n\", \"path\": \"/home/mathias/.osq/worktrees/osq/219-rust-specs-parity/crates/kernel/specs/tests/openspec_archive_parity_corpus.rs\"}"},"time":{"start":1792395018539,"end":1792395020984}}}}
