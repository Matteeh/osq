th that no longer exists', async () => {\n    const sourceDir = await makeTree({ 'harness/types.ts': 10 });\n\n    const violations = await checkLineBudget(sourceDir, ['core/spec/gone.ts'], MAX_LINES);\n\n    assert.deepEqual(violations, ['src/core/spec/gone.ts no longer exists']);\n  });\n\n  it('returns no violations for a clean tree', async () => {\n    const sourceDir = await makeTree({ 'core/a.ts': 200, 'harness/b.ts': 20 });\n\n    const violations = await checkLineBudget(sourceDir, [], MAX_LINES);\n\n    assert.deepEqual(violations, []);\n  });\n\n  it('ignores declaration files', async () => {\n    const sourceDir = await makeTree({ 'harness/types.d.ts': 300, 'harness/types.ts': 5 });\n\n    const violations = await checkLineBudget(sourceDir, [], MAX_LINES);\n\n    assert.deepEqual(violations, []);\n  });\n8:const ROOT = path.resolve(fileURLToPath(new URL('..', import.meta.url)));\n9:const SRC_DIR = path.join(ROOT, 'src');\n10:const UI_SRC_DIR = path.join(ROOT, 'packages', 'ui', 'src');\n75:        violations.push(`${path.relative(ROOT, file)} has ${lineCount} lines (max ${MAX_LINES})`);\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"sed -n '1,80p' tests/line-budget-check.test.ts; grep -n \\\"crates\\\\|ROOT\\\\|roots\\\" tests/line-budget.test.ts | head -30\"}"},"time":{"start":1792394764731,"end":1792394764753}}}}
