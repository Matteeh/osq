ect\");\n30:     let repo = repository_root();\n31:     let cli = OpenSpecCli::locate(&repo);\n32:     let openspec = scaffold(&format!(\"archive-{name}-openspec\"), &case);\n33:     let rust = scaffold(&format!(\"archive-{name}-rust\"), &case);\n34:     let changes = folders(&rust.root().join(\"openspec/changes\"));\n35:     let first = changes\n36:         .first()\n37:         .map_or_else(|| panic!(\"case {name} has no change\"), PathBuf::as_path);\n38:     let cli_specs = openspec.root().join(\"openspec/specs\");\n39:     let rust_specs = rust.root().join(\"openspec/specs\");\n40:     match expect {\n41:         \"identical\" => assert_identical(&cli, &openspec, &rust_specs, &changes),\n42:         \"both-refuse\" => assert_both_refuse(&cli, first, &cli_specs, &rust_specs, &case),\n43:         \"osq-refuses\" => assert_osq_refuses(&cli, first, &cli_specs, &rust_specs, &case),\n44:         other => panic!(\"case {name} has unknown expect `{other}`\"),\n45:     }\n46: }\n47: \n48: /// Reads one file, naming it when that fails.\n49: fn read(path: &Path) -> String {\n50:     std::fs::read_to_string(path)\n51:         .unwrap_or_else(|error| panic!(\"reading {}: {error}\", path.display()))\n52: }\n53: \n54: /// Builds one temporary project with the scaffold, the case's specs and changes.\n55: fn scaffold(name: &str, case: &Path) -> Project {\n56:     let project = Project::prepare(name, &repository_root()).expect(\"the project writes\");\n57:     let specs = case.join(\"specs\");\n58:     project\n59:         .set_specs(specs.is_dir().then_some(specs.as_path()))\n60:         .expect(\"the case specs copy\");\n61:     copy_tree(\n62:         &case.join(\"changes\"),\n63:         &project.root().join(\"openspec/changes\"),\n64:     )\n65:     .expect(\"the case changes copy\");\n66:     project\n67: }\n68: \n69: /// Runs the CLI, asserting it exits zero.\n70: fn run_ok(cli: &OpenSpecCli, args: &[&str], cwd: &Path) {\n71:     let output = cli.run(args, cwd);\n72:     assert!(\n73:         output.status.success(),\n74:         \"{}: {} failed:\\n{}\",\n75:         cli.path().display(),\n76:         args.join(\" \"),\n77:         text_of(&output)\n78:     );\n79: }\n80: \n81: /// A case both tools accept: each change validates and archives in the CLI\n82: /// project, the Rust merge applies each change, and the specs trees match.\n83: fn assert_identical(cli: &OpenSpecCli, openspec: &Project, rust_specs: &Path, changes: &[PathBuf]) {\n84:     for change in changes {\n85:         let name = name_of(change);\n86:         let args = [\"validate\", &name, \"--type\", \"change\", \"--strict\", \"--json\"];\n87:         let args = [&args[..], &[\"--no-interactive\"]].concat();\n88:         run_ok(cli, &args, openspec.root());\n89:     }\n90:     for change in changes {\n91:         let name = name_of(change);\n92:         run_ok(cli, &[\"archive\", &name, \"--yes\", \"--json\"], openspec.root());\n93:         merge_into(change, rust_specs);\n94:     }\n95:     assert_trees_equal(\n96:         &openspec.root().join(\"openspec/specs\"),\n97:         rust_specs,\n98:         \"the specs trees\",\n99:     );\n100: }\n101: \n102: /// A case both tools refuse: the CLI reports `archive_spec_update_failed`, the\n103: /// Rust merge refuses, and neither tree changes.\n104: fn assert_both_refuse(\n105:     cli: &OpenSpecCli,\n106:     first: &Path,\n107:     cli_specs: &Path,\n108:     rust_specs: &Path,\n109:     case: &Path,\n110: ) {\n111:     let name = name_of(first);\n112:     let archive = cli.run(&[\"archive\", &name, \"--yes\", \"--json\"], cli_specs);\n113:     assert!(\n114:         !archive.status.success(),\n115:         \"archive {name} unexpectedly succeeded:\\n{}\",\n116:         text_of(&archive)\n117:     );\n118:     let value: Value = serde_json::from_slice(&archive.stdout)\n119:         .unwrap_or_else(|error| panic!(\"archive {name} printed no JSON: {error}\"));\n120:     let refused = value\n121:         .get(\"status\")\n122:         .and_then(Value::as_array)\n123:         .is_some_and(|entries| {\n124:             entries.iter().any(|entry| {\n125:                 entry.get(\"code\").and_then(Value::as_str) == Some(\"archive_spec_update_failed\")\n126:             })\n127:         });\n128:     assert!(\n129:         refused,\n130:         \"archive {name} reported no archive_spec_update_failed\"\n131:     );\n132:     match merge_change(first, rust_specs) {\n133:         Err(MergeChangeError::Merge { .. }) => {}\n134:         other => panic!(\n135:             \"{}: the Rust merge should refuse, got {other:?}\",\n136:             first.display()\n137:         ),\n138:     }\n139:     let case_specs = case.join(\"specs\");\n140:     assert_trees_equal(cli_specs, &case_specs, \"the OpenSpec tree\");\n141:     assert_trees_equal(rust_specs, &case_specs, \"the Rust tree\");\n142: }\n143: \n144: /// A case the Rust merge refuses and the CLI accepts: the refusal names the\n145: /// expected rename form, and no living spec holds a rename target.\n146: fn assert_osq_refuses(\n147:     cli: &OpenSpecCli,\n148:     first: &Path,\n149:     cli_specs: &Path,\n150:     rust_specs: &Path,\n151:     case: &Path,\n152: ) {\n153:     let message = match merge_change(first, rust_specs) {\n154:         Err(MergeChangeError::Merge { error, .. }) => error.to_string(),\n155:         other => panic!(\n156:             \"{}: expected a merge refusal, got {other:?}\",\n157:             first.display()\n158:         ),\n159:     };\n160:     assert!(\n161:         message.contains(\"### Requirement:\"),\n162:         \"{}: the refusal must name the expected form: {message}\",\n163:         first.display()\n164:     );\n165:     let name = name_of(first);\n166:     run_ok(cli, &[\"archive\", &name, \"--yes\", \"--json\"], cli_specs);\n167:     let living = tree(cli_specs);\n168:     for target in rename_targets(&case.join(\"changes\")) {\n169:         let header = format!(\"### Requirement: {target}\");\n170