t differential test reads them.\n172: fn rename_targets(changes: &Path) -> Vec<String> {\n173:     let mut targets = Vec::new();\n174:     for change in folders(changes) {\n175:         for capability in folders(&change.join(\"specs\")) {\n176:             let text = read(&capability.join(\"spec.md\"));\n177:             for line in text.lines() {\n178:                 let rest = line.trim_start().trim_start_matches(['-', '*', '+']);\n179:                 if let Some(name) = to_target(rest.trim_start()) {\n180:                     targets.push(name);\n181:                 }\n182:             }\n183:         }\n184:     }\n185:     targets\n186: }\n187: \n188: /// The requirement name a `TO:` line names, or none for any other line.\n189: fn to_target(rest: &str) -> Option<String> {\n190:     let head = rest.get(..3).filter(|h| h.eq_ignore_ascii_case(\"TO:\"))?;\n191:     let name = rest[head.len()..].trim().trim_matches('`').trim();\n192:     let prefix = name\n193:         .get(..16)\n194:         .filter(|h| h.eq_ignore_ascii_case(\"### Requirement:\"));\n195:     let name = prefix.map_or(name, |prefix| name[prefix.len()..].trim());\n196:     (!name.is_empty()).then(|| name.to_string())\n197: }\n198: \n199: /// Runs one differential case: builds both projects, then checks its expectation.\n200: fn run_case(name: &str) {\n201:     let case = repository_root().join(FIXTURES).join(name);\n202:     let value: Value = serde_json::from_str(&read(&case.join(\"case.json\"))).expect(\"the case\");\n203:     let expect = value\n204:         .get(\"expect\")\n205:         .and_then(Value::as_str)\n206:         .expect(\"an expect\");\n207:     let cli = OpenSpecCli::locate(&repository_root());\n208:     let openspec = scaffold(&format!(\"archive-{name}-openspec\"), &case);\n209:     let rust = scaffold(&format!(\"archive-{name}-rust\"), &case);\n210:     let changes = folders(&rust.root().join(\"openspec/changes\"));\n211:     let first = changes\n212:         .first()\n213: 