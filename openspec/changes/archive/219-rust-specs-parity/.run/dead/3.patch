erge applies every change\");\n    for name in names {\n        let validate = cli.run(\n            &[\n                \"validate\",\n                name,\n                \"--type\",\n                \"change\",\n                \"--strict\",\n                \"--json\",\n                \"--no-interactive\",\n            ],\n            cli_project.root(),\n        );\n        assert!(\n            validate.status.success(),\n            \"case {case}: validate {name} failed: {}\",\n            text_of(&validate)\n        );\n        let archive = cli_archive(cli, cli_project, name);\n        assert!(\n            archive.status.success(),\n            \"case {case}: archive {name} failed: {}\",\n            text_of(&archive)\n        );\n    }\n    let cli_tree = tree_of(&specs_of(cli_project));\n    assert!(\n        !cli_tree.is_empty(),\n        \"case {case}: the CLI archived no living spec\"\n    );\n    assert_eq!(\n        cli_tree,\n        tree_of(&specs_of(rust_project)),\n        \"case {case}: the two openspec/specs trees differ\"\n    );\n}\n\n/// Runs a `both-refuse` case: both tools refuse the first change and neither\n/// tree moves.\nfn both_refuse_case(\n    case: &str,\n    dir: &Path,\n    cli: &OpenSpecCli,\n    cli_project: &Project,\n    rust_project: &Project,\n) {\n    let names = change_names(dir);\n    let error = rust_merge(rust_project, &names).expect_err(\"the Rust merge refuses\");\n    refusal_message(&error, case);\n    let name = first_name(&names);\n    let archive = cli_archive(cli, cli_project, name);\n    assert!(\n        !archive.status.success(),\n        \"case {case}: archive {name} unexpectedly succeeded: {}\",\n        text_of(&archive)\n    );\n    assert!(\n        status_codes(&archive.stdout)\n            .iter()\n            .any(|code| code == \"archive_spec_update_failed\"),\n        \"case {case}: archive {name} did not report archive_spec_update_failed: {}\",\n        text_of(&archive)\n    );\n    let expected = tree_of(&dir.join(\"specs\"));\n    assert_eq!(\n        tree_of(&specs_of(cli_project)),\n        expected,\n        \"case {case}: the CLI changed the specs\"\n    );\n    assert_eq!(\n        tree_of(&specs_of(rust_project)),\n        expected,\n        \"case {case}: the Rust merge changed the specs\"\n    );\n}\n\n/// Runs an `osq-refuses` case: the Rust merge refuses naming the expected\n/// form, the CLI archives, and no renamed name lands.\nfn osq_refuses_case(\n    case: &str,\n    dir: &Path,\n    cli: &OpenSpecCli,\n    cli_project: &Project,\n    rust_project: &Project,\n) {\n    let names = change_names(dir);\n    let error = rust_merge(rust_project, &names).expect_err(\"the Rust merge refuses\");\n    let message = refusal_message(&error, case);\n    assert!(\n        message.contains(\"### Requirement:\"),\n        \"case {case}: the refusal must name the expected form: {message}\"\n    );\n    let name = first_name(&names);\n    let archive = cli_archive(cli, cli_project, name);\n    assert!(\n        archive.status.success(),\n        \"case {case}: archive {name} unexpectedly failed: {}\",\n        text_of(&archive)\n    );\n    let living = tree_of(&specs_of(cli_project));\n    for target in rename_targets(dir) {\n        let marker = format!(\"### Requirement: {target}\");\n        assert!(\n            !living.values().any(|text| text.contains(&marker)),\n            \"case {case}: OpenSpec applied a rename it should skip: {target}\"\n        );\n    }\n}"},"output":"Edited crates/kernel/specs/tests/openspec_archive_parity_corpus.rs (1 replacement)","title":"edit","metadata":{"metadata":{"files":[{"file":"crates/kernel/specs/tests/openspec_archive_parity_corpus.rs","patch":"Index: crates/kernel/specs/tests/openspec_archive_parity_corpus.rs\n===================================================================\n--- crates/kernel/specs/tests/openspec_archive_parity_corpus.rs\n+++ crates/kernel/specs/tests/openspec_archive_parity_corpus.rs\n@@