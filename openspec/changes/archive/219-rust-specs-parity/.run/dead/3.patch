-{"type":"tool_use","timestamp":1792396213028,"sessionID":"ses_eacf54832ffeFAS4YOYdKea9Bo","part":{"partID":"prt_15323b9bb0023WmBIPnlmhHdc7","sessionID":"ses_eacf54832ffeFAS4YOYdKea9Bo","messageID":"msg_15323b2e6001bi4A2AIbwy0zIs","type":"tool","id":"call_ef4a61a877bc452da8085073","tool":"read","state":{"status":"completed","input":{"path":"/home/mathias/.osq/worktrees/osq/219-rust-specs-parity/crates/kernel/specs/tests/openspec_archive_parity_corpus.rs"},"output":"Read file /home/mathias/.osq/worktrees/osq/219-rust-specs-parity/crates/kernel/specs/tests/openspec_archive_parity_corpus.rs, lines 1-250\n1: //! Corpus test: the Rust merge matches `OpenSpec` archive on the differential\n2: //! cases under `tests/fixtures/openspec-diff/`; only `parity` builds it.\n3: \n4: pub mod openspec_parity_support;\n5: \n6: use openspec_parity_support::cli::{OpenSpecCli, text_of};\n7: use openspec_parity_support::project::Project;\n8: use openspec_parity_support::trees::{copy_tree, folders, name_of, read_tree, repository_root};\n9: use osq_kernel_specs::{MergeChangeError, merge_change};\n10: use serde_json::Value;\n11: use std::collections::BTreeMap;\n12: use std::path::{Path, PathBuf};\n13: \n14: /// The differential fixtures, relative to the repository root.\n15: const FIXTURES: &str = \"tests/fixtures/openspec-diff\";\n16: \n17: /// Reads one file as text.\n18: fn read(path: &Path) -> String {\n19:     std::fs::read_to_string(path).unwrap_or_else(|e| panic!(\"reading {}: {e}\", path.display()))\n20: }\n21: \n22: /// Every file under `root` as its `/`-joined path and text, or none.\n23: fn tree(root: &Path) -> BTreeMap<String, String> {\n24:     if !root.is_dir() {\n25:         return BTreeMap::new();\n26:     }\n27:     read_tree(root).expect(\"a tree reads\")\n28: }\n29: \n30: /// Builds a temporary project with the scaffold, the case's specs and changes.\n31: fn scaffold(name: &str, case: &Path) -> Project {\n32:     let project = Project::prepare(name, &repository_root()).expect(\"the project writes\");\n33:     let specs = case.join(\"specs\");\n34:     project\n35:         .set_specs(specs.is_dir().then_some(specs.as_path()))\n36:         .expect(\"the case specs copy\");\n37:     let changes = project.root().join(\"openspec/changes\");\n38:     copy_tree(&case.join(\"changes\"), &changes).expect(\"the case changes copy\");\n39:     project\n40: }\n41: \n42: /// Runs the CLI, asserting it exits zero.\n43: fn run_ok(cli: &OpenSpecCli, args: &[&str], cwd: &Path) {\n44:     let output = cli.run(args, cwd);\n45:     assert!(\n46:         output.status.success(),\n47:         \"{}: {} failed:\\n{}\",\n48:         cli.path().display(),\n49:         args.join(\" \"),\n50:         text_of(&output)\n51:     );\n52: }\n53: \n54: /// Merges one change into `specs`, writing or removing each merged spec.\n55: fn merge_into(change: &Path, specs: &Path) {\n56:     let merged = merge_change(change, specs)\n57:         .unwrap_or_else(|error| panic!(\"{}: the merge refuses: {error}\", change.display()));\n58:     for spec in merged {\n59:         let folder = specs.join(&spec.capability);\n60:         if let Some(text) = &spec.text {\n61:             std::fs::create_dir_all(&folder).expect(\"the capability folder\");\n62:             std::fs::write(folder.join(\"spec.md\"), text).expect(\"the merged spec\");\n63:         } else {\n64:             let _ = std::fs::remove_dir_all(&folder);\n65:         }\n66:     }\n67: }\n68: \n69: /// A case both tools accept: each change validates and archives in the CLI\n70: /// project, the merge applies each change, and the specs trees match.\n71: fn assert_identical(cli: &OpenSpecCli, openspec: &Project, rust_specs: &Path, changes: &[PathBuf]) {\n72:     for change in changes {\n73:         let name = name_of(change);\n74:         let args = [\n75:             \"validate\",\n76:             &name,\n77:             \"--type\",\n78:             \"change\",\n79:             \"--strict\",\n80:             \"--json\",\n81:             \"--no-interactive\",\n82:         ];\n83:         run_ok(cli, &args, openspec.root());\n84:     }\n85:     for change in changes {\n86:         let name = name_of(change);\n87:         run_ok(cli, &[\"archive\", &name, \"--yes\", \"--json\"], openspec.root());\n88:         merge_into(change, rust_specs);\n89:     }\n90:     let cli_specs = openspec.root().join(\"openspec/specs\");\n91:     let cli_tree = tree(&cli_specs);\n92:     assert!(!cli_tree.is_empty(), \"the CLI archived no spec\");\n93:     assert_eq!(cli_tree, tree(rust_specs), \"the two specs trees\");\n94: }\n95: \n96: /// A case both tools refuse: the CLI reports `archive_spec_update_failed`, the\n97: /// merge refuses, and neither tree changes.\n98: fn assert_both_refuse(\n99:     cli: &OpenSpecCli,\n100:     project: &Project,\n101:     first: &Path,\n102:     rust_specs: &Path,\n103:     case: &Path,\n104: ) {\n105:     let name = name_of(first);\n106:     let archive = cli.run(&[\"archive\", &name, \"--yes\", \"--json\"], project.root());\n107:     let value: Value = serde_json::from_slice(&archive.stdout).unwrap_or(Value::Null);\n108:     let status = value.get(\"status\").and_then(Value::as_array);\n109:     let refused = status.is_some_and(|entries| {\n110:         entries\n111:             .iter()\n112:             .any(|e| e.get(\"code\").and_then(Value::as_str) == Some(\"archive_spec_update_failed\"))\n113:     });\n114:     assert!(\n115:         !archive.status.success() && refused,\n116:         \"archive {name} did not report archive_spec_update_failed:\\n{}\",\n117:         text_of(&archive)\n118:     );\n119:     let refused = matches!(\n120:         merge_change(first, rust_specs),\n121:         Err(MergeChangeError::Merge { .. })\n122:     );\n123:     assert!(refused, \"{}: the merge should refuse\", first.display());\n124:     let cli_specs = project.root().join(\"openspec/specs\");\n125:     let case_specs = case.join(\"specs\");\n126:     assert_eq!(tree(&cli_specs), tree(&case_specs), \"the OpenSpec tree\");\n127:     assert_eq!(tree(rust_specs), tree(&case_specs), \"the Rust tree\");\n128: }\n129: \n130: /// A case the Rust merge refuses and the CLI accepts: the refusal names the\n131: /// expected rename form, and no living spec holds a rename target.\n132: fn assert_osq_refuses(\n133:     cli: &OpenSpecCli,\n134:     project: &Project,\n135:     first: &Path,\n136:     rust_specs: &Path,\n137:     case: &Path,\n138: ) {\n139:     let Err(MergeChangeError::Merge { error, .. }) = merge_change(first, rust_specs) else {\n140:         panic!(\"{}: expected a merge refusal\", first.display());\n141:     };\n142:     assert!(\n143:         error.to_string().contains(\"### Requirement:\"),\n144:         \"{}: the refusal must name the expected form: {error}\",\n145:         first.display()\n146:     );\n147:     let name = name_of(first);\n148:     run_ok(cli, &[\"archive\", &name, \"--yes\", \"--json\"], project.root());\n149:     let living = tree(&project.root().join(\"openspec/specs\"));\n150:     for target in rename_targets(&case.join(\"changes\")) {\n151:         let header = format!(\"### Requirement: {target}\");\n152:         assert!(\n153:             !living.values().any(|text| text.contains(&header)),\n154:             \"the case applied a rename OpenSpec should skip: {target}\"\n155:         );\n156:     }\n157: }\n158: \n159: /// The requirement names the case's delta specs give a `TO:` line, as the\n160: /// TypeScript differential test reads them.\n161: fn rename_targets(changes: &Path) -> Vec<String> {\n162:     let mut targets = Vec::new();\n163:     for change in folders(changes) {\n164:         for capability in folders(&change.join(\"specs\")) {\n165:             let text = read(&capability.join(\"spec.md\"));\n166:             for line in text.lines() {\n167:                 let rest = line\n168:                     .trim_start()\n169:                     .trim_start_matches(['-', '*', '+'])\n170:                     .trim_start();\n171:                 let Some(rest) = rest\n172:                     .strip_prefix(\"TO:\")\n173:                     .or_else(|| rest.strip_prefix(\"to:\"))\n174:                 else {\n175:                     continue;\n176:                 };\n177:                 let name = rest.trim().trim_matches('`').trim();\n178:                 let name = name.strip_prefix(\"### Requirement: \").unwrap_or(name);\n179:                 if !name.trim().is_empty() {\n180:                     targets.push(name.trim().to_string());\n181:                 }\n182:             }\n183:         }\n184:     }\n185:     targets\n186: }\n187: \n188: /// Runs one differential case: builds both projects, then checks its expectation.\n189: fn run_case(name: &str) {\n190:     let case = repository_root().join(FIXTURES).join(name);\n191:     let value: Value = serde_json::from_str(&read(&case.join(\"case.json\"))).expect(\"the case\");\n192:     let expect = value\n193:         .get(\"expect\")\n194:         .and_then(Value::as_str)\n195:         .expect(\"an expect\");\n196:     let cli = OpenSpecCli::locate(&repository_root());\n197:     let openspec = scaffold(&format!(\"archive-{name}-openspec\"), &case);\n198:     let rust = scaffold(&format!(\"archive-{name}-rust\"), &case);\n199:     let changes = folders(&rust.root().join(\"openspec/changes\"));\n200:     let first = changes\n201:         .first()\n202:         .map_or_else(|| panic!(\"case {name} has no change\"), PathBuf::as_path);\n203:     let rust_specs = rust.root().join(\"openspec/specs\");\n204:     match expect {\n205:         \"identical\" => assert_identical(&cli, &openspec, &rust_specs, &changes),\n206:         \"both-refuse\" => assert_both_refuse(&cli, &openspec, first, &rust_specs, &case),\n207:         \"osq-refuses\" => assert_osq_refuses(&cli, &openspec, first, &rust_specs, &case),\n208:         other => panic!(\"case {name} has unknown expect `{other}`\"),\n209:     }\n210: }\n211: \n212: /// Declares one corpus test per differential case, in byte order.\n213: macro_rules! case_tests {\n214:     ($($fn_name:ident => $case:literal),* $(,)?) => {\n215:         /// The differential case names, in byte order.\n216:         const CASE_NAMES: &[&str] = &[$($case),*];\n217: \n218:         $(\n219:             /// Covers: rust-specs/archive-cases-match-openspec\n220:             #[ignore = \"corpus test: runs the OpenSpec CLI on the differential cases\"]\n221:             #[test]\n222:             fn $fn_name() { run_case($case); }\n223:         )*\n224:     };\n225: }\n226: \n227: case_tests! {\n228:     added => \"added\",\n229:     bare_rename => \"bare-rename\",\n230:     dropped_scenario => \"dropped-scenario\",\n231:     duplicate_added => \"duplicate-added\",\n232:     given_and => \"given-and\",\n233:     modified => \"modified\",\n234:     new_capability => \"new-capability\",\n235:     removed => \"removed\",\n236:     renamed => \"renamed\",\n237:     second_change => \"second-change\",\n238: }\n239: \n240: /// Covers: rust-specs/archive-cases-match-openspec\n241: #[ignore = \"corpus test: runs the OpenSpec CLI on the differential cases\"]\n242: #[test]\n243: fn cases_are_exactly_the_fixture_folders() {\n244:     let actual: Vec<String> = folders(&repository_root().join(FIXTURES))\n245:         .iter()\n246:         .map(|path| name_of(path))\n247:         .collect();\n248:     let expected: Vec<String> = CASE_NAMES.iter().map(|name| (*name).to_string()).collect();\n249:     assert_eq!(expected, actual, \"the differential case folders\");\n250: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file /home/mathias/.osq/worktrees/osq/219-rust-specs-parity/crates/kernel/specs/tests/openspec_archive_parity_corpus.rs, lines 1-250\n1: //! Corpus test: the Rust merge matches `OpenSpec` archive on the differential\n2: //! cases under `tests/fixtures/openspec-diff/`; only `parity` builds it.\n3: \n4: pub mod openspec_parity_support;\n5: \n6: use openspec_parity_support::cli::{OpenSpecCli, text_of};\n7: use openspec_parity_support::project::Project;\n8: use openspec_parity_support::trees::{copy_tree, folders, name_of, read_tree, repository_root};\n9: use osq_kernel_specs::{MergeChangeError, merge_change};\n10: use serde_json::Value;\n11: use std::collections::BTreeMap;\n12: use std::path::{Path, PathBuf};\n13: \n14: /// The differential fixtures, relative to the repository root.\n15: const FIXTURES: &str = \"tests/fixtures/openspec-diff\";\n16: \n17: /// Reads one file as text.\n18: fn read(path: &Path) -> String {\n19:     std::fs::read_to_string(path).unwrap_or_else(|e| panic!(\"reading {}: {e}\", path.display()))\n20: }\n21: \n22: /// Every file under `root` as its `/`-joined path and text, or none.\n23: fn tree(root: &Path) -> BTreeMap<String, String> {\n24:     if !root.is_dir() {\n25:         return BTreeMap::new();\n26:     }\n27:     read_tree(root).expect(\"a tree reads\")\n28: }\n29: \n30: /// Builds a temporary project with the scaffold, the case's specs and changes.\n31: fn scaffold(name: &str, case: &Path) -> Project {\n32:     let project = Project::prepare(name, &repository_root()).expect(\"the project writes\");\n33:     let specs = case.join(\"specs\");\n34:     project\n35:         .set_specs(specs.is_dir().then_some(specs.as_path()))\n36:         .expect(\"the case specs copy\");\n37:     let changes = project.root().join(\"openspec/changes\");\n38:     copy_tree(&case.join(\"changes\"), &changes).expect(\"the case changes copy\");\n39:     project\n40: }\n41: \n42: /// Runs the CLI, asserting it exits zero.\n43: fn run_ok(cli: &OpenSpecCli, args: &[&str], cwd: &Path) {\n44:     let output = cli.run(args, cwd);\n45:     assert!(\n46:         output.status.success(),\n47:         \"{}: {} failed:\\n{}\",\n48:         cli.path().display(),\n49:         args.join(\" \"),\n50:         text_of(&output)\n51:     );\n52: }\n53: \n54: /// Merges one change into `specs`, writing or removing each merged spec.\n55: fn merge_into(change: &Path, specs: &Path) {\n56:     let merged = merge_change(change, specs)\n57:         .unwrap_or_else(|error| panic!(\"{}: the merge refuses: {error}\", change.display()));\n58:     for spec in merged {\n59:         let folder = specs.join(&spec.capability);\n60:         if let Some(text) = &spec.text {\n61:             std::fs::create_dir_all(&folder).expect(\"the capability folder\");\n62:             std::fs::write(folder.join(\"spec.md\"), text).expect(\"the merged spec\");\n63:         } else {\n64:             let _ = std::fs::remove_dir_all(&folder);\n65:         }\n66:     }\n67: }\n68: \n69: /// A case both tools accept: each change validates and archives in the CLI\n70: /// project, the merge applies each change, and the specs trees match.\n71: fn assert_identical(cli: &OpenSpecCli, openspec: &Project, rust_specs: &Path, changes: &[PathBuf]) {\n72:     for change in changes {\n73:         let name = name_of(change);\n74:         let args = [\n75:             \"validate\",\n76:             &name,\n77:             \"--type\",\n78:             \"change\",\n79:             \"--strict\",\n80:             \"--json\",\n81:             \"--no-interactive\",\n82:         ];\n83:         run_ok(cli, &args, openspec.root());\n84:     }\n85:     for change in changes {\n86:         let name = name_of(change);\n87:         run_ok(cli, &[\"archive\", &name, \"--yes\", \"--json\"], openspec.root());\n88:         merge_into(change, rust_specs);\n89:     }\n90:     let cli_specs = openspec.root().join(\"openspec/specs\");\n91:     let cli_tree = tree(&cli_specs);\n92:     assert!(!cli_tree.is_empty(), \"the CLI archived no spec\");\n93:     assert_eq!(cli_tree, tree(rust_specs), \"the two specs trees\");\n94: }\n95: \n96: /// A case both tools refuse: the CLI reports `archive_spec_update_failed`, the\n97: /// merge refuses, and neither tree changes.\n98: fn assert_both_refuse(\n99:     cli: &OpenSpecCli,\n100:     project: &Project,\n101:     first: &Path,\n102:     rust_specs: &Path,\n103:     case: &Path,\n104: ) {\n105:     let name = name_of(first);\n106:     let archive = cli.run(&[\"archive\", &name, \"--yes\", \"--json\"], project.root());\n107:     let value: Value = serde_json::from_slice(&archive.stdout).unwrap_or(Value::Null);\n108:     let status = value.get(\"status\").and_then(Value::as_array);\n109:     let refused = status.is_some_and(|entries| {\n110:         entries\n111:             .iter()\n112:             .any(|e| e.get(\"code\").and_then(Value::as_str) == Some(\"archive_spec_update_failed\"))\n113:     });\n114:     assert!(\n115:         !archive.status.success() && refused,\n116:         \"archive {name} did not report archive_spec_update_failed:\\n{}\",\n117:         text_of(&archive)\n118:     );\n119:     let refused = matches!(\n120:         merge_change(first, rust_specs),\n121:         Err(MergeChangeError::Merge { .. })\n122:     );\n123:     assert!(refused, \"{}: the merge should refuse\", first.display());\n124:     let cli_specs = project.root().join(\"openspec/specs\");\n125:     let case_specs = case.join(\"specs\");\n126:     assert_eq!(tree(&cli_specs), tree(&case_specs), \"the OpenSpec tree\");\n127:     assert_eq!(tree(rust_specs), tree(&case_specs), \"the Rust tree\");\n128: }\n129: \n130: /// A case the Rust merge refuses and the CLI accepts: the refusal names the\n131: /// expected rename form, and no living spec holds a rename target.\n132: fn assert_osq_refuses(\n133:     cli: &OpenSpecCli,\n134:     project: &Project,\n135:     first: &Path,\n136:     rust_specs: &Path,\n137:     case: &Path,\n138: ) {\n139:     let Err(MergeChangeError::Merge { error, .. }) = merge_change(first, rust_specs) else {\n140:         panic!(\"{}: expected a merge refusal\", first.display());\n141:     };\n142:     assert!(\n143:         error.to_string().contains(\"### Requirement:\"),\n144:         \"{}: the refusal must name the expected form: {error}\",\n145:         first.display()\n146:     );\n147:     let name = name_of(first);\n148:     run_ok(cli, &[\"archive\", &name, \"--yes\", \"--json\"], project.root());\n149:     let living = tree(&project.root().join(\"openspec/specs\"));\n150:     for target in rename_targets(&case.join(\"changes\")) {\n151:         let header = format!(\"### Requirement: {target}\");\n152:         assert!(\n153:             !living.values().any(|text| text.contains(&header)),\n154:             \"the case applied a rename OpenSpec should skip: {target}\"\n155:         );\n156:     }\n157: }\n158: \n159: /// The requirement names the case's delta specs give a `TO:` line, as the\n160: /// TypeScript differential test reads them.\n161: fn rename_targets(changes: &Path) -> Vec<String> {\n162:     let mut targets = Vec::new();\n163:     for change in folders(changes) {\n164:         for capability in folders(&change.join(\"specs\")) {\n165:             let text = read(&capability.join(\"spec.md\"));\n166:             for line in text.lines() {\n167:                 let rest = line\n168:                     .trim_start()\n169:                     .trim_start_matches(['-', '*', '+'])\n170:                     .trim_start();\n171:                 let Some(rest) = rest\n172:                     .strip_prefix(\"TO:\")\n173:                     .or_else(|| rest.strip_prefix(\"to:\"))\n174:                 else {\n175:                     continue;\n176:                 };\n177:                 let name = rest.trim().trim_matches('`').trim();\n178:                 let name = name.strip_prefix(\"### Requirement: \").unwrap_or(name);\n179:                 if !name.trim().is_empty() {\n180:                     targets.push(name.trim().to_string());\n181:                 }\n182:             }\n183:         }\n184:     }\n185:     targets\n186: }\n187: \n188: /// Runs one differential case: builds both projects, then checks its expectation.\n189: fn run_case(name: &str) {\n