ded\",\n235:     bare_rename => \"bare-rename\",\n236:     dropped_scenario => \"dropped-scenario\",\n237:     duplicate_added => \"duplicate-added\",\n238:     given_and => \"given-and\",\n239:     modified => \"modified\",\n240:     new_capability => \"new-capability\",\n241:     removed => \"removed\",\n242:     renamed => \"renamed\",\n243:     second_change => \"second-change\",\n244: }\n245: \n246: /// Covers: rust-specs/archive-cases-match-openspec\n247: #[ignore = \"corpus test: runs the OpenSpec CLI on the differential cases\"]\n248: #[test]\n249: fn cases_are_exactly_the_fixture_folders() {\n250:     let actual: Vec<String> = folders(&repository_root().join(FIXTURES))\n251:         .iter()\n252:         .map(|path| name_of(path))\n253:         .collect();\n254:     let expected: Vec<String> = CASE_NAMES.iter().map(|name| (*name).to_string()).collect();\n255:     assert_eq!(expected, actual, \"the differential case folders\");\n256: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/home/mathias/.osq/worktrees/osq/219-rust-specs-parity/crates/kernel/specs/tests/openspec_archive_parity_corpus.rs\", \"offset\": 100, \"limit\": 160}"},"time":{"start":1792395603850,"end":1792395603872}}}}
