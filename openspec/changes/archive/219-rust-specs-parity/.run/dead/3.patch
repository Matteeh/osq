190:     let case = repository_root().join(FIXTURES).join(name);\n191:     let value: Value = serde_json::from_str(&read(&case.join(\"case.json\"))).expect(\"the case\");\n192:     let expect = value\n193:         .get(\"expect\")\n194:         .and_then(Value::as_str)\n195:         .expect(\"an expect\");\n196:     let cli = OpenSpecCli::locate(&repository_root());\n197:     let openspec = scaffold(&format!(\"archive-{name}-openspec\"), &case);\n198:     let rust = scaffold(&format!(\"archive-{name}-rust\"), &case);\n199:     let changes = folders(&rust.root().join(\"openspec/changes\"));\n200:     let first = changes\n201:         .first()\n202:         .map_or_else(|| panic!(\"case {name} has no change\"), PathBuf::as_path);\n203:     let rust_specs = rust.root().join(\"openspec/specs\");\n204:     match expect {\n205:         \"identical\" => assert_identical(&cli, &openspec, &rust_specs, &changes),\n206:         \"both-refuse\" => assert_both_refuse(&cli, &openspec, first, &rust_specs, &case),\n207:         \"osq-refuses\" => assert_osq_refuses(&cli, &openspec, first, &rust_specs, &case),\n208:         other => panic!(\"case {name} has unknown expect `{other}`\"),\n209:     }\n210: }\n211: \n212: /// Declares one corpus test per differential case, in byte order.\n213: macro_rules! case_tests {\n214:     ($($fn_name:ident => $case:literal),* $(,)?) => {\n215:         /// The differential case names, in byte order.\n216:         const CASE_NAMES: &[&str] = &[$($case),*];\n217: \n218:         $(\n219:             /// Covers: rust-specs/archive-cases-match-openspec\n220:             #[ignore = \"corpus test: runs the OpenSpec CLI on the differential cases\"]\n221:             #[test]\n222:             fn $fn_name() { run_case($case); }\n223:         )*\n224:     };\n225: }\n226: \n227: case_tests! {\n228:     added => \"added\",\n229:     bare_rename => \"bare-rename\",\n230:     dropped_scenario => \"dropped-scenario\",\n231:     duplicate_added => \"duplicate-added\",\n232:     given_and => \"given-and\",\n233:     modified => \"modified\",\n234:     new_capability => \"new-capability\",\n235:     removed => \"removed\",\n236:     renamed => \"renamed\",\n237:     second_change => \"second-change\",\n238: }\n239: \n240: /// Covers: rust-specs/archive-cases-match-openspec\n241: #[ignore = \"corpus test: runs the OpenSpec CLI on the differential cases\"]\n242: #[test]\n243: fn cases_are_exactly_the_fixture_folders() {\n244:     let actual: Vec<String> = folders(&repository_root().join(FIXTURES))\n245:         .iter()\n246:         .map(|path| name_of(path))\n247:         .collect();\n248:     let expected: Vec<String> = CASE_NAMES.iter().map(|name| (*name).to_string()).collect();\n249:     assert_eq!(expected, actual, \"the differential case folders\");\n250: }"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/home/mathias/.osq/worktrees/osq/219-rust-specs-parity/crates/kernel/specs/tests/openspec_archive_parity_corpus.rs\"}"},"time":{"start":1792396212667,"end":1792396213028}}}}
