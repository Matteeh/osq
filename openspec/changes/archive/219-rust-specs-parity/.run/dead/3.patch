+{"type":"step_start","timestamp":1792396285013,"sessionID":"ses_eacdb5a85ffeETstJhXFodxnfQ","part":{"id":"prt_15324d455001G1E4pTPwQOYGlW","sessionID":"ses_eacdb5a85ffeETstJhXFodxnfQ","messageID":"msg_15324be89001PT6Z5afuo3vVJ1","type":"step-start","snapshot":"2d34cb0798137c739515b26d9e4a905be762721a"}}
+{"type":"tool_use","timestamp":1792396285817,"sessionID":"ses_eacdb5a85ffeETstJhXFodxnfQ","part":{"partID":"prt_15324d6fb001sKLZ8qiZ1777KK","sessionID":"ses_eacdb5a85ffeETstJhXFodxnfQ","messageID":"msg_15324be89001PT6Z5afuo3vVJ1","type":"tool","id":"call_00_u26kvkfwkf94me1q34li2h6j","tool":"shell","state":{"status":"completed","input":{"command":"cd crates/kernel/specs/tests && for f in openspec_parity_support/mod.rs openspec_parity_support/cli.rs openspec_parity_support/project.rs openspec_parity_support/trees.rs openspec_parity_support/replay.rs openspec_parity_support/report.rs; do echo \"===== $f\"; cat \"$f\"; done; echo \"===== items\"; ls openspec_parity_support/items; for f in openspec_parity_support/items/*; do echo \"--- $f\"; cat \"$f\"; done; echo \"===== validate corpus\"; cat openspec_validate_parity_corpus.rs"},"output":"===== openspec_parity_support/mod.rs\n//! Shared helpers for the specs kernel's `OpenSpec` CLI parity tests (ADR 026).\n//!\n//! The validate parity test and the archive parity test both build temporary\n//! `OpenSpec` projects and run the CLI, so those helpers live here. An\n//! integration test declares this folder as `pub mod openspec_parity_support;`\n//! and uses the parts it needs; the rest stay reachable, so they do not warn as\n//! dead code.\n\npub mod cli;\npub mod items;\npub mod project;\npub mod replay;\npub mod report;\npub mod trees;\n===== openspec_parity_support/cli.rs\n//! Locating and running the `OpenSpec` CLI for the parity tests.\n\nuse std::path::{Path, PathBuf};\nuse std::process::{Command, Output};\n\n/// The `OpenSpec` CLI the parity tests run.\n#[derive(Debug, Clone)]\npub struct OpenSpecCli {\n    /// The path the tests invoke.\n    path: PathBuf,\n}\n\nimpl OpenSpecCli {\n    /// Finds the CLI: `OSQ_OPENSPEC_BIN` when set and not empty, else\n    /// `node_modules/.bin/openspec` under `root`.\n    #[must_use]\n    pub fn locate(root: &Path) -> Self {\n        let from_env = std::env::var_os(\"OSQ_OPENSPEC_BIN\");\n        let path = match from_env {\n            Some(value) if !value.is_empty() => PathBuf::from(value),\n            _ => root.join(\"node_modules/.bin/openspec\"),\n        };\n        Self { path }\n    }\n\n    /// The CLI path.\n    #[must_use]\n    pub fn path(&self) -> &Path {\n        &self.path\n    }\n\n    /// Runs the CLI with `OPENSPEC_TELEMETRY=0` in `cwd`.\n    ///\n    /// # Panics\n    ///\n    /// Panics, naming the path, when the CLI cannot be started.\n    #[must_use]\n    pub fn run(&self, args: &[&str], cwd: &Path) -> Output {\n        Command::new(&self.path)\n            .args(args)\n            .current_dir(cwd)\n            .env(\"OPENSPEC_TELEMETRY\", \"0\")\n            .output()\n            .unwrap_or_else(|error| {\n                panic!(\n                    \"cannot run openspec {} -- {}: {error}\",\n                    self.path.display(),\n                    args.join(\" \")\n                )\n            })\n    }\n\n    /// The trimmed `--version` output.\n    ///\n    /// # Panics\n    ///\n    /// Panics, naming the path, when the CLI cannot be started or exits\n    /// nonzero.\n    #[must_use]\n    pub fn version(&self, cwd: &Path) -> String {\n        let output = self.run(&[\"--version\"], cwd);\n        assert!(\n            output.status.success(),\n            \"openspec {} --version failed: {}\",\n            self.path.display(),\n            text_of(&output)\n        );\n        String::from_utf8_lossy(&output.stdout).trim().to_string()\n    }\n}\n\n/// True when `text` is exactly `<digits>.<digits>.<digits>`.\n#[must_use]\npub fn is_version(text: &str) -> bool {\n    let parts: Vec<&str> = text.split('.').collect();\n    parts.len() == 3\n        && parts\n            .iter()\n            .all(|part| !part.is_empty() && part.bytes().all(|byte| byte.is_ascii_digit()))\n}\n\n/// The stdout and stderr of one run, joined and truncated to 500 characters.\n#[must_use]\npub fn text_of(output: &Output) -> String {\n    let mut text = String::from_utf8_lossy(&output.stdout).into_owned();\n    text.push_str(&String::from_utf8_lossy(&output.stderr));\n    text.chars().take(500).collect()\n}\n===== openspec_parity_support/project.rs\n//! Temporary `OpenSpec` projects the parity tests build and validate.\n\nuse super::trees::copy_tree;\nuse std::io;\nuse std::path::{Path, PathBuf};\n\n/// The proposal a fixture change without one gets, because `OpenSpec` reads a\n/// change only through its proposal.\nconst PARITY_PROPOSAL: &str = \"# Parity fixture\\n\";\n\n/// A temporary `OpenSpec` project under `CARGO_TARGET_TMPDIR`.\n#[derive(Debug)]\npub struct Project {\n    /// The project's root folder.\n    root: PathBuf,\n}\n\nimpl Project {\n    /// Prepares an empty project folder with the scaffolded osq schema.\n    ///\n    /// Removes any earlier folder at the same path, so a rerun starts clean.\n    ///\n    /// # Errors\n    ///\n    /// Returns the IO error of the scaffold copy.\n    pub fn prepare(name: &str, repo: &Path) -> io::Result<Self> {\n        let root = Path::new(env!(\"CARGO_TARGET_TMPDIR\"))\n            .join(\"openspec-parity\")\n            .join(name);\n        let _ = std::fs::remove_dir_all(&root);\n        std::fs::create_dir_all(root.join(\"openspec\"))?;\n        copy_tree(&repo.join(\"templates/openspec\"), &root.join(\"openspec\"))?;\n        Ok(Self { root })\n    }\n\n    /// The project's root folder.\n    #[must_use]\n    pub fn root(&self) -> &Path {\n        &self.root\n    }\n\n    /// Replaces `openspec/specs` with a copy of `source`, or removes it when\n    /// there is no source.\n    ///\n    /// # Errors\n    ///\n    /// Returns the IO error of the copy.\n    pub fn set_specs(&self, source: Option<&Path>) -> io::Result<()> {\n        let target = self.root.join(\"openspec/specs\");\n        let _ = std::fs::remove_dir_all(&target);\n        match source {\n            Some(source) => copy_tree(source, &target),\n            None => Ok(()),\n        }\n    }\n\n    /// Removes `openspec/changes`.\n    ///\n    /// # Errors\n    ///\n    /// Never fails today, but keeps the `io::Result` shape of its siblings.\n    pub fn clear_changes(&self) -> io::Result<()> {\n        let _ = std::fs::remove_dir_all(self.root.join(\"openspec/changes\"));\n        Ok(())\n    }\n\n    /// Creates `openspec/changes/<name>` with the parity proposal.\n    ///\n    /// # Errors\n    ///\n    /// Returns the IO error of the folder or proposal write.\n    pub fn make_change(&self, name: &str) -> io::Result<PathBuf> {\n        let target = self.root.join(\"openspec/changes\").join(name);\n        std::fs::create_dir_all(&target)?;\n        ensure_proposal(&target)?;\n        Ok(target)\n    }\n\n    /// Puts a change's `proposal.md`, `tasks.md` and `specs/` under\n    /// `openspec/changes/<name>`, writing the parity proposal when the source\n    /// holds none.\n    ///\n    /// # Errors\n    ///\n    /// Returns the IO error of the copy or the proposal write.\n    pub fn put_change(&self, name: &str, source: &Path) -> io::Result<PathBuf> {\n        let target = self.make_change(name)?;\n        for part in [\"proposal.md\", \"tasks.md\"] {\n            let from = source.join(part);\n            if from.is_file() {\n                std::fs::copy(&from, target.join(part))?;\n            }\n        }\n        let specs = source.join(\"specs\");\n        if specs.is_dir() {\n            copy_tree(&specs, &target.join(\"specs\"))?;\n        }\n        ensure_proposal(&target)?;\n        Ok(target)\n    }\n\n    /// Writes `text` to `relative` under the project root, creating folders.\n    ///\n    /// # Errors\n    ///\n    /// Returns the IO error of the folder or file write.\n    pub fn write(&self, relative: &str, text: &str) -> io::Result<()> {\n        let path = self.root.join(relative);\n        if let Some(parent) = path.parent() {\n            std::fs::create_dir_all(parent)?;\n        }\n        std::fs::write(path, text)\n    }\n}\n\n/// Writes the parity proposal into `change` when it holds none.\nfn ensure_proposal(change: &Path) -> io::Result<()> {\n    let proposal = change.join(\"proposal.md\");\n    if proposal.is_file() {\n        return Ok(());\n    }\n    std::fs::write(proposal, PARITY_PROPOSAL)\n}\n===== openspec_parity_support/trees.rs\n//! Reading and copying directory trees for the parity projects.\n\nuse std::collections::BTreeMap;\nuse std::io;\nuse std::path::{Path, PathBuf};\n\n/// The repository root, three folders above this crate's manifest.\n///\n/// # Panics\n///\n/// Panics when the crate's manifest is not three folders below the root.\n#[must_use]\npub fn repository_root() -> PathBuf {\n    Path::new(env!(\"CARGO_MANIFEST_DIR\"))\n        .ancestors()\n        .nth(3)\n        .expect(\"the repository root is three folders above crates/kernel/specs\")\n        .to_path_buf()\n}\n\n/// The folders directly under `dir`, in byte order of their names.\n#[must_use]\npub fn folders(dir: &Path) -> Vec<PathBuf> {\n    entries(dir)\n        .into_iter()\n        .filter(|path| path.is_dir())\n        .collect()\n}\n\n/// The `.md` files directly under `dir`, in byte order of their names.\n#[must_use]\npub fn markdown_files(dir: &Path) -> Vec<PathBuf> {\n    entries(dir)\n        .into_iter()\n        .filter(|path| path.is_file() && path.extension().is_some_and(|ext| ext == \"md\"))\n        .collect()\n}\n\n/// The entries directly under `dir`, in byte order of their file names.\nfn entries(dir: &Path) -> Vec<PathBuf> {\n    let Ok(read) = std::fs::read_dir(dir) else {\n        return Vec::new();\n    };\n    let mut paths: Vec<PathBuf> = read.flatten().map(|entry| entry.path()).collect();\n    paths.sort_by(|left, right| left.file_name().cmp(&right.file_name()));\n    paths\n}\n\n/// The file name of `path` as text, or empty when it has none.\n#[must_use]\npub fn name_of(path: &Path) -> String {\n    path.file_name()\n        .map(|name| name.to_string_lossy().into_owned())\n        .unwrap_or_default()\n}\n\n/// Copies the tree at `source` into `target`, creating every folder.\n///\n/// # Errors\n///\n/// Returns the IO error of a folder it cannot create or a file it cannot copy.\npub fn copy_tree(source: &Path, target: &Path) -> io::Result<()> {\n    std::fs::create_dir_all(target)?;\n    for entry in std::fs::read_dir(source)?.flatten() {\n        let from = entry.path();\n        let to = target.join(entry.file_name());\n        if entry.file_type()?.is_dir() {\n            copy_tree(&from, &to)?;\n        } else {\n            std::fs::copy(&from, &to)?;\n        }\n    }\n    Ok(())\n}\n\n/// Reads every regular file under `root` as its `/`-joined relative path and\n/// its text.\n///\n/// # Errors\n///\n/// Returns the IO or UTF-8 error of the first file that cannot be read.\npub fn read_tree(root: &Path) -> io::Result<BTreeMap<String, String>> {\n    let mut tree = BTreeMap::new();\n    collect_tree(root, \"\", &mut tree)?;\n    Ok(tree)\n}\n\n/// Collects the files under `dir`, prefixing each key with `prefix`.\nfn collect_tree(dir: &Path, prefix: &str, tree: &mut BTreeMap<String, String>) -> io::Result<()> {\n    for entry in std::fs::read_dir(dir)?.flatten() {\n        let path = entry.path();\n        let key = if prefix.is_empty() {\n            name_of(&path)\n        } else {\n            format!(\"{prefix}/{}\", name_of(&path))\n        };\n        if entry.file_type()?.is_dir() {\n            collect_tree(&path, &key, tree)?;\n        } else {\n            tree.insert(key, std::fs::read_to_string(&path)?);\n        }\n    }\n    Ok(())\n}\n===== openspec_parity_support/replay.rs\n//! The landing order of this repository's archive for the parity tests.\n\nuse super::trees::folders;\nuse std::path::{Path, PathBuf};\n\n/// The archived change folders in the landing order of rust-specs \"Archive\n/// replay\": the folders with no `archived` timestamp first, in byte order of\n/// their names, then the others by the timestamp of their last `archived`\n/// event and then by name.\n#[must_use]\npub fn archived_landing_order(archive: &Path) -> Vec<PathBuf> {\n    let mut landed: Vec<(Option<String>, PathBuf)> = folders(archive)\n        .into_iter()\n        .map(|path| (last_archived_timestamp(&path), path))\n        .collect();\n    landed.sort_by(|(left_stamp, left), (right_stamp, right)| {\n        left_stamp\n            .cmp(right_stamp)\n            .then_with(|| left.file_name().cmp(&right.file_name()))\n    });\n    landed.into_iter().map(|(_, path)| path).collect()\n}\n\n/// The last `archived` timestamp one change folder recorded, when it has one.\nfn last_archived_timestamp(change: &Path) -> Option<String> {\n    let text = std::fs::read_to_string(change.join(\".run/events/change.jsonl\")).ok()?;\n    let mut last = None;\n    for line in text.lines() {\n        if line.trim().is_empty() {\n            continue;\n        }\n        let Ok(value) = serde_json::from_str::<serde_json::Value>(line) else {\n            continue;\n        };\n        if value.get(\"type\").and_then(|kind| kind.as_str()) != Some(\"archived\") {\n            continue;\n        }\n        if let Some(stamp) = value.get(\"timestamp\").and_then(|stamp| stamp.as_str()) {\n            last = Some(stamp.to_string());\n        }\n    }\n    last\n}\n===== openspec_parity_support/report.rs\n//! Comparing the Rust validator and the `OpenSpec` CLI for the parity tests.\n\n/// What one side of one parity comparison decided.\n#[derive(Debug, Clone, PartialEq, Eq)]\npub enum Outcome {\n    /// The side found nothing to fail on.\n    Pass,\n    /// The side failed, with one detail per finding or issue, possibly none.\n    Fail(Vec<String>),\n}\n\nimpl Outcome {\n    /// Builds a pass for no details and a fail otherwise.\n    #[must_use]\n    pub fn from_details(details: Vec<String>) -> Self {\n        if details.is_empty() {\n            Self::Pass\n        } else {\n            Self::Fail(details)\n        }\n    }\n\n    /// True when the side passed.\n    #[must_use]\n    pub fn passed(&self) -> bool {\n        matches!(self, Self::Pass)\n    }\n\n    /// The detail lines, empty for a pass.\n    #[must_use]\n    pub fn details(&self) -> &[String] {\n        match self {\n            Self::Pass => &[],\n            Self::Fail(details) => details,\n        }\n    }\n\n    /// `pass` or `fail`.\n    #[must_use]\n    pub fn label(&self) -> &'static str {\n        if self.passed() { \"pass\" } else { \"fail\" }\n    }\n}\n\n/// One compared parity item.\n#[derive(Debug, Clone)]\npub struct Comparison {\n    /// The item's label, relative to the repository or the crate.\n    pub label: String,\n    /// The Rust validator's outcome.\n    pub rust: Outcome,\n    /// The `OpenSpec` CLI's outcome.\n    pub openspec: Outcome,\n}\n\n/// A difference the Rust validator and the `OpenSpec` CLI are allowed to have.\n#[derive(Debug, Clone)]\npub struct KnownDifference {\n    /// The item's label.\n    pub label: &'static str,\n    /// True when the Rust side passes.\n    pub rust_passes: bool,\n    /// True when the `OpenSpec` side passes.\n    pub openspec_passes: bool,\n    /// Why the two sides differ.\n    pub why: &'static str,\n}\n\n/// Asserts every comparison agrees, except the listed differences, which must\n/// differ exactly as listed. Prints every failing item at once.\n///\n/// # Panics\n///\n/// Panics when an unlisted item disagrees, a listed difference no longer\n/// holds, or a listed difference names an item that was not compared.\npub fn assert_parity(comparisons: &[Comparison], differences: &[KnownDifference]) {\n    let failures = collect_failures(comparisons, differences);\n    assert!(\n        failures.is_empty(),\n        \"validate parity failures:\\n{}\",\n        failures.join(\"\\n\")\n    );\n}\n\n/// Every failure: each unlisted disagreement, each stale difference, and each\n/// listed difference with no item.\nfn collect_failures(comparisons: &[Comparison], differences: &[KnownDifference]) -> Vec<String> {\n    let mut failures = Vec::new();\n    for comparison in comparisons {\n        match differences\n            .iter()\n            .find(|difference| difference.label == comparison.label)\n        {\n            None => {\n                if comparison.rust.passed() != comparison.openspec.passed() {\n                    failures.push(format!(\n                        \"unlisted difference:\\n{}\",\n                        format_comparison(comparison)\n                    ));\n                }\n            }\n            Some(difference) => {\n                if comparison.rust.passed() != difference.rust_passes\n                    || comparison.openspec.passed() != difference.openspec_passes\n                {\n                    failures.push(format!(\n                        \"listed difference no longer holds ({}):\\n{}\",\n                        difference.why,\n                        format_comparison(comparison)\n                    ));\n                }\n            }\n        }\n    }\n    for difference in differences {\n        if !comparisons\n            .iter()\n            .any(|comparison| comparison.label == difference.label)\n        {\n            failures.push(format!(\n                \"listed difference was not compared: `{}`\",\n                difference.label\n            ));\n        }\n    }\n    failures\n}\n\n/// The label, both outcomes, and both sides' details.\nfn format_comparison(comparison: &Comparison) -> String {\n    format!(\n        \"`{}`: rust {}, openspec {}\\n  rust: {}\\n  openspec: {}\",\n        comparison.label,\n        comparison.rust.label(),\n        comparison.openspec.label(),\n        details_text(&comparison.rust),\n        details_text(&comparison.openspec)\n    )\n}\n\n/// One side's details, or a note that it has none.\nfn details_text(outcome: &Outcome) -> String {\n    if outcome.details().is_empty() {\n        \"(no details)\".to_string()\n    } else {\n        outcome.details().join(\"; \")\n    }\n}\n===== items\narchive.rs\ndelta.rs\nliving.rs\nmod.rs\nopenspec.rs\ntargets.rs\n--- openspec_parity_support/items/archive.rs\n//! The archived changes, each validated against the replay before it lands.\n\nuse super::super::cli::OpenSpecCli;\nuse super::super::project::Project;\nuse super::super::replay::archived_landing_order;\nuse super::super::report::Comparison;\nuse super::super::trees::name_of;\nuse super::openspec::{change_outcome, single_item_outcome};\nuse osq_kernel_specs::merge_change;\nuse std::path::{Path, PathBuf};\n\n/// The archive, relative to the repository root.\nconst ARCHIVE: &str = \"openspec/changes/archive\";\n\n/// The archived changes in landing order, each validated against the living\n/// specs the replay gives before it, and then merged into the replay.\npub(super) fn archive_comparisons(repo: &Path, cli: &OpenSpecCli) -> Vec<Comparison> {\n    let archive = repo.join(ARCHIVE);\n    let scratch = scratch_specs();\n    let project = Project::prepare(\"archive\", repo).expect(\"the project writes\");\n    let mut comparisons = Vec::new();\n    for folder in archived_landing_order(&archive) {\n        let name = name_of(&folder);\n        let rust = change_outcome(&folder, &scratch);\n        project\n            .set_specs(Some(&scratch))\n            .expect(\"the replay specs copy\");\n        project.clear_changes().expect(\"the changes clear\");\n        project\n            .put_change(&name, &folder)\n            .expect(\"the change copies\");\n        let output = cli.run(\n            &[\n                \"validate\",\n                &name,\n                \"--type\",\n                \"change\",\n                \"--strict\",\n                \"--json\",\n                \"--no-interactive\",\n            ],\n            project.root(),\n        );\n        comparisons.push(Comparison {\n            label: format!(\"openspec/changes/archive/{name}\"),\n            rust,\n            openspec: single_item_outcome(&output),\n        });\n        merge_into(&folder, &scratch);\n    }\n    comparisons\n}\n\n/// An empty scratch specs folder for the replay.\nfn scratch_specs() -> PathBuf {\n    let scratch = Path::new(env!(\"CARGO_TARGET_TMPDIR\")).join(\"openspec-parity/archive-specs\");\n    let _ = std::fs::remove_dir_all(&scratch);\n    std::fs::create_dir_all(&scratch).expect(\"the scratch folder creates\");\n    scratch\n}\n\n/// Merges one change into the scratch specs, writing or removing before the\n/// next change is compared.\nfn merge_into(change: &Path, scratch: &Path) {\n    let merged = merge_change(change, scratch).unwrap_or_else(|error| {\n        panic!(\n            \"{}: the archive replay cannot merge: {error}\",\n            change.display()\n        )\n    });\n    for spec in merged {\n        let target = scratch.join(&spec.capability);\n        match spec.text {\n            Some(text) => {\n                std::fs::create_dir_all(&target).expect(\"the scratch capability creates\");\n                std::fs::write(target.join(\"spec.md\"), text).expect(\"the scratch spec writes\");\n            }\n            None => {\n                let _ = std::fs::remove_dir_all(&target);\n            }\n        }\n    }\n}\n--- openspec_parity_support/items/delta.rs\n//! The delta spec fixtures, each as `specs/alpha/spec.md` of a change.\n\nuse super::super::cli::OpenSpecCli;\nuse super::super::project::Project;\nuse super::super::report::Comparison;\nuse super::super::trees::{markdown_files, name_of};\nuse super::openspec::{delta_outcome, single_item_outcome};\nuse std::path::Path;\n\n/// The delta spec fixtures, relative to the repository root.\nconst DELTA_FIXTURES: &str = \"crates/kernel/specs/tests/fixtures/validate/delta\";\n\n/// The delta spec fixtures, each as `specs/alpha/spec.md` of a change `parity`\n/// with no living spec.\npub(super) fn delta_fixture_comparisons(repo: &Path, cli: &OpenSpecCli) -> Vec<Comparison> {\n    let dir = repo.join(DELTA_FIXTURES);\n    let project = Project::prepare(\"delta-fixtures\", repo).expect(\"the project writes\");\n    let mut comparisons = Vec::new();\n    for file in markdown_files(&dir) {\n        let stem = name_of(&file);\n        let stem = stem.trim_end_matches(\".md\");\n        let text = std::fs::read_to_string(&file).expect(\"a fixture reads\");\n        project.set_specs(None).expect(\"the living specs clear\");\n        project.clear_changes().expect(\"the changes clear\");\n        project.make_change(\"parity\").expect(\"the change writes\");\n        project\n            .write(\"openspec/changes/parity/specs/alpha/spec.md\", &text)\n            .expect(\"the fixture writes\");\n        let output = cli.run(\n            &[\n                \"validate\",\n                \"parity\",\n                \"--type\",\n                \"change\",\n                \"--strict\",\n                \"--json\",\n                \"--no-interactive\",\n            ],\n            project.root(),\n        );\n        let label = format!(\"fixtures/validate/delta/{stem}.md\");\n        comparisons.push(Comparison {\n            rust: delta_outcome(&label, &text),\n            openspec: single_item_outcome(&output),\n            label,\n        });\n    }\n    comparisons\n}\n--- openspec_parity_support/items/living.rs\n//! The living specs under `openspec/specs/` and the living spec fixtures.\n\nuse super::super::cli::OpenSpecCli;\nuse super::super::project::Project;\nuse super::super::report::Comparison;\nuse super::super::trees::{folders, markdown_files, name_of};\nuse super::openspec::{item_outcome, items_of, living_outcome, single_item_outcome};\nuse std::path::Path;\n\n/// The living spec fixtures, relative to the repository root.\nconst LIVING_FIXTURES: &str = \"crates/kernel/specs/tests/fixtures/validate/living\";\n\n/// The living specs under `openspec/specs/`, one comparison per capability.\npub(super) fn living_spec_comparisons(repo: &Path, cli: &OpenSpecCli) -> Vec<Comparison> {\n    let specs = repo.join(\"openspec/specs\");\n    let project = Project::prepare(\"living-specs\", repo).expect(\"the project writes\");\n    project\n        .set_specs(Some(&specs))\n        .expect(\"the living specs copy\");\n    let output = cli.run(\n        &[\n            \"validate\",\n            \"--specs\",\n            \"--strict\",\n            \"--json\",\n            \"--no-interactive\",\n        ],\n        project.root(),\n    );\n    let items = items_of(&output).unwrap_or_default();\n    let mut comparisons = Vec::new();\n    for folder in folders(&specs) {\n        let path = folder.join(\"spec.md\");\n        if !path.is_file() {\n            continue;\n        }\n        let capability = name_of(&folder);\n        let label = format!(\"openspec/specs/{capability}/spec.md\");\n        let text = std::fs::read_to_string(&path).expect(\"a living spec reads\");\n        comparisons.push(Comparison {\n            rust: living_outcome(&label, &text),\n            openspec: item_outcome(&items, &capability),\n            label,\n        });\n    }\n    comparisons\n}\n\n/// The living spec fixtures, each as the only spec of a project.\npub(super) fn living_fixture_comparisons(repo: &Path, cli: &OpenSpecCli) -> Vec<Comparison> {\n    let dir = repo.join(LIVING_FIXTURES);\n    let project = Project::prepare(\"living-fixtures\", repo).expect(\"the project writes\");\n    let mut comparisons = Vec::new();\n    for file in markdown_files(&dir) {\n        let stem = name_of(&file);\n        let stem = stem.trim_end_matches(\".md\");\n        let text = std::fs::read_to_string(&file).expect(\"a fixture reads\");\n        project.set_specs(None).expect(\"the living specs clear\");\n        project\n            .write(&format!(\"openspec/specs/{stem}/spec.md\"), &text)\n            .expect(\"the fixture writes\");\n        let output = cli.run(\n            &[\n                \"validate\",\n                stem,\n                \"--type\",\n                \"spec\",\n                \"--strict\",\n                \"--json\",\n                \"--no-interactive\",\n            ],\n            project.root(),\n        );\n        let label = format!(\"fixtures/validate/living/{stem}.md\");\n        comparisons.push(Comparison {\n            rust: living_outcome(&label, &text),\n            openspec: single_item_outcome(&output),\n            label,\n        });\n    }\n    comparisons\n}\n--- openspec_parity_support/items/mod.rs\n//! Collecting every rust-specs \"`OpenSpec` validate parity\" item and both\n//! outcomes.\n\nmod archive;\nmod delta;\nmod living;\nmod openspec;\nmod targets;\n\nuse super::cli::OpenSpecCli;\nuse super::report::Comparison;\nuse std::path::Path;\n\n/// Compares every item of rust-specs \"`OpenSpec` validate parity\": the living\n/// specs, the archived changes, and the validate fixtures.\n///\n/// # Panics\n///\n/// Panics when a temporary project cannot be written or an item cannot be\n/// prepared.\n#[must_use]\npub fn validate_comparisons(repo: &Path, cli: &OpenSpecCli) -> Vec<Comparison> {\n    let mut comparisons = living::living_spec_comparisons(repo, cli);\n    comparisons.extend(living::living_fixture_comparisons(repo, cli));\n    comparisons.extend(delta::delta_fixture_comparisons(repo, cli));\n    comparisons.extend(targets::target_comparisons(repo, cli));\n    comparisons.extend(archive::archive_comparisons(repo, cli));\n    comparisons\n}\n--- openspec_parity_support/items/openspec.rs\n//! Reading the CLI's JSON and turning an item into an outcome.\n\nuse super::super::cli::text_of;\nuse super::super::report::Outcome;\nuse osq_kernel_specs::{\n    SpecFinding, validate_change, validate_delta, validate_living_spec, validate_merged_change,\n};\nuse serde_json::Value;\nuse std::path::Path;\nuse std::process::Output;\n\n/// The `items` array of a `--json` run, or none when the output is not JSON.\npub(super) fn items_of(output: &Output) -> Option<Vec<Value>> {\n    let text = String::from_utf8_lossy(&output.stdout);\n    let value: Value = serde_json::from_str(&text).ok()?;\n    value.get(\"items\")?.as_array().cloned()\n}\n\n/// The outcome of a run that validates exactly one item.\npub(super) fn single_item_outcome(output: &Output) -> Outcome {\n    match items_of(output).as_deref().and_then(|items| items.first()) {\n        Some(item) => outcome_of(item),\n        None => Outcome::Fail(vec![format!(\n            \"the CLI printed no JSON item: {}\",\n            text_of(output)\n        )]),\n    }\n}\n\n/// The outcome of the item with `id` in a multi-item run, failing when absent.\npub(super) fn item_outcome(items: &[Value], id: &str) -> Outcome {\n    let Some(item) = items\n        .iter()\n        .find(|item| item.get(\"id\").and_then(Value::as_str) == Some(id))\n    else {\n        return Outcome::Fail(vec![format!(\"the CLI reported no item `{id}`\")]);\n    };\n    outcome_of(item)\n}\n\n/// The outcome of one `--json` item value.\npub(super) fn outcome_of(item: &Value) -> Outcome {\n    if item.get(\"valid\").and_then(Value::as_bool) == Some(true) {\n        return Outcome::Pass;\n    }\n    Outcome::Fail(issue_messages(item))\n}\n\n/// The item's ERROR and WARNING messages, in order.\nfn issue_messages(item: &Value) -> Vec<String> {\n    let mut messages = Vec::new();\n    let Some(issues) = item.get(\"issues\").and_then(Value::as_array) else {\n        return messages;\n    };\n    for issue in issues {\n        let level = issue\n            .get(\"level\")\n            .and_then(Value::as_str)\n            .unwrap_or(\"ERROR\");\n        if level == \"ERROR\" || level == \"WARNING\" {\n            let message = issue.get(\"message\").and_then(Value::as_str).unwrap_or(\"\");\n            messages.push(format!(\"{level} {message}\"));\n        }\n    }\n    messages\n}\n\n/// The Rust findings of one living spec.\npub(super) fn living_outcome(label: &str, text: &str) -> Outcome {\n    Outcome::from_details(finding_lines(&validate_living_spec(label, text)))\n}\n\n/// The Rust findings of a delta spec that need no living spec.\npub(super) fn delta_outcome(label: &str, text: &str) -> Outcome {\n    Outcome::from_details(finding_lines(&validate_delta(label, text)))\n}\n\n/// The Rust outcome of a change, from `validate_change` and\n/// `validate_merged_change`.\npub(super) fn change_outcome(change: &Path, specs: &Path) -> Outcome {\n    let mut details = Vec::new();\n    match validate_change(change, specs) {\n        Ok(found) => details.extend(finding_lines(&found)),\n        Err(error) => details.push(format!(\"validate_change read error: {error}\")),\n    }\n    match validate_merged_change(change, specs) {\n        Ok(found) => details.extend(finding_lines(&found)),\n        Err(error) => details.push(format!(\"validate_merged_change error: {error}\")),\n    }\n    Outcome::from_details(details)\n}\n\n/// One finding as a failure line.\nfn finding_line(finding: &SpecFinding) -> String {\n    let requirement = finding\n        .requirement\n        .as_deref()\n        .map_or(String::new(), |name| format!(\" for `{name}`\"));\n    format!(\n        \"{} at line {}{}: {}\",\n        finding.code.as_str(),\n        finding.line,\n        requirement,\n        finding.message\n    )\n}\n\n/// The failure lines of a list of findings.\nfn finding_lines(found: &[SpecFinding]) -> Vec<String> {\n    found.iter().map(finding_line).collect()\n}\n--- openspec_parity_support/items/targets.rs\n//! The validate target changes, validated against the target living specs.\n\nuse super::super::cli::OpenSpecCli;\nuse super::super::project::Project;\nuse super::super::report::Comparison;\nuse super::super::trees::{folders, name_of};\nuse super::openspec::{change_outcome, single_item_outcome};\nuse std::path::Path;\n\n/// The target fixtures, relative to the repository root.\nconst TARGETS: &str = \"crates/kernel/specs/tests/fixtures/validate/targets\";\n\n/// The changes under `targets/changes/`, each with `targets/specs/` as the\n/// living specs.\npub(super) fn target_comparisons(repo: &Path, cli: &OpenSpecCli) -> Vec<Comparison> {\n    let base = repo.join(TARGETS);\n    let specs = base.join(\"specs\");\n    let project = Project::prepare(\"targets\", repo).expect(\"the project writes\");\n    let mut comparisons = Vec::new();\n    for folder in folders(&base.join(\"changes\")) {\n        let name = name_of(&folder);\n        project\n            .set_specs(Some(&specs))\n            .expect(\"the living specs copy\");\n        project.clear_changes().expect(\"the changes clear\");\n        project\n            .put_change(&name, &folder)\n            .expect(\"the change copies\");\n        let output = cli.run(\n            &[\n                \"validate\",\n                &name,\n                \"--type\",\n                \"change\",\n                \"--strict\",\n                \"--json\",\n                \"--no-interactive\",\n            ],\n            project.root(),\n        );\n        let label = format!(\"fixtures/validate/targets/changes/{name}\");\n        comparisons.push(Comparison {\n            rust: change_outcome(&folder, &specs),\n            openspec: single_item_outcome(&output),\n            label,\n        });\n    }\n    comparisons\n}\n===== validate corpus\n//! Corpus test: the Rust validator and the `OpenSpec` CLI agree on every living\n//! spec, archived change and validate fixture, except the five differences of\n//! rust-specs \"Validate differences\".\n//!\n//! It runs the `OpenSpec` CLI over this repository's live specs and archive, so\n//! it is a corpus test (rust-core \"Corpus tests\"): each test carries the corpus\n//! ignore, and only a build with the `parity` feature compiles it.\n\npub mod openspec_parity_support;\n\nuse openspec_parity_support::cli::{OpenSpecCli, is_version};\nuse openspec_parity_support::items::validate_comparisons;\nuse openspec_parity_support::report::{KnownDifference, assert_parity};\nuse openspec_parity_support::trees::repository_root;\n\n/// The five differences rust-specs \"Validate differences\" lists.\nconst KNOWN_DIFFERENCES: [KnownDifference; 5] = [\n    KnownDifference {\n        label: \"fixtures/validate/living/valid.md\",\n        rust_passes: true,\n        openspec_passes: false,\n        why: \"OpenSpec warns that a Purpose under 50 characters is too brief, \\\n              which ADR 026 does not port\",\n    },\n    KnownDifference {\n        label: \"fixtures/validate/delta/empty-delta-section.md\",\n        rust_passes: false,\n        openspec_passes: true,\n        why: \"ADR 026 makes every delta section well formed\",\n    },\n    KnownDifference {\n        label: \"fixtures/validate/delta/invalid-rename.md\",\n        rust_passes: false,\n        openspec_passes: true,\n        why: \"ADR 026 makes every delta section well formed\",\n    },\n    KnownDifference {\n        label: \"fixtures/validate/delta/unknown-delta-section.md\",\n        rust_passes: false,\n        openspec_passes: true,\n        why: \"ADR 026 allows only the four delta sections\",\n    },\n    KnownDifference {\n        label: \"fixtures/validate/targets/changes/unknown\",\n        rust_passes: false,\n        openspec_passes: true,\n        why: \"OpenSpec checks targets only at archive, and ADR 026 checks them at validate\",\n    },\n];\n\n/// Covers: rust-specs/validate-differences\n#[ignore = \"corpus test: runs the OpenSpec CLI on the live specs and archive\"]\n#[test]\nfn cli_reports_a_version() {\n    let repo = repository_root();\n    let cli = OpenSpecCli::locate(&repo);\n    let version = cli.version(&repo);\n    assert!(\n        is_version(&version),\n        \"openspec {} --version printed `{version}`, not <n>.<n>.<n>\",\n        cli.path().display()\n    );\n}\n\n/// Covers: rust-specs/validate-differences\n#[ignore = \"corpus test: runs the OpenSpec CLI on the live specs and archive\"]\n#[test]\nfn validate_matches_openspec() {\n    let repo = repository_root();\n    let cli = OpenSpecCli::locate(&repo);\n    let comparisons = validate_comparisons(&repo, &cli);\n    let labels: Vec<&str> = comparisons\n        .iter()\n        .map(|comparison| comparison.label.as_str())\n        .collect();\n    assert!(\n        labels\n            .iter()\n            .any(|label| label.starts_with(\"openspec/specs/\")),\n        \"no living spec was compared\"\n    );\n    assert!(\n        labels\n            .iter()\n            .any(|label| label.starts_with(\"openspec/changes/archive/\")),\n        \"no archived change was compared\"\n    );\n    assert_parity(&comparisons, &KNOWN_DIFFERENCES);\n}\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"===== openspec_parity_support/mod.rs\n//! Shared helpers for the specs kernel's `OpenSpec` CLI parity tests (ADR 026).\n//!\n//! The validate parity test and the archive parity test both build temporary\n//! `OpenSpec` projects and run the CLI, so those helpers live here. An\n//! integration test declares this folder as `pub mod openspec_parity_support;`\n//! and uses the parts it needs; the rest stay reachable, so they do not warn as\n//! dead code.\n\npub mod cli;\npub mod items;\npub mod project;\npub mod replay;\npub mod report;\npub mod trees;\n===== openspec_parity_support/cli.rs\n//! Locating and running the `OpenSpec` CLI for the parity tests.\n\nuse std::path::{Path, PathBuf};\nuse std::process::{Command, Output};\n\n/// The `OpenSpec` CLI the parity tests run.\n#[derive(Debug, Clone)]\npub struct OpenSpecCli {\n    /// The path the tests invoke.\n    path: PathBuf,\n}\n\nimpl OpenSpecCli {\n    /// Finds the CLI: `OSQ_OPENSPEC_BIN` when set and not empty, else\n    /// `node_modules/.bin/openspec` under `root`.\n    #[must_use]\n    pub fn locate(root: &Path) -> Self {\n        let from_env = std::env::var_os(\"OSQ_OPENSPEC_BIN\");\n        let path = match from_env {\n            Some(value) if !value.is_empty() => PathBuf::from(value),\n            _ => root.join(\"node_modules/.bin/openspec\"),\n        };\n        Self { path }\n    }\n\n    /// The CLI path.\n    #[must_use]\n    pub fn path(&self) -> &Path {\n        &self.path\n    }\n\n    /// Runs the CLI with `OPENSPEC_TELEMETRY=0` in `cwd`.\n    ///\n    /// # Panics\n    ///\n    /// Panics, naming the path, when the CLI cannot be started.\n    #[must_use]\n    pub fn run(&self, args: &[&str], cwd: &Path) -> Output {\n        Command::new(&self.path)\n            .args(args)\n            .current_dir(cwd)\n            .env(\"OPENSPEC_TELEMETRY\", \"0\")\n            .output()\n            .unwrap_or_else(|error| {\n                panic!(\n                    \"cannot run openspec {} -- {}: {error}\",\n                    self.path.display(),\n                    args.join(\" \")\n                )\n            })\n    }\n\n    /// The trimmed `--version` output.\n    ///\n    /// # Panics\n    ///\n    /// Panics, naming the path, when the CLI cannot be started or exits\n    /// nonzero.\n    #[must_use]\n    pub fn version(&self, cwd: &Path) -> String {\n        let output = self.run(&[\"--version\"], cwd);\n        assert!(\n            output.status.success(),\n            \"openspec {} --version failed: {}\",\n            self.path.display(),\n            text_of(&output)\n        );\n        String::from_utf8_lossy(&output.stdout).trim().to_string()\n    }\n}\n\n/// True when `text` is exactly `<digits>.<digits>.<digits>`.\n#[must_use]\npub fn is_version(text: &str) -> bool {\n    let parts: Vec<&str> = text.split('.').collect();\n    parts.len() == 3\n        && parts\n            .iter()\n            .all(|part| !part.is_empty() && part.bytes().all(|byte| byte.is_ascii_digit()))\n}\n\n/// The stdout and stderr of one run, joined and truncated to 500 characters.\n#[must_use]\npub fn text_of(output: &Output) -> String {\n    let mut text = String::from_utf8_lossy(&output.stdout).into_owned();\n    text.push_str(&String::from_utf8_lossy(&output.stderr));\n    text.chars().take(500).collect()\n}\n===== openspec_parity_support/project.rs\n//! Temporary `OpenSpec` projects the parity tests build and validate.\n\nuse super::trees::copy_tree;\nuse std::io;\nuse std::path::{Path, PathBuf};\n\n/// The proposal a fixture change without one gets, because `OpenSpec` reads a\n/// change only through its proposal.\nconst PARITY_PROPOSAL: &str = \"# Parity fixture\\n\";\n\n/// A temporary `OpenSpec` project under `CARGO_TARGET_TMPDIR`.\n#[derive(Debug)]\npub struct Project {\n    /// The project's root folder.\n    root: PathBuf,\n}\n\nimpl Project {\n    /// Prepares an empty project folder with the scaffolded osq schema.\n    ///\n    /// Removes any earlier folder at the same path, so a rerun starts clean.\n    ///\n    /// # Errors\n    ///\n    /// Returns the IO error of the scaffold copy.\n    pub fn prepare(name: &str, repo: &Path) -> io::Result<Self> {\n        let root = Path::new(env!(\"CARGO_TARGET_TMPDIR\"))\n            .join(\"openspec-parity\")\n            .join(name);\n        let _ = std::fs::remove_dir_all(&root);\n        std::fs::create_dir_all(root.join(\"openspec\"))?;\n        copy_tree(&repo.join(\"templates/openspec\"), &root.join(\"openspec\"))?;\n        Ok(Self { root })\n    }\n\n    /// The project's root folder.\n    #[must_use]\n    pub fn root(&self) -> &Path {\n        &self.root\n    }\n\n    /// Replaces `openspec/specs` with a copy of `source`, or removes it when\n    /// there is no source.\n    ///\n    /// # Errors\n    ///\n    /// Returns the IO error of the copy.\n    pub fn set_specs(&self, source: Option<&Path>) -> io::Result<()> {\n        let target = self.root.join(\"openspec/specs\");\n        let _ = std::fs::remove_dir_all(&target);\n        match source {\n            Some(source) => copy_tree(source, &target),\n            None => Ok(()),\n        }\n    }\n\n    /// Removes `openspec/changes`.\n    ///\n    /// # Errors\n    ///\n    /// Never fails today, but keeps the `io::Result` shape of its siblings.\n    pub fn clear_changes(&self) -> io::Result<()> {\n        let _ = std::fs::remove_dir_all(self.root.join(\"openspec/changes\"));\n        Ok(())\n    }\n\n    /// Creates `openspec/changes/<name>` with the parity proposal.\n    ///\n    /// # Errors\n    ///\n    /// Returns the IO error of the folder or proposal write.\n    pub fn make_change(&self, name: &str) -> io::Result<PathBuf> {\n        let target = self.root.join(\"openspec/changes\").join(name);\n        std::fs::create_dir_all(&target)?;\n        ensure_proposal(&target)?;\n        Ok(target)\n    }\n\n    /// Puts a change's `proposal.md`, `tasks.md` and `specs/` under\n    /// `openspec/changes/<name>`, writing the parity proposal when the source\n    /// holds none.\n    ///\n    /// # Errors\n    ///\n    /// Returns the IO error of the copy or the proposal write.\n    pub fn put_change(&self, name: &str, source: &Path) -> io::Result<PathBuf> {\n        let target = self.make_change(name)?;\n        for part in [\"proposal.md\", \"tasks.md\"] {\n            let from = source.join(part);\n            if from.is_file() {\n                std::fs::copy(&from, target.join(part))?;\n            }\n        }\n        let specs = source.join(\"specs\");\n        if specs.is_dir() {\n            copy_tree(&specs, &target.join(\"specs\"))?;\n        }\n        ensure_proposal(&target)?;\n        Ok(target)\n    }\n\n    /// Writes `text` to `relative` under the project root, creating folders.\n    ///\n    /// # Errors\n    ///\n    /// Returns the IO error of the folder or file write.\n    pub fn write(&self, relative: &str, text: &str) -> io::Result<()> {\n        let path = self.root.join(relative);\n        if let Some(parent) = path.parent() {\n            std::fs::create_dir_all(parent)?;\n        }\n        std::fs::write(path, text)\n    }\n}\n\n/// Writes the parity proposal into `change` when it holds none.\nfn ensure_proposal(change: &Path) -> io::Result<()> {\n    let proposal = change.join(\"proposal.md\");\n    if proposal.is_file() {\n        return Ok(());\n    }\n    std::fs::write(proposal, PARITY_PROPOSAL)\n}\n===== openspec_parity_support/trees.rs\n//! Reading and copying directory trees for the parity projects.\n\nuse std::collections::BTreeMap;\nuse std::io;\nuse std::path::{Path, PathBuf};\n\n/// The repository root, three folders above this crate's manifest.\n///\n/// # Panics\n///\n/// Panics when the crate's manifest is not three folders below the root.\n#[must_use]\npub fn repository_root() -> PathBuf {\n    Path::new(env!(\"CARGO_MANIFEST_DIR\"))\n        .ancestors()\n        .nth(3)\n        .expect(\"the repository root is three folders above crates/kernel/specs\")\n        .to_path_buf()\n}\n\n/// The folders directly under `dir`, in byte order of their names.\n#[must_use]\npub fn folders(dir: &Path) -> Vec<PathBuf> {\n    entries(dir)\n        .into_iter()\n        .filter(|path| path.is_dir())\n        .collect()\n}\n\n/// The `.md` files directly under `dir`, in byte order of their names.\n#[must_use]\npub fn markdown_files(dir: &Path) -> Vec<PathBuf> {\n    entries(dir)\n        .into_iter()\n        .filter(|path| path.is_file() && path.extension().is_some_and(|ext| ext == \"md\"))\n        .collect()\n}\n\n/// The entries directly under `dir`, in byte order of their file names.\nfn entries(dir: &Path) -> Vec<PathBuf> {\n    let Ok(read) = std::fs::read_dir(dir) else {\n        return Vec::new();\n    };\n    let mut paths: Vec<PathBuf> = read.flatten().map(|entry| entry.path()).collect();\n    paths.sort_by(|left, right| left.file_name().cmp(&right.file_name()));\n    paths\n}\n\n/// The file name of `path` as text, or empty when it has none.\n#[must_use]\npub fn name_of(path: &Path) -> String {\n    path.file_name()\n        .map(|name| name.to_string_lossy().into_owned())\n        .unwrap_or_default()\n}\n\n/// Copies the tree at `source` into `target`, creating every folder.\n///\n/// # Errors\n///\n/// Returns the IO error of a folder it cannot create or a file it cannot copy.\npub fn copy_tree(source: &Path, target: &Path) -> io::Result<()> {\n    std::fs::create_dir_all(target)?;\n    for entry in std::fs::read_dir(source)?.flatten() {\n        let from = entry.path();\n        let to = target.join(entry.file_name());\n        if entry.file_type()?.is_dir() {\n            copy_tree(&from, &to)?;\n        } else {\n            std::fs::copy(&from, &to)?;\n        }\n    }\n    Ok(())\n}\n\n/// Reads every regular file under `root` as its `/`-joined relative path and\n/// its text.\n///\n/// # Errors\n///\n/// Returns the IO or UTF-8 error of the first file that cannot be read.\npub fn read_tree(root: &Path) -> io::Result<BTreeMap<String, String>> {\n    let mut tree = BTreeMap::new();\n    collect_tree(root, \"\", &mut tree)?;\n    Ok(tree)\n}\n\n/// Collects the files under `dir`, prefixing each key with `prefix`.\nfn collect_tree(dir: &Path, prefix: &str, tree: &mut BTreeMap<String, String>) -> io::Result<()> {\n    for entry in std::fs::read_dir(dir)?.flatten() {\n        let path = entry.path();\n        let key = if prefix.is_empty() {\n            name_of(&path)\n        } else {\n            format!(\"{prefix}/{}\", name_of(&path))\n        };\n        if entry.file_type()?.is_dir() {\n            collect_tree(&path, &key, tree)?;\n        } else {\n            tree.insert(key, std::fs::read_to_string(&path)?);\n        }\n    }\n    Ok(())\n}\n===== openspec_parity_support/replay.rs\n//! The landing order of this repository's archive for the parity tests.\n\nuse super::trees::folders;\nuse std::path::{Path, PathBuf};\n\n/// The archived change folders in the landing order of rust-specs \"Archive\n/// replay\": the folders with no `archived` timestamp first, in byte order of\n/// their names, then the others by the timestamp of their last `archived`\n/// event and then by name.\n#[must_use]\npub fn archived_landing_order(archive: &Path) -> Vec<PathBuf> {\n    let mut landed: Vec<(Option<String>, PathBuf)> = folders(archive)\n        .into_iter()\n        .map(|path| (last_archived_timestamp(&path), path))\n        .collect();\n    landed.sort_by(|(left_stamp, left), (right_stamp, right)| {\n        left_stamp\n            .cmp(right_stamp)\n            .then_with(|| left.file_name().cmp(&right.file_name()))\n    });\n    landed.into_iter().map(|(_, path)| path).collect()\n}\n\n/// The last `archived` timestamp one change folder recorded, when it has one.\nfn last_archived_timestamp(change: &Path) -> Option<String> {\n    let text = std::fs::read_to_string(change.join(\".run/events/change.jsonl\")).ok()?;\n    let mut last = None;\n    for line in text.lines() {\n        if line.trim().is_empty() {\n            continue;\n        }\n        let Ok(value) = serde_json::from_str::<serde_json::Value>(line) else {\n            continue;\n        };\n        if value.get(\"type\").and_then(|kind| kind.as_str()) != Some(\"archived\") {\n            continue;\n        }\n        if let Some(stamp) = value.get(\"timestamp\").and_then(|stamp| stamp.as_str()) {\n            last = Some(stamp.to_string());\n        }\n    }\n    last\n}\n===== openspec_parity_support/report.rs\n//! Comparing the Rust validator and the `OpenSpec` CLI for the parity tests.\n\n/// What one side of one parity comparison decided.\n#[derive(Debug, Clone, PartialEq, Eq)]\npub enum Outcome {\n    /// The side found nothing to fail on.\n    Pass,\n    /// The side failed, with one detail per finding or issue, possibly none.\n    Fail(Vec<String>),\n}\n\nimpl Outcome {\n    /// Builds a pass for no details and a fail otherwise.\n    #[must_use]\n    pub fn from_details(details: Vec<String>) -> Self {\n        if details.is_empty() {\n            Self::Pass\n        } else {\n            Self::Fail(details)\n        }\n    }\n\n    /// True when the side passed.\n    #[must_use]\n    pub fn passed(&self) -> bool {\n        matches!(self, Self::Pass)\n    }\n\n    /// The detail lines, empty for a pass.\n    #[must_use]\n    pub fn details(&self) -> &[String] {\n        match self {\n            Self::Pass => &[],\n            Self::Fail(details) => details,\n        }\n    }\n\n    /// `pass` or `fail`.\n    #[must_use]\n    pub fn label(&self) -> &'static str {\n        if self.passed() { \"pass\" } else { \"fail\" }\n    }\n}\n\n/// One compared parity item.\n#[derive(Debug, Clone)]\npub struct Comparison {\n    /// The item's label, relative to the repository or the crate.\n    pub label: String,\n    /// The Rust validator's outcome.\n    pub rust: Outcome,\n    /// The `OpenSpec` CLI's outcome.\n    pub openspec: Outcome,\n}\n\n/// A difference the Rust validator and the `OpenSpec` CLI are allowed to have.\n#[derive(Debug, Clone)]\npub struct KnownDifference {\n    /// The item's label.\n    pub label: &'static str,\n    /// True when the Rust side passes.\n    pub rust_passes: bool,\n    /// True when the `OpenSpec` side passes.\n    pub openspec_passes: bool,\n    /// Why the two sides differ.\n    pub why: &'static str,\n}\n\n/// Asserts every comparison agrees, except the listed differences, which must\n/// differ exactly as listed. Prints every failing item at once.\n///\n/// # Panics\n///\n/// Panics when an unlisted item disagrees, a listed difference no longer\n/// holds, or a listed difference names an item that was not compared.\npub fn assert_parity(comparisons: &[Comparison], differences: &[KnownDifference]) {\n    let failures = collect_failures(comparisons, differences);\n    assert!(\n        failures.is_empty(),\n        \"validate parity failures:\\n{}\",\n        failures.join(\"\\n\")\n    );\n}\n\n/// Every failure: each unlisted disagreement, each stale difference, and each\n/// listed difference with no item.\nfn collect_failures(comparisons: &[Comparison], differences: &[KnownDifference]) -> Vec<String> {\n    let mut failures = Vec::new();\n    for comparison in comparisons {\n        match differences\n            .iter()\n            .find(|difference| difference.label == comparison.label)\n        {\n            None => {\n                if comparison.rust.passed() != comparison.openspec.passed() {\n                    failures.push(format!(\n                        \"unlisted difference:\\n{}\",\n                        format_comparison(comparison)\n                    ));\n                }\n            }\n            Some(difference) => {\n                if comparison.rust.passed() != difference.rust_passes\n                    || comparison.openspec.passed() != difference.openspec_passes\n                {\n                    failures.push(format!(\n                        \"listed difference no longer holds ({}):\\n{}\",\n                        difference.why,\n                        format_comparison(comparison)\n                    ));\n                }\n            }\n        }\n    }\n    for difference in differences {\n        if !comparisons\n            .iter()\n            .any(|comparison| comparison.label == difference.label)\n        {\n            failures.push(format!(\n                \"listed difference was not compared: `{}`\",\n                difference.label\n            ));\n        }\n    }\n    failures\n}\n\n/// The label, both outcomes, and both sides' details.\nfn format_comparison(comparison: &Comparison) -> String {\n    format!(\n        \"`{}`: rust {}, openspec {}\\n  rust: {}\\n  openspec: {}\",\n        comparison.label,\n        comparison.rust.label(),\n        comparison.openspec.label(),\n        details_text(&comparison.rust),\n        details_text(&comparison.openspec)\n    )\n}\n\n/// One side's details, or a note that it has none.\nfn details_text(outcome: &Outcome) -> String {\n    if outcome.details().is_empty() {\n        \"(no details)\".to_string()\n    } else {\n        outcome.details().join(\"; \")\n    }\n}\n===== items\narchive.rs\ndelta.rs\nliving.rs\nmod.rs\nopenspec.rs\ntargets.rs\n--- openspec_parity_support/items/archive.rs\n//! The archived changes, each validated against the replay before it lands.\n\nuse super::super::cli::OpenSpecCli;\nuse super::super::project::Project;\nuse super::super::replay::archived_landing_order;\nuse super::super::report::Comparison;\nuse super::super::trees::name_of;\nuse super::openspec::{change_outcome, single_item_outcome};\nuse osq_kernel_specs::merge_change;\nuse std::path::{Path, PathBuf};\n\n/// The archive, relative to the repository root.\nconst ARCHIVE: &str = \"openspec/changes/archive\";\n\n/// The archived changes in landing order, each validated against the living\n/// specs the replay gives before it, and then merged into the replay.\npub(super) fn archive_comparisons(repo: &Path, cli: &OpenSpecCli) -> Vec<Comparison> {\n    let archive = repo.join(ARCHIVE);\n    let scratch = scratch_specs();\n    let project = Project::prepare(\"archive\", repo).expect(\"the project writes\");\n    let mut comparisons = Vec::new();\n    for folder in archived_landing_order(&archive) {\n        let name = name_of(&folder);\n        let rust = change_outcome(&folder, &scratch);\n        project\n            .set_specs(Some(&scratch))\n            .expect(\"the replay specs copy\");\n        project.clear_changes().expect(\"the changes clear\");\n        project\n            .put_change(&name, &folder)\n            .expect(\"the change copies\");\n        let output = cli.run(\n            &[\n                \"validate\",\n                &name,\n                \"--type\",\n                \"change\",\n                \"--strict\",\n                \"--json\",\n                \"--no-interactive\",\n            ],\n            project.root(),\n        );\n        comparisons.push(Comparison {\n            label: format!(\"openspec/changes/archive/{name}\"),\n            rust,\n            openspec: single_item_outcome(&output),\n        });\n        merge_into(&folder, &scratch);\n    }\n    comparisons\n}\n\n/// An empty scratch specs folder for the replay.\nfn scratch_specs() -> PathBuf {\n    let scratch = Path::new(env!(\"CARGO_TARGET_TMPDIR\")).join(\"openspec-parity/archive-specs\");\n    let _ = std::fs::remove_dir_all(&scratch);\n    std::fs::create_dir_all(&scratch).expect(\"the scratch folder creates\");\n    scratch\n}\n\n/// Merges one change into the scratch specs, writing or removing before the\n/// next change is compared.\nfn merge_into(change: &Path, scratch: &Path) {\n    let merged = merge_change(change, scratch).unwrap_or_else(|error| {\n        panic!(\n            \"{}: the archive replay cannot merge: {error}\",\n            change.display()\n        )\n    });\n    for spec in merged {\n        let target = scratch.join(&spec.capability);\n        match spec.text {\n            Some(text) => {\n                std::fs::create_dir_all(&target).expect(\"the scratch capability creates\");\n                std::fs::write(target.join(\"spec.md\"), text).expect(\"the scratch spec writes\");\n            }\n            None => {\n                let _ = std::fs::remove_dir_all(&target);\n            }\n        }\n    }\n}\n--- openspec_parity_support/items/delta.rs\n//! The delta spec fixtures, each as `specs/alpha/spec.md` of a change.\n\nuse super::super::cli::OpenSpecCli;\nuse super::super::project::Project;\nuse super::super::report::Comparison;\nuse super::super::trees::{markdown_files, name_of};\nuse super::openspec::{delta_outcome, single_item_outcome};\nuse std::path::Path;\n\n/// The delta spec fixtures, relative to the repository root.\nconst DELTA_FIXTURES: &str = \"crates/kernel/specs/tests/fixtures/validate/delta\";\n\n/// The delta spec fixtures, each as `specs/alpha/spec.md` of a change `parity`\n/// with no living spec.\npub(super) fn delta_fixture_comparisons(repo: &Path, cli: &OpenSpecCli) -> Vec<Comparison> {\n    let dir = repo.join(DELTA_FIXTURES);\n    let project = Project::prepare(\"delta-fixtures\", repo).expect(\"the project writes\");\n    let mut comparisons = Vec::new();\n    for file in markdown_files(&dir) {\n        let stem = name_of(&file);\n        let stem = stem.trim_end_matches(\".md\");\n        let text = std::fs::read_to_string(&file).expect(\"a fixture reads\");\n        project.set_specs(None).expect(\"the living specs clear\");\n        project.clear_changes().expect(\"the changes clear\");\n        project.make_change(\"parity\").expect(\"the change writes\");\n        project\n            .write(\"openspec/changes/parity/specs/alpha/spec.md\", &text)\n            .expect(\"the fixture writes\");\n        let output = cli.run(\n            &[\n                \"validate\",\n                \"parity\",\n                \"--type\",\n                \"change\",\n                \"--strict\",\n                \"--json\",\n                \"--no-interactive\",\n            ],\n            project.root(),\n        );\n        let label = format!(\"fixtures/validate/delta/{stem}.md\");\n        comparisons.push(Comparison {\n            rust: delta_outcome(&label, &text),\n            openspec: single_item_outcome(&output),\n            label,\n        });\n    }\n    comparisons\n}\n--- openspec_parity_support/items/living.rs\n//! The living specs under `openspec/specs/` and the living spec fixtures.\n\nuse super::super::cli::OpenSpecCli;\nuse super::super::project::Project;\nuse super::super::report::Comparison;\nuse super::super::trees::{folders, markdown_files, name_of};\nuse super::openspec::{item_outcome, items_of, living_outcome, single_item_outcome};\nuse std::path::Path;\n\n/// The living spec fixtures, relative to the repository root.\nconst LIVING_FIXTURES: &str = \"crates/kernel/specs/tests/fixtures/validate/living\";\n\n/// The living specs under `openspec/specs/`, one comparison per capability.\npub(super) fn living_spec_comparisons(repo: &Path, cli: &OpenSpecCli) -> Vec<Comparison> {\n    let specs = repo.join(\"openspec/specs\");\n    let project = Project::prepare(\"living-specs\", repo).expect(\"the project writes\");\n    project\n        .set_specs(Some(&specs))\n        .expect(\"the living specs copy\");\n    let output = cli.run(\n        &[\n            \"validate\",\n            \"--specs\",\n            \"--strict\",\n            \"--json\",\n            \"--no-interactive\",\n        ],\n        project.root(),\n    );\n    let items = items_of(&output).unwrap_or_default();\n    let mut comparisons = Vec::new();\n    for folder in folders(&specs) {\n        let path = folder.join(\"spec.md\");\n        if !path.is_file() {\n            continue;\n        }\n        let capability = name_of(&folder);\n        let label = format!(\"openspec/specs/{capability}/spec.md\");\n        let text = std::fs::read_to_string(&path).expect(\"a living spec reads\");\n        comparisons.push(Comparison {\n            rust: living_outcome(&label, &text),\n            openspec: item_outcome(&items, &capability),\n            label,\n        });\n    }\n    comparisons\n}\n\n/// The living spec fixtures, each as the only spec of a project.\npub(super) fn living_fixture_comparisons(repo: &Path, cli: &OpenSpecCli) -> Vec<Comparison> {\n    let dir = repo.join(LIVING_FIXTURES);\n    let project = Project::prepare(\"living-fixtures\", repo).expect(\"the project writes\");\n    let mut comparisons = Vec::new();\n    for file in markdown_files(&dir) {\n        let stem = name_of(&file);\n        let stem = stem.trim_end_matches(\".md\");\n        let text = std::fs::read_to_string(&file).expect(\"a fixture reads\");\n        project.set_specs(None).expect(\"the living specs clear\");\n        project\n            .write(&format!(\"openspec/specs/{stem}/spec.md\"), &text)\n            .expect(\"the fixture writes\");\n        let output = cli.run(\n            &[\n                \"validate\",\n                stem,\n                \"--type\",\n                \"spec\",\n                \"--strict\",\n                \"--json\",\n                \"--no-interactive\",\n            ],\n            project.root(),\n        );\n        let label = format!(\"fixtures/validate/living/{stem}.md\");\n        comparisons.push(Comparison {\n            rust: living_outcome(&label, &text),\n            openspec: single_item_outcome(&output),\n            label,\n        });\n    }\n    comparisons\n}\n--- openspec_parity_support/items/mod.rs\n//! Collecting every rust-specs \"`OpenSpec` validate parity\" item and both\n//! outcomes.\n\nmod archive;\nmod delta;\nmod living;\nmod openspec;\nmod targets;\n\nuse super::cli::OpenSpecCli;\nuse super::report::Comparison;\nuse std::path::Path;\n\n/// Compares every item of rust-specs \"`OpenSpec` validate parity\": the living\n/// specs, the archived changes, and the validate fixtures.\n///\n/// # Panics\n///\n/// Panics when a temporary project cannot be written or an item cannot be\n/// prepared.\n#[must_use]\npub fn validate_comparisons(repo: &Path, cli: &OpenSpecCli) -> Vec<Comparison> {\n    let mut comparisons = living::living_spec_comparisons(repo, cli);\n    comparisons.extend(living::living_fixture_comparisons(repo, cli));\n    comparisons.extend(delta::delta_fixture_comparisons(repo, cli));\n    comparisons.extend(targets::target_comparisons(repo, cli));\n    comparisons.extend(archive::archive_comparisons(repo, cli));\n    comparisons\n}\n--- openspec_parity_support/items/openspec.rs\n//! Reading the CLI's JSON and turning an item into an outcome.\n\nuse super::super::cli::text_of;\nuse super::super::report::Outcome;\nuse osq_kernel_specs::{\n    SpecFinding, validate_change, validate_delta, validate_living_spec, validate_merged_change,\n};\nuse serde_json::Value;\nuse std::path::Path;\nuse std::process::Output;\n\n/// The `items` array of a `--json` run, or none when the output is not JSON.\npub(super) fn items_of(output: &Output) -> Option<Vec<Value>> {\n    let text = String::from_utf8_lossy(&output.stdout);\n    let value: Value = serde_json::from_str(&text).ok()?;\n    value.get(\"items\")?.as_array().cloned()\n}\n\n/// The outcome of a run that validates exactly one item.\npub(super) fn single_item_outcome(output: &Output) -> Outcome {\n    match items_of(output).as_deref().and_then(|items| items.first()) {\n        Some(item) => outcome_of(item),\n        None => Outcome::Fail(vec![format!(\n            \"the CLI printed no JSON item: {}\",\n            text_of(output)\n        )]),\n    }\n}\n\n/// The outcome of the item with `id` in a multi-item run, failing when absent.\npub(super) fn item_outcome(items: &[Value], id: &str) -> Outcome {\n    let Some(item) = items\n        .iter()\n        .find(|item| item.get(\"id\").and_then(Value::as_str) == Some(id))\n    else {\n        return Outcome::Fail(vec![format!(\"the CLI reported no item `{id}`\")]);\n    };\n    outcome_of(item)\n}\n\n/// The outcome of one `--json` item value.\npub(super) fn outcome_of(item: &Value) -> Outcome {\n    if item.get(\"valid\").and_then(Value::as_bool) == Some(true) {\n        return Outcome::Pass;\n    }\n    Outcome::Fail(issue_messages(item))\n}\n\n/// The item's ERROR and WARNING messages, in order.\nfn issue_messages(item: &Value) -> Vec<String> {\n    let mut messages = Vec::new();\n    let Some(issues) = item.get(\"issues\").and_then(Value::as_array) else {\n        return messages;\n    };\n    for issue in issues {\n        let level = issue\n            .get(\"level\")\n            .and_then(Value::as_str)\n            .unwrap_or(\"ERROR\");\n        if level == \"ERROR\" || level == \"WARNING\" {\n            let message = issue.get(\"message\").and_then(Value::as_str).unwrap_or(\"\");\n            messages.push(format!(\"{level} {message}\"));\n        }\n    }\n    messages\n}\n\n/// The Rust findings of one living spec.\npub(super) fn living_outcome(label: &str, text: &str) -> Outcome {\n    Outcome::from_details(finding_lines(&validate_living_spec(label, text)))\n}\n\n/// The Rust findings of a delta spec that need no living spec.\npub(super) fn delta_outcome(label: &str, text: &str) -> Outcome {\n    Outcome::from_details(finding_lines(&validate_delta(label, text)))\n}\n\n/// The Rust outcome of a change, from `validate_change` and\n/// `validate_merged_change`.\npub(super) fn change_outcome(change: &Path, specs: &Path) -> Outcome {\n    let mut details = Vec::new();\n    match validate_change(change, specs) {\n        Ok(found) => details.extend(finding_lines(&found)),\n        Err(error) => details.push(format!(\"validate_change read error: {error}\")),\n    }\n    match validate_merged_change(change, specs) {\n        Ok(found) => details.extend(finding_lines(&found)),\n        Err(error) => details.push(format!(\"validate_merged_change error: {error}\")),\n    }\n    Outcome::from_details(details)\n}\n\n/// One finding as a failure line.\nfn finding_line(finding: &SpecFinding) -> String {\n    let requirement = finding\n        .requirement\n        .as_deref()\n        .map_or(String::new(), |name| format!(\" for `{name}`\"));\n    format!(\n        \"{} at line {}{}: {}\",\n        finding.code.as_str(),\n        finding.line,\n        requirement,\n        finding.message\n    )\n}\n\n/// The failure lines of a list of findings.\nfn finding_lines(found: &[SpecFinding]) -> Vec<String> {\n    found.iter().map(finding_line).collect()\n}\n--- openspec_parity_support/items/targets.rs\n//! The validate target changes, validated against the target living specs.\n\nuse super::super::cli::OpenSpecCli;\nuse super::super::project::Project;\nuse super::super::report::Comparison;\nuse super::super::trees::{folders, name_of};\nuse super::openspec::{change_outcome, single_item_outcome};\nuse std::path::Path;\n\n/// The target fixtures, relative to the repository root.\nconst TARGETS: &str = \"crates/kernel/specs/tests/fixtures/validate/targets\";\n\n/// The changes under `targets/changes/`, each with `targets/specs/` as the\n/// living specs.\npub(super) fn target_comparisons(repo: &Path, cli: &OpenSpecCli) -> Vec<Comparison> {\n    let base = repo.join(TARGETS);\n    let specs = base.join(\"specs\");\n    let project = Project::prepare(\"targets\", repo).expect(\"the project writes\");\n    let mut comparisons = Vec::new();\n    for folder in folders(&base.join(\"changes\")) {\n        let name = name_of(&folder);\n        project\n            .set_specs(Some(&specs))\n            .expect(\"the living specs copy\");\n        project.clear_changes().expect(\"the changes clear\");\n        project\n            .put_change(&name, &folder)\n            .expect(\"the change copies\");\n        let output = cli.run(\n            &[\n                \"validate\",\n                &name,\n                \"--type\",\n                \"change\",\n                \"--strict\",\n                \"--json\",\n                \"--no-interactive\",\n            ],\n            project.root(),\n        );\n        let label = format!(\"fixtures/validate/targets/changes/{name}\");\n        comparisons.push(Comparison {\n            rust: change_outcome(&folder, &specs),\n            openspec: single_item_outcome(&output),\n            label,\n        });\n    }\n    comparisons\n}\n===== validate corpus\n//! Corpus test: the Rust validator and the `OpenSpec` CLI agree on every living\n//! spec, archived change and validate fixture, except the five differences of\n//! rust-specs \"Validate differences\".\n//!\n//! It runs the `OpenSpec` CLI over this repository's live specs and archive, so\n//! it is a corpus test (rust-core \"Corpus tests\"): each test carries the corpus\n//! ignore, and only a build with the `parity` feature compiles it.\n\npub mod openspec_parity_support;\n\nuse openspec_parity_support::cli::{OpenSpecCli, is_version};\nuse openspec_parity_support::items::validate_comparisons;\nuse openspec_parity_support::report::{KnownDifference, assert_parity};\nuse openspec_parity_support::trees::repository_root;\n\n/// The five differences rust-specs \"Validate differences\" lists.\nconst KNOWN_DIFFERENCES: [KnownDifference; 5] = [\n    KnownDifference {\n        label: \"fixtures/validate/living/valid.md\",\n        rust_passes: true,\n        openspec_passes: false,\n        why: \"OpenSpec warns that a Purpose under 50 characters is too brief, \\\n              which ADR 026 does not port\",\n    },\n    KnownDifference {\n        label: \"fixtures/validate/delta/empty-delta-section.md\",\n        rust_passes: false,\n        openspec_passes: true,\n        why: \"ADR 026 makes every delta section well formed\",\n    },\n    KnownDifference {\n        label: \"fixtures/validate/delta/invalid-rename.md\",\n        rust_passes: false,\n        openspec_passes: true,\n        why: \"ADR 026 makes every delta section well formed\",\n    },\n    KnownDifference {\n        label: \"fixtures/validate/delta/unknown-delta-section.md\",\n        rust_passes: false,\n        openspec_passes: true,\n        why: \"ADR 026 allows only the four delta sections\",\n    },\n    KnownDifference {\n        label: \"fixtures/validate/targets/changes/unknown\",\n        rust_passes: false,\n        openspec_passes: true,\n        why: \"OpenSpec checks targets only at archive, and ADR 026 checks them at validate\",\n    },\n];\n\n/// Covers: rust-specs/validate-differences\n#[ignore = \"corpus test: runs the OpenSpec CLI on the live specs and archive\"]\n#[test]\nfn cli_reports_a_version() {\n    let repo = repository_root();\n    let cli = OpenSpecCli::locate(&repo);\n    let version = cli.version(&repo);\n    assert!(\n        is_version(&version),\n        \"openspec {} --version printed `{version}`, not <n>.<n>.<n>\",\n        cli.path().display()\n    );\n}\n\n/// Covers: rust-specs/validate-differences\n#[ignore = \"corpus test: runs the OpenSpec CLI on the live specs and archive\"]\n#[test]\nfn validate_matches_openspec() {\n    let repo = repository_root();\n    let cli = OpenSpecCli::locate(&repo);\n    let comparisons = validate_comparisons(&repo, &cli);\n    let labels: Vec<&str> = comparisons\n        .iter()\n        .map(|comparison| comparison.label.as_str())\n        .collect();\n    assert!(\n        labels\n            .iter()\n            .any(|label| label.starts_with(\"openspec/specs/\")),\n        \"no living spec was compared\"\n    );\n    assert!(\n        labels\n            .iter()\n            .any(|label| label.starts_with(\"openspec/changes/archive/\")),\n        \"no archived change was compared\"\n    );\n    assert_parity(&comparisons, &KNOWN_DIFFERENCES);\n}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd crates/kernel/specs/tests && for f in openspec_parity_support/mod.rs openspec_parity_support/cli.rs openspec_parity_support/project.rs openspec_parity_support/trees.rs openspec_parity_support/replay.rs openspec_parity_support/report.rs; do echo \\\"===== $f\\\"; cat \\\"$f\\\"; done; echo \\\"===== items\\\"; ls openspec_parity_support/items; for f in openspec_parity_support/items/*; do echo \\\"--- $f\\\"; cat \\\"$f\\\"; done; echo \\\"===== validate corpus\\\"; cat openspec_validate_parity_corpus.rs\"}"},"time":{"start":1792396285691,"end":1792396285817}}}}
