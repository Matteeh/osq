h)\n            .args(args)\n            .current_dir(cwd)\n            .env(\"OPENSPEC_TELEMETRY\", \"0\")\n            .output()\n            .unwrap_or_else(|error| {\n                panic!(\n                    \"cannot run openspec {} -- {}: {error}\",\n                    self.path.display(),\n                    args.join(\" \")\n                )\n            })\n    }\n\n    /// The trimmed `--version` output.\n    ///\n    /// # Panics\n    ///\n    /// Panics, naming the path, when the CLI cannot be started or exits\n    /// nonzero.\n    #[must_use]\n    pub fn version(&self, cwd: &Path) -> String {\n        let output = self.run(&[\"--version\"], cwd);\n        assert!(\n            output.status.success(),\n            \"openspec {} --version failed: {}\",\n            self.path.display(),\n            text_of(&output)\n        );\n        String::from_utf8_lossy(&output.stdout).trim().to_string()\n    }\n}\n\n/// True when `text` is exactly `<digits>.<digits>.<digits>`.\n#[must_use]\npub fn is_version(text: &str) -> bool {\n    let parts: Vec<&str> = text.split('.').collect();\n    parts.len() == 3\n        && parts\n            .iter()\n            .all(|part| !part.is_empty() && part.bytes().all(|byte| byte.is_ascii_digit()))\n}\n\n/// The stdout and stderr of one run, joined and truncated to 500 characters.\n#[must_use]\npub fn text_of(output: &Output) -> String {\n    let mut text = String::from_utf8_lossy(&output.stdout).into_owned();\n    text.push_str(&String::from_utf8_lossy(&output.stderr));\n    text.chars().take(500).collect()\n}\n=== crates/kernel/specs/tests/openspec_parity_support/items\n=== crates/kernel/specs/tests/openspec_parity_support/mod.rs\ncat: crates/kernel/specs/tests/openspec_parity_support/items: Is a directory\n//! Shared helpers for the specs kernel's `OpenSpec` CLI parity tests (ADR 026).\n//!\n//! The validate parity test and the archive parity test both build temporary\n//! `OpenSpec` projects and run the CLI, so those helpers live here. An\n//! integration test declares this folder as `pub mod openspec_parity_support;`\n//! and uses the parts it needs; the rest stay reachable, so they do not warn as\n//! dead code.\n\npub mod cli;\npub mod items;\npub mod project;\npub mod replay;\npub mod report;\npub mod trees;\n=== crates/kernel/specs/tests/openspec_parity_support/project.rs\n//! Temporary `OpenSpec` projects the parity tests build and validate.\n\nuse super::trees::copy_tree;\nuse std::io;\nuse std::path::{Path, PathBuf};\n\n/// The proposal a fixture change without one gets, because `OpenSpec` reads a\n/// change only through its proposal.\nconst PARITY_PROPOSAL: &str = \"# Parity fixture\\n\";\n\n/// A temporary `OpenSpec` project under `CARGO_TARGET_TMPDIR`.\n#[derive(Debug)]\npub struct Project {\n    /// The project's root folder.\n    root: PathBuf,\n}\n\nimpl Project {\n    /// Prepares an empty project folder with the scaffolded osq schema.\n    ///\n    /// Removes any earlier folder at the same path, so a rerun starts clean.\n    ///\n    /// # Errors\n    ///\n    /// Returns the IO error of the scaffold copy.\n    pub fn prepare(name: &str, repo: &Path) -> io::Result<Self> {\n        let root = Path::new(env!(\"CARGO_TARGET_TMPDIR\"))\n            .join(\"openspec-parity\")\n            .join(name);\n        let _ = std::fs::remove_dir_all(&root);\n        std::fs::create_dir_all(root.join(\"openspec\"))?;\n        copy_tree(&repo.join(\"templates/openspec\"), &root.join(\"openspec\"))?;\n        Ok(Self { root })\n    }\n\n    /// The project's root folder.\n    #[must_use]\n    pub fn root(&self) -> &Path {\n        &self.root\n    }\n\n    /// Replaces `openspec/specs` with a copy of `source`, or removes it when\n    /// there is no source.\n    ///\n    /// # Errors\n    ///\n    /// Returns the IO error of the copy.\n    pub fn set_specs(&self, source: Option<&Path>) -> io::Result<()> {\n        let target = self.root.join(\"openspec/specs\");\n        let _ = std::fs::remove_dir_all(&target);\n        match source {\n            Some(source) => copy_tree(source, &target),\n            None => Ok(()),\n        }\n    }\n\n    /// Removes `openspec/changes`.\n    ///\n    /// # Errors\n    ///\n    /// Never fails today, but keeps the `io::Result` shape of its siblings.\n    pub fn clear_changes(&self) -> io::Result<()> {\n        let _ = std::fs::remove_dir_all(self.root.join(\"openspec/changes\"));\n        Ok(())\n    }\n\n    /// Creates `openspec/changes/<name>` with the parity proposal.\n    ///\n    /// # Errors\n    ///\n    /// Returns the IO error of the folder or proposal write.\n    pub fn make_change(&self, name: &str) -> io::Result<PathBuf> {\n        let target = self.root.join(\"openspec/changes\").join(name);\n        std::fs::create_dir_all(&target)?;\n        ensure_proposal(&target)?;\n        Ok(target)\n    }\n\n    /// Puts a change's `proposal.md`, `tasks.md` and `specs/` under\n    /// `openspec/changes/<name>`, writing the parity proposal when the source\n    /// holds none.\n    ///\n    /// # Errors\n    ///\n    /// Returns the IO error of the copy or the proposal write.\n    pub fn put_change(&self, name: &str, source: &Path) -> io::Result<PathBuf> {\n        let target = self.make_change(name)?;\n        for part in [\"proposal.md\", \"tasks.md\"] {\n            let from = source.join(part);\n            if from.is_file() {\n                std::fs::copy(&from, target.join(part))?;\n            }\n        }\n        let specs = source.join(\"specs\");\n        if specs.is_dir() {\n            copy_tree(&specs, &target.join(\"specs\"))?;\n        }\n        ensure_proposal(&target)?;\n        Ok(target)\n    }\n\n    /// Writes `text` to `relative` under the project root, creating folders.\n    ///\n    /// # Errors\n    ///\n    /// Returns the IO error of the folder or file write.\n    pub fn write(&self, relative: &str, text: &str) -> io::Result<()> {\n        let path = self.root.join(relative);\n        if let Some(parent) = path.parent() {\n            std::fs::create_dir_all(parent)?;\n        }\n        std::fs::write(path, text)\n    }\n}\n\n/// Writes the parity proposal into `change` when it holds none.\nfn ensure_proposal(change: &Path) -> io::Result<()> {\n    let proposal = change.join(\"proposal.md\");\n    if proposal.is_file() {\n        return Ok(());\n    }\n    std::fs::write(proposal, PARITY_PROPOSAL)\n}\n=== crates/kernel/specs/tests/openspec_parity_support/replay.rs\n//! The landing order of this repository's archive for the parity tests.\n\nuse super::trees::folders;\nuse std::path::{Path, PathBuf};\n\n/// The archived change folders in the landing order of rust-specs \"Archive\n/// replay\": the folders with no `archived` timestamp first, in byte order of\n/// their names, then the others by the timestamp of their last `archived`\n/// event and then by name.\n#[must_use]\npub fn archived_landing_order(archive: &Path) -> Vec<PathBuf> {\n    let mut landed: Vec<(Option<String>, PathBuf)> = folders(archive)\n        .into_iter()\n        .map(|path| (last_archived_timestamp(&path), path))\n        .collect();\n    landed.sort_by(|(left_stamp, left), (right_stamp, right)| {\n        left_stamp\n            .cmp(right_stamp)\n            .then_with(|| left.file_name().cmp(&right.file_name()))\n    });\n    landed.into_iter().map(|(_, path)| path).collect()\n}\n\n/// The last `archived` timestamp one change folder recorded, when it has one.\nfn last_archived_timestamp(change: &Path) -> Option<String> {\n    let text = std::fs::read_to_string(change.join(\".run/events/change.jsonl\")).ok()?;\n    let mut last = None;\n    for line in text.lines() {\n        if line.trim().is_empty() {\n            continue;\n        }\n        let Ok(value) = serde_json::from_str::<serde_json::Value>(line) else {\n            continue;\n        };\n        if value.get(\"type\").and_then(|kind| kind.as_str()) != Some(\"archived\") {\n            continue;\n        }\n        if let Some(stamp) = value.get(\"timestamp\").and_then(|stamp| stamp.as_str()) {\n            last = Some(stamp.to_string());\n        }\n    }\n    last\n}\n=== crates/kernel/specs/tests/openspec_parity_support/report.rs\n//! Comparing the Rust validator and the `OpenSpec` CLI for the parity tests.\n\n/// What one side of one parity comparison decided.\n#[derive(Debug, Clone, PartialEq, Eq)]\npub enum Outcome {\n    /// The side found nothing to fail on.\n    Pass,\n    /// The side failed, with one detail per finding or issue, possibly none.\n    Fail(Vec<String>),\n}\n\nimpl Outcome {\n    /// Builds a pass for no details and a fail otherwise.\n    #[must_use]\n    pub fn from_details(details: Vec<String>) -> Self {\n        if details.is_empty() {\n            Self::Pass\n        } else {\n            Self::Fail(details)\n        }\n    }\n\n    /// True when the side passed.\n    #[must_use]\n    pub fn passed(&self) -> bool {\n        matches!(self, Self::Pass)\n    }\n\n    /// The detail lines, empty for a pass.\n    #[must_use]\n    pub fn details(&self) -> &[String] {\n        match self {\n            Self::Pass => &[],\n            Self::Fail(details) => details,\n        }\n    }\n\n    /// `pass` or `fail`.\n    #[must_use]\n    pub fn label(&self) -> &'static str {\n        if self.passed() { \"pass\" } else { \"fail\" }\n    }\n}\n\n/// One compared parity item.\n#[derive(Debug, Clone)]\npub struct Comparison {\n    /// The item's label, relative to the repository or the crate.\n    pub label: String,\n    /// The Rust validator's outcome.\n    pub rust: Outcome,\n    /// The `OpenSpec` CLI's outcome.\n    pub openspec: Outcome,\n}\n\n/// A difference the Rust validator and the `OpenSpec` CLI are allowed to have.\n#[derive(Debug, Clone)]\npub struct KnownDifference {\n    /// The item's label.\n    pub label: &'static str,\n    /// True when the Rust side passes.\n    pub rust_passes: bool,\n    /// True when the `OpenSpec` side passes.\n    pub openspec_passes: bool,\n    /// Why the two sides differ.\n    pub why: &'static str,\n}\n\n/// Asserts every comparison agrees, except the listed differences, which must\n/// differ exactly as listed. Prints every failing item at once.\n///\n/// # Panics\n///\n/// Panics when an unlisted item disagrees, a listed difference no longer\n/// holds, or a listed difference names an item that was not compared.\npub fn assert_parity(comparisons: &[Comparison], differences: &[KnownDifference]) {\n    let failures = collect_failures(comparisons, differences);\n    assert!(\n        failures.is_empty(),\n        \"validate parity failures:\\n{}\",\n        failures.join(\"\\n\")\n    );\n}\n\n/// Every failure: each unlisted disagreement, each stale difference, and each\n/// listed difference with no item.\nfn collect_failures(comparisons: &[Comparison], differences: &[KnownDifference]) -> Vec<String> {\n    let mut failures = Vec::new();\n    for comparison in comparisons {\n        match differences\n            .iter()\n            .find(|difference| difference.label == comparison.label)\n        {\n            None => {\n                if comparison.rust.passed() != comparison.openspec.passed() {\n                    failures.push(format!(\n                        \"unlisted difference:\\n{}\",\n                        format_comparison(comparison)\n                    ));\n                }\n            }\n            Some(difference) => {\n                if comparison.rust.passed() != difference.rust_passes\n                    || comparison.openspec.passed() != difference.openspec_passes\n                {\n                    failures.push(format!(\n                        \"listed difference no longer holds ({}):\\n{}\",\n                        difference.why,\n                        format_comparison(comparison)\n                    ));\n                }\n            }\n        }\n    }\n    for difference in differences {\n        if !com