-+{"type":"tool_use","timestamp":1792394815602,"sessionID":"ses_eacf54832ffeFAS4YOYdKea9Bo","part":{"partID":"prt_1530e5e11001ZfnRz30z3hykbf","sessionID":"ses_eacf54832ffeFAS4YOYdKea9Bo","messageID":"msg_1530e253f001NUZI1O60cdi0iW","type":"tool","id":"call_00_ib3agr9d1j0s3y3vnlq8vwjr","tool":"write","state":{"status":"completed","input":{"content":"//! Corpus test: the Rust merge and `OpenSpec` archive agree on every\n//! differential case of `tests/fixtures/openspec-diff/`.\n//!\n//! It runs the `OpenSpec` CLI over the repository's fixtures, so it is a corpus\n//! test (rust-core \"Corpus tests\"): each test carries the corpus ignore, and\n//! only a build with the `parity` feature compiles it.\n\npub mod openspec_parity_support;\n\nuse openspec_parity_support::cli::{OpenSpecCli, text_of};\nuse openspec_parity_support::project::Project;\nuse openspec_parity_support::trees::{copy_tree, folders, name_of, read_tree, repository_root};\nuse osq_kernel_specs::{MergeChangeError, merge_change};\nuse serde_json::Value;\nuse std::collections::BTreeMap;\nuse std::path::{Path, PathBuf};\nuse std::process::Output;\n\n/// The differential fixtures, relative to the repository root.\nconst FIXTURES: &str = \"tests/fixtures/openspec-diff\";\n\n/// Runs one differential case: builds both projects, then checks its\n/// expectation.\nfn run_case(name: &str) {\n    let case = repository_root().join(FIXTURES).join(name);\n    let expect = case_expect(&case);\n    let repo = repository_root();\n    let cli = OpenSpecCli::locate(&repo);\n    let openspec = scaffold(&format!(\"archive-{name}-openspec\"), &case);\n    let rust = scaffold(&format!(\"archive-{name}-rust\"), &case);\n    let changes = folders(&rust.root().join(\"openspec/changes\"));\n    let first = changes\n        .first()\n        .map_or_else(|| panic!(\"case {name} has no change\"), PathBuf::as_path);\n    let cli_specs = openspec.root().join(\"openspec/specs\");\n    let rust_specs = rust.root().join(\"openspec/specs\");\n    match expect.as_str() {\n        \"identical\" => assert_identical(&cli, &openspec, &rust_specs, &changes),\n        \"both-refuse\" => assert_both_refuse(&cli, first, &cli_specs, &rust_specs, &case),\n        \"osq-refuses\" => assert_osq_refuses(&cli, first, &cli_specs, &rust_specs, &case),\n        other => panic!(\"case {name} has unknown expect `{other}`\"),\n    }\n}\n\n/// Builds one temporary project holding the scaffold, the case's specs and its\n/// changes.\nfn scaffold(name: &str, case: &Path) -> Project {\n    let project = Project::prepare(name, &repository_root()).expect(\"the project writes\");\n    let specs = case.join(\"specs\");\n    project\n        .set_specs(specs.is_dir().then_some(specs.as_path()))\n        .expect(\"the case specs copy\");\n    copy_tree(&case.join(\"changes\"), &project.root().join(\"openspec/changes\"))\n        .expect(\"the case changes copy\");\n    project\n}\n\n/// The `expect` value of one case's `case.json`.\nfn case_expect(case: &Path) -> String {\n    let file = case.join(\"case.json\");\n    let text = std::fs::read_to_string(&file)\n        .unwrap_or_else(|error| panic!(\"reading {}: {error}\", file.display()));\n    let value: Value = serde_json::from_str(&text)\n        .unwrap_or_else(|error| panic!(\"parsing {}: {error}\", file.display()));\n    value\n        .get(\"expect\")\n        .and_then(Value::as_str)\n        .unwrap_or_else(|| panic!(\"{} has no expect\", file.display()))\n        .to_string()\n}\n\n/// Runs the CLI, asserting it exits zero, and returns its output.\nfn run_ok(cli: &OpenSpecCli, args: &[&str], cwd: &Path) -> Output {\n    let output = cli.run(args, cwd);\n    assert!(\n        output.status.success(),\n        \"{}: {} failed:\\n{}\",\n        cli.path().display(),\n        args.join(\" \"),\n        text_of(&output)\n    );\n    output\n}\n\n/// A case both tools accept: every change validates and archives in the CLI\n/// project, the Rust merge applies each change, and the specs trees match.\nfn assert_identical(cli: &OpenSpecCli, openspec: &Project, rust_specs: &Path, changes: &[PathBuf]) {\n    let validate = [\"validate\", \"\", \"--type\", \"change\", \"--strict\", \"--json\", \"--no-interactive\"];\n    for change in changes {\n        let mut args = validate;\n        args[1] = &name_of(change);\n        run_ok(cli, &args, openspec.root());\n    }\n    for change in changes {\n        let name = name_of(change);\n        run_ok(cli, &[\"archive\", &name, \"--yes\", \"--json\"], openspec.root());\n        merge_into(change, rust_specs);\n    }\n    assert_trees_equal(\n        &openspec.root().join(\"openspec/specs\"),\n        rust_specs,\n        \"the two specs trees\",\n    );\n}\n\n/// A case both tools refuse: the CLI reports `archive_spec_update_failed`, the\n/// Rust merge refuses, and neither tree changes.\nfn assert_both_refuse(\n    cli: &OpenSpecCli,\n    first: &Path,\n    cli_specs: &Path,\n    rust_specs: &Path,\n    case: &Path,\n) {\n    let name = name_of(first);\n    let archive = cli.run(&[\"archive\", &name, \"--yes\", \"--json\"], cli_specs);\n    assert!(\n        !archive.status.success(),\n        \"{}: archive {name} unexpectedly succeeded:\\n{}\",\n        cli.path().display(),\n        text_of(&archive)\n    );\n    let value: Value = serde_json::from_slice(&archive.stdout).unwrap_or_else(|error| {\n        panic!(\"archive {name} printed no JSON: {error}\\n{}\", text_of(&archive))\n    });\n    let refused = value\n        .get(\"status\")\n        .and_then(Value::as_array)\n        .is_some_and(|status| {\n            status.iter().any(|entry| {\n                entry.get(\"code\").and_then(Value::as_str) == Some(\"archive_spec_update_failed\")\n            })\n        });\n    assert!(\n        refused,\n        \"{}: archive {name} did not report archive_spec_update_failed:\\n{}\",\n        cli.path().display(),\n        text_of(&archive)\n    );\n    match merge_change(first, rust_specs) {\n        Err(MergeChangeError::Merge { .. }) => {}\n        other => panic!(\n            \"{}: the Rust merge should refuse, got {other:?}\",\n            first.display()\n        ),\n    }\n    let case_specs = case.join(\"specs\");\n    assert_trees_equal(cli_specs, &case_specs, \"the OpenSpec tree\");\n    assert_trees_equal(rust_specs, &case_specs, \"the Rust tree\");\n}\n\n/// A case the Rust merge refuses and the CLI accepts: the refusal names the\n/// expected rename form, and no living spec holds a rename target.\nfn assert_osq_refuses(\n    cli: &OpenSpecCli,\n    first: &Path,\n    cli_specs: &Path,\n    rust_specs: &Path,\n    case: &Path,\n) {\n    let name = name_of(first);\n    let message = match merge_change(first, rust_specs) {\n        Err(MergeChangeError::Merge { error, .. }) => error.to_string(),\n        other => panic!(\n            \"{}: expected a merge refusal, got {other:?}\",\n            first.display()\n        ),\n    };\n    assert!(\n        message.contains(\"### Requirement:\"),\n        \"{}: the refusal must name the expected form: {message}\",\n        first.display()\n    );\n    run_ok(cli, &[\"archive\", &name, \"--yes\", \"--json\"], cli_specs);\n    let living = tree(cli_specs);\n    for target in rename_targets(&case.join(\"changes\")) {\n        let header = format!(\"### Requirement: {target}\");\n        assert!(\n            !living.values().any(|text| text.contains(&header)),\n            \"{}: the case applied a rename OpenSpec should skip: {target}\",\n            case.display()\n        );\n    }\n}\n\n/// Merges one change into `specs`, writing or removing each merged spec.\nfn merge_into(change: &Path, specs: &Path) {\n    let merged = merge_change(change, specs)\n        .unwrap_or_else(|error| panic!(\"{}: the Rust merge refuses: {error}\", change.display()));\n    for spec in merged {\n        let folder = specs.join(&spec.capability);\n        match &spec.text {\n            Some(text) => {\n                std