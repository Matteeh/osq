ase}: archive {name} failed: {}\",\n                    text_of(&archive)\n                );\n            }\n            let cli_tree = tree_of(&cli_specs);\n            assert!(\n                !cli_tree.is_empty(),\n                \"case {case}: the CLI archived no living spec\"\n            );\n            assert_eq!(\n                cli_tree,\n                tree_of(&rust_specs),\n                \"case {case}: the two openspec/specs trees differ\"\n            );\n        }\n        \"both-refuse\" => {\n            let error = rust_merge(&rust_project, &names).expect_err(\"the Rust merge refuses\");\n            refusal_message(&error, case);\n            let name = first_name(&names);\n            let archive = cli_archive(&cli, &cli_project, name);\n            assert!(\n                !archive.status.success(),\n                \"case {case}: archive {name} unexpectedly succeeded: {}\",\n                text_of(&archive)\n            );\n            assert!(\n                status_codes(&archive.stdout)\n                    .iter()\n                    .any(|code| code == \"archive_spec_update_failed\"),\n                \"case {case}: archive {name} did not report archive_spec_update_failed: {}\",\n                text_of(&archive)\n            );\n            let expected = tree_of(&base);\n            assert_eq!(\n                tree_of(&cli_specs),\n                expected,\n                \"case {case}: the CLI changed the specs\"\n            );\n            assert_eq!(\n                tree_of(&rust_specs),\n                expected,\n                \"case {case}: the Rust merge changed the specs\"\n            );\n        }\n        \"osq-refuses\" => {\n            let error = rust_merge(&rust_project, &names).expect_err(\"the Rust merge refuses\");\n            let message = refusal_message(&error, case);\n            assert!(\n                message.contains(\"### Requirement:\"),\n                \"case {case}: the refusal must name 