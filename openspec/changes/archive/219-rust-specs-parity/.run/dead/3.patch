File,\n    VerifyStarts, parse_frontmatter, parse_proposal, parse_sidecar, parse_task_file,\n    parse_task_list,\n};\npub use markdown::{\n    Delta, LivingSpec, Outcome, Rename, RenameSide, Requirement, Scenario, UnpairedRename,\n    code_ownership, js_trim, normalize_requirement_name, parse_delta, parse_living_spec,\n    parse_requirement, parse_scenario, section,\n};\npub use merge::{\n    MergeChangeError, MergeError, MergedSpec, merge_change, merge_delta, merge_living_spec,\n};\npub use owners::{\n    CapabilityOwnership, owner_capabilities, read_capability_ownership, scope_covers_path,\n};\npub use read::{\n    SpecsError, read_delta, read_living_spec, read_proposal, read_sidecar, read_task_file,\n    read_task_list,\n};\npub use validate::{\n    FindingCode, SpecFinding, check_delta_targets, validate_change, validate_delta,\n    validate_living_spec, validate_living_specs, validate_merged_change,\n};\n58:pub struct Delta {\n59-    /// The title without a leading `Spec Delta:`.\n60-    pub title: String,\n61-    /// The trimmed purpose, or empty text.\n62-    pub purpose: String,\n63-    /// The requirement blocks under ADDED sections.\n64-    pub added: Vec<Requirement>,\n65-    /// The requirement blocks under MODIFIED sections.\n66-    pub modified: Vec<Requirement>,\n67-    /// The requirement names under REMOVED sections.\n68-    pub removed: Vec<String>,\n69-    /// The paired renames under RENAMED sections.\n70-    pub renamed: Vec<Rename>,\n71-    /// The malformed rename lines, kept trimmed.\n72:    pub invalid_renames: Vec<String>,\n73-    /// The FROM and TO sides without a partner.\n74:    pub unpaired_renames: Vec<UnpairedRename>,\n75-}\n76-\n77-/// One rename pair of a RENAMED section.\n78-#[derive(Debug, Clone, PartialEq, Eq, Serialize)]\n79-pub struct Rename {\n80-    /// The old requirement name.\n81-    pub from: String,\n82-    /// The new requirement name.\n83-    pub to: String,\n84-}\n85-\n86-/// One side of a rename that has no partner.\n87-#[derive(Debug, Clone, PartialEq, Eq, Serialize)]\n88-pub struct UnpairedRename {\n89-    /// Whether this is the FROM or the TO side.\n90-    pub side: RenameSide,\n91-    /// The requirement name on that side.\n92-    pub name: String,\n93-}\n94-\n95-/// The side of a rename pair.\n96-#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]\n97-pub enum RenameSide {\n98-    /// The side named `FROM`.\n99-    #[serde(rename = \"FROM\")]\n100-    From,\n101-    /// The side named `TO`.\n102-    #[serde(rename = \"TO\")]\n103-    To,\n104-}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"sed -n '1,45p' crates/kernel/specs/src/lib.rs; grep -n \\\"pub unpaired\\\\|pub invalid_renames\\\\|pub struct Delta\\\" -A 30 crates/kernel/specs/src/markdown/types.rs | head -50\"}"},"time":{"start":1792394971667,"end":1792394971684}}}}
