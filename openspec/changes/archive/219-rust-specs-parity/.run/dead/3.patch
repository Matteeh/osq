+{"type":"tool_use","timestamp":1792396492801,"sessionID":"ses_eacdb5a85ffeETstJhXFodxnfQ","part":{"partID":"prt_15327b6c1002Sm0i15bLgqHG0G","sessionID":"ses_eacdb5a85ffeETstJhXFodxnfQ","messageID":"msg_15327a8bb0017iUcCRT1IPL8OX","type":"tool","id":"call_99ff0b5f92f043c4b3c738ea","tool":"write","state":{"status":"completed","input":{"path":"crates/kernel/specs/tests/openspec_archive_parity_corpus.rs","content":"//! Corpus test: the Rust merge gives the result `openspec archive` gives on\n//! every differential case of `tests/fixtures/openspec-diff/`.\n//!\n//! It runs the `OpenSpec` CLI over the cases, so it is a corpus test (rust-core\n//! \"Corpus tests\"): each test carries the corpus ignore, and only a build with\n//! the `parity` feature compiles it.\n\npub mod openspec_parity_support;\n\nuse openspec_parity_support::cli::{OpenSpecCli, text_of};\nuse openspec_parity_support::project::Project;\nuse openspec_parity_support::trees::{folders, name_of, read_tree, repository_root};\nuse osq_kernel_specs::{MergeChangeError, MergedSpec, merge_change};\nuse serde_json::Value;\nuse std::collections::BTreeMap;\nuse std::path::{Path, PathBuf};\n\n/// The differential cases, relative to the repository root.\nconst FIXTURES: &str = \"tests/fixtures/openspec-diff\";\n\n/// The case folder names below, in byte order.\nconst CASES: [&str; 10] = [\n    \"added\",\n    \"bare-rename\",\n    \"dropped-scenario\",\n    \"duplicate-added\",\n    \"given-and\",\n    \"modified\",\n    \"new-capability\",\n    \"removed\",\n    \"renamed\",\n    \"second-change\",\n];\n\n/// Declares one test per differential case, each reading its `case.json`.\nmacro_rules! case_tests {\n    ($($name:ident => $case:literal),+ $(,)?) => {\n        $(\n            /// Covers: rust-specs/archive-cases-match-openspec\n            #[ignore = \"corpus test: runs the OpenSpec CLI on the differential cases\"]\n            #[test]\n            fn $name() {\n                run_case($case);\n            }\n        )+\n    };\n}\n\ncase_tests! {\n    added => \"added\",\n    bare_rename => \"bare-rename\",\n    dropped_scenario => \"dropped-scenario\",\n    duplicate_added => \"duplicate-added\",\n    given_and => \"given-and\",\n    modified => \"modified\",\n    new_capability => \"new-capability\",\n    removed => \"removed\",\n    renamed => \"renamed\",\n    second_change => \"second-change\",\n}\n\n/// Covers: rust-specs/archive-cases-match-openspec\n#[ignore = \"corpus test: runs the OpenSpec CLI on the differential cases\"]\n#[test]\nfn cases_are_exactly_the_fixture_folders() {\n    let repo = repository_root();\n    let found: Vec<String> = folders(&repo.join(FIXTURES))\n        .iter()\n        .map(|path| name_of(path))\n        .collect();\n    let declared: Vec<String> = CASES.iter().map(|name| (*name).to_string()).collect();\n    assert_eq!(found, declared, \"the differential case folders\");\n}\n\n/// Runs one case and checks the result its `case.json` names.\nfn run_case(case: &str) {\n    let repo = repository_root();\n    let dir = repo.join(FIXTURES).join(case);\n    let expect = expect_of(&dir);\n    let names = change_names(&dir);\n    let cli = OpenSpecCli::locate(&repo);\n    let cli_project = project_for(case, \"cli\", &dir, &repo, &names);\n    let rust_project = project_for(case, \"rust\", &dir, &repo, &names);\n    let cli_specs = cli_project.root().join(\"openspec/specs\");\n    let rust_specs = rust_project.root().join(\"openspec/specs\");\n    let base = dir.join(\"specs\");\n\n    match expect.as_str() {\n        \"identical\" => {\n            rust_merge(&rust_project, &names).expect(\"the Rust merge applies every change\");\n            for name in &names {\n                let validate = cli.run(\n                    &[\n                        \"validate\",\n                        name,\n                        \"--type\",\n                        \"change\",\n                        \"--strict\",\n                        \"--json\",\n                        \"--no-interactive\",\n                    ],\n                    cli_project.root(),\n                );\n                assert!(\n                    validate.status.success(),\n                    \"case {case}: validate {name} failed: {}\",\n                    text_of(&validate)\n                );\n                let archive = cli_archive(&cli, &cli_project, name);\n                assert!(\n                    archive.status.success(),\n                    \"case {case}: archive {name} failed: {}\",\n                    text_of(&archive)\n                );\n            }\n            let cli_tree = tree_of(&cli_specs);\n            assert!(\n                !cli_tree.is_empty(),\n                \"case {case}: the CLI archived no living spec\"\n            );\n            assert_eq!(\n                cli_tree,\n                tree_of(&rust_specs),\n                \"case {case}: the two openspec/specs trees differ\"\n            );\n        }\n        \"both-refuse\" => {\n            let error = rust_merge(&rust_project, &names).expect_err(\"the Rust merge refuses\");\n            refusal_message(&error, case);\n            let name = first_name(&names);\n            let archive = cli_archive(&cli, &cli_project, name);\n            assert!(\n                !archive.status.success(),\n                \"case {case}: archive {name} unexpectedly succeeded: {}\",\n                text_of(&archive)\n            );\n            assert!(\n                status_codes(&archive.stdout)\n                    .iter()\n                    .any(|code| code == \"archive_spec_update_failed\"),\n                \"case {case}: archive {name} did not report archive_spec_update_failed: {}\",\n                text_of(&archive)\n            );\n            let expected = tree_of(&base);\n            assert_eq!(\n                tree_of(&cli_specs),\n                expected,\n                \"case {case}: the CLI changed the specs\"\n            );\n            assert_eq!(\n                tree_of(&rust_specs),\n                expected,\n                \"case {case}: the Rust merge changed the specs\"\n            );\n        }\n        \"osq-refuses\" => {\n            let error = rust_merge(&rust_project, &names).expect_err(\"the Rust merge refuses\");\n            let message = refusal_message(&error, case);\n            assert!(\n                message.contains(\"### Requirement:\"),\n                \"case {case}: the refusal must name the expected form: {message}\"\n            );\n            let name = first_name(&names);\n            let archive = cli_archive(&cli, &cli_project, name);\n            assert!(\n                archive.status.success(),\n                \"case {case}: archive {name} unexpectedly failed: {}\",\n                text_of(&archive)\n            );\n            let living = tree_of(&cli_specs);\n            for target in rename_targets(&dir) {\n                let marker = format!(\"### Requirement: {target}\");\n                assert!(\n                    !living.values().any(|text| text.contains(&marker)),\n                    \"case {case}: OpenSpec applied a rename it should skip: {target}\"\n                );\n            }\n        }\n        other => panic!(\"case {case} names an unknown expectation `{other}`\"),\n    }\n}\n\n/// Builds a temporary project from a case: the scaffolded schema, the case's\n/// specs when it has any, and each change.\nfn project_for(\n    case: &str,\n    kind: &str,\n    dir: &Path,\n    repo: &Path,\n    names: &[String],\n) -> Project {\n    let project =\n        Project::prepare(&format!(\"archive-{case}-{kind}\"), repo).expect(\"the project writes\");\n    let specs = dir.join(\"specs\");\n    let source = specs.is_dir().then_some(specs.as_path());\n    project.set_specs(source).expect(\"the living specs copy\");\n    for name in names {\n        project\n            .put_change(name, &dir.join(\"changes\").join(name))\n            .expect(\"the change copies\");\n    }\n    project\n}\n\n/// Merges each named change into the project's living specs, in order.\nfn rust_merge(project: &Project, names: &[String]) -> Result<(), MergeChangeError> {\n    let specs = project.root().join(\"openspec/specs\");\n    let changes = project.root().join(\"openspec/changes\");\n    for name in names {\n        let merged = merge_change(&changes.join(name), &specs)?;\n        apply(&specs, &merged);\n    }\n    Ok(())\n}\n\n/// Writes each merged text, or removes a capability folder the change empties.\nfn apply(specs_root: &Path, merged: &[MergedSpec]) {\n    for spec in merged {\n        let folder = specs_root.join(&spec.capability);\n        match &spec.text {\n            Some(text) => {\n                std::fs::create_dir_all(&folder).expect(\"a capability folder\");\n                std::fs::write(folder.join(\"spec.md\"), text).expect(\"a merged spec\");\n            }\n            None => {\n                if folder.is_dir() {\n                    std::fs::remove_dir_all(&folder).expect(\"an emptied folder\");\n                }\n            }\n        }\n    }\n}\n\n/// Runs `archive` for one change in a CLI project.\nfn cli_archive(cli: &OpenSpecCli, project: &Project, name: &str) -> std::process::Output {\n    cli.run(&[\"archive\", name, \"--yes\", \"--json\"], project.root())\n}\n\n/// The `expect` of a case's `case.json`.\nfn expect_of(dir: &Path) -> String {\n    let text = std::fs::read_to_string(dir.join(\"case.json\")).expect(\"case.json reads\");\n    let value: Value = serde_json::from_str(&text).expect(\"case.json parses\");\n    value\n        .get(\"expect\")\n        .and_then(Value::as_str)\n        .expect(\"case.json names expect\")\n        .to_string()\n}\n\n/// The change folder names of a case, in byte order.\nfn change_names(dir: &Path) -> Vec<String> {\n    folders(&dir.join(\"changes\"))\n        .iter()\n        .map(|path| name_of(path))\n        .collect()\n}\n\n/// The first change name, which every case has.\nfn first_name(names: &[String]) -> &str {\n    names.first().expect(\"a case has at least one change\")\n}\n\n/// The message of a merge refusal, panicking on any other error.\nfn refusal_message(error: &MergeChangeError, case: &str) -> String {\n    match error {\n        MergeChangeError::Merge { error, .. } => error.to_string(),\n        MergeChangeError::Read(read) => panic!(\"case {case}: unexpected read error: {read}\"),\n    }\n}\n\n/// The `code` of each entry of an `archive --json` `status` array.\nfn status_codes(stdout: &[u8]) -> Vec<String> {\n    let Ok(value) = serde_json::from_slice::<Value>(stdout) else {\n        return Vec::new();\n    };\n    value\n        .get(\"status\")\n        .and_then(Value::as_array)\n        .map_or_else(Vec::new, |entries| {\n            entries\n                .iter()\n                .filter_map(|entry| entry.get(\"code\").and_then(Value::as_str))\n                .map(str::to_string)\n                .collect()\n        })\n}\n\n/// Every file under `root`, keyed by its `/`-joined relative path, or empty\n/// when the folder is missing.\nfn tree_of(root: &Path) -> BTreeMap<String, String> {\n    read_tree(root).unwrap_or_default()\n}\n\n/// The `TO:` names of a case's delta specs, as the TypeScript differential test\n/// reads them: any bulleted `TO:` line, backticks and a `### Requirement:`\n/// prefix stripped.\nfn rename_targets(dir: &Path) -> Vec<String> {\n    let mut targets = Vec::new();\n    for change in folders(&dir.join(\"changes\")) {\n        for capability in folders(&change.join(\"specs\")) {\n            let Ok(text) = std::fs::read_to_string(capability.join(\"spec.md\")) else {\n                continue;\n            };\n            targets.extend(text.lines().filter_map(to_name));\n        }\n    }\n    targets\n}\n\n/// The requirement name a delta line's `TO:` names, or none.\nfn to_name(line: &str) -> Option<String> {\n    let trimmed = line.trim_start();\n    let trimmed = trimmed\n        .strip_prefix('-')\n        .or_else(|| trimmed.strip_prefix('*'))\n        .or_else(|| trimmed.strip_prefix('+'))\n        .unwrap_or(trimmed)\n        .trim_start();\n    let lower = trimmed.to_lowercase();\n    let rest = lower.strip_prefix(\"to:\")?;\n    let rest = trimmed[trimmed.len() - rest.len()..].trim();\n    let rest = rest.trim_start_matches('`').trim_end_matches('`').trim();\n    let rest = rest\n        .strip_prefix(\"###\")\n        .map_or(rest, |tail| tail.trim_start());\n    let lower = rest.to_lowercase();\n    let name = lower.strip_prefix(\"requirement:\").map_or(rest, |_| {\n        &rest[rest.len() - (lower.len() - \"requirement:\".len())..]\n    });\n    let name = name.trim();\n    if name.is_empty() {\n        None\n    } else {\n        Some(name.to_string())\n    }\n}\n"},"output":"Created file successfully: crates/kernel/specs/tests/openspec_archive_parity_corpus.rs","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: crates/kernel/specs/tests/openspec_archive_parity_corpus.rs"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"crates/kernel/specs/tests/openspec_archive_parity_corpus.rs\",\"content\":\"//! Corpus test: the Rust merge gives the result `openspec archive` gives on\\n//! every differential case of `tests/fixtures/openspec-diff/`.\\n//!\\n//! It runs the `OpenSpec` CLI over the cases, so it is a corpus test (rust-core\\n//! \\\"Corpus tests\\\"): each test carries the corpus ignore, and only a build with\\n//! the `parity` feature compiles it.\\n\\npub mod openspec_parity_support;\\n\\nuse openspec_parity_support::cli::{OpenSpecCli, text_of};\\nuse openspec_parity_support::project::Project;\\nuse openspec_parity_support::trees::{folders, name_of, read_tree, repository_root};\\nuse osq_kernel_specs::{MergeChangeError, MergedSpec, merge_change};\\nuse serde_json::Value;\\nuse