ct.root());\n151:     let living = tree(&project.root().join(\"openspec/specs\"));\n152:     for target in rename_targets(&case.join(\"changes\")) {\n153:         let header = format!(\"### Requirement: {target}\");\n154:         assert!(\n155:             !living.values().any(|text| text.contains(&header)),\n156:             \"the case applied a rename OpenSpec should skip: {target}\"\n157:         );\n158:     }\n159: }\n160: \n161: /// The requirement names the case's delta specs give a `TO:` line, as the\n162: /// TypeScript differential test reads them.\n163: fn rename_targets(changes: &Path) -> Vec<String> {\n164:     let mut targets = Vec::new();\n165:     for change in folders(changes) {\n166:         for capability in folders(&change.join(\"specs\")) {\n167:             let text = read(&capability.join(\"spec.md\"));\n168:             targets.extend(text.lines().filter_map(to_target));\n169:         }\n170:     }\n171:     targets\n172: }\n173: \n174: /// The requirement name a `TO:` line names, or none for any other line.\n175: fn to_target(line: &str) -> Option<String> {\n176:     let rest = line\n177:         .trim_start()\n178:         .trim_start_matches(['-', '*', '+'])\n179:         .trim_start();\n180:     let rest = rest\n181:         .strip_prefix(\"TO:\")\n182:         .or_else(|| rest.strip_prefix(\"to:\"))?;\n183:     let name = rest.trim().trim_matches('`').trim();\n184:     let name = name\n185:         .strip_prefix(\"### Requirement: \")\n186:         .or_else(|| name.strip_prefix(\"### Requirement:\"))\n187:         .unwrap_or(name)\n188:         .trim();\n189:     (!name.is_empty()).then(|| name.to_string())\n190: }\n191: \n192: /// Runs one differential case: builds both projects, then checks its expectation.\n193: fn run_case(name: &str) {\n194:     let case = repository_root().join(FIXTURES).join(name);\n195:     let value: Value = serde_json::from_str(&read(&case.join(\"case.json\"))).expect(\"the case\");\n196:     let expect = value