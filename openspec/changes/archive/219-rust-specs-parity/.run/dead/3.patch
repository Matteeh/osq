+{"type":"tool_use","timestamp":1792396746753,"sessionID":"ses_eacdb5a85ffeETstJhXFodxnfQ","part":{"partID":"prt_1532bdf87001f60MqBbTx0cela","sessionID":"ses_eacdb5a85ffeETstJhXFodxnfQ","messageID":"msg_1532bd4560017ITva3i8bZL6nL","type":"tool","id":"call_5745099c15ce49c09165e6e5","tool":"read","state":{"status":"completed","input":{"path":"crates/kernel/specs/tests/openspec_archive_parity_corpus.rs"},"output":"Read file crates/kernel/specs/tests/openspec_archive_parity_corpus.rs, lines 1-358\n1: //! Corpus test: the Rust merge gives the result `openspec archive` gives on\n2: //! every differential case of `tests/fixtures/openspec-diff/`.\n3: //!\n4: //! It runs the `OpenSpec` CLI over the cases, so it is a corpus test (rust-core\n5: //! \"Corpus tests\"): each test carries the corpus ignore, and only a build with\n6: //! the `parity` feature compiles it.\n7: \n8: pub mod openspec_parity_support;\n9: \n10: use openspec_parity_support::cli::{OpenSpecCli, text_of};\n11: use openspec_parity_support::project::Project;\n12: use openspec_parity_support::trees::{folders, name_of, read_tree, repository_root};\n13: use osq_kernel_specs::{MergeChangeError, MergedSpec, merge_change};\n14: use serde_json::Value;\n15: use std::collections::BTreeMap;\n16: use std::path::{Path, PathBuf};\n17: \n18: /// The differential cases, relative to the repository root.\n19: const FIXTURES: &str = \"tests/fixtures/openspec-diff\";\n20: \n21: /// The case folder names below, in byte order.\n22: const CASES: [&str; 10] = [\n23:     \"added\",\n24:     \"bare-rename\",\n25:     \"dropped-scenario\",\n26:     \"duplicate-added\",\n27:     \"given-and\",\n28:     \"modified\",\n29:     \"new-capability\",\n30:     \"removed\",\n31:     \"renamed\",\n32:     \"second-change\",\n33: ];\n34: \n35: /// Declares one test per differential case, each reading its `case.json`.\n36: macro_rules! case_tests {\n37:     ($($name:ident => $case:literal),+ $(,)?) => {\n38:         $(\n39:             /// Covers: rust-specs/archive-cases-match-openspec\n40:             #[ignore = \"corpus test: runs the OpenSpec CLI on the differential cases\"]\n41:             #[test]\n42:             fn $name() {\n43:                 run_case($case);\n44:             }\n45:         )+\n46:     };\n47: }\n48: \n49: case_tests! {\n50:     added => \"added\",\n51:     bare_rename => \"bare-rename\",\n52:     dropped_scenario => \"dropped-scenario\",\n53:     duplicate_added => \"duplicate-added\",\n54:     given_and => \"given-and\",\n55:     modified => \"modified\",\n56:     new_capability => \"new-capability\",\n57:     removed => \"removed\",\n58:     renamed => \"renamed\",\n59:     second_change => \"second-change\",\n60: }\n61: \n62: /// Covers: rust-specs/archive-cases-match-openspec\n63: #[ignore = \"corpus test: runs the OpenSpec CLI on the differential cases\"]\n64: #[test]\n65: fn cases_are_exactly_the_fixture_folders() {\n66:     let repo = repository_root();\n67:     let found: Vec<String> = folders(&repo.join(FIXTURES))\n68:         .iter()\n69:         .map(|path| name_of(path))\n70:         .collect();\n71:     let declared: Vec<String> = CASES.iter().map(|name| (*name).to_string()).collect();\n72:     assert_eq!(found, declared, \"the differential case folders\");\n73: }\n74: \n75: /// Runs one case and checks the result its `case.json` names.\n76: fn run_case(case: &str) {\n77:     let repo = repository_root();\n78:     let dir = repo.join(FIXTURES).join(case);\n79:     let expect = expect_of(&dir);\n80:     let names = change_names(&dir);\n81:     let cli = OpenSpecCli::locate(&repo);\n82:     let cli_project = project_for(case, \"cli\", &dir, &repo, &names);\n83:     let rust_project = project_for(case, \"rust\", &dir, &repo, &names);\n84:     match expect.as_str() {\n85:         \"identical\" => identical_case(case, &names, &cli, &cli_project, &rust_project),\n86:         \"both-refuse\" => both_refuse_case(case, &dir, &cli, &cli_project, &rust_project),\n87:         \"osq-refuses\" => osq_refuses_case(case, &dir, &cli, &cli_project, &rust_project),\n88:         other => panic!(\"case {case} names an unknown expectation `{other}`\"),\n89:     }\n90: }\n91: \n92: /// Runs an `identical` case: both tools archive every change and the two\n93: /// `openspec/specs` trees match.\n94: fn identical_case(\n95:     case: &str,\n96:     names: &[String],\n97:     cli: &OpenSpecCli,\n98:     cli_project: &Project,\n99:     rust_project: &Project,\n100: ) {\n101:     rust_merge(rust_project, names).expect(\"the Rust merge applies every change\");\n102:     for name in names {\n103:         let validate = cli.run(\n104:             &[\n105:                 \"validate\",\n106:                 name,\n107:                 \"--type\",\n108:                 \"change\",\n109:                 \"--strict\",\n110:                 \"--json\",\n111:                 \"--no-interactive\",\n112:             ],\n113:             cli_project.root(),\n114:         );\n115:         assert!(\n116:             validate.status.success(),\n117:             \"case {case}: validate {name} failed: {}\",\n118:             text_of(&validate)\n119:         );\n120:         let archive = cli_archive(cli, cli_project, name);\n121:         assert!(\n122:             archive.status.success(),\n123:             \"case {case}: archive {name} failed: {}\",\n124:             text_of(&archive)\n125:         );\n126:     }\n127:     let cli_tree = tree_of(&specs_of(cli_project));\n128:     assert!(\n129:         !cli_tree.is_empty(),\n130:         \"case {case}: the CLI archived no living spec\"\n131:     );\n132:     assert_eq!(\n133:         cli_tree,\n134:         tree_of(&specs_of(rust_project)),\n135:         \"case {case}: the two openspec/specs trees differ\"\n136:     );\n137: }\n138: \n139: /// Runs a `both-refuse` case: both tools refuse the first change and neither\n140: /// tree moves.\n141: fn both_refuse_case(\n142:     case: &str,\n143:     dir: &Path,\n144:     cli: &OpenSpecCli,\n145:     cli_project: &Project,\n146:     rust_project: &Project,\n147: ) {\n148:     let names = change_names(dir);\n149:     let error = rust_merge(rust_project, &names).expect_err(\"the Rust merge refuses\");\n150:     refusal_message(&error, case);\n151:     let name = first_name(&names);\n152:     let archive = cli_archive(cli, cli_project, name);\n153:     assert!(\n154:         !archive.status.success(),\n155:         \"case {case}: archive {name} unexpectedly succeeded: {}\",\n156:         text_of(&archive)\n157:     );\n158:     assert!(\n159:         status_codes(&archive.stdout)\n160:             .iter()\n161:             .any(|code| code == \"archive_spec_update_failed\"),\n162:         \"case {case}: archive {name} did not report archive_spec_update_failed: {}\",\n163:         text_of(&archive)\n164:     );\n165:     let expected = tree_of(&dir.join(\"specs\"));\n166:     assert_eq!(\n167:         tree_of(&specs_of(cli_project)),\n168:         expected,\n169:         \"case {case}: the CLI changed the specs\"\n170:     );\n171:     assert_eq!(\n172:         tree_of(&specs_of(rust_project)),\n173:         expected,\n174:         \"case {case}: the Rust merge changed the specs\"\n175:     );\n176: }\n177: \n178: /// Runs an `osq-refuses` case: the Rust merge refuses naming the expected\n179: /// form, the CLI archives, and no renamed name lands.\n180: fn osq_refuses_case(\n181:     case: &str,\n182:     dir: &Path,\n183:     cli: &OpenSpecCli,\n184:     cli_project: &Project,\n185:     rust_project: &Project,\n186: ) {\n187:     let names = change_names(dir);\n188:     let error = rust_merge(rust_project, &names).expect_err(\"the Rust merge refuses\");\n189:     let message = refusal_message(&error, case);\n190:     assert!(\n191:         message.contains(\"### Requirement:\"),\n192:         \"case {case}: the refusal must name the expected form: {message}\"\n193:     );\n194:     let name = first_name(&names);\n195:     let archive = cli_archive(cli, cli_project, name);\n196:     assert!(\n197:         archive.status.success(),\n198:         \"case {case}: archive {name} unexpectedly failed: {}\",\n199:         text_of(&archive)\n200:     );\n201:     let living = tree_of(&specs_of(cli_project));\n202:     for target in rename_targets(dir) {\n203:         let marker = format!(\"### Requirement: {target}\");\n204:         assert!(\n205:             !living.values().any(|text| text.contains(&marker)),\n206:             \"case {case}: OpenSpec applied a rename it should skip: {target}\"\n207:         );\n208:     }\n209: }\n210: \n211: /// Builds a temporary project from a case: the scaffolded schema, the case's\n212: /// specs when it has any, and each change.\n213: fn project_for(case: &str, kind: &str, dir: &Path, repo: &Path, names: &[String]) -> Project {\n214:     let project =\n215:         Project::prepare(&format!(\"archive-{case}-{kind}\"), repo).expect(\"the project writes\");\n216:     let specs = dir.join(\"specs\");\n217:     let source = specs.is_dir().then_some(specs.as_path());\n218:     project.set_specs(source).expect(\"the living specs copy\");\n219:     for name in names {\n220:         project\n221:             .put_change(name, &dir.join(\"changes\").join(name))\n222:             .expect(\"the change copies\");\n223:     }\n224:     project\n225: }\n226: \n227: /// The `openspec/specs` folder of a project.\n228: fn specs_of(project: &Project) -> PathBuf {\n229:     project.root().join(\"openspec/specs\")\n230: }\n231: \n232: /// Merges each named change into the project's living specs, in order.\n233: fn rust_merge(project: &Project, names: &[String]) -> Result<(), MergeChangeError> {\n234:     let specs = project.root().join(\"openspec/specs\");\n235:     let changes = project.root().join(\"openspec/changes\");\n236:     for name in names {\n237:         let merged = merge_change(&changes.join(name), &specs)?;\n238:         apply(&specs, &merged);\n239:     }\n240:     Ok(())\n241: }\n242: \n243: /// Writes each merged text, or removes a capability folder the change empties.\n244: fn apply(specs_root: &Path, merged: &[MergedSpec]) {\n245:     for spec in merged {\n246:         let folder = specs_root.join(&spec.capability);\n247:         match &spec.text {\n248:             Some(text) => {\n249:                 std::fs::create_dir_all(&folder).expect(\"a capability folder\");\n250:                 std::fs::write(folder.join(\"spec.md\"), text).expect(\"a merged spec\");\n251:             }\n252:             None => {\n253:                 if folder.is_dir() {\n254:                     std::fs::remove_dir_all(&folder).expect(\"an emptied folder\");\n255:                 }\n256:             }\n257:         }\n258:     }\n259: }\n260: \n261: /// Runs `archive` for one change in a CLI project.\n262: fn cli_archive(cli: &OpenSpecCli, project: &Project, name: &str) -> std::process::Output {\n263:     cli.run(&[\"archive\", name, \"--yes\", \"--json\"], project.root())\n264: }\n265: \n266: /// The `expect` of a case's `case.json`.\n267: fn expect_of(dir: &Path) -> String {\n268:     let text = std::fs::read_to_string(dir.join(\"case.json\")).expect(\"case.json reads\");\n269:     let value: Value = serde_json::from_str(&text).expect(\"case.json parses\");\n270:     value\n271:         .get(\"expect\")\n272:         .and_then(Value::as_str)\n273:         .expect(\"case.json names expect\")\n274:         .to_string()\n275: }\n276: \n277: /// The change folder names of a case, in byte order.\n278: fn change_names(dir: &Path) -> Vec<String> {\n279:     folders(&dir.join(\"changes\"))\n280:         .iter()\n281:         .map(|path| name_of(path))\n282:         .collect()\n283: }\n284: \n285: /// The first change name, which every case has.\n286: fn first_name(names: &[String]) -> &str {\n287:     names.first().expect(\"a case has at least one change\")\n288: }\n289: \n290: /// The message of a merge refusal, panicking on any other error.\n291: fn refusal_message(error: &MergeChangeError, case: &str) -> String {\n292:     match error {\n293:         MergeChangeError::Merge { error, .. } => error.to_string(),\n294:         MergeChangeError::Read(read) => panic!(\"case {case}: unexpected read error: {read}\"),\n295:     }\n296: }\n297: \n298: /// The `code` of each entry of an `archive --json` `status` array.\n299: fn status_codes(stdout: &[u8]) -> Vec<String> {\n300:     let Ok(value) = serde_json::from_slice::<Value>(stdout) else {\n301:         return Vec::new();\n302:     };\n303:     value\n304:         .get(\"status\")\n305:         .and_then(Value::as_array)\n306:         .map_or_else(Vec::new, |entries| {\n307:             entries\n308:                 .iter()\n309:                 .filter_map(|entry| entry.get(\"code\").and_then(Value::as_str))\n310:                 .map(str::to_string)\n311:                 .collect()\n312:         })\n313: }\n314: \n315: /// Every file under `root`, keyed by its `/`-joined relative path, or empty\n316: /// when the folder is missing.\n317: fn tree_of(root: &Path) -> BTreeMap<String, String> {\n318:     read_tree(root).unwrap_or_default()\n319: }\n320: \n321: /// The `TO:` names of a case's delta specs, as the TypeScript differential test\n322: /// reads them: any bulleted `TO:` line, backticks and a `### Requirement:`\n323: /// prefix stripped.\n324: fn rename_targets(dir: &Path) -> Vec<String> {\n325:     let mut targets = Vec::new();\n326:     for change in folders(&dir.join(\"changes\")) {\n327:         for capability in folders(&change.join(\"specs\")) {\n328:             let Ok(text) = std::fs::read_to_string(capability.join(\"spec.md\")) else {\n329:                 continue;\n330:             };\n331:             targets.extend(text.lines().filter_map(to_name));\n332:         }\n333:     }\n334:     targets\n335: }\n336: \n337: /// The requirement name a delta line's `TO:` names, or none.\n338: fn to_name(line: &str) -> Option<String> {\n339:     let trimmed = line.trim_start();\n340:     let trimmed = trimmed\n341:         .strip_prefix('-')\n342:         .or_else(|| trimmed.strip_prefix('*'))\n343:         .or_else(|| trimmed.strip_prefix('+'))\n344:         .unwrap_or(trimmed)\n345:         .trim_start();\n346:     if !trimmed.to_lowercase().starts_with(\"to:\") {\n347:         return None;\n348:     }\n349:     let rest = trimmed[3..].trim();\n350:     let rest = rest.trim_start_matches('`').trim_end_matches('`').trim();\n351:     let rest = rest.strip_prefix(\"###\").map_or(rest, str::trim_start);\n352:     let name = if rest.to_lowercase().starts_with(\"requirement:\") {\n353:         rest[\"requirement:\".len()..].trim()\n354:     } else {\n355:         rest\n356:     };\n357:     (!name.is_empty()).then(|| name.to_string())\n358: }","title":"read","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Read file crates/kernel/specs/tests/openspec_archive_parity_corpus.rs, lines 1-358\n1: //! Corpus test: the Rust merge gives the result `openspec archive` gives on\n2: //! every differential case of `tests/fixtures/openspec-diff/`.\n3: //!\n4: //! It runs the `OpenSpec` CLI over the cases, so it is a corpus test (rust-core\n5: //! \"Corpus tests\"): each test carries the corpus ignore, and only a build with\n6: //! the `parity` feature compiles it.\n7: \n8: pub mod openspec_parity_support;\n9: \n10: use openspec_parity_support::cli::{OpenSpecCli, text_of};\n11: use openspec_parity_support::project::Project;\n12: use openspec_parity_support::trees::{folders, name_of, read_tree, repository_root};\n13: use osq_kernel_specs::{MergeChangeError, MergedSpec, merge_change};\n14: use serde_json::Value;\n15: use std::collections::BTreeMap;\n16: use std::path::{Path, PathBuf};\n17: \n18: /// The differential cases, relative to the repository root.\n19: const FIXTURES: &str = \"tests/fixtures/openspec-diff\";\n20: \n21: /// The case folder names below, in byte order.\n22: const CASES: [&str; 10] = [\n23:     \"added\",\n24:     \"bare-rename\",\n25:     \"dropped-scenario\",\n26:     \"duplicate-added\",\n27:     \"given-and\",\n28:     \"modified\",\n29:     \"new-capability\",\n30:     \"removed\",\n31:     \"renamed\",\n32:     \"second-change\",\n33: ];\n34: \n35: /// Declares one test per differential case, each reading its `case.json`.\n36: macro_rules! case_tests {\n37:     ($($name:ident => $case:literal),+ $(,)?) => {\n38:         $(\n39:             /// Covers: rust-specs/archive-cases-match-openspec\n40:             #[ignore = \"corpus test: runs the OpenSpec CLI on the differential cases\"]\n41:             #[test]\n42:             fn $name() {\n43:                 run_case($case);\n44:             }\n45:         )+\n46:     };\n47: }\n48: \n49: case_tests! {\n50:     added => \"added\",\n51:     bare_rename => \"bare-rename\",\n52:     dropped_scenario => \"dropped-scenario\",\n53:     duplicate_added => \"duplicate-added\",\n54:     given_and => \"given-and\",\n55:     modified => \"modified\",\n56:     new_capability => \"new-capability\",\n57:     removed => \"removed\",\n58:     renamed => \"renamed\",\n59:     second_change => \"second-change\",\n60: }\n61: \n62: /// Covers: rust-specs/archive-cases-match-openspec\n63: #[ignore = \"corpus test: runs the OpenSpec CLI on the differential cases\"]\n64: #[test]\n65: fn cases_are_exactly_the_fixture_folders() {\n66:     let repo = repository_root();\n67:     let found: Vec<String> = folders(&repo.join(FIXTURES))\n68:         .iter()\n69:         .map(|path| name_of(path))\n70:         .collect();\n71:     let declared: Vec<String> = CASES.iter().map(|name| (*name).to_string()).collect();\n72:     assert_eq!(found, declared, \"the differential case folders\");\n73: }\n74: \n75: /// Runs one case and checks the result its `case.json` names.\n76: fn run_case(case: &str) {\n77:     let repo = repository_root();\n78:     let dir = repo.join(FIXTURES).join(case);\n79:     let expect = expect_of(&dir);\n80:     let names = change_names(&dir);\n81:     let cli = OpenSpecCli::locate(&repo);\n82:     let cli_project = project_for(case, \"cli\", &dir, &repo, &names);\n83:     let rust_project = project_for(case, \"rust\", &dir, &repo, &names);\n84:     match expect.as_str() {\n85:         \"identical\" => identical_case(case, &names, &cli, &cli_project, &rust_project),\n86:         \"both-refuse\" => both_refuse_case(case, &dir, &cli, &cli_project, &rust_project),\n87:         \"osq-refuses\" => osq_refuses_case(case, &dir, &cli, &cli_project, &rust_project),\n88:         other => panic!(\"case {case} names an unknown expectation `{other}`\"),\n89:     }\n90: }\n91: \n92: /// Runs an `identical` case: both tools archive every change and the two\n93: /// `openspec/specs` trees match.\n94: fn identical_case(\n95:     case: &str,\n96:     names: &[String],\n97:     cli: &OpenSpecCli,\n98:     cli_project: &Project,\n99:     rust_project: &Project,\n100: ) {\n101:     rust_merge(rust_project, names).expect(\"the Rust merge applies every change\");\n102:     for name in names {\n103:         let validate = cli.run(\n104:             &[\n105:                 \"validate\",\n106:                 name,\n107:                 \"--type\",\n108:                 \"change\",\n109:                 \"--strict\",\n110:                 \"--json\",\n111:                 \"--no-interactive\",\n112:             ],\n113:             cli_project.root(),\n114:         );\n115:         assert!(\n116:             validate.status.success(),\n117:             \"case {case}: validate {name} failed: {}\",\n118:             text_of(&validate)\n119:         );\n120:         let archive = cli_archive(cli, cli_project, name);\n121:         assert!(\n122:             archive.status.success(),\n123:             \"case {case}: archive {name} failed: {}\",\n124:             text_of(&archive)\n125:         );\n126:     }\n127:     let cli_tree = tree_of(&specs_of(cli_project));\n128:     assert!(\n129:         !cli_tree.is_empty(),\n130:         \"case {case}: the CLI archived no living spec\"\n131:     );\n132:     assert_eq!(\n133:         cli_tree,\n134:         tree_of(&specs_of(rust_project)),\n135:         \"case {case}: the two openspec/specs trees differ\"\n136:     );\n137: }\n138: \n139: /// Runs a `both-refuse` case: both tools refuse the first change and neither\n140: /// tree moves.\n141: fn both_refuse_case(\n142:     case: &str,\n143:     dir: &Path,\n144:     cli: &OpenSpecCli,\n145:     cli_project: &Project,\n146:     rust_project: &Project,\n147: ) {\n148:     let names = change_names(dir);\n149:     let error = rust_merge(rust_project, &names).expect_err(\"the Rust merge refuses\");\n150:     refusal_message(&error, case);\n151:     let name = first_name(&names);\n152:     let archive = cli_archive(cli, cli_project, name);\n153:     assert!(\n154:         !archive.status.success(),\n155:         \"case {case}: archive {name} unexpectedly succeeded: {}\",\n156:         text_of(&archive)\n157:     );\n158:     assert!(\n159:         status_codes(&archive.stdout)\n160:             .iter()\n161:             .any(|code| code == \"archive_spec_update_failed\"),\n162:         \"case {case}: archive {name} did not report archive_spec_update_failed: {}\",\n163:         text_of(&archive)\n164:     );\n165:     let expected = tree_of(&dir.join(\"specs\"));\n166:     assert_eq!(\n167:         tree_of(&specs_of(cli_project)),\n168:         expected,\n169:         \"case {case}: the CLI changed the specs\"\n170:     );\n171:     assert_eq!(\n172:         tree_of(&specs_of(rust_project)),\n173:         expected,\n174:         \"case {case}: the Rust merge changed the specs\"\n175:     );\n176: }\n177: \n178: /// Runs an `osq-refuses` case: the Rust merge refuses naming the expected\n179: /// form, the CLI archives, and no renamed name lands.\n180: fn osq_refuses_case(\n181:     case: &str,\n182:     dir: &Path,\n183:     cli: &OpenSpecCli,\n184:     cli_project: &Project,\n185:     rust_project: &Project,\n186: ) {\n187:     let names = change_names(dir);\n188:     let error = rust_merge(rust_project, &names).expect_err(\"the Rust merge refuses\");\n189:     let message = refusal_message(&error, case);\n190:     assert!(\n191:         message.contains(\"### Requirement:\"),\n192:         \"case {case}: the refusal must name the expected form: {message}\"\n193:     );\n194:     let name = first_name(&names);\n195:     let archive = cli_archive(cli, cli_project, name);\n196:     assert!(\n197:         archive.status.success(),\n198:         \"case {case}: archive {name} unexpectedly failed: {}\",\n199:         text_of(&archive)\n200:     );\n201:     let living = tree_of(&specs_of(cli_project));\n202:     for target in rename_targets(dir) {\n203:         let marker = format!(\"### Requirement: {target}\");\n204:         assert!(\n205:             !living.values().any(|text| text.contains(&marker)),\n206:             \"case {case}: OpenSpec applied a rename it should skip: {target}\"\n207:         );\n208:     }\n209: }\n210: \n211: /// Builds a temporary project from a case: the scaffolded schema, the case's\n212: /// specs when it has any, and each change.\n213: fn project_for(case: &str, kind: &str, dir: &Path, repo: &Path, names: &[String]) -> Project {\n214:     let project =\n215:         Project::prepare(&format!(\"archive-{case}-{kind}\"), repo).expect(\"the project writes\");\n216:     let specs = dir.join(\"specs\");\n217:     let source = specs.is_dir().then_some(specs.as_path());\n218:     project.set_specs(source).expect(\"the living specs copy\");\n219:     for name in names {\n220:         project\n221:             .put_change(name, &dir.join(\"changes\").join(name))\n222:             .expect(\"the change copies\");\n223:     }\n224:     project\n225: }\n226: \n227: /// The `openspec/specs` folder of a project.\n228: fn specs_of(project: &Project) -> PathBuf {\n229:     project.root().join(\"openspec/specs\")\n230: }\n231: 