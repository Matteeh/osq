 }\n88:     for change in changes {\n89:         let name = name_of(change);\n90:         run_ok(cli, &[\"archive\", &name, \"--yes\", \"--json\"], openspec.root());\n91:         merge_into(change, rust_specs);\n92:     }\n93:     let cli_specs = openspec.root().join(\"openspec/specs\");\n94:     assert_eq!(tree(&cli_specs), tree(rust_specs), \"the two specs trees\");\n95: }\n96: \n97: /// A case both tools refuse: the CLI reports `archive_spec_update_failed`, the\n98: /// Rust merge refuses, and neither tree changes.\n99: fn assert_both_refuse(\n100:     cli: &OpenSpecCli,\n101:     first: &Path,\n102:     cli_specs: &Path,\n103:     rust_specs: &Path,\n104:     case: &Path,\n105: ) {\n106:     let name = name_of(first);\n107:     let archive = cli.run(&[\"archive\", &name, \"--yes\", \"--json\"], cli_specs);\n108:     let value: Value = serde_json::from_slice(&archive.stdout).unwrap_or(Value::Null);\n109:     let refused = value\n110:         .get(\"status\")\n111:         .and_then(Value::as_array)\n112:         .is_some_and(|entries| {\n113:             entries.iter().any(|entry| {\n114:                 entry.get(\"code\").and_then(Value::as_str) == Some(\"archive_spec_update_failed\")\n115:             })\n116:         });\n117:     assert!(\n118:         !archive.status.success() && refused,\n119:         \"archive {name} did not report archive_spec_update_failed:\\n{}\",\n120:         text_of(&archive)\n121:     );\n122:     let rust_refused = matches!(\n123:         merge_change(first, rust_specs),\n124:         Err(MergeChangeError::Merge { .. })\n125:     );\n126:     assert!(\n127:         rust_refused,\n128:         \"{}: the Rust merge should refuse\",\n129:         first.display()\n130:     );\n131:     let case_specs = case.join(\"specs\");\n132:     assert_eq!(tree(cli_specs), tree(&case_specs), \"the OpenSpec tree\");\n133:     assert_eq!(tree(rust_specs), tree(&case_specs), \"the Rust tree\");\n134: }\n135: \n136: /// A case the Rust merge refuses and the CLI accepts: the refusal names the\n137: /// expected rename form, and no living spec holds a rename target.\n138: fn assert_osq_refuses(\n139:     cli: &OpenSpecCli,\n140:     first: &Path,\n141:     cli_specs: &Path,\n142:     rust_specs: &Path,\n143:     case: &Path,\n144: ) {\n145:     let Err(MergeChangeError::Merge { error, .. }) = merge_change(first, rust_specs) else {\n146:         panic!(\"{}: expected a merge refusal\", first.display());\n147:     };\n148:     assert!(\n149:         error.to_string().contains(\"### Requirement:\"),\n150:         \"{}: the refusal must name the expected form: {error}\",\n151:         first.display()\n152:     );\n153:     let name = name_of(first);\n154:     run_ok(cli, &[\"archive\", &name, \"--yes\", \"--json\"], cli_specs);\n155:     let living = tree(cli_specs);\n156:     for target in rename_targets(&case.join(\"changes\")) {\n157:         let header = format!(\"### Requirement: {target}\");\n158:         assert!(\n159:             !living.values().any(|text| text.contains(&header)),\n160:             \"the case applied a rename OpenSpec should skip: {target}\"\n161:         );\n162:     }\n163: }\n164: \n165: /// The requirement names the case's delta specs give a `TO:` line.\n166: fn rename_targets(changes: &Path) -> Vec<String> {\n167:     let mut targets = Vec::new();\n168:     for change in folders(changes) {\n169:         for capability in folders(&change.join(\"specs\")) {\n170:             let delta = parse_delta(&read(&capability.join(\"spec.md\")));\n171:             targets.extend(delta.renamed.into_iter().map(|rename| rename.to));\n172:             targets.extend(\n173:                 delta\n174:                     .unpaired_renames\n175:                     .into_iter()\n176:                     .filter(|side| side.side == RenameSide::To)\n177:                     .map(|side| side.name),\n178:             );\n179:         }\n180:     }\n181:     targets\n182: }\n183: \n184: /// Runs one differential case: builds both projects, then checks its expectation.\n185: fn run_case(name: &str) {\n186:     let case = repository_root().join(FIXTURES).join(name);\n187:     let value: Value = serde_json::from_str(&read(&case.join(\"case.json\"))).expect(\"the case\");\n188:     let expect = value\n189:         .get(\"expect\")\n190:         .and_then(Value::as_str)\n191:         .expect(\"an expect\");\n192:     let repo = repository_root();\n193:     let cli = OpenSpecCli::locate(&repo);\n194:     let openspec = scaffold(&format!(\"archive-{name}-openspec\"), &case);\n195:     let rust = scaffold(&format!(\"archive-{name}-rust\"), &case);\n196:     let changes = folders(&rust.root().join(\"openspec/changes\"));\n197:     let first = changes\n198:         .first()\n199:         .map_or_else(|| panic!(\"case {name} has no change\"), PathBuf::as_path);\n200:     let cli_specs = openspec.root().join(\"openspec/specs\");\n201:     let rust_specs = rust.root().join(\"openspec/specs\");\n202:     match expect {\n203:         \"identical\" => assert_identical(&cli, &openspec, &rust_specs, &changes),\n204:         \"both-refuse\" => assert_both_refuse(&cli, first, &cli_specs, &rust_specs, &case),\n205:         \"osq-refuses\" => assert_osq_refuses(&cli, first, &cli_specs, &rust_specs, &case),\n206:         other => panic!(\"case {name} has unknown expect `{other}`\"),\n207:     }\n208: }\n209: \n210: /// Declares one corpus test per differential case, in byte order.\n211: macro_rules! case_tests {\n212:     ($($fn_name:ident => $case:literal),* $(,)?) => {\n213:         /// The differential case names, in byte order.\n214:         const CASE_NAMES: &[&str] = &[$($case),*];\n215: \n216:         $(\n217:             /// Covers: rust-specs/archive-cases-match-openspec\n218:             #[ignore = \"corpus test: runs the OpenSpec CLI on the differential cases\"]\n219:             #[test]\n220:             fn $fn_name() {\n221:                 run_case($case);\n222:             }\n2