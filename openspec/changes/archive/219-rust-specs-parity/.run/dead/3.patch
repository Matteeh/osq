SourceMissing {\n        /// The capability merged.\n        capability: String,\n        /// The FROM name of the rename.\n        requirement: String,\n    },\n    /// A rename whose TO name the spec already has.\n    RenameTargetExists {\n        /// The capability merged.\n        capability: String,\n        /// The TO name of the rename.\n        requirement: String,\n    },\n    /// A REMOVED name the spec has no block for.\n    RemovedMissing {\n        /// The capability merged.\n        capability: String,\n        /// The missing requirement name.\n        requirement: String,\n    },\n    /// A MODIFIED block dropping scenarios the current block has.\n    ScenariosDropped {\n        /// The capability merged.\n        capability: String,\n        /// The modified requirement name.\n        requirement: String,\n        /// The dropped scenario names, in the current block's order.\n        scenarios: Vec<String>,\n    },\n=== mod.rs\n//! Merging a parsed delta into a living spec, as TypeScript osq does (ADR 026).\n\nmod apply;\nmod apply_names;\nmod base;\nmod change;\nmod compose;\nmod error;\n\npub use change::{MergeChangeError, MergedSpec, merge_change};\npub use compose::{merge_delta, merge_living_spec};\npub use error::MergeError;\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"//! Merging every delta spec of a change folder into the living specs (ADR 026).\n\nuse super::compose::merge_living_spec;\nuse super::error::MergeError;\nuse crate::markdown::parse_delta;\nuse crate::read::SpecsError;\nuse crate::validate::change::{folders, read_text};\nuse serde::Serialize;\nuse std::fmt;\nuse std::path::{Path, PathBuf};\n\n/// One delta spec of a change and the living text it merges to.\n#[derive(Debug, Clone, PartialEq, Eq, Serialize)]\npub struct MergedSpec {\n    /// The capability folder name the delta sits under.\n    pub capability: String,\n    /// The delta spec's joined p