= repository_root().join(FIXTURES).join(name);\n195:     let value: Value = serde_json::from_str(&read(&case.join(\"case.json\"))).expect(\"the case\");\n196:     let expect = value\n197:         .get(\"expect\")\n198:         .and_then(Value::as_str)\n199:         .expect(\"an expect\");\n200:     let cli = OpenSpecCli::locate(&repository_root());\n201:     let openspec = scaffold(&format!(\"archive-{name}-openspec\"), &case);\n202:     let rust = scaffold(&format!(\"archive-{name}-rust\"), &case);\n203:     let changes = folders(&rust.root().join(\"openspec/changes\"));\n204:     let first = changes\n205:         .first()\n206:         .map_or_else(|| panic!(\"case {name} has no change\"), PathBuf::as_path);\n207:     let rust_specs = rust.root().join(\"openspec/specs\");\n208:     match expect {\n209:         \"identical\" => assert_identical(&cli, &openspec, &rust_specs, &changes),\n210:         \"both-refuse\" => assert_both_refuse(&cli, &openspec, first, &rust_specs, &case),\n211:         \"osq-refuses\" => assert_osq_refuses(&cli, &openspec, first, &rust_specs, &case),\n212:         other => panic!(\"case {name} has unknown expect `{other}`\"),\n213:     }\n214: }\n215: \n216: /// Declares one corpus test per differential case, in byte order.\n217: macro_rules! case_tests {\n218:     ($($fn_name:ident => $case:literal),* $(,)?) => {\n219:         /// The differential case names, in byte order.\n220:         const CASE_NAMES: &[&str] = &[$($case),*];\n221: \n222:         $(\n223:             /// Covers: rust-specs/archive-cases-match-openspec\n224:             #[ignore = \"corpus test: runs the OpenSpec CLI on the differential cases\"]\n225:             #[test]\n226:             fn $fn_name() { run_case($case); }\n227:         )*\n228:     };\n229: }\n230: \n231: case_tests! {\n232:     added => \"added\",\n233:     bare_rename => \"bare-rename\",\n234:     dropped_scenario => \"dropped-scenario\",\n235:     duplicate_added => \"duplicate-added\",\n236:     gi