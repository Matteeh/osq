ines().filter_map(rename_target));\n        }\n    }\n    targets\n}\n\n/// The target a `TO:` line names, or none for any other line.\n#[must_use]\nfn rename_target(line: &str) -> Option<String> {\n    let mut rest = line.trim_start();\n    for marker in ['-', '*', '+'] {\n        if let Some(stripped) = rest.strip_prefix(marker) {\n            rest = stripped.trim_start();\n            break;\n        }\n    }\n    if !rest.get(..3)?.eq_ignore_ascii_case(\"TO:\") {\n        return None;\n    }\n    let value = strip_requirement_header(rest[3..].trim().trim_matches('`').trim()).trim();\n    (!value.is_empty()).then(|| value.to_string())\n}\n\n/// `text` without a leading `### Requirement:` header, in any case.\n#[must_use]\nfn strip_requirement_header(text: &str) -> &str {\n    let Some(head) = text.get(..3) else {\n        return text;\n    };\n    if !head.eq_ignore_ascii_case(\"###\") {\n        return text;\n    }\n    let rest = text[3..].trim_start();\n    match rest.get(..12) {\n        Some(word) if word.eq_ignore_ascii_case(\"Requirement:\") => rest[12..].trim_start(),\n        _ => text,\n    }\n}\n\nmacro_rules! case_tests {\n    ($($fn_name:ident => $case:literal),* $(,)?) => {\n        /// The differential case names, in byte order.\n        const CASE_NAMES: &[&str] = &[$($case),*];\n\n        $(\n            /// Covers: rust-specs/archive-cases-match-openspec\n            #[ignore = \"corpus test: runs the OpenSpec CLI on the differential cases\"]\n            #[test]\n            fn $fn_name() {\n                run_case($case);\n            }\n        )*\n    };\n}\n\ncase_tests! {\n    added => \"added\",\n    bare_rename => \"bare-rename\",\n    dropped_scenario => \"dropped-scenario\",\n    duplicate_added => \"duplicate-added\",\n    given_and => \"given-and\",\n    modified => \"modified\",\n    new_capability => \"new-capability\",\n    removed => \"removed\",\n    renamed => \"renamed\",\n    second_change => \"second-change\",\n}\n\n/// Covers: rust-specs/archive-cases-match-openspec\n#[ignore = \"corpus test: runs the OpenSpec CLI on the differential cases\"]\n#[test]\nfn cases_are_exactly_the_fixture_folders() {\n    let actual: Vec<String> = folders(&fixtures()).iter().map(|path| name_of(path)).collect();\n    let expected: Vec<String> = CASE_NAMES.iter().map(|name| (*name).to_string()).collect();\n    assert_eq!(expected, actual, \"the differential case folders\");\n}\n","path":"/home/mathias/.osq/worktrees/osq/219-rust-specs-parity/crates/kernel/specs/tests/openspec_archive_parity_corpus.rs"},"output":"Wrote file successfully: crates/kernel/specs/tests/openspec_archive_parity_corpus.rs","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Wrote file successfully: crates/kernel/specs/tests/openspec_archive_parity_corpus.rs"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"content\": \"//! Corpus test: the Rust merge and `OpenSpec` archive agree on every\\n//! differential case of `tests/fixtures/openspec-diff/`.\\n//!\\n//! It runs the `OpenSpec` CLI over the repository's fixtures, so it is a corpus\\n//! test (rust-core \\\"Corpus tests\\\"): each test carries the corpus ignore, and\\n//! only a build with the `parity` feature compiles it.\\n\\npub mod openspec_parity_support;\\n\\nuse openspec_parity_support::cli::{OpenSpecCli, text_of};\\nuse openspec_parity_support::project::Project;\\nuse openspec_parity_support::trees::{copy_tree, folders, name_of, read_tree, repository_root};\\nuse osq_kernel_specs::{MergeChangeError, MergedSpec, merge_change};\\nuse serde_json::Value;\\nuse std::collections::BTreeMap;\\nuse std::path::{Path, PathBuf};\\n\\n/// The differential fixtures, relative to the repository root.\\nconst FIXTURES: &str = \\\"tests/fixtures/openspec-diff\\\";\\n\\n/// The fixtures folder under the repository root.\\n#[must_use]\\nfn fixtures() -> PathBuf {\\n    repository_root().join(FIXTURES)\\n}\\n\\n/// Runs one differential case: builds both projects, then checks its\\n/// expectation.\\nfn run_case(name: &str) {\\n    let case = fixtures().join(name);\\n    let expect = case_expect(&case);\\n    let repo = repository_root();\\n    let cli = OpenSpecCli::locate(&repo);\\n    let openspec =\\n        Project::prepare(&format!(\\\"archive-{name}-openspec\\\"), &repo).expect(\\\"the project writes\\\");\\n    let rust =\\n        Project::prepare(&format!(\\\"archive-{name}-rust\\\"), &repo).expect(\\\"the project writes\\\");\\n    for project in [&openspec, &rust] {\\n        let specs = case.join(\\\"specs\\\");\\n        project\\n            .set_specs(specs.is_dir().then_some(specs.as_path()))\\n            .expect(\\\"the case specs copy\\\");\\n        copy_tree(&case.join(\\\"changes\\\"), &project.root().join(\\\"openspec/changes\\\"))\\n            .expect(\\\"the case changes copy\\\");\\n    }\\n    let changes = folders(&rust.root().join(\\\"openspec/changes\\\"));\\n    let first = changes\\n        .first()\\n        .map(PathBuf::as_path)\\n        .unwrap_or_else(|| panic!(\\\"case {name} has no change\\\"));\\n    let cli_specs = openspec.root().join(\\\"openspec/specs\\\");\\n    let rust_specs = rust.root().join(\\\"openspec/specs\\\");\\n    match expect.as_str() {\\n        \\\"identical\\\" => assert_identical(&cli, &openspec, &rust_specs, &changes),\\n        \\\"both-refuse\\\" => assert_both_refuse(&cli, first, &cli_specs, &rust_specs, &case),\\n        \\\"osq-refuses\\\" => assert_osq_refuses(&cli, first, &cli_specs, &case),\\n        other => panic!(\\\"case {name} has unknown expect `{other}`\\\"),\\n    }\\n}\\n\\n/// The `expect` value of one case's `case.json`.\\n#[must_use]\\nfn case_expect(case: &Path) -> String {\\n    let file = case.join(\\\"case.json\\\");\\n    let text = std::fs::read_to_string(&file)\\n        .unwrap_or_else(|error| panic!(\\\"reading {}: {error}\\\", file.display()));\\n    let value: Value = serde_json::from_str(&text)\\n        .unwrap_or_else(|error| panic!(\\\"parsing {}: {error}\\\", file.display()));\\n    value\\n        .get(\\\"expect\\\")\\n        .and_then(Value::as_str)\\n        .unwrap_or_else(|| panic!(\\\"{} has no expect\\\", file.display()))\\n        .to_string()\\n}\\n\\n/// A case both tools accept: every change validates and archives in the CLI\\n/// project, the Rust merge applies each change, and the specs trees match.\\nfn assert_identical(cli: &OpenSpecCli, openspec: &Project, rust_specs: &Path, changes: &[PathBuf]) {\\n    for change in changes {\\n        let name = name_of(change);\\n        let validate = cli.run(\\n            &[\\n                \\\"validate\\\",\\n                &name,\\n                \\\"--type\\\",\\n                \\\"change\\\",\\n                \\\"--strict\\\",\\n                \\\"--json\\\",\\n                \\\"--no-interactive\\\",\\n            ],\\n            openspec.root(),\\n        );\\n        assert!(\\n            validate.status.success(),\\n            \\\"{}: validate {name} failed:\\\\n{}\\\",\\n            cli.path().display(),\\n            text_of(&validate)\\n        );\\n        let archive = cli.run(&[\\\"archive\\\", &name, \\\"--yes\\\", \\\"--json\\\"], openspec.root());\\n        assert!(\\n            archive.status.success(),\\n            \\\"{}: archive {name} failed:\\\\n{}\\\",\\n            cli.path().display(),\\n            text_of(&archive)\\n        );\\n        merge_into(change, rust_specs);\\n    }\\n    assert_trees_equal(\\n        &openspec.root().join(\\\"openspec/specs\\\"),\\n        rust_specs,\\n        \\\"the two specs trees\\\",\\n    );\\n}\\n\\n/// A case both tools refuse: the CLI reports `archive_spec_update_failed`, the\\n/// Rust merge refuses, and neither tree changes.\\nfn assert_both_refuse(\\n    cli: &OpenSpecCli,\\n    first: &Path,\\n    cli_specs: &Path,\\n    rust_specs: &Path,\\n    case: &Path,\\n) {\\n    let name = name_of(first);\\n    let archive = cli.run(&[\\\"archive\\\", &name, \\\"--yes\\\", \\\"--json\\\"], cli_specs);\\n    assert!(\\n        !archive.status.success(),\\n        \\\"{}: archive {name} unexpectedly succeeded:\\\\n{}\\\",\\n        cli.path().display(),\\n        text_of(&archive)\\n    );\\n    let value: Value = serde_json::from_slice(&archive.stdout).unwrap_or_else(|error| {\\n        panic!(\\n            \\\"archive {name} printed no JSON: {error}\\\\n{}\\\",\\n            text_of(&archive)\\n        )\\n    });\\n    let refused = value\\n        .get(\\\"status\\\")\\n        .and_then(Value::as_array)\\n        .is_some_and(|status| {\\n            status.iter().any(|entry| {\\n                entry.get(\\\"code\\\").and_then(Value::as_str) == Some(\\\"archive_spec_update_failed\\\")\\n            })\\n        });\\n    assert!(\\n        refused,\\n        \\\"{}: archive {name} did not report archive_spec_update_failed:\\\\n{}\\\",\\n        cli.path().display(),\\n        text_of(&archive)\\n    );\\n    match merge_change(first, rust_specs) {\\n        Err(MergeChangeError::Merge { .. }) => {}\\n        other => panic!(\\n            \\\"{}: the Rust merge should refuse, got {other:?}\\\",\\n            first.display()\\n        ),\\n    }\\n    let case_specs = case.join(\\\"specs\\\");\\n    assert_trees_equal(cli_specs, &case_specs, \\\"the OpenSpec tree\\\");\\n    assert_trees_equal(rust_specs, &case_specs, \\\"the Rust tree\\\");\\n}\\n\\n/// A case the Rust merge refuses and the CLI accepts: the refusal names the\\n/// expected rename form, and no living spec holds a rename target.\\nfn assert_osq_refuses(cli: &OpenSpecCli, first: &Path, cli_specs: &Path, case: &Path) {\\n    let name = name_of(first);\\n    let message = match merge_change(first, cli_specs) {\\n        Err(MergeChangeError::Merge { error, .. }) => error.to_string(),\\n        other => panic!(\\n            \\\"{}: expected a merge refusal, got {other:?}\\\",\\n            first.display()\\n        ),\\n    };\\n    assert!(\\n        message.contains(\\\"### Requirement:\\\"),\\n        \\\"{}: the refusal must name the expected form: {message}\\\",\\n        first.display()\\n    );\\n    let archive = cli.run(&[\\\"archive\\\", &name, \\\"--yes\\\", \\\"--json\\\"], cli_specs);\\n    assert!(\\n        archive.status.success(),\\n        \\\"{}: archive {name} unexpectedly failed:\\\\n{}\\\",\\n        cli.path().display(),\\n        text_of(&archive)\\n    );\\n    let living = read_tree_or_empty(cli_specs);\\n    for target in rename_targets(&case.join(\\\"changes\\\")) {\\n        let header = format!(\\\"### Requirement: {target}\\\");\\n        assert!(\\n            !living.values().any(|text| text.contains(&header)),\\n            \\\"{}: the case applied a rename OpenSpec should skip: {target}\\\",\\n            case.display()\\n        );\\n    }\\n}\\n\\n/// Merges one change into `specs`, applying each merged text before the next.\\nfn merge_into(change: &Path, specs: &Path) {\\n    let merged = merge_change(change, specs)\\n        .unwrap_or_else(|error| panic!(\\\"{}: the Rust merge refuses: {error}\\\", change.display()));\\n    apply(specs, &merged);\\n}\\n\\n/// Writes each merged text, or removes a capability folder the change empties.\\nfn apply(specs: &Path, merged: &[MergedSpec]) {\\n    for spec in merged {\\n        let folder = specs.join(&spec.capability);\\n        match &spec.text {\\n            Some(text) => {\\n                std::fs::create_dir_all(&folder).expect(\\\"the capability folder\\\");\\n                std::fs::write(folder.join(\\\"spec.md\\\"), text).expect(\\\"the merged spec\\\");\\n            }\\n            None => {\\n                let _ = std::fs::remove_dir_all(&folder);\\n            }\\n        }\\n    }\\n}\\n\\n/// Asserts two trees hold the same paths with the same bytes.\\nfn assert_trees_equal(left: &Path, right: &Path, label: &str) {\\n    let left_tree = read_tree_or_empty(left);\\n    let right_tree = read_tree_or_empty(right);\\n    assert_eq!(\\n        left_tree.keys().collect::<Vec<_>>(),\\n        right_tree.keys().collect::<Vec<_>>(),\\n        \\\"{label}: different paths\\\"\\n    );\\n    for (path, text) in &left_tree {\\n        assert_eq!(Some(text), right_tree.get(path), \\\"{label}: {path}\\\");\\n    }\\n}\\n\\n/// Every file under `root`, or none when the folder does not exist.\\n#[must_use]\\nfn read_tree_or_empty(root: &Path) -> BTreeMap<String, String> {\\n    if !root.is_dir() {\\n        return BTreeMap::new();\\n    }\\n    read_tree(root).unwrap_or_else(|error| panic!(\\\"reading {}: {error}\\\", root.display()))\\n}\\n\\n/// The rename targets the case's delta specs name with a `TO:` line.\\n#[must_use]\\nfn rename_targets(changes: &Path) -> Vec<String> {\\n    let mut targets = Vec::new();\\n    for change in folders(changes) {\\n        for capability in folders(&change.join(\\\"specs\\\")) {\\n            let Ok(text) = std::fs::read_to_string(capability.join(\\\"spec.md\\\")) else {\\n                continue;\\n            };\\n            targets.extend(text.lines().filter_map(rename_target));\\n        }\\n    }\\n    targets\\n}\\n\\n/// The target a `TO:` line names, or none for any other line.\\n#[must_use]\\nfn rename_target(line: &str) -> Option<String> {\\n    let mut rest = line.trim_start();\\n    for marker in ['-', '*', '+'] {\\n        if let Some(stripped) = rest.strip_prefix(marker) {\\n            rest = stripped.trim_start();\\n            break;\\n        }\\n    }\\n    if !rest.get(..3)?.eq_ignore_ascii_case(\\\"TO:\\\") {\\n        return None;\\n    }\\n    let value = strip_requirement_header(rest[3..].trim().trim_matches('`').trim()).trim();\\n    (!value.is_empty()).then(|| value.to_string())\\n}\\n\\n/// `text` without a leading `### Requirement:` header, in any case.\\n#[must_use]\\nfn strip_requirement_header(text: &str) -> &str {\\n    let Some(head) = text.get(..3) else {\\n        return text;\\n    };\\n    if !head.eq_ignore_ascii_case(\\\"###\\\") {\\n        return text;\\n    }\\n    let rest = text[3..].trim_start();\\n    match rest.get(..12) {\\n        Some(word) if word.eq_ignore_ascii_case(\\\"Requirement:\\\") => rest[12..].trim_start(),\\n        _ => text,\\n    }\\n}\\n\\nmacro_rules! case_tests {\\n    ($($fn_name:ident => $case:literal),* $(,)?) => {\\n        /// The differential case names, in byte order.\\n        const CASE_NAMES: &[&str] = &[$($case),*];\\n\\n        $(\\n            /// Covers: rust-specs/archive-cases-match-openspec\\n            #[ignore = \\\"corpus test: runs the OpenSpec CLI on the differential cases\\\"]\\n            #[test]\\n            fn $fn_name() {\\n                run_case($case);\\n            }\\n        )*\\n    };\\n}\\n\\ncase_tests! {\\n    added => \\\"added\\\",\\n    bare_rename => \\\"bare-rename\\\",\\n    dropped_scenario => \\\"dropped-scenario\\\",\\n    duplicate_added => \\\"duplicate-added\\\",\\n    given_and => \\\"given-and\\\",\\n    modified => \\\"modified\\\",\\n    new_capability => \\\"new-capability\\\",\\n    removed => \\\"removed\\\",\\n    renamed => \\\"renamed\\\",\\n    second_change => \\\"second-change\\\",\\n}\\n\\n/// Covers: rust-specs/archive-cases-match-openspec\\n#[ignore = \\\"corpus test: runs the OpenSpec CLI on the differential cases\\\"]\\n#[test]\\nfn cases_are_exactly_the_fixture_folders() {\\n    let actual: Vec<String> = folders(&fixtures()).iter().map(|path| name_of(path)).collect();\\n    let expected: Vec<String> = CASE_NAMES.iter().map(|name| (*name).to_string()).collect();\\n    assert_eq!(expected, actual, \\\"the differential case folders\\\");\\n}\\n\", \"path\": \"/home/mathias/.osq/worktrees/osq/219-rust-specs-parity/crates/kernel/specs/tests/openspec_archive_parity_corpus.rs\"}"},"time":{"start":1792394750402,"end":1792394753026}}}}
