+{"type":"tool_use","timestamp":1792396813086,"sessionID":"ses_eacdb5a85ffeETstJhXFodxnfQ","part":{"partID":"prt_1532cc60e001hZtgn4DpZ1zgei","sessionID":"ses_eacdb5a85ffeETstJhXFodxnfQ","messageID":"msg_1532c093a001WSEzbBm1SQU26O","type":"tool","id":"call_7641cbaf0a4841738a76b276","tool":"write","state":{"status":"completed","input":{"path":"crates/kernel/specs/tests/openspec_archive_parity_corpus.rs","content":"//! Corpus test: the Rust merge gives the result `openspec archive` gives on every\n//! differential case of `tests/fixtures/openspec-diff/`. It runs the `OpenSpec`\n//! CLI, so it is a corpus test (rust-core \"Corpus tests\"): each test carries the\n//! corpus ignore, and only a build with the `parity` feature compiles it.\n\npub mod openspec_parity_support;\n\nuse openspec_parity_support::cli::{OpenSpecCli, text_of};\nuse openspec_parity_support::project::Project;\nuse openspec_parity_support::trees::{folders, name_of, read_tree, repository_root};\nuse osq_kernel_specs::{MergeChangeError, merge_change};\nuse serde_json::Value;\nuse std::collections::BTreeMap;\nuse std::path::{Path, PathBuf};\nuse std::process::Output;\n\n/// The differential cases, relative to the repository root.\nconst FIXTURES: &str = \"tests/fixtures/openspec-diff\";\n\n/// The case folder names below, in byte order.\n#[rustfmt::skip]\nconst CASES: [&str; 10] = [\n    \"added\", \"bare-rename\", \"dropped-scenario\", \"duplicate-added\", \"given-and\",\n    \"modified\", \"new-capability\", \"removed\", \"renamed\", \"second-change\",\n];\n\n/// Declares one test per differential case, each reading its `case.json`.\nmacro_rules! case_tests {\n    ($($name:ident => $case:literal),+ $(,)?) => {\n        $(\n            /// Covers: rust-specs/archive-cases-match-openspec\n            #[ignore = \"corpus test: runs the OpenSpec CLI on the differential cases\"]\n            #[test]\n            fn $name() {\n                run_case($case);\n            }\n        )+\n    };\n}\n\n#[rustfmt::skip]\ncase_tests! {\n    added => \"added\", bare_rename => \"bare-rename\", dropped_scenario => \"dropped-scenario\",\n    duplicate_added => \"duplicate-added\", given_and => \"given-and\", modified => \"modified\",\n    new_capability => \"new-capability\", removed => \"removed\", renamed => \"renamed\",\n    second_change => \"second-change\",\n}\n\n/// Covers: rust-specs/archive-cases-match-openspec\n#[ignore = \"corpus test: runs the OpenSpec CLI on the differential cases\"]\n#[test]\nfn cases_are_exactly_the_fixture_folders() {\n    let found: Vec<String> = folders(&repository_root().join(FIXTURES))\n        .iter()\n        .map(|path| name_of(path))\n        .collect();\n    assert_eq!(found, CASES.map(String::from).to_vec(), \"the case folders\");\n}\n\n/// Runs one case and checks the result its `case.json` names.\nfn run_case(case: &str) {\n    let repo = repository_root();\n    let dir = repo.join(FIXTURES).join(case);\n    let names = change_names(&dir);\n    let cli = OpenSpecCli::locate(&repo);\n    let a = project_for(case, \"cli\", &dir, &repo, &names);\n    let b = project_for(case, \"rust\", &dir, &repo, &names);\n    let rust = rust_merge(&b, &names);\n    match expect_of(&dir).as_str() {\n        \"identical\" => {\n            assert!(rust.is_ok(), \"case {case}: the Rust merge refuses\");\n            for name in &names {\n                let validate = cli_validate(&cli, &a, name);\n                assert_status(&validate, true, &format!(\"case {case}: validate {name}\"));\n                let archive = cli_archive(&cli, &a, name);\n                assert_status(&archive, true, &format!(\"case {case}: archive {name}\"));\n            }\n            let cli_tree = tree_of(&specs_of(&a));\n            assert!(!cli_tree.is_empty(), \"case {case}: no living spec archived\");\n            let what = format!(\"case {case}: the openspec/specs trees\");\n            assert_tree(&cli_tree, &tree_of(&specs_of(&b)), &what);\n        }\n        \"both-refuse\" => {\n            refusal_message(&rust.expect_err(\"the Rust merge refuses\"), case);\n            let archive = cli_archive(&cli, &a, first_name(&names));\n            assert_status(&archive, false, &format!(\"case {case}: archive\"));\n            let codes = status_codes(&archive.stdout);\n            assert!(\n                codes.iter().any(|code| code == \"archive_spec_update_failed\"),\n                \"case {case}: no archive_spec_update_failed: {}\",\n                text_of(&archive)\n            );\n            let base = tree_of(&dir.join(\"specs\"));\n            assert_tree(&tree_of(&specs_of(&a)), &base, &format!(\"case {case}: CLI specs\"));\n            assert_tree(&tree_of(&specs_of(&b)), &base, &format!(\"case {case}: Rust specs\"));\n        }\n        \"osq-refuses\" => {\n            let error = rust.expect_err(\"the Rust merge refuses\");\n            let message = refusal_message(&error, case);\n            assert!(\n                message.contains(\"### Requirement:\"),\n                \"case {case}: the refusal must name the form: {message}\"\n            );\n            let archive = cli_archive(&cli, &a, first_name(&names));\n            assert_status(&archive, true, &format!(\"case {case}: archive\"));\n            let living = tree_of(&specs_of(&a));\n            for target in rename_targets(&dir) {\n                let marker = format!(\"### Requirement: {target}\");\n                assert!(\n                    !living.values().any(|text| text.contains(&marker)),\n                    \"case {case}: a skipped rename landed: {target}\"\n                );\n            }\n        }\n        other => panic!(\"case {case} names an unknown expectation `{other}`\"),\n    }\n}\n\n/// Builds a temporary project: the scaffolded schema, the case's specs, and each change.\nfn project_for(case: &str, kind: &str, dir: &Path, repo: &Path, names: &[String]) -> Project {\n    let name = format!(\"archive-{case}-{kind}\");\n    let project = Project::prepare(&name, repo).expect(\"the project writes\");\n    let specs = dir.join(\"specs\");\n    let source = specs.is_dir().then_some(specs.as_path());\n    project.set_specs(source).expect(\"the living specs copy\");\n    for name in names {\n        let from = dir.join(\"changes\").join(name);\n        project.put_change(name, &from).expect(\"the change copies\");\n    }\n    project\n}\n\n/// The `openspec/specs` folder of a project.\nfn specs_of(project: &Project) -> PathBuf {\n    project.root().join(\"openspec/specs\")\n}\n\n/// Merges each named change into the project's living specs, in order.\nfn rust_merge(project: &Project, names: &[String]) -> Result<(), MergeChangeError> {\n    let specs = specs_of(project);\n    let changes = project.root().join(\"openspec/changes\");\n    for name in names {\n        for spec in merge_change(&changes.join(name), &specs)? {\n            let folder = specs.join(&spec.capability);\n            match spec.text {\n                Some(text) => {\n                    std::fs::create_dir_all(&folder).expect(\"a capability folder\");\n                    std::fs::write(folder.join(\"spec.md\"), text).expect(\"a merged spec\");\n                }\n                None if folder.is_dir() => {\n                    std::fs::remove_dir_all(&folder).expect(\"an emptied folder\");\n                }\n                None => {}\n            }\n        }\n    }\n    Ok(())\n}\n\n/// Runs `validate` on one change in a CLI project.\nfn cli_validate(cli: &OpenSpecCli, project: &Project, name: &str) -> Output {\n    let args = [\"validate\", name, \"--type\", \"change\", \"--strict\", \"--json\", \"--no-interactive\"];\n    cli.run(&args, project.root())\n}\n\n/// Runs `archive` on one change in a CLI project.\nfn cli_archive(cli: &OpenSpecCli, project: &Project, name: &str) -> Output {\n    cli.run(&[\"archive\", name, \"--yes\", \"--json\"], project.root())\n}\n\n/// The first change name, which every case has.\nfn first_name(names: &[String]) -> &str {\n    names.first().expect(\"a case has at least one change\")\n}\n\n/// The `expect` of a case's `case.json`.\nfn expect_of(dir: &Path) -> String {\n    let text = std::fs::read_to_string(dir.join(\"case.json\")).expect(\"case.json reads\");\n    let value: Value = serde_json::from_str(&text).expect(\"case.json parses\");\n    value[\"expect\"].as_str().expect(\"expect is named\").to_string()\n}\n\n/// The change folder names of a case, in byte order.\nfn change_names(dir: &Path) -> Vec<String> {\n    folders(&dir.join(\"changes\")).iter().map(|path| name_of(path)).collect()\n}\n\n/// The message of a merge refusal, panicking on any other error.\nfn refusal_message(error: &MergeChangeError, case: &str) -> String {\n    match error {\n        MergeChangeError::Merge { error, .. } => error.to_string(),\n        MergeChangeError::Read(read) => panic!(\"case {case}: unexpected read error: {read}\"),\n    }\n}\n\n/// Asserts a CLI run's exit status, naming it when it differs.\nfn assert_status(output: &Output, success: bool, what: &str) {\n    assert_eq!(output.status.success(), success, \"{what}: {}\", text_of(output));\n}\n\n/// Asserts two trees hold the same paths and bytes.\nfn assert_tree(actual: &BTreeMap<String, String>, expected: &BTreeMap<String, String>, what: &str) {\n    assert_eq!(actual, expected, \"{what} differ\");\n}\n\n/// The `code` of each entry of an `archive --json` `status` array.\nfn status_codes(stdout: &[u8]) -> Vec<String> {\n    let value: Value = serde_json::from_slice(stdout).unwrap_or(Value::Null);\n    let entries = value[\"status\"].as_array().cloned().unwrap_or_default();\n    entries.iter().filter_map(|entry| entry[\"code\"].as_str()).map(str::to_string).collect()\n}\n\n/// Every file under `root`, keyed by its `/`-joined relative path, or empty when missing.\nfn tree_of(root: &Path) -> BTreeMap<String, String> {\n    read_tree(root).unwrap_or_default()\n}\n\n/// The `TO:` names of a case's delta specs, as the TypeScript differential test reads them.\nfn rename_targets(dir: &Path) -> Vec<String> {\n    let mut targets = Vec::new();\n    for change in folders(&dir.join(\"changes\")) {\n        for capability in folders(&change.join(\"specs\")) {\n            let Ok(text) = std::fs::read_to_string(capability.join(\"spec.md\")) else {\n                continue;\n            };\n            targets.extend(text.lines().filter_map(to_name));\n        }\n    }\n    targets\n}\n\n/// The requirement name a delta line's `TO:` names, or none.\nfn to_name(line: &str) -> Option<String> {\n    let line = line.trim_start();\n    let line = line.strip_prefix('-').or_else(|| line.strip_prefix('*')).unwrap_or(line);\n    let line = line.strip_prefix('+').unwrap_or(line).trim_start();\n    if !line.to_lowercase().starts_with(\"to:\") {\n        return None;\n    }\n    let rest = line[3..].trim().trim_matches('`').trim();\n    let rest = rest.strip_prefix(\"###\").map_or(rest, str::trim_start);\n    let name = rest.to_lowercase().strip_prefix(\"requirement:\").map_or(rest, |_| &rest[12..]);\n    let name = name.trim();\n    (!name.is_empty()).then(|| name.to_string())\n}\n"},"output":"Wrote file successfully: crates/kernel/specs/tests/openspec_archive_parity_corpus.rs","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Wrote file successfully: crates/kernel/specs/tests/openspec_archive_parity_corpus.rs"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"crates/kernel/specs/tests/openspec_archive_parity_corpus.rs\",\"content\":\"//! Corpus test: the Rust merge gives the result `openspec archive` gives on every\\n//! differential case of `tests/fixtures/openspec-diff/`. It runs the `OpenSpec`\\n//! CLI, so it is a corpus test (rust-core \\\"Corpus tests\\\"): each test carries the\\n//! corpus ignore, and only a build with the `parity` feature compiles it.\\n\\npub mod openspec_parity_support;\\n\\nuse openspec_parity_support::cli::{OpenSpecCli, text_of};\\nuse openspec_parity_support::project::Project;\\nuse openspec_parity_support::trees::{folders, name_of, read_tree, repository_root};\\nuse osq_kernel_specs::{MergeChangeError, merge_change};\\nuse serde_json::Value;\\nuse std::collections::BTreeMap;\\nuse std::path::{Path, PathBuf};\\nuse std::process::Output;\\n\\n/// The differential cases, relative to the repository root.\\nconst FIXTURES: &str = \\\"tests/fixtures/openspec-diff\\\";\\n\\n/// The case folder names below, in byte order.\\n#[rustfmt::skip]\\nconst CASES: [&str; 10] = [\\n    \\\"added\\\", \\\"bare-rename\\\", \\\"dropped-scenario\\\", \\\"duplicate-added\\\", \\\"given-and\\\",\\n    \\\"modified\\\", \\\"new-capability\\\", \\\"removed\\\", \\\"renamed\\\", \\\"second-change\\\",\\n];\\n\\n/// Declares one test per differential case, each reading its `case.json`.\\nmacro_rules! case_tests {\\n    ($($name:ident => $case:literal),+ $(,)?) => {\\n        $(\\n            /// Covers: rust-specs/archive-cases-match-openspec\\n            #[ignore = \\\"corpus test: runs the OpenSpec CLI on the differential cases\\\"]\\n            #[test]\\n            fn $name() {\\n                run_case($case);\\n            }\\n        )+\\n    };\\n}\\n\\n#[rustfmt::skip]\\ncase_tests! {\\n    added => \\\"added\\\", bare_rename => \\\"bare-rename\\\", dropped_scenario => \\\"dropped-scenario\\\",\\n    duplicate_added => \\\"duplicate-added\\\", given_and => \\\"given-and\\\", modified => \\\"modified\\\",\\n    new_capability => \\\"new-capability\\\", removed => \\\"removed\\\", renamed => \\\"renamed\\\",\\n    second_change => \\\"second-change\\\",\\n}\\n\\n/// Covers: rust-specs/archive-cases-match-openspec\\n#[ignore = \\\"corpus test: runs the OpenSpec CLI on the differential cases\\\"]\\n#[test]\\nfn cases_are_exactly_the_fixture_folders() {\\n    let found: Vec<String> = folders(&repository_root().join(FIXTURES))\\n        .iter()\\n        .map(|path| name_of(path))\\n        .collect();\\n    assert_eq!(found, CASES.map(String::from).to_vec(), \\\"the case folders\\\");\\n}\\n\\n/// Runs one case and checks the result its `case.json` names.\\nfn run_case(case: &str) {\\n    let repo = repository_root();\\n    let dir = repo.join(FIXTURES).join(case);\\n    let names = change_names(&dir);\\n    let cli = OpenSpecCli::locate(&repo);\\n    let a = project_for(case, \\\"cli\\\", &dir, &repo, &names);\\n    let b = project_for(case, \\\"rust\\\", &dir, &repo, &names);\\n    let rust = rust_merge(&b, &names);\\n    match expect_of(&dir).as_str() {\\n        \\\"identical\\\" => {\\n            assert!(rust.is_ok(), \\\"case {case}: the Rust merge refuses\\\");\\n            for name in &names {\\n                let validate = cli_validate(&cli, &a, name);\\n                assert_status(&validate, true, &format!(\\\"case {case}: validate {name}\\\"));\\n                let archive = cli_archive(&cli, &a, name);\\n                assert_status(&archive, true, &format!(\\\"case {case}: archive {name}\\\"));\\n            }\\n            let cli_tree = tree_of(&specs_of(&a));\\n            assert!(!cli_tree.is_empty(), \\\"case {case}: no living spec archived\\\");\\n            let what = format!(\\\"case {case}: the openspec/specs trees\\\");\\n            assert_tree(&cli_tree, &tree_of(&specs_of(&b)), &what);\\n        }\\n        \\\"both-refuse\\\" => {\\n            refusal_message(&rust.expect_err(\\\"the Rust merge refuses\\\"), case);\\n            let archive = cli_archive(&cli, &a, first_name(&names));\\n            assert_status(&archive, false, &format!(\\\"case {case}: archive\\\"));\\n            let codes = status_codes(&archive.stdout);\\n            assert!(\\n                codes.iter().any(|code| code == \\\"archive_spec_update_failed\\\"),\\n                \\\"case {case}: no archive_spec_update_failed: {}\\\",\\n                text_of(&archive)\\n            );\\n            let base = tree_of(&dir.join(\\\"specs\\\"));\\n            assert_tree(&tree_of(&specs_of(&a)), &base, &format!(\\\"case {case}: CLI specs\\\"));\\n            assert_tree(&tree_of(&specs_of(&b)), &base, &format!(\\\"case {case}: Rust specs\\\"));\\n        }\\n        \\\"osq-refuses\\\" => {\\n            let error = rust.expect_err(\\\"the Rust merge refuses\\\");\\n            let message = refusal_message(&error, case);\\n            assert!(\\n                message.contains(\\\"### Requirement:\\\"),\\n                \\\"case {case}: the refusal must name the form: {message}\\\"\\n            );\\n            let archive = cli_archive(&cli, &a, first_name(&names));\\n            assert_status(&archive, true, &format!(\\\"case {case}: archive\\\"));\\n            let living = tree_of(&specs_of(&a));\\n            for target in rename_targets(&dir) {\\n                let marker = format!(\\\"### Requirement: {target}\\\");\\n                assert!(\\n                    !living.values().any(|text| text.contains(&marker)),\\n                    \\\"case {case}: a skipped rename landed: {target}\\\"\\n                );\\n            }\\n        }\\n        other => panic!(\\\"case {case} names an unknown expectation `{other}`\\\"),\\n    }\\n}\\n\\n/// Builds a temporary project: the scaffolded schema, the case's specs, and each change.\\nfn project_for(case: &str, kind: &str, dir: &Path, repo: &Path, names: &[String]) -> Project {\\n    let name = format!(\\\"archive-{case}-{kind}\\\");\\n    let project = Project::prepare(&name, repo).expect(\\\"the project writes\\\");\\n    let specs = dir.join(\\\"specs\\\");\\n    let source = specs.is_dir().then_some(specs.as_path());\\n    project.set_specs(source).expect(\\\"the living specs copy\\\");\\n    for name in names {\\n        let from = dir.join(\\\"changes\\\").join(name);\\n        project.put_change(name, &from).expect(\\\"the change copies\\\");\\n    }\\n    project\\n}\\n\\n/// The `openspec/specs` folder of a project.\\nfn specs_of(project: &Project) -> PathBuf {\\n    project.root().join(\\\"openspec/specs\\\")\\n}\\n\\n/// Merges each named change into the project's living specs, in order.\\nfn rust_merge(project: &Project, names: &[String]) -> Result<(), MergeChangeError> {\\n    let specs = specs_of(project);\\n    let changes = project.root().join(\\\"openspec/changes\\\");\\n    for name in names {\\n        for spec in merge_change(&changes.join(name), &specs)? {\\n            let folder = specs.join(&spec.capability);\\n            match spec.text {\\n                Some(text) => {\\n                    std::fs::create_dir_all(&folder).expect(\\\"a capability folder\\\");\\n                    std::fs::write(folder.join(\\\"spec.md\\\"), text).expect(\\\"a merged spec\\\");\\n                }\\n                None if folder.is_dir() => {\\n                    std::fs::remove_dir_all(&folder).expect(\\\"an emptied folder\\\");\\n                }\\n                None => {}\\n            }\\n        }\\n    }\\n    Ok(())\\n}\\n\\n/// Runs `validate` on one change in a CLI project.\\nfn cli_validate(cli: &OpenSpecCli, project: &Project, name: &str) -> Output {\\n    let args = [\\\"validate\\\", name, \\\"--type\\\", \\\"change\\\", \\\"--strict\\\", \\\"--json\\\", \\\"--no-interactive\\\"];\\n    cli.run(&args, project.root())\\n}\\n\\n/// Runs `archive` on one change in a CLI project.\\nfn cli_archive(cli: &OpenSpecCli, project: &Project, name: &str) -> Output {\\n    cli.run(&[\\\"archive\\\", name, \\\"--yes\\\", \\\"--json\\\"], project.root())\\n}\\n\\n/// The first change name, which every case has.\\nfn first_name(names: &[String]) -> &str {\\n    names.first().expect(\\\"a case has at least one change\\\")\\n}\\n\\n/// The `expect` of a case's `case.json`.\\nfn expect_of(dir: &Path) -> String {\\n    let text = std::fs::read_to_string(dir.join(\\\"case.json\\\")).expect(\\\"case.json reads\\\");\\n    let value: Value = serde_json::from_str(&text).expect(\\\"case.json parses\\\");\\n    value[\\\"expect\\\"].as_str().expect(\\\"expect is named\\\").to_string()\\n}\\n\\n/// The change folder names of a case, in byte order.\\nfn change_names(dir: &Path) -> Vec<String> {\\n    folders(&dir.join(\\\"changes\\\")).iter().map(|path| name_of(path)).collect()\\n}\\n\\n/// The message of a merge refusal, panicking on any other error.\\nfn refusal_message(error: &MergeChangeError, case: &str) -> String {\\n    match error {\\n        MergeChangeError::Merge { error, .. } => error.to_string(),\\n        MergeChangeError::Read(read) => panic!(\\\"case {case}: unexpected read error: {read}\\\"),\\n    }\\n}\\n\\n/// Asserts a CLI run's exit status, naming it when it differs.\\nfn assert_status(output: &Output, success: bool, what: &str) {\\n    assert_eq!(output.status.success(), success, \\\"{what}: {}\\\", text_of(output));\\n}\\n\\n/// Asserts two trees hold the same paths and bytes.\\nfn assert_tree(actual: &BTreeMap<String, String>, expected: &BTreeMap<String, String>, what: &str) {\\n    assert_eq!(actual, expected, \\\"{what} differ\\\");\\n}\\n\\n/// The `code` of each entry of an `archive --json` `status` array.\\nfn status_codes(stdout: &[u8]) -> Vec<String> {\\n    let value: Value = serde_json::from_slice(stdout).unwrap_or(Value::Null);\\n    let entries = value[\\\"status\\\"].as_array().cloned().unwrap_or_default();\\n    entries.iter().filter_map(|entry| entry[\\\"code\\\"].as_str()).map(str::to_string).collect()\\n}\\n\\n/// Every file under `root`, keyed by its `/`-joined relative path, or empty when missing.\\nfn tree_of(root: &Path) -> BTreeMap<String, String> {\\n    read_tree(root).unwrap_or_default()\\n}\\n\\n/// The `TO:` names of a case's delta specs, as the TypeScript differential test reads them.\\nfn rename_targets(dir: &Path) -> Vec<String> {\\n    let mut targets = Vec::new();\\n    for change in folders(&dir.join(\\\"changes\\\")) {\\n        for capability in folders(&change.join(\\\"specs\\\")) {\\n            let Ok(text) = std::fs::read_to_string(capability.join(\\\"spec.md\\\")) else {\\n                continue;\\n            };\\n            targets.extend(text.lines().filter_map(to_name));\\n        }\\n    }\\n    targets\\n}\\n\\n/// The requirement name a delta line's `TO:` names, or none.\\nfn to_name(line: &str) -> Option<String> {\\n    let line = line.trim_start();\\n    let line = line.strip_prefix('-').or_else(|| line.strip_prefix('*')).unwrap_or(line);\\n    let line = line.strip_prefix('+').unwrap_or(line).trim_start();\\n    if !line.to_lowercase().starts_with(\\\"to:\\\") {\\n        return None;\\n    }\\n    let rest = line[3..].trim().trim_matches('`').trim();\\n    let rest = rest.strip_prefix(\\\"###\\\").map_or(rest, str::trim_start);\\n    let name = rest.to_lowercase().strip_prefix(\\\"requirement:\\\").map_or(rest, |_| &rest[12..]);\\n    let name = name.trim();\\n    (!name.is_empty()).then(|| name.to_string())\\n}\\n\"}"},"time":{"start":1792396805646,"end":1792396813086}}}}
