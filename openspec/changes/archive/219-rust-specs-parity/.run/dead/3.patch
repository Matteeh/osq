ontinue;\n        }\n        let Ok(value) = serde_json::from_str::<serde_json::Value>(line) else {\n            continue;\n        };\n        if value.get(\"type\").and_then(|kind| kind.as_str()) != Some(\"archived\") {\n            continue;\n        }\n        if let Some(stamp) = value.get(\"timestamp\").and_then(|stamp| stamp.as_str()) {\n            last = Some(stamp.to_string());\n        }\n    }\n    last\n}\n\n/// The folders directly under `dir` whose names pass `keep`, in byte order.\nfn folders_in(dir: &Path, keep: impl Fn(&Path) -> bool) -> Vec<PathBuf> {\n    let Ok(entries) = std::fs::read_dir(dir) else {\n        return Vec::new();\n    };\n    let mut folders: Vec<PathBuf> = entries\n        .flatten()\n===\n//! Corpus tests: this repository's living specs and archived delta specs validate.\n//!\n//! Both read documents outside this crate, so they are corpus tests (rust-core\n//! \"Corpus tests\"): they carry the corpus ignore, run under\n//! `scripts/verify-rust.sh`, and cargo-mutants leaves them out.\n\nuse osq_kernel_specs::{SpecFinding, validate_delta, validate_living_specs};\nuse std::path::{Path, PathBuf};\n\n/// The repository root, three folders above this crate's manifest.\nfn repository_root() -> PathBuf {\n    Path::new(env!(\"CARGO_MANIFEST_DIR\"))\n        .ancestors()\n        .nth(3)\n        .expect(\"the repository root is three folders above crates/kernel/specs\")\n        .to_path_buf()\n}\n\n/// The change number a folder name leads with, if it leads with digits.\nfn leading_number(name: &str) -> Option<u32> {\n    let digits: String = name.chars().take_while(char::is_ascii_digit).collect();\n    digits.parse().ok()\n}\n\n/// One finding as its file, line, code and message.\nfn describe(finding: &SpecFinding) -> String {\n    format!(\n        \"{}:{}: {}: {}\",\n        finding.file,\n        finding.line,\n        finding.code.as_str(),\n        finding.message\n    )\n}\n\n/// Every finding as a line, joined, so a failure prints all of them.\nfn describe_all(findings: &[SpecFinding]) -> String {\n    findings.iter().map(describe).collect::<Vec<_>>().join(\"\\n\")\n}\n\n/// A path under `root` written repository-relative.\nfn relative(root: &Path, path: &Path) -> String {\n    path.strip_prefix(root)\n        .unwrap_or(path)\n        .display()\n        .to_string()\n}\n\n/// Covers: rust-specs/living-specs-validate\n#[ignore = \"corpus test: reads the live specs and archive\"]\n#[test]\nfn living_specs_validate() {\n    let specs = repository_root().join(\"openspec/specs\");\n    let findings = validate_living_specs(&specs).expect(\"this repository's living specs\");\n    assert!(\n        findings.is_empty(),\n        \"living spec findings:\\n{}\",\n        describe_all(&findings)\n    );\n}\n\n/// The archived change folders numbered 001 to 216, by number.\nfn archived_changes(root: &Path) -> Vec<(u32, PathBuf)> {\n    let archive = root.join(\"openspec/changes/archive\");\n    let Ok(entries) = std::fs::read_dir(&archive) else {\n        return Vec::new();\n    };\n    let mut changes: Vec<(u32, PathBuf)> = entries\n        .flatten()\n        .filter_map(|entry| {\n            let number = leading_number(&entry.file_name().to_string_lossy())?;\n            (1..=216).contains(&number).then(|| (number, entry.path()))\n        })\n        .collect();\n    changes.sort_by_key(|(number, _)| *number);\n    changes\n}\n\n/// The `specs/<capability>/spec.md` paths of one archived change.\nfn delta_paths(change: &Path) -> Vec<PathBuf> {\n    let Ok(entries) = std::fs::read_dir(change.join(\"specs\")) else {\n        return Vec::new();\n    };\n    let mut paths: Vec<PathBuf> = entries\n        .flatten()\n        .map(|entry| entry.path().join(\"spec.md\"))\n        .filter(|path| path.is_file())\n        .collect();\n    paths.sort();\n    paths\n}\n\n/// The change numbers the corpus expects to hold no delta spec.\nfn expected_without_delta() -> Vec<u32> {\n    let mut numbers: Vec<u32> = (1..=15).collect();\n    numbers.push(18);\n    numbers.push(19);\n    numbers\n}\n\n/// Covers: rust-specs/archived-deltas-validate\n#[ignore = \"corpus test: reads the live specs and archive\"]\n#[test]\nfn archived_deltas_validate() {\n    let root = repository_root();\n    let mut findings = Vec::new();\n    let mut without = Vec::new();\n    for (number, change) in archived_changes(&root) {\n        let deltas = delta_paths(&change);\n        if deltas.is_empty() {\n            without.push(number);\n            continue;\n        }\n        for path in deltas {\n            let file = relative(&root, &path);\n            let text = std::fs::read_to_string(&path).expect(\"a delta spec reads\");\n            findings.extend(validate_delta(&file, &text));\n        }\n    }\n    assert!(\n        findings.is_empty(),\n        \"archived delta findings:\\n{}\",\n        describe_all(&findings)\n    );\n    assert_eq!(\n        expected_without_delta(),\n        without,\n        \"archived changes numbered 001 to 216 without a delta spec\"\n    );\n}\n===\n//! Corpus golden tests: the archived documents and the live living specs.\n//!\n//! Both are corpus tests (rust-core \"Corpus tests\"): they read the archive and\n//! the living specs outside this crate, so they carry the corpus ignore, run\n//! under `scripts/verify-rust.sh`, and cargo-mutants leaves them out.\n//! `golden_cases.rs` is their fast counterpart.\n\npub mod golden_support;\n\n#[path = \"golden_corpus/corpus.rs\"]\nmod corpus;\n\nuse golden_support::assert_no_failures;\n\n/// Covers: rust-specs/archived-documents-match-typescript\n#[ignore = \"corpus test: reads the live archive\"]\n#[test]\nfn archived_documents_match_typescript() {\n    let failures = corpus::archive_failures(&corpus::repository_root());\n    assert_no_failures(&failures);\n}\n\n/// Covers: rust-specs/living-specs-read\n#[ignore = \"corpus test: reads the live living specs\"]\n#[test]\nfn living_specs_read() {\n    let failures = corpus::living_failures(&corpus::repository_root());\n    assert_no_failures(&failures);\n}\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"//! Corpus test: replaying this repository's archive gives its living specs.\n//!\n//! It reads the live archive, living specs and event files, so it is a corpus\n//! test (rust-core \"Corpus tests\"): each test carries the corpus ignore, runs\n//! under `scripts/verify-rust.sh`, and cargo-mutants leaves it out.\n\nuse osq_kernel_specs::merge_change;\nuse std::collections::BTreeSet;\nuse std::path::{Path, PathBuf};\n\n/// The repository root, three folders above this crate's manifest.\nfn repository_root() -> PathBuf {\n    Path::new(env!(\"CARGO_MANIFEST_DIR\"))\n        .ancestors()\n        .nth(3)\n        .expect(\"the repository root is three folders above crates/kernel/specs\")\n        .to_path_buf()\n}\n\n/// The capabilities that predate the merge's Purpose rule and keep one blank\n/// line after `## Purpose`.\nfn purpose_blank_line_capabilities() -> [&'static str; 6] {\n    [\n        \"cli-foundation\",\n        \"metrics-and-reporting\",\n        \"spec-lint-and-approve\",\n        \"status-inspection\",\n        \"watcher-and-harness\",\n        \"web-inspection\",\n    ]\n}\n\n/// The last `archived` timestamp of one change folder, when it recorded one.\nfn last_archived_timestamp(change: &Path) -> Option<String> {\n    let text = std::fs::read_to_string(change.join(\".run/events/change.jsonl\")).ok()?;\n    let mut last = None;\n    for line in text.lines() {\n        if line.trim().is_empty() {\n            continue;\n        }\n        let Ok(value) = serde_json::from_str::<serde_json::Value>(line) else {\n            continue;\n        };\n        if value.get(\"type\").and_then(|kind| kind.as_str()) != Some(\"archived\") {\n            continue;\n        }\n        if let Some(stamp) = value.get(\"timestamp\").and_then(|stamp| stamp.as_str()) {\n            last = Some(stamp.to_string());\n        }\n    }\n    last\n}\n\n/// The folders directly under `dir` whose names pass `keep`, in byte order.\nfn folders_in(dir: &Path, keep: impl Fn(&Path) -> bool) -> Vec<PathBuf> {\n    let Ok(entries) = std::fs::read_dir(dir) else {\n        return Vec::new();\n    };\n    let mut folders: Vec<PathBuf> = entries\n        .flatten()\n===\n//! Corpus tests: this repository's living specs and archived delta specs validate.\n//!\n//! Both read documents outside this crate, so they are corpus tests (rust-core\n//! \"Corpus tests\"): they carry the corpus ignore, run under\n//! `scripts/verify-rust.sh`, and cargo-mutants leaves them out.\n\nuse osq_kernel_specs::{SpecFinding, validate_delta, validate_living_specs};\nuse std::path::{Path, PathBuf};\n\n/// The repository root, three folders above this crate's manifest.\nfn repository_root() -> PathBuf {\n    Path::new(env!(\"CARGO_MANIFEST_DIR\"))\n        .ancestors()\n        .nth(3)\n        .expect(\"the repository root is three folders above crates/kernel/specs\")\n        .to_path_buf()\n}\n\n/// The change number a folder name leads with, if it leads with digits.\nfn leading_number(name: &str) -> Option<u32> {\n    let digits: String = name.chars().take_while(char::is_ascii_digit).collect();\n    digits.parse().ok()\n}\n\n/// One finding as its file, line, code and message.\nfn describe(finding: &SpecFinding) -> String {\n    format!(\n        \"{}:{}: {}: {}\",\n        finding.file,\n        finding.line,\n        finding.code.as_str(),\n        finding.message\n    )\n}\n\n/// Every finding as a line, joined, so a failure prints all of them.\nfn describe_all(findings: &[SpecFinding]) -> String {\n    findings.iter().map(describe).collect::<Vec<_>>().join(\"\\n\")\n}\n\n/// A path under `root` written repository-relative.\nfn relative(root: &Path, path: &Path) -> String {\n    path.strip_prefix(root)\n        .unwrap_or(path)\n        .display()\n        .to_string()\n}\n\n/// Covers: rust-specs/living-specs-validate\n#[ignore = \"corpus test: reads the live specs and archive\"]\n#[test]\nfn living_specs_validate() {\n    let specs = repository_root().join(\"openspec/specs\");\n    let findings = validate_living_specs(&specs).expect(\"this repository's living specs\");\n    assert!(\n        findings.is_empty(),\n        \"living spec findings:\\n{}\",\n        describe_all(&findings)\n    );\n}\n\n/// The archived change folders numbered 001 to 216, by number.\nfn archived_changes(root: &Path) -> Vec<(u32, PathBuf)> {\n    let archive = root.join(\"openspec/changes/archive\");\n    let Ok(entries) = std::fs::read_dir(&archive) else {\n        return Vec::new();\n    };\n    let mut changes: Vec<(u32, PathBuf)> = entries\n        .flatten()\n        .filter_map(|entry| {\n            let number = leading_number(&entry.file_name().to_string_lossy())?;\n            (1..=216).contains(&number).then(|| (number, entry.path()))\n        })\n        .collect();\n    changes.sort_by_key(|(number, _)| *number);\n    changes\n}\n\n/// The `specs/<capability>/spec.md` paths of one archived change.\nfn delta_paths(change: &Path) -> Vec<PathBuf> {\n    let Ok(entries) = std::fs::read_dir(change.join(\"specs\")) else {\n        return Vec::new();\n    };\n    let mut paths: Vec<PathBuf> = entries\n        .flatten()\n        .map(|entry| entry.path().join(\"spec.md\"))\n        .filter(|path| path.is_file())\n        .collect();\n    paths.sort();\n    paths\n}\n\n/// The change numbers the corpus expects to hold no delta spec.\nfn expected_without_delta() -> Vec<u32> {\n    let mut numbers: Vec<u32> = (1..=15).collect();\n    numbers.push(18);\n    numbers.push(19);\n    numbers\n}\n\n/// Covers: rust-specs/archived-deltas-validate\n#[ignore = \"corpus test: reads the live specs and archive\"]\n#[test]\nfn archived_deltas_validate() {\n    let root = repository_root();\n    let mut findings = Vec::new();\n    let mut without = Vec::new();\n    for (number, change) in archived_changes(&root) {\n        let deltas = delta_paths(&change);\n        if deltas.is_empty() {\n            without.push(number);\n            continue;\n        }\n        for path in deltas {\n            let file = relative(&root, &path);\n            let text = std::fs::read_to_string(&path).expect(\"a delta spec reads\");\n            findings.extend(validate_delta(&file, &text));\n        }\n    }\n    assert!(\n        findings.is_empty(),\n        \"archived delta findings:\\n{}\",\n        describe_all(&findings)\n    );\n    assert_eq!(\n        expected_without_delta(),\n        without,\n        \"archived changes numbered 001 to 216 without a delta spec\"\n    );\n}\n===\n//! Corpus golden tests: the archived documents and the live living specs.\n//!\n//! Both are corpus tests (rust-core \"Corpus tests\"): they read the archive and\n//! the living specs outside this crate, so they carry the corpus ignore, run\n//! under `scripts/verify-rust.sh`, and cargo-mutants leaves them out.\n//! `golden_cases.rs` is their fast counterpart.\n\npub mod golden_support;\n\n#[path = \"golden_corpus/corpus.rs\"]\nmod corpus;\n\nuse golden_support::assert_no_failures;\n\n/// Covers: rust-specs/archived-documents-match-typescript\n#[ignore = \"corpus test: reads the live archive\"]\n#[test]\nfn archived_documents_match_typescript() {\n    let failures = corpus::archive_failures(&corpus::repository_root());\n    assert_no_failures(&failures);\n}\n\n/// Covers: rust-specs/living-specs-read\n#[ignore = \"corpus test: reads the live living specs\"]\n#[test]\nfn living_specs_read() {\n    let failures = corpus::living_failures(&corpus::repository_root());\n    assert_no_failures(&failures);\n}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cat crates/kernel/specs/tests/replay_corpus.rs | head -60 && echo === && cat crates/kernel/specs/tests/validate_corpus.rs && echo === && head -60 crates/kernel/specs/tests/golden_corpus.rs\"}"},"time":{"start":1792394587948,"end":1792394588000}}}}
