e\"), PathBuf::as_path);\n    let (cli_specs, rust_specs) = (\n        openspec.root().join(\"openspec/specs\"),\n        rust.root().join(\"openspec/specs\"),\n    );\n    match expect {\n        \"identical\" => assert_identical(&cli, &openspec, &rust_specs, &changes),\n        \"both-refuse\" => assert_both_refuse(&cli, first, &cli_specs, &rust_specs, &case),\n        \"osq-refuses\" => assert_osq_refuses(&cli, first, &cli_specs, &rust_specs, &case),\n        other => panic!(\"case {name} has unknown expect `{other}`\"),\n    }\n}\n\n/// Reads one file, naming it when that fails.\nfn read(path: &Path) -> String {\n    std::fs::read_to_string(path)\n        .unwrap_or_else(|error| panic!(\"reading {}: {error}\", path.display()))\n}\n\n/// Builds one temporary project with the scaffold, the case's specs and changes.\nfn scaffold(name: &str, case: &Path) -> Project {\n    let project = Project::prepare(name, &repository_root()).expect(\"the project writes\");\n    let specs = case.join(\"specs\");\n    project\n        .set_specs(specs.is_dir().then_some(specs.as_path()))\n        .expect(\"the case specs copy\");\n    copy_tree(&case.join(\"changes\"), &project.root().join(\"openspec/changes\"))\n        .expect(\"the case changes copy\");\n    project\n}\n\n/// Runs the CLI, asserting it exits zero.\nfn run_ok(cli: &OpenSpecCli, args: &[&str], cwd: &Path) {\n    let output = cli.run(args, cwd);\n    assert!(\n        output.status.success(),\n        \"{}: {} failed:\\n{}\",\n        cli.path().display(),\n        args.join(\" \"),\n        text_of(&output)\n    );\n}\n\n/// A case both tools accept: each change validates and archives in the CLI\n/// project, the Rust merge applies each change, and the specs trees match.\nfn assert_identical(cli: &OpenSpecCli, openspec: &Project, rust_specs: &Path, changes: &[PathBuf]) {\n    for change in changes {\n        let name = name_of(change);\n        let args = [\n            \"validate\",\n            &name,\n            \"--type\",\n            \"change\",\n            \"--strict\",\n            \"--json\",\n            \"--no-interactive\",\n        ];\n        run_ok(cli, &args, openspec.root());\n    }\n    for change in changes {\n        let name = name_of(change);\n        run_ok(cli, &[\"archive\", &name, \"--yes\", \"--json\"], openspec.root());\n        merge_into(change, rust_specs);\n    }\n    assert_trees_equal(&openspec.root().join(\"openspec/specs\"), rust_specs, \"the specs trees\");\n}\n\n/// A case both tools refuse: the CLI reports `archive_spec_update_failed`, the\n/// Rust merge refuses, and neither tree changes.\nfn assert_both_refuse(\n    cli: &OpenSpecCli,\n    first: &Path,\n    cli_specs: &Path,\n    rust_specs: &Path,\n    case: &Path,\n) {\n    let name = name_of(first);\n    let archive = cli.run(&[\"archive\", &name, \"--yes\", \"--json\"], cli_specs);\n    assert!(\n        !archive.status.success(),\n        \"archive {name} unexpectedly succeeded:\\n{}\",\n        text_of(&archive)\n    );\n    let value: Value = serde_json::from_slice(&archive.stdout)\n        .unwrap_or_else(|error| panic!(\"archive {name} printed no JSON: {error}\"));\n    let refused = value\n        .get(\"status\")\n        .and_then(Value::as_array)\n        .is_some_and(|entries| {\n            entries.iter().any(|entry| {\n                entry.get(\"code\").and_then(Value::as_str) == Some(\"archive_spec_update_failed\")\n            })\n        });\n    assert!(refused, \"archive {name} reported no archive_spec_update_failed\");\n    match merge_change(first, rust_specs) {\n        Err(MergeChangeError::Merge { .. }) => {}\n        other => panic!(\"{}: the Rust merge should refuse, got {other:?}\", first.display()),\n    }\n    let case_specs = case.join(\"specs\");\n    assert_trees_equal(cli_specs, &case_specs, \"the OpenSpec tree\");\n    assert_trees_equal(rust_specs, &case_specs, \"the Rust tree\");\n}\n\n/// A case the Rust merge refuses and the CLI accepts: the refusal names the\n/// expected rename form, and no living spec holds a rename target.\nfn assert_osq_refuses(\n    cli: &OpenSpecCli,\n    first: &Path,\n    cli_specs: &Path,\n    rust_specs: &Path,\n    case: &Path,\n) {\n    let message = match merge_change(first, rust_specs) {\n        Err(MergeChangeError::Merge { error, .. }) => error.to_string(),\n        other => panic!(\"{}: expected a merge refusal, got {other:?}\", first.display()),\n    };\n    assert!(\n        message.contains(\"### Requirement:\"),\n        \"{}: the refusal must name the expected form: {message}\",\n        first.display()\n    );\n    let name = name_of(first);\n    run_ok(cli, &[\"archive\", &name, \"--yes\", \"--json\"], cli_specs);\n    let living = tree(cli_specs);\n    for target in rename_targets(&case.join(\"changes\")) {\n        let header = format!(\"### Requirement: {target}\");\n        assert!(\n            !living.values().any(|text| text.contains(&header)),\n            \"the case applied a rename OpenSpec should skip: {target}\"\n        );\n    }\n}\n\n/// Merges one change into `specs`, writing or removing each merged spec.\nfn merge_into(change: &Path, specs: &Path) {\n    let merged = merge_change(change, specs)\n        .unwrap_or_else(|error| panic!(\"{}: the Rust merge refuses: {error}\", change.display()));\n    for spec in merged {\n        let folder = specs.join(&spec.capability);\n        match &spec.text {\n            Some(text) => {\n                std::fs::create_dir_all(&folder).expect(\"the capability folder\");\n                std::fs::write(folder.join(\"spec.md\"), text).expect(\"the merged spec\");\n            }\n            None => {\n                let _ = std::fs::remove_dir_all(&folder);\n            }\n        }\n    }\n}\n\n/// Every file under `root`, or none when the folder does not exist.\nfn tree(root: &Path) -> BTreeMap<String, String> {\n    if !root.is_dir() {\n        return BTreeMap::new();\n    }\n    read_tree(root).unwrap_or_else(|error| panic!(\"reading {}: {error}\", root.display()))\n}\n\n/// Asserts two trees hold the same paths with the same bytes.\nfn assert_trees_equal(left: &Path, right: &Path, label: &str) {\n    let (left, right) = (tree(left), tree(right));\n    assert_eq!(\n        left.keys().collect::<Vec<_>>(),\n        right.keys().collect::<Vec<_>>(),\n        \"{label}: different paths\"\n    );\n    for (path, text) in &left {\n        assert_eq!(Some(text), right.get(path), \"{label}: {path}\");\n    }\n}\n\n/// The requirement names the case's delta specs give a `TO:` line.\nfn rename_targets(changes: &Path) -> Vec<String> {\n    let mut targets = Vec::new();\n    for change in folders(changes) {\n        for capability in folders(&change.join(\"specs\")) {\n            for line in read(&capability.join(\"spec.md\")).lines() {\n                let rest = line.trim_start().trim_start_matches(['-', '*', '+']).trim_start();\n                if !rest.get(..3).is_some_and(|head| head.eq_ignore_ascii_case(\"TO:\")) {\n                    continue;\n                }\n                let mut name = rest[3..].trim().trim_matches('`').trim();\n                if let Some(head) = name\n                    .get(..16)\n                    .filter(|head| head.eq_ignore_ascii_case(\"### Requirement:\"))\n                {\n                    name = name[head.len()..].trim();\n                }\n                if !name.is_empty() {\n                    targets.push(name.to_string());\n                }\n            }\n        }\n    }\n    targets\n}\n\nmacro_rules! case_tests {\n    ($($fn_name:ident => $case:literal),* $(,)?) => {\n        /// The differential case names, in byte order.\n        const CASE_NAMES: &[&str] = &[$($case),*];\n\n        $(\n            /// Covers: rust-specs/archive-cases-match-openspec\n            #[ignore = \"corpus test: runs the OpenSpec CLI on the differential cases\"]\n            #[test]\n            fn $fn_name() {\n                run_case($case);\n            }\n        )*\n    };\n}\n\ncase_tests! {\n    added => \"added\",\n    bare_rename => \"bare-rename\",\n    dropped_scenario => \"dropped-scenario\",\n    duplicate_added => \"duplicate-added\",\n    given_and => \"given-and\",\n    modified => \"modified\",\n    new_capability => \"new-capability\",\n    removed => \"removed\",\n    renamed => \"renamed\",\n    second_change => \"second-change\",\n}\n\n/// Covers: rust-specs/archive-cases-match-openspec\n#[ignore = \"corpus test: runs the OpenSpec CLI on the differential cases\"]\n#[test]\nfn cases_are_exactly_the_fixture_folders() {\n    let actual: Vec<String> = folders(&repository_root().join(FIXTURES))\n        .iter()\n        .map(|path| name_of(path))\n        .collect();\n    let expected: Vec<String> = CASE_NAMES.iter().map(|name| (*name).to_string()).collect();\n    assert_eq!(expected, actual, \"the differential case folders\");\n}\n","path":"/home/mathias/.osq/worktrees/osq/219-rust-specs-parity/crates/kernel/specs/tests/openspec_archive_parity_corpus.rs"},"output":"Wrote file successfully: crates/kernel/specs/tests/openspec_archive_parity_corpus.rs","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Wrote file successfully: crates/kernel/specs/tests/openspec_archive_parity_corpus.rs"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"content\": \"//! Corpus test: the Rust merge and `OpenSpec` archive agree on every\\n//! differential case of `tests/fixtures/openspec-diff/`.\\n//!\\n//! It runs the `OpenSpec` CLI over the repository's fixtures, so it is a corpus\\n//! test (rust-core \\\"Corpus tests\\\"): each test carries the corpus ignore, and\\n//! only a build with the `parity` feature compiles it.\\n\\npub mod openspec_parity_support;\\n\\nuse openspec_parity_support::cli::{OpenSpecCli, text_of};\\nuse openspec_parity_support::project::Project;\\nuse openspec_parity_support::trees::{copy_tree, folders, name_of, read_tree, repository_root};\\nuse osq_kernel_specs::{MergeChangeError, merge_change};\\nuse serde_json::Value;\\nuse std::collections::BTreeMap;\\nuse std::path::{Path, PathBuf};\\n\\n/// The differential fixtures, relative to the repository root.\\nconst FIXTURES: &str = \\\"tests/fixtures/openspec-diff\\\";\\n\\n/// Runs one differential case: builds both projects, then checks its expectation.\\nfn run_case(name: &str) {\\n    let case = repository_root().join(FIXTURES).join(name);\\n    let file = case.join(\\\"case.json\\\");\\n    let value: Value = serde_json::from_str(&read(&file)).expect(\\\"the case parses\\\");\\n    let expect = value.get(\\\"expect\\\").and_then(Value::as_str).expect(\\\"an expect\\\");\\n    let repo = repository_root();\\n    let cli = OpenSpecCli::locate(&repo);\\n    let openspec = scaffold(&format!(\\\"archive-{name}-openspec\\\"), &case);\\n    let rust = scaffold(&format!(\\\"archive-{name}-rust\\\"), &case);\\n    let changes = folders(&rust.root().join(\\\"openspec/changes\\\"));\\n    let first = changes\\n        .first()\\n        .map_or_else(|| panic!(\\\"case {name} has no change\\\"), PathBuf::as_path);\\n    let (cli_specs, rust_specs) = (\\n        openspec.root().join(\\\"openspec/specs\\\"),\\n        rust.root().join(\\\"openspec/specs\\\"),\\n    );\\n    match expect {\\n        \\\"identical\\\" => assert_identical(&cli, &openspec, &rust_specs, &changes),\\n        \\\"both-refuse\\\" => assert_both_refuse(&cli, first, &cli_specs, &rust_specs, &case),\\n        \\\"osq-refuses\\\" => assert_osq_refuses(&cli, first, &cli_specs, &rust_specs, &case),\\n        other => panic!(\\\"case {name} has unknown expect `{other}`\\\"),\\n    }\\n}\\n\\n/// Reads one file, naming it when that fails.\\nfn read(path: &Path) -> String {\\n    std::fs::read_to_string(path)\\n        .unwrap_or_else(|error| panic!(\\\"reading {}: {error}\\\", path.display()))\\n}\\n\\n/// Builds one temporary project with the scaffold, the case's specs and changes.\\nfn scaffold(name: &str, case: &Path) -> Project {\\n    let project = Project::prepare(name, &repository_root()).expect(\\\"the project writes\\\");\\n    let specs = case.join(\\\"specs\\\");\\n    project\\n        .set_specs(specs.is_dir().then_some(specs.as_path()))\\n        .expect(\\\"the case specs copy\\\");\\n    copy_tree(&case.join(\\\"changes\\\"), &project.root().join(\\\"openspec/changes\\\"))\\n        .expect(\\\"the case changes copy\\\");\\n    project\\n}\\n\\n/// Runs the CLI, asserting it exits zero.\\nfn run_ok(cli: &OpenSpecCli, args: &[&str], cwd: &Path) {\\n    let output = cli.run(args, cwd);\\n    assert!(\\n        output.status.success(),\\n        \\\"{}: {} failed:\\\\n{}\\\",\\n        cli.path().display(),\\n        args.join(\\\" \\\"),\\n        text_of(&output)\\n    );\\n}\\n\\n/// A case both tools accept: each change validates and archives in the CLI\\n/// project, the Rust merge applies each change, and the specs trees match.\\nfn assert_identical(cli: &OpenSpecCli, openspec: &Project, rust_specs: &Path, changes: &[PathBuf]) {\\n    for change in changes {\\n        let name = name_of(change);\\n        let args = [\\n            \\\"validate\\\",\\n            &name,\\n            \\\"--type\\\",\\n            \\\"change\\\",\\n            \\\"--strict\\\",\\n            \\\"--json\\\",\\n            \\\"--no-interactive\\\",\\n        ];\\n        run_ok(cli, &args, openspec.root());\\n    }\\n    for change in changes {\\n        let name = name_of(change);\\n        run_ok(cli, &[\\\"archive\\\", &name, \\\"--yes\\\", \\\"--json\\\"], openspec.root());\\n        merge_into(change, rust_specs);\\n    }\\n    assert_trees_equal(&openspec.root().join(\\\"openspec/specs\\\"), rust_specs, \\\"the specs trees\\\");\\n}\\n\\n/// A case both tools refuse: the CLI reports `archive_spec_update_failed`, the\\n/// Rust merge refuses, and neither tree changes.\\nfn assert_both_refuse(\\n    cli: &OpenSpecCli,\\n    first: &Path,\\n    cli_specs: &Path,\\n    rust_specs: &Path,\\n    case: &Path,\\n) {\\n    let name = name_of(first);\\n    let archive = cli.run(&[\\\"archive\\\", &name, \\\"--yes\\\", \\\"--json\\\"], cli_specs);\\n    assert!(\\n        !archive.status.success(),\\n        \\\"archive {name} unexpectedly succeeded:\\\\n{}\\\",\\n        text_of(&archive)\\n    );\\n    let value: Value = serde_json::from_slice(&archive.stdout)\\n        .unwrap_or_else(|error| panic!(\\\"archive {name} printed no JSON: {error}\\\"));\\n    let refused = value\\n        .get(\\\"status\\\")\\n        .and_then(Value::as_array)\\n        .is_some_and(|entries| {\\n            entries.iter().any(|entry| {\\n                entry.get(\\\"code\\\").and_then(Value::as_str) == Some(\\\"archive_spec_update_failed\\\")\\n            })\\n        });\\n    assert!(refused, \\\"archive {name} reported no archive_spec_update_failed\\\");\\n    match merge_change(first, rust_specs) {\\n        Err(MergeChangeError::Merge { .. }) => {}\\n        other => panic!(\\\"{}: the Rust merge should refuse, got {other:?}\\\", first.display()),\\n    }\\n    let case_specs = case.join(\\\"specs\\\");\\n    assert_trees_equal(cli_specs, &case_specs, \\\"the OpenSpec tree\\\");\\n    assert_trees_equal(rust_specs, &case_specs, \\\"the Rust tree\\\");\\n}\\n\\n/// A case the Rust merge refuses and the CLI accepts: the refusal names the\\n/// expected rename form, and no living spec holds a rename target.\\nfn assert_osq_refuses(\\n    cli: &OpenSpecCli,\\n    first: &Path,\\n    cli_specs: &Path,\\n    rust_specs: &Path,\\n    case: &Path,\\n) {\\n    let message = match merge_change(first, rust_specs) {\\n        Err(MergeChangeError::Merge { error, .. }) => error.to_string(),\\n        other => panic!(\\\"{}: expected a merge refusal, got {other:?}\\\", first.display()),\\n    };\\n    assert!(\\n        message.contains(\\\"### Requirement:\\\"),\\n        \\\"{}: the refusal must name the expected form: {message}\\\",\\n        first.display()\\n    );\\n    let name = name_of(first);\\n    run_ok(cli, &[\\\"archive\\\", &name, \\\"--yes\\\", \\\"--json\\\"], cli_specs);\\n    let living = tree(cli_specs);\\n    for target in rename_targets(&case.join(\\\"changes\\\")) {\\n        let header = format!(\\\"### Requirement: {target}\\\");\\n        assert!(\\n            !living.values().any(|text| text.contains(&header)),\\n            \\\"the case applied a rename OpenSpec should skip: {target}\\\"\\n        );\\n    }\\n}\\n\\n/// Merges one change into `specs`, writing or removing each merged spec.\\nfn merge_into(change: &Path, specs: &Path) {\\n    let merged = merge_change(change, specs)\\n        .unwrap_or_else(|error| panic!(\\\"{}: the Rust merge refuses: {error}\\\", change.display()));\\n    for spec in merged {\\n        let folder = specs.join(&spec.capability);\\n        match &spec.text {\\n            Some(text) => {\\n                std::fs::create_dir_all(&folder).expect(\\\"the capability folder\\\");\\n                std::fs::write(folder.join(\\\"spec.md\\\"), text).expect(\\\"the merged spec\\\");\\n            }\\n            None => {\\n                let _ = std::fs::remove_dir_all(&folder);\\n            }\\n        }\\n    }\\n}\\n\\n/// Every file under `root`, or none when the folder does not exist.\\nfn tree(root: &Path) -> BTreeMap<String, String> {\\n    if !root.is_dir() {\\n        return BTreeMap::new();\\n    }\\n    read_tree(root).unwrap_or_else(|error| panic!(\\\"reading {}: {error}\\\", root.display()))\\n}\\n\\n/// Asserts two trees hold the same paths with the same bytes.\\nfn assert_trees_equal(left: &Path, right: &Path, label: &str) {\\n    let (left, right) = (tree(left), tree(right));\\n    assert_eq!(\\n        left.keys().collect::<Vec<_>>(),\\n        right.keys().collect::<Vec<_>>(),\\n        \\\"{label}: different paths\\\"\\n    );\\n    for (path, text) in &left {\\n        assert_eq