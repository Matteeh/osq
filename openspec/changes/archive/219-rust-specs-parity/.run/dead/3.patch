       let relative = path\n                    .strip_prefix(root)\n                    .expect(\"a path under the root\")\n                    .to_string_lossy()\n                    .replace('\\\\', \"/\");\n                files.insert(relative, std::fs::read(&path).expect(\"a read file\"));\n            }\n        }\n    }\n    files\n}\n\n/// The message of a merge refusal the case expects.\nfn refusal_message(error: &MergeChangeError) -> String {\n    match error {\n        MergeChangeError::Merge { error, .. } => error.to_string(),\n        MergeChangeError::Read(error) => panic!(\"unexpected read error: {error}\"),\n    }\n}\n\n/// Covers: rust-specs/differential-cases\n#[test]\nfn differential_cases() {\n    let rows: &[(&str, bool)] = &[\n        (\"added\", true),\n        (\"given-and\", true),\n        (\"modified\", true),\n        (\"new-capability\", true),\n        (\"removed\", true),\n        (\"renamed\", true),\n        (\"second-change\", true),\n        (\"bare-rename\", false),\n        (\"dropped-scenario\", false),\n        (\"duplicate-added\", false),\n    ];\n    for (case, identical) in rows {\n        let work = scratch(case);\n        let _ = std::fs::remove_dir_all(&work);\n        copy_tree(&fixtures().join(case), &work);\n\n        let specs_root = work.join(\"work\");\n        if work.join(\"specs\").is_dir() {\n            copy_tree(&work.join(\"specs\"), &specs_root);\n        }\n        let mut refusal = None;\n        for change in folders(&work.join(\"changes\")) {\n            match merge_change(&change, &specs_root) {\n                Ok(specs) => apply(&specs_root, &specs),\n                Err(error) => {\n                    refusal = Some(refusal_message(&error));\n                    break;\n                }\n            }\n        }\n        if *identical {\n            assert_eq!(None, refusal, \"case {case} refused\");\n            let expected = tree(&work.join(\"expected\"));\n            let actual = tree(&specs_root);\n            assert_eq!(expected, actual, \"the tree of case {case}\");\n        } else {\n            let expected = read_text(&work.join(\"error.txt\"));\n            assert_eq!(Some(expected), refusal, \"the refusal of case {case}\");\n        }\n    }\n}\n===\n--- tests/fixtures/openspec-diff/added/case.json\n{\n  \"expect\": \"identical\"\n}\n--- tests/fixtures/openspec-diff/bare-rename/case.json\n{\n  \"expect\": \"osq-refuses\"\n}\n--- tests/fixtures/openspec-diff/dropped-scenario/case.json\n{\n  \"expect\": \"both-refuse\"\n}\n--- tests/fixtures/openspec-diff/duplicate-added/case.json\n{\n  \"expect\": \"both-refuse\"\n}\n--- tests/fixtures/openspec-diff/given-and/case.json\n{\n  \"expect\": \"identical\"\n}\n--- tests/fixtures/openspec-diff/modified/case.json\n{\n  \"expect\": \"identical\"\n}\n--- tests/fixtures/openspec-diff/new-capability/case.json\n{\n  \"expect\": \"identical\"\n}\n--- tests/fixtures/openspec-diff/removed/case.json\n{\n  \"expect\": \"identical\"\n}\n--- tests/fixtures/openspec-diff/renamed/case.json\n{\n  \"expect\": \"identical\"\n}\n--- tests/fixtures/openspec-diff/second-change/case.json\n{\n  \"expect\": \"identical\"\n}\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cat crates/kernel/specs/tests/merging_changes_differential.rs && echo === && for c in tests/fixtures/openspec-diff/*/case.json; do echo \\\"--- $c\\\"; cat \\\"$c\\\"; done\"}"},"time":{"start":1792394584541,"end":1792394584571}}}}
