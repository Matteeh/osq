-{"type":"tool_use","timestamp":1792395745259,"sessionID":"ses_eacf54832ffeFAS4YOYdKea9Bo","part":{"partID":"prt_1531c8e22001xB1NW53nSAs581","sessionID":"ses_eacf54832ffeFAS4YOYdKea9Bo","messageID":"msg_1531c695d001PtO9aYvsp9odt7","type":"tool","id":"call_00_hjcplatxv4s1r3ttz7pznfrm","tool":"write","state":{"status":"completed","input":{"content":"//! Corpus test: the Rust merge and `OpenSpec` archive agree on every case of\n//! `tests/fixtures/openspec-diff/`; only the `parity` feature builds it.\n\npub mod openspec_parity_support;\n\nuse openspec_parity_support::cli::{OpenSpecCli, text_of};\nuse openspec_parity_support::project::Project;\nuse openspec_parity_support::trees::{copy_tree, folders, name_of, read_tree, repository_root};\nuse osq_kernel_specs::{MergeChangeError, merge_change};\nuse serde_json::Value;\nuse std::collections::BTreeMap;\nuse std::path::{Path, PathBuf};\n\n/// The differential fixtures, relative to the repository root.\nconst FIXTURES: &str = \"tests/fixtures/openspec-diff\";\n\n/// The status code `OpenSpec` reports when it cannot update the specs.\nconst FAILED: &str = \"archive_spec_update_failed\";\n\n/// Reads one file as text.\nfn read(path: &Path) -> String {\n    std::fs::read_to_string(path).unwrap_or_else(|e| panic!(\"reading {}: {e}\", path.display()))\n}\n\n/// Every file under `root` as its `/`-joined path and text; the fixtures are\n/// UTF-8 Markdown, so equal text is equal bytes.\nfn tree(root: &Path) -> BTreeMap<String, String> {\n    if !root.is_dir() {\n        return BTreeMap::new();\n    }\n    read_tree(root).expect(\"a tree reads\")\n}\n\n/// Builds a temporary project with the scaffold, the case's specs and changes.\nfn scaffold(name: &str, case: &Path) -> Project {\n    let project = Project::prepare(name, &repository_root()).expect(\"the project writes\");\n    let specs = case.join(\"specs\");\n    project\n        .set_specs(specs.is_dir().then_some(specs.as_path()))\n        .expect(\"the case specs copy\");\n    let changes = project.root().join(\"openspec/changes\");\n    copy_tree(&case.join(\"changes\"), &changes).expect(\"the case changes copy\");\n    project\n}\n\n/// Runs the CLI, asserting it exits zero.\nfn run_ok(cli: &OpenSpecCli, args: &[&str], cwd: &Path) {\n    let output = cli.run(args, cwd);\n    assert!(\n        output.status.success(),\n        \"{}: {} failed:\\n{}\",\n        cli.path().display(),\n        args.join(\" \"),\n        text_of(&output)\n    );\n}\n\n/// Validates one change in a project.\nfn validate(cli: &OpenSpecCli, project: &Project, name: &str) {\n    let args = [\n        \"validate\",\n        name,\n        \"--type\",\n        \"change\",\n        \"--strict\",\n        \"--json\",\n        \"--no-interactive\",\n    ];\n    run_ok(cli, &args, project.root());\n}\n\n/// Merges one change into `specs`, writing or removing each merged spec.\nfn merge_into(change: &Path, specs: &Path) {\n    let merged = merge_change(change, specs)\n        .unwrap_or_else(|error| panic!(\"{}: the merge refuses: {error}\", change.display()));\n    for spec in merged {\n        let folder = specs.join(&spec.capability);\n        if let Some(text) = &spec.text {\n            std::fs::create_dir_all(&folder).expect(\"the capability folder\");\n            std::fs::write(folder.join(\"spec.md\"), text).expect(\"the merged spec\");\n        } else {\n            let _ = std::fs::remove_dir_all(&folder);\n        }\n    }\n}\n\n/// A case both tools accept: each change validates and archives in the CLI\n/// project, the Rust merge applies each change, and the specs trees match.\nfn assert_identical(cli: &OpenSpecCli, openspec: &Project, rust_specs: &Path, changes: &[PathBuf]) {\n    for change in changes {\n        validate(cli, openspec, &name_of(change));\n    }\n    for change in changes {\n        let name = name_of(change);\n        run_ok(cli, &[\"archive\", &name, \"--yes\", \"--json\"], openspec.root());\n        merge_into(change, rust_specs);\n    }\n    let cli_specs = openspec.root().join(\"openspec/specs\");\n    assert_eq!(tree(&cli_specs), tree(rust_specs), \"the two specs trees\");\n}\n\n/// A case both tools refuse: the CLI reports `archive_spec_update_failed`, the\n/// Rust merge refuses, and neither tree changes.\nfn assert_both_refuse(\n    cli: &OpenSpecCli,\n    project: &Project,\n    first: &Path,\n    rust_specs: &Path,\n    case: &Path,\n) {\n    let name = name_of(first);\n    let archive = cli.run(&[\"archive\", &name, \"--yes\", \"--json\"], project.root());\n    let value: Value = serde_json::from_slice(&archive.stdout).unwrap_or(Value::Null);\n    let status = value.get(\"status\").and_then(Value::as_array);\n    let refused = status.is_some_and(|entries| {\n        entries\n            .iter()\n            .any(|e| e.get(\"code\").and_then(Value::as_str) == Some(FAILED))\n    });\n    assert!(\n        !archive.status.success() && refused,\n        \"archive {name} did not report {FAILED}:\\n{}\",\n        text_of(&archive)\n    );\n    let refused = matches!(\n        merge_change(first, rust_specs),\n        Err(MergeChangeError::Merge { .. })\n    );\n    assert!(refused, \"{}: the merge should refuse\", first.display());\n    let cli_specs = project.root().join(\"openspec/specs\");\n    let case_specs = case.join(\"specs\");\n    assert_eq!(tree(&cli_specs), tree(&case_specs), \"the OpenSpec tree\");\n    assert_eq!(tree(rust_specs), tree(&case_specs), \"the Rust tree\");\n}\n\n/// A case the Rust merge refuses and the CLI accepts: the refusal names the\n/// expected rename form, and no living spec holds a rename target.\nfn assert_osq_refuses(\n    cli: &OpenSpecCli,\n    project: &Project,\n    first: &Path,\n    rust_specs: &Path,\n    case: &Path,\n) {\n    let Err(MergeChangeError::Merge { error, .. }) = merge_change(first, rust_specs) else {\n        panic!(\"{}: expected a merge refusal\", first.display());\n    };\n    assert!(\n        error.to_string().contains(\"### Requirement:\"),\n        \"{}: the refusal must name the expected form: {error}\",\n        first.display()\n    );\n    let name = name_of(first);\n    run_ok(cli, &[\"archive\", &name, \"--yes\", \"--json\"], project.root());\n    let living = tree(&project.root().join(\"openspec/specs\"));\n    for target in rename_targets(&case.join(\"changes\")) {\n        let header = format!(\"### Requirement: {target}\");\n        assert!(\n            !living.values().any(|text| text.contains(&header)),\n            \"the case applied a rename OpenSpec should skip: {target}\"\n        );\n    }\n}\n\n/// The requirement names the case's delta specs give a `TO:` line, as the\n/// TypeScript differential test reads them.\nfn rename_targets(changes: &Path) -> Vec<String> {\n    let mut targets = Vec::new();\n    for change in folders(changes) {\n        for capability in folders(&change.join(\"specs\")) {\n            targets.extend(read(&capability.join(\"spec.md\")).lines().filter_map(to_target));\n        }\n    }\n    targets\n}\n\n/// The requirement name a `TO:` line names, or none for any other line.\nfn to_target(line: &str) -> Option<String> {\n    let rest = line.trim_start().trim_start_matches(['-', '*', '+']);\n    let rest = rest.trim_start();\n    if !rest.get(..3)?.eq_ignore_ascii_case(\"TO:\") {\n        return None;\n    }\n    let name = rest[3..].trim().trim_matches('`').trim();\n    let head = name\n        .get(..16)\n        .filter(|head| head.eq_ignore_ascii_case(\"### Requirement:\"));\n    let name = head.map_or(name, |head| name[head.len()..].trim());\n    (!name.is_empty()).then(|| name.to_string())\n}\n\n/// Runs one differential case: builds both projects, then checks its expectation.\nfn run_case(name: &str) {\n    let case = repository_root().join(FIXTURES).join(name);\n    let value: Value = serde_json::from_str(&read(&case.join(\"case.json\"))).expect(\"the case\");\n    let expect = value.get(\"expect\").and_then(Value::as_str).expect(\"an expect\");\n    let cli = OpenSpecCli::locate(&repository_root());\n    let openspec = scaffold(&format!(\"archive-{name}-openspec\"), &case);\n    let rust = scaffold(&format!(\"archive-{name}-rust\"), &case);\n    let changes = folders(&rust.root().join(\"openspec/changes\"));\n    let first = changes\n        .first()\n        .map_or_else(|| panic!(\"case {name} has no change\"), PathBuf::as_path);\n    let rust_specs = rust.root().join(\"openspec/specs\");\n    match expect {\n        \"identical\" => assert_identical(&cli, &openspec, &rust_specs, &changes),\n        \"both-refuse\" => assert_both_refuse(&cli, &openspec, first, &rust_specs, &case),\n        \"osq-refuses\" => assert_osq_refuses(&cli, &openspec, first, &rust_specs, &case),\n        other => panic!(\"case {name} has unknown expect `{other}`\"),\n    }\n}\n\n/// Declares one corpus test per differential case, in byte order.\nmacro_rules! case_tests {\n    ($($fn_name:ident => $case:literal),* $(,)?) => {\n        /// The differential case names, in byte order.\n        const CASE_NAMES: &[&str] = &[$($case),*];\n\n        $(\n            /// Covers: rust-specs/archive-cases-match-openspec\n            #[ignore = \"corpus test: runs the OpenSpec CLI on the differential cases\"]\n            #[test]\n            fn $fn_name() { run_case($case); }\n        )*\n    };\n}\n\ncase_tests! {\n    added => \"added\",\n    bare_rename => \"bare-rename\",\n    dropped_scenario => \"dropped-scenario\",\n    duplicate_added => \"duplicate-added\",\n    given_and => \"given-and\",\n    modified => \"modified\",\n    new_capability => \"new-capability\",\n    removed => \"removed\",\n    renamed => \"renamed\",\n    second_change => \"second-change\",\n}\n\n/// Covers: rust-specs/archive-cases-match-openspec\n#[ignore = \"corpus test: runs the OpenSpec CLI on the differential cases\"]\n#[test]\nfn cases_are_exactly_the_fixture_folders() {\n    let actual: Vec<String> = folders(&repository_root().join(FIXTURES))\n        .iter()\n        .map(|path| name_of(path))\n        .collect();\n    let expected: Vec<String> = CASE_NAMES.iter().map(|name| (*name).to_string()).collect();\n    assert_eq!(expected, actual, \"the differential case folders\");\n}\n","path":"/home/mathias/.osq/worktrees/osq/219-rust-specs-parity/crates/kernel/specs/tests/openspec_archive_parity_corpus.rs"},"output":"Wrote file successfully: crates/kernel/specs/tests/openspec_archive_parity_corpus.rs","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Wrote file successfully: crates/kernel/specs/tests/openspec_archive_parity_corpus.rs"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"content\": \"//! Corpus test: the Rust merge and `OpenSpec` archive agree on every case of\\n//! `tests/fixtures/openspec-diff/`; only the `parity` feature builds it.\\n\\npub mod openspec_parity_support;\\n\\nuse openspec_parity_support::cli::{OpenSpecCli, text_of};\\nuse openspec_parity_support::project::Project;\\nuse openspec_parity_support::trees::{copy_tree, folders, name_of, read_tree, repository_root};\\nuse osq_kernel_specs::{MergeChangeError, merge_change};\\nuse serde_json::Value;\\nuse std::collections::BTreeMap;\\nuse std::path::{Path, PathBuf};\\n\\n/// The differential fixtures, relative to the repository root.\\nconst FIXTURES: &str = \\\"tests/fixtures/openspec-diff\\\";\\n\\n/// The status code `OpenSpec` reports when it cannot update the specs.\\nconst FAILED: &str = \\\"archive_spec_update_failed\\\";\\n\\n/// Reads one file as text.\\nfn read(path: &Path) -> String {\\n    std::fs::read_to_string(path).unwrap_or_else(|e| panic!(\\\"reading {}: {e}\\\", path.display()))\\n}\\n\\n/// Every file under `root` as its `/`-joined path and text; the fixtures are\\n/// UTF-8 Markdown, so equal text is equal bytes.\\nfn tree(root: &Path) -> BTreeMap<String, String> {\\n    if !root.is_dir() {\\n        return BTreeMap::new();\\n    }\\n    read_tree(root).expect(\\\"a tree reads\\\")\\n}\\n\\n/// Builds a temporary project with the scaffold, the case's specs and changes.\\nfn scaffold(name: &str, case: &Path) -> Project {\\n    let project = Project::prepare(name, &repository_root()).expect(\\\"the project writes\\\");\\n    let specs = case.join(\\\"specs\\\");\\n    project\\n        .set_specs(specs.is_dir().then_some(specs.as_path()))\\n        .expect(\\\"the case specs copy\\\");\\n    let changes = project.root().join(\\\"openspec/changes\\\");\\n    copy_tree(&case.join(\\\"changes\\\"), &changes).expect(\\\"the case changes copy\\\");\\n    project\\n}\\n\\n/// Runs the CLI, asserting it exits zero.\\nfn run_ok(cli: &OpenSpecCli, args: &[&str], cwd: &Path) {\\n    let output = cli.run(args, cwd);\\n    assert!(\\n        output.status.success(),\\n        \\\"{}: {} failed:\\\\n{}\\\",\\n        cli.path().display(),\\n        args.join(\\\" \\\"),\\n        text_of(&output)\\n    );\\n}\\n\\n/// Validates one change in a project.\\nfn validate(cli: &OpenSpecCli, project: &Project, name: &str) {\\n    let args = [\\n        \\\"validate\\\",\\n        name,\\n        \\\"--type\\\",\\n        \\\"change\\\",\\n        \\\"--strict\\\",\\n        \\\"--json\\\",\\n        \\\"--no-interactive\\\",\\n    ];\\n    run_ok(cli, &args, project.root());\\n}\\n\\n/// Merges one change into `specs`, writing or removing each merged spec.\\nfn merge_into(change: &Path, specs: &Path) {\\n    let merged = merge_change(change, specs)\\n        .unwrap_or_else(|error| panic!(\\\"{}: the merge refuses: {error}\\\", change.display()));\\n    for spec in merged {\\n        let folder = specs.join(&spec.capability);\\n        if let Some(text) = &spec.text {\\n            std::fs::create_dir_all(&folder).expect(\\\"the capability folder\\\");\\n            std::fs::write(folder.join(\\\"spec.md\\\"), text).expect(\\\"the merged spec\\\");\\n        } else {\\n            let _ = std::fs::remove_dir_all(&folder);\\n        }\\n    }\\n}\\n\\n/// A case both tools accept: each change validates and archives in the CLI\\n/// project, the Rust merge applies each change, and the specs trees match.\\nfn assert_identical(cli: &OpenSpecCli, openspec: &Project, rust_specs: &Path, changes: &[PathBuf]) {\\n    for change in changes {\\n        validate(cli, openspec, &name_of(change));\\n    }\\n    for change in changes {\\n        let name = name_of(change);\\n        run_ok(cli, &[\\\"archive\\\", &name, \\\"--yes\\\", \\\"--json\\\"], openspec.root());\\n        merge_into(change, rust_specs);\\n    }\\n    let cli_specs = openspec.root().join(\\\"openspec/specs\\\");\\n    assert_eq!(tree(&cli_specs), tree(rust_specs), \\\"the two specs trees\\\");\\n}\\n\\n/// A case both tools refuse: the CLI reports `archive_spec_update_failed`, the\\n/// Rust merge refuses, and neither tree changes.\\nfn assert_both_refuse(\\n    cli: &OpenSpecCli,\\n    project: &Project,\\n    first: &Path,\\n    rust_specs: &Path,\\n    case: &Path,\\n) {\\n    let name = name_of(first);\\n    let archive = cli.run(&[\\\"archive\\\", &name, \\\"--yes\\\", \\\"--json\\\"], project.root());\\n    let value: Value = serde_json::from_slice(&archive.stdout).unwrap_or(Value::Null);\\n    let status = value.get(\\\"status\\\").and_then(Value::as_array);\\n    let refused = status.is_some_and(|entries| {\\n        entries\\n            .iter()\\n            .any(|e| e.get(\\\"code\\\").and_then(Value::as_str) == Some(FAILED))\\n    });\\n    assert!(\\n        !archive.status.success() && refused,\\n        \\\"archive {name} did not report {FAILED}:\\\\n{}\\\",\\n        text_of(&archive)\\n    );\\n    let refused = matches!(\\n        merge_change(first, rust_specs),\\n        Err(MergeChangeError::Merge { .. })\\n    );\\n    assert!(refused, \\\"{}: the merge should refuse\\\", first.display());\\n    let cli_specs = project.root().join(\\\"openspec/specs\\\");\\n    let case_specs = case.join(\\\"specs\\\");\\n    assert_eq!(tree(&cli_specs), tree(&case_specs), \\\"the OpenSpec tree\\\");\\n    assert_eq!(tree(rust_specs), tree(&case_specs), \\\"the Rust tree\\\");\\n}\\n\\n/// A case the Rust merge refuses and the CLI accepts: the refusal names the\\n/// expected rename form, and no living spec holds a rename target.\\nfn assert_osq_refuses(\\n    cli: &OpenSpecCli,\\n    project: &Project,\\n    first: &Path,\\n    rust_specs: &Path,\\n    case: &Path,\\n) {\\n    let Err(MergeChangeError::Merge { error, .. }) = merge_change(first, rust_specs) else {\\n        panic!(\\\"{}: expected a merge refusal\\\", first.display());\\n    };\\n    assert!(\\n        error.to_string().contains(\\\"### Requirement:\\\"),\\n        \\\"{}: the refusal must name the expected form: {error}\\\",\\n        first.display()\\n    );\\n    let name = name_of(first);\\n    run_ok(cli, &[\\\"archive\\\", &name, \\\"--yes\\\", \\\"--json\\\"], project.root());\\n    let living = tree(&project.root().join(\\\"openspec/specs\\\"));\\n    for target in rename_targets(&case.join(\\\"changes\\\")) {\\n        let header = format!(\\\"### Requirement: {target}\\\");\\n        assert!(\\n            !living.values().any(|text| text.contains(&header)),\\n            \\\"the case applied a rename OpenSpec should skip: {target}\\\"\\n        );\\n    }\\n}\\n\\n/// The requirement names the case's delta specs give a `TO:` line, as the\\n/// TypeScript differential test reads them.\\nfn rename_targets(changes: &Path) -> Vec<String> {\\n    let mut targets = Vec::new();\\n    for change in folders(changes) {\\n        for capability in folders(&change.join(\\\"specs\\\")) {\\n            targets.extend(read(&capability.join(\\\"spec.md\\\")).lines().filter_map(to_target));\\n        }\\n    }\\n    targets\\n}\\n\\n/// The requirement name a `TO:` line names, or none for any other line.\\nfn to_target(line: &str) -> Option<String> {\\n    let rest = line.trim_start().trim_start_matches(['-', '*', '+']);\\n    let rest = rest.trim_start();\\n    if !rest.get(..3)?.eq_ignore_ascii_case(\\\"TO:\\\") {\\n        return None;\\n    }\\n    let name = rest[3..].trim().trim_matches('`').trim();\\n    let head = name\\n        .get(..16)\\n        .filter(|head| head.eq_ignore_ascii_case(\\\"### Requirement:\\\"));\\n    let name = head.map_or(name, |head| name[head.len()..].trim());\\n    (!name.is_empty()).then(|| name.to_string())\\n}\\n\\n/// Runs one differential case: builds both projects, then checks its expectation.\\nfn run_case(name: &str) {\\n    let case = repository_root().join(FIXTURES).join(name);\\n    let value: Value = serde_json::from_str(&read(&case.join(\\\"case.json\\\"))).expect(\\\"the case\\\");\\n    let expect = value.get(\\\"expect\\\").and_then(Value::as_str).expect(\\\"an expect\\\");\\n    let cli = OpenSpecCli::locate(&repository_root());\\n    let openspec = scaffold(&format!(\\\"archive-{name}-openspec\\\"), &case);\\n    let rust = scaffold(&format!(\\\"archive-{name}-rust\\\"), &case);\\n    let changes = folders(&rust.root().join(\\\"openspec/changes\\\"));\\n    let first = changes\\n        .first()\\n        .map_or_else(|| panic!(\\\"case {name} has no change\\\"), PathBuf::as_path);\\n    let rust_specs = rust.root().join(\\\"openspec/specs\\\");\\n    match expect {\\n        \\\"identical\\\" => assert_identical(&cli, &openspec, &rust_specs, &changes),\\n        \\\"both-refuse\\\" => assert_both_refuse(&cli, &openspec, first, &rust_specs, &case),\\n        \\\"osq-refuses\\\" => assert_osq_refuses(&cli, &openspec, first, &rust_specs, &case),\\n        other => panic!(\\\"case {name} has unknown expect `{other}`\\\"),\\n    }\\n}\\n\\n/// Declares one corpus test per differential case, in byte order.\\nmacro_rules! case_tests {\\n    ($($fn_name:ident => $case:literal),* $(,)?) => {\\n        /// The differential case names, in byte order.\\n        const CASE_NAMES: &[&str] = &[$($case),*];\\n\\n        $(\\n            /// Cov