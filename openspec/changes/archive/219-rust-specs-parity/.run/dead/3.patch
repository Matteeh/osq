-{"type":"tool_use","timestamp":1792394898307,"sessionID":"ses_eacf54832ffeFAS4YOYdKea9Bo","part":{"partID":"prt_1530fab340016d4HDy2oykByWo","sessionID":"ses_eacf54832ffeFAS4YOYdKea9Bo","messageID":"msg_1530f9c3a001lLo2HX7CAvZubl","type":"tool","id":"call_00_0ctdz887783w5zale17w7qhf","tool":"read","state":{"status":"completed","input":{"path":"/home/mathias/.osq/worktrees/osq/219-rust-specs-parity/crates/kernel/specs/tests/openspec_archive_parity_corpus.rs"},"output":"Read file /home/mathias/.osq/worktrees/osq/219-rust-specs-parity/crates/kernel/specs/tests/openspec_archive_parity_corpus.rs, lines 1-289\n1: //! Corpus test: the Rust merge and `OpenSpec` archive agree on every\n2: //! differential case of `tests/fixtures/openspec-diff/`.\n3: //!\n4: //! It runs the `OpenSpec` CLI over the repository's fixtures, so it is a corpus\n5: //! test (rust-core \"Corpus tests\"): each test carries the corpus ignore, and\n6: //! only a build with the `parity` feature compiles it.\n7: \n8: pub mod openspec_parity_support;\n9: \n10: use openspec_parity_support::cli::{OpenSpecCli, text_of};\n11: use openspec_parity_support::project::Project;\n12: use openspec_parity_support::trees::{copy_tree, folders, name_of, read_tree, repository_root};\n13: use osq_kernel_specs::{MergeChangeError, merge_change};\n14: use serde_json::Value;\n15: use std::collections::BTreeMap;\n16: use std::path::{Path, PathBuf};\n17: \n18: /// The differential fixtures, relative to the repository root.\n19: const FIXTURES: &str = \"tests/fixtures/openspec-diff\";\n20: \n21: /// Runs one differential case: builds both projects, then checks its expectation.\n22: fn run_case(name: &str) {\n23:     let case = repository_root().join(FIXTURES).join(name);\n24:     let file = case.join(\"case.json\");\n25:     let value: Value = serde_json::from_str(&read(&file)).expect(\"the case parses\");\n26:     let expect = value\n27:         .get(\"expect\")\n28:         .and_then(Value::as_str)\n29:         .expect(\"an expect\");\n30:     let repo = repository_root();\n31:     let cli = OpenSpecCli::locate(&repo);\n32:     let openspec = scaffold(&format!(\"archive-{name}-openspec\"), &case);\n33:     let rust = scaffold(&format!(\"archive-{name}-rust\"), &case);\n34:     let changes = folders(&rust.root().join(\"openspec/changes\"));\n35:     let first = changes\n36:         .first()\n37:         .map_or_else(|| panic!(\"case {name} has no change\"), PathBuf::as_path);\n38:     let cli_specs = openspec.root().join(\"openspec/specs\");\n39:     let rust_specs = rust.root().join(\"openspec/specs\");\n40:     match expect {\n41:         \"identical\" => assert_identical(&cli, &openspec, &rust_specs, &changes),\n42:         \"both-refuse\" => assert_both_refuse(&cli, first, &cli_specs, &rust_specs, &case),\n43:         \"osq-refuses\" => assert_osq_refuses(&cli, first, &cli_specs, &rust_specs, &case),\n44:         other => panic!(\"case {name} has unknown expect `{other}`\"),\n45:     }\n46: }\n47: \n48: /// Reads one file, naming it when that fails.\n49: fn read(path: &Path) -> String {\n50:     std::fs::read_to_string(path)\n51:         .unwrap_or_else(|error| panic!(\"reading {}: {error}\", path.display()))\n52: }\n53: \n54: /// Builds one temporary project with the scaffold, the case's specs and changes.\n55: fn scaffold(name: &str, case: &Path) -> Project {\n56:     let project = Project::prepare(name, &repository_root()).expect(\"the project writes\");\n57:     let specs = case.join(\"specs\");\n58:     project\n59:         .set_specs(specs.is_dir().then_some(specs.as_path()))\n60:         .expect(\"the case specs copy\");\n61:     copy_tree(\n62:         &case.join(\"changes\"),\n63:         &project.root().join(\"openspec/changes\"),\n64:     )\n65:     .expect(\"the case changes copy\");\n66:     project\n67: }\n68: \n69: /// Runs the CLI, asserting it exits zero.\n70: fn run_ok(cli: &OpenSpecCli, args: &[&str], cwd: &Path) {\n71:     let output = cli.run(args, cwd);\n72:     assert!(\n73:         output.status.success(),\n74:         \"{}: {} failed:\\n{}\",\n75:         cli.path().display(),\n76:         args.join(\" \"),\n77:         text_of(&output)\n78:     );\n79: }\n80: \n81: /// A case both tools accept: each change validates and archives in the CLI\n82: /// project, the Rust merge applies each change, and the specs trees match.\n83: fn assert_identical(cli: &OpenSpecCli, openspec: &Project, rust_specs: &Path, changes: &[PathBuf]) {\n84:     for change in changes {\n85:         let name = name_of(change);\n86:         let args = [\"validate\", &name, \"--type\", \"change\", \"--strict\", \"--json\"];\n87:         let args = [&args[..], &[\"--no-interactive\"]].concat();\n88:         run_ok(cli, &args, openspec.root());\n89:     }\n90:     for change in changes {\n91:         let name = name_of(change);\n92:         run_ok(cli, &[\"archive\", &name, \"--yes\", \"--json\"], openspec.root());\n93:         merge_into(change, rust_specs);\n94:     }\n95:     assert_trees_equal(\n96:         &openspec.root().join(\"openspec/specs\"),\n97:         rust_specs,\n98:         \"the specs trees\",\n99:     );\n100: }\n101: \n102: /// A case both tools refuse: the CLI reports `archive_spec_update_failed`, the\n103: /// Rust merge refuses, and neither tree changes.\n104: fn assert_both_refuse(\n105:     cli: &OpenSpecCli,\n106:     first: &Path,\n107:     cli_specs: &Path,\n108:     rust_specs: &Path,\n109:     case: &Path,\n110: ) {\n111:     let name = name_of(first);\n112:     let archive = cli.run(&[\"archive\", &name, \"--yes\", \"--json\"], cli_specs);\n113:     assert!(\n114:         !archive.status.success(),\n115:         \"archive {name} unexpectedly succeeded:\\n{}\",\n116:         text_of(&archive)\n117:     );\n118:     let value: Value = serde_json::from_slice(&archive.stdout)\n119:         .unwrap_or_else(|error| panic!(\"archive {name} printed no JSON: {error}\"));\n120:     let refused = value\n121:         .get(\"status\")\n122:         .and_then(Value::as_array)\n123:         .is_some_and(|entries| {\n124:             entries.iter().any(|entry| {\n125:                 entry.get(\"code\").and_then(Value::as_str) == Some(\"archive_spec_update_failed\")\n126:             })\n127:         });\n128:     assert!(\n129:         refused,\n130:         \"archive {name} reported no archive_spec_update_failed\"\n131:     );\n132:     match merge_change(first, rust_specs) {\n133:         Err(MergeChangeError::Merge { .. }) => {}\n134:         other => panic!(\n135:             \"{}: the Rust merge should refuse, got {other:?}\",\n136:             first.display()\n137:         ),\n138:     }\n139:     let case_specs = case.join(\"specs\");\n140:     assert_trees_equal(cli_specs, &case_specs, \"the OpenSpec tree\");\n141:     assert_trees_equal(rust_specs, &case_specs, \"the Rust tree\");\n142: }\n143: \n144: /// A case the Rust merge refuses and the CLI accepts: the refusal names the\n145: /// expected rename form, and no living spec holds a rename target.\n146: fn assert_osq_refuses(\n147:     cli: &OpenSpecCli,\n148:     first: &Path,\n149:     cli_specs: &Path,\n150:     rust_specs: &Path,\n151:     case: &Path,\n152: ) {\n153:     let message = match merge_change(first, rust_specs) {\n154:         Err(MergeChangeError::Merge { error, .. }) => error.to_string(),\n155:         other => panic!(\n156:             \"{}: expected a merge refusal, got {other:?}\",\n157:             first.display()\n158:         ),\n159:     };\n160:     assert!(\n161:         message.contains(\"### Requirement:\"),\n162:         \"{}: the refusal must name the expected form: {message}\",\n163:         first.display()\n164:     );\n165:     let name = name_of(first);\n166:     run_ok(cli, &[\"archive\", &name, \"--yes\", \"--json\"], cli_specs);\n167:     let living = tree(cli_specs);\n168:     for target in rename_targets(&case.join(\"changes\")) {\n169:         let header = format!(\"### Requirement: {target}\");\n170:         assert!(\n171:             !living.values().any(|text| text.contains(&header)),\n172:             \"the case applied a rename OpenSpec should skip: {target}\"\n173:         );\n174:     }\n175: }\n176: \n177: /// Merges one change into `specs`, writing or removing each merged spec.\n178: fn merge_into(change: &Path, specs: &Path) {\n179:     let merged = merge_change(change, specs)\n180:         .unwrap_or_else(|error| panic!(\"{}: the Rust merge refuses: {error}\", change.display()));\n181:     for spec in merged {\n182:         let folder = specs.join(&spec.capability);\n183:         match &spec.text {\n184:             Some(text) => {\n185:                 std::fs::create_dir_all(&folder).expect(\"the capability folder\");\n186:                 std::fs::write(folder.join(\"spec.md\"), text).expect(\"the merged spec\");\n187:             }\n188:             None => {\n189:                 let _ = std::fs::remove_dir_all(&folder);\n190:             }\n191:         }\n192:     }\n193: }\n194: \n195: /// Every file under `root`, or none when the folder does not exist.\n196: fn tree(root: &Path) -> BTreeMap<String, String> {\n197:     if !root.is_dir() {\n198:         return BTreeMap::new();\n199:     }\n200:     read_tree(root).unwrap_or_else(|error| panic!(\"reading {}: {error}\", root.display()))\n201: }\n202: \n203: /// Asserts two trees hold the same paths with the same bytes.\n204: fn assert_trees_equal(left: &Path, right: &Path, label: &str) {\n205:     let (left, right) = (tree(left), tree(right));\n206:     assert_eq!(\n207:         left.keys().collect::<Vec<_>>(),\n208:         right.keys().collect::<Vec<_>>(),\n209:         \"{label}: different paths\"\n210:     );\n211:     for (path, text) in &left {\n212:         assert_eq!(Some(text), right.get(path), \"{label}: {path}\");\n213:     }\n214: }\n215: \n216: /// The requirement names the case's delta specs give a `TO:` line.\n217: fn rename_targets(changes: &Path) -> Vec<String> {\n218:     let mut targets = Vec::new();\n219:     for change in folders(changes) {\n220:         for capability in folders(&change.join(\"specs\")) {\n221:             targets.extend(\n222:                 read(&capability.join(\"spec.md\"))\n223:                     .lines()\n224:                     .filter_map(rename_target),\n225:             );\n226:         }\n227:     }\n228:     targets\n229: }\n230: \n231: /// The requirement name a `TO:` line names, or none for any other line.\n232: fn rename_target(line: &str) -> Option<String> {\n233:     let rest = line\n234:         .trim_start()\n235:         .trim_start_matches(['-', '*', '+'])\n236:         .trim_start();\n237:     if !rest.get(..3)?.eq_ignore_ascii_case(\"TO:\") {\n238:         return None;\n239:     }\n240:     let mut name = rest[3..].trim().trim_matches('`').trim();\n241:     if let Some(head) = name\n242:         .get(..16)\n243:         .filter(|head| head.eq_ignore_ascii_case(\"### Requirement:\"))\n244:     {\n245:         name = name[head.len()..].trim();\n246:     }\n247:     (!name.is_empty()).then(|| name.to_string())\n248: }\n249: \n250: macro_rules! case_tests {\n251:     ($($fn_name:ident => $case:literal),* $(,)?) => {\n252:         /// The differential case names, in byte order.\n253:         const CASE_NAMES: &[&str] = &[$($case),*];\n254: \n255:         $(\n256:             /// Covers: rust-specs/archive-cases-match-openspec\n257:             #[ignore = \"corpus test: runs the OpenSpec CLI on the differential cases\"]\n258:             #[test]\n259:             fn $fn_name() {\n260:                 run_case($case);\n261:             }\n262:         )*\n263:     };\n264: }\n265: \n266: case_tests! {\n267:     added => \"added\",\n268:     bare_rename => \"bare-rename\",\n269:     dropped_scenario => \"dropped-scenario\",\n270:     duplicate_added => \"duplicate-added\",\n271:     given_and => \"given-and\",\n272:     modified => \"modified\",\n273:     new_capability => \"new-capability\",\n274:  