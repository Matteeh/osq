+{"type":"tool_use","timestamp":1792395211927,"sessionID":"ses_eacf54832ffeFAS4YOYdKea9Bo","part":{"partID":"prt_153147485001x5ZrARo4zN081i","sessionID":"ses_eacf54832ffeFAS4YOYdKea9Bo","messageID":"msg_153144a410012NB9bHMljzWDlr","type":"tool","id":"call_00_lvibntkrr864j77o28apum25","tool":"read","state":{"status":"completed","input":{"path":"/home/mathias/.osq/worktrees/osq/219-rust-specs-parity/crates/kernel/specs/tests/openspec_archive_parity_corpus.rs"},"output":"Read file /home/mathias/.osq/worktrees/osq/219-rust-specs-parity/crates/kernel/specs/tests/openspec_archive_parity_corpus.rs, lines 1-250\n1: //! Corpus test: the Rust merge and `OpenSpec` archive agree on every\n2: //! differential case of `tests/fixtures/openspec-diff/`, running the CLI, so\n3: //! each test carries the corpus ignore and only the `parity` feature builds it.\n4: pub mod openspec_parity_support;\n5: \n6: use openspec_parity_support::cli::{OpenSpecCli, text_of};\n7: use openspec_parity_support::project::Project;\n8: use openspec_parity_support::trees::{copy_tree, folders, name_of, read_tree, repository_root};\n9: use osq_kernel_specs::{MergeChangeError, RenameSide, merge_change, parse_delta};\n10: use serde_json::Value;\n11: use std::collections::BTreeMap;\n12: use std::path::{Path, PathBuf};\n13: \n14: /// The differential fixtures, relative to the repository root.\n15: const FIXTURES: &str = \"tests/fixtures/openspec-diff\";\n16: \n17: /// Reads one file, naming it when that fails.\n18: fn read(path: &Path) -> String {\n19:     std::fs::read_to_string(path).unwrap_or_else(|e| panic!(\"reading {}: {e}\", path.display()))\n20: }\n21: \n22: /// Every file under `root` as its `/`-joined path and text, or none.\n23: fn tree(root: &Path) -> BTreeMap<String, String> {\n24:     read_tree(root).unwrap_or_default()\n25: }\n26: \n27: /// Builds a temporary project with the scaffold, the case's specs and changes.\n28: fn scaffold(name: &str, case: &Path) -> Project {\n29:     let project = Project::prepare(name, &repository_root()).expect(\"the project writes\");\n30:     let specs = case.join(\"specs\");\n31:     project\n32:         .set_specs(specs.is_dir().then_some(specs.as_path()))\n33:         .expect(\"the case specs copy\");\n34:     copy_tree(\n35:         &case.join(\"changes\"),\n36:         &project.root().join(\"openspec/changes\"),\n37:     )\n38:     .expect(\"the case changes copy\");\n39:     project\n40: }\n41: \n42: /// Runs the CLI, asserting it exits zero.\n43: fn run_ok(cli: &OpenSpecCli, args: &[&str], cwd: &Path) {\n44:     let output = cli.run(args, cwd);\n45:     assert!(\n46:         output.status.success(),\n47:         \"{}: {} failed:\\n{}\",\n48:         cli.path().display(),\n49:         args.join(\" \"),\n50:         text_of(&output)\n51:     );\n52: }\n53: \n54: /// Merges one change into `specs`, writing or removing each merged spec.\n55: fn merge_into(change: &Path, specs: &Path) {\n56:     let merged = merge_change(change, specs)\n57:         .unwrap_or_else(|error| panic!(\"{}: the Rust merge refuses: {error}\", change.display()));\n58:     for spec in merged {\n59:         let folder = specs.join(&spec.capability);\n60:         match &spec.text {\n61:             Some(text) => {\n62:                 std::fs::create_dir_all(&folder).expect(\"the capability folder\");\n63:                 std::fs::write(folder.join(\"spec.md\"), text).expect(\"the merged spec\");\n64:             }\n65:             None => {\n66:                 let _ = std::fs::remove_dir_all(&folder);\n67:             }\n68:         }\n69:     }\n70: }\n71: \n72: /// A case both tools accept: each change validates and archives in the CLI\n73: /// project, the Rust merge applies each change, and the specs trees match.\n74: fn assert_identical(cli: &OpenSpecCli, openspec: &Project, rust_specs: &Path, changes: &[PathBuf]) {\n75:     for change in changes {\n76:         let name = name_of(change);\n77:         let args = [\n78:             \"validate\",\n79:             &name,\n80:             \"--type\",\n81:             \"change\",\n82:             \"--strict\",\n83:             \"--json\",\n84:             \"--no-interactive\",\n85:         ];\n86:         run_ok(cli, &args, openspec.root());\n87:     }\n88:     for change in changes {\n89:         let name = name_of(change);\n90:         run_ok(cli, &[\"archive\", &name, \"--yes\", \"--json\"], openspec.root());\n91:         merge_into(change, rust_specs);\n92:     }\n93:     let cli_specs = openspec.root().join(\"openspec/specs\");\n94:     assert_eq!(tree(&cli_specs), tree(rust_specs), \"the two specs trees\");\n95: }\n96: \n97: /// A case both tools refuse: the CLI reports `archive_spec_update_failed`, the\n98: /// Rust merge refuses, and neither tree changes.\n99: fn assert_both_refuse(\n100:     cli: &OpenSpecCli,\n101:     project: &Project,\n102:     first: &Path,\n103:     rust_specs: &Path,\n104:     case: &Path,\n105: ) {\n106:     let name = name_of(first);\n107:     let archive = cli.run(&[\"archive\", &name, \"--yes\", \"--json\"], project.root());\n108:     let cli_specs = project.root().join(\"openspec/specs\");\n109:     let value: Value = serde_json::from_slice(&archive.stdout).unwrap_or(Value::Null);\n110:     let refused = value\n111:         .get(\"status\")\n112:         .and_then(Value::as_array)\n113:         .is_some_and(|entries| {\n114:             entries.iter().any(|entry| {\n115:                 entry.get(\"code\").and_then(Value::as_str) == Some(\"archive_spec_update_failed\")\n116:             })\n117:         });\n118:     assert!(\n119:         !archive.status.success() && refused,\n120:         \"archive {name} did not report archive_spec_update_failed:\\n{}\",\n121:         text_of(&archive)\n122:     );\n123:     let rust_refused = matches!(\n124:         merge_change(first, rust_specs),\n125:         Err(MergeChangeError::Merge { .. })\n126:     );\n127:     assert!(\n128:         rust_refused,\n129:         \"{}: the Rust merge should refuse\",\n130:         first.display()\n131:     );\n132:     let case_specs = case.join(\"specs\");\n133:     assert_eq!(tree(&cli_specs), tree(&case_specs), \"the OpenSpec tree\");\n134:     assert_eq!(tree(rust_specs), tree(&case_specs), \"the Rust tree\");\n135: }\n136: \n137: /// A case the Rust merge refuses and the CLI accepts: the refusal names the\n138: /// expected rename form, and no living spec holds a rename target.\n139: fn assert_osq_refuses(\n140:     cli: &OpenSpecCli,\n141:     project: &Project,\n142:     first: &Path,\n143:     rust_specs: &Path,\n144:     case: &Path,\n145: ) {\n146:     let Err(MergeChangeError::Merge { error, .. }) = merge_change(first, rust_specs) else {\n147:         panic!(\"{}: expected a merge refusal\", first.display());\n148:     };\n149:     assert!(\n150:         error.to_string().contains(\"### Requirement:\"),\n151:         \"{}: the refusal must name the expected form: {error}\",\n152:         first.display()\n153:     );\n154:     let name = name_of(first);\n155:     run_ok(cli, &[\"archive\", &name, \"--yes\", \"--json\"], project.root());\n156:     let living = tree(&project.root().join(\"openspec/specs\"));\n157:     for target in rename_targets(&case.join(\"changes\")) {\n158:         let header = format!(\"### Requirement: {target}\");\n159:         assert!(\n160:             !living.values().any(|text| text.contains(&header)),\n161:             \"the case applied a rename OpenSpec should skip: {target}\"\n162:         );\n163:     }\n164: }\n165: \n166: /// The requirement names the case's delta specs give a `TO:` line.\n167: fn rename_targets(changes: &Path) -> Vec<String> {\n168:     let mut targets = Vec::new();\n169:     for change in folders(changes) {\n170:         for capability in folders(&change.join(\"specs\")) {\n171:             let delta = parse_delta(&read(&capability.join(\"spec.md\")));\n172:             targets.extend(delta.renamed.into_iter().map(|rename| rename.to));\n173:             targets.extend(\n174:                 delta\n175:                     .unpaired_renames\n176:                     .into_iter()\n177:                     .filter(|side| side.side == RenameSide::To)\n178:                     .map(|side| side.name),\n179:             );\n180:         }\n181:     }\n182:     targets\n183: }\n184: \n185: /// Runs one differential case: builds both projects, then checks its expectation.\n186: fn run_case(name: &str) {\n187:     let case = repository_root().join(FIXTURES).join(name);\n188:     let value: Value = serde_json::from_str(&read(&case.join(\"case.json\"))).expect(\"the case\");\n189:     let expect = value\n190:         .get(\"expect\")\n191:         .and_then(Value::as_str)\n192:         .expect(\"an expect\");\n193:     let repo = repository_root();\n194:     let cli = OpenSpecCli::locate(&repo);\n195:     let openspec = scaffold(&format!(\"archive-{name}-openspec\"), &case);\n196:     let rust = scaffold(&format!(\"archive-{name}-rust\"), &case);\n197:     let changes = folders(&rust.root().join(\"openspec/changes\"));\n198:     let first = changes\n199:         .first()\n200:         .map_or_else(|| panic!(\"case {name} has no change\"), PathBuf::as_path);\n201:     let rust_specs = rust.root().join(\"openspec/specs\");\n202:     match expect {\n203:         \"identical\" => assert_identical(&cli, &openspec, &rust_specs, &changes),\n204:         \"both-refuse\" => assert_both_refuse(&cli, &openspec, first, &rust_specs, &case),\n205:         \"osq-refuses\" => assert_osq_refuses(&cli, &openspec, first, &rust_specs, &case),\n206:         other => panic!(\"case {name} has unknown expect `{other}`\"),\n207:     }\n208: }\n209: \n210: /// Declares one corpus test per differential case, in byte order.\n211: macro_rules! case_tests {\n212:     ($($fn_name:ident => $case:literal),* $(,)?) => {\n213:         /// The differential case names, in byte order.\n214:         const CASE_NAMES: &[&str] = &[$($case),*];\n215: \n216:   