    assert_eq!(tree(&cli_specs), tree(&case_specs), \"the OpenSpec tree\");\n133:     assert_eq!(tree(rust_specs), tree(&case_specs), \"the Rust tree\");\n134: }\n135: \n136: /// A case the Rust merge refuses and the CLI accepts: the refusal names the\n137: /// expected rename form, and no living spec holds a rename target.\n138: fn assert_osq_refuses(\n139:     cli: &OpenSpecCli,\n140:     project: &Project,\n141:     first: &Path,\n142:     rust_specs: &Path,\n143:     case: &Path,\n144: ) {\n145:     let Err(MergeChangeError::Merge { error, .. }) = merge_change(first, rust_specs) else {\n146:         panic!(\"{}: expected a merge refusal\", first.display());\n147:     };\n148:     assert!(\n149:         error.to_string().contains(\"### Requirement:\"),\n150:         \"{}: the refusal must name the expected form: {error}\",\n151:         first.display()\n152:     );\n153:     let name = name_of(first);\n154:     run_ok(cli, &[\"archive\", &name, \"--yes\", \"--json\"], project.root());\n155:     let living = tree(&project.root().join(\"openspec/specs\"));\n156:     for target in rename_targets(&case.join(\"changes\")) {\n157:         let header = format!(\"### Requirement: {target}\");\n158:         assert!(\n159:             !living.values().any(|text| text.contains(&header)),\n160:             \"the case applied a rename OpenSpec should skip: {target}\"\n161:         );\n162:     }\n163: }\n164: \n165: /// The requirement names the case's delta specs give a `TO:` line, as the\n166: /// TypeScript differential test reads them.\n167: fn rename_targets(changes: &Path) -> Vec<String> {\n168:     let mut targets = Vec::new();\n169:     for change in folders(changes) {\n170:         for capability in folders(&change.join(\"specs\")) {\n171:             let text = read(&capability.join(\"spec.md\"));\n172:             for line in text.lines() {\n173:                 let rest = line.trim_start().trim_start_matches(['-', '*', '+']);\n174:                 if let Some(name) = to_target(rest.trim_start()) {\n175:                     targets.push(name);\n176:                 }\n177:             }\n178:         }\n179:     }\n180:     targets\n181: }\n182: \n183: /// The requirement name a `TO:` line names, or none for any other line.\n184: fn to_target(rest: &str) -> Option<String> {\n185:     let head = rest.get(..3).filter(|h| h.eq_ignore_ascii_case(\"TO:\"))?;\n186:     let name = rest[head.len()..].trim().trim_matches('`').trim();\n187:     let prefix = name\n188:         .get(..16)\n189:         .filter(|h| h.eq_ignore_ascii_case(\"### Requirement:\"));\n190:     let name = prefix.map_or(name, |prefix| name[prefix.len()..].trim());\n191:     (!name.is_empty()).then(|| name.to_string())\n192: }\n193: \n194: /// Runs one differential case: builds both projects, then checks its expectation.\n195: fn run_case(name: &str) {\n196:     let case = repository_root().join(FIXTURES).join(name);\n197:     let value: Value = serde_json::from_str(&read(&case.join(\"case.json\"))).expect(\"the case\");\n198:     let expect = value\n199:         .get(\"expect\")\n200:         .and_then(Value::as_str)\n201:         .expect(\"an expect\");\n202:     let cli = OpenSpecCli::locate(&repository_root());\n203:     let openspec = scaffold(&format!(\"archive-{name}-openspec\"), &case);\n204:     let rust = scaffold(&format!(\"archive-{name}-rust\"), &case);\n205:     let changes = folders(&rust.root().join(\"openspec/changes\"));\n206:     let first = changes\n207:         .first()\n208:         .map_or_else(|| panic!(\"case {name} has no change\"), PathBuf::as_path);\n209:     let rust_specs = rust.root().join(\"openspec/specs\");\n210:     match expect {\n211:         \"identical\" => assert_identical(&cli, &openspec, &rust_specs, &changes),\n212:         \"both-refuse\" => assert_both_refuse(&cli, &openspec, first, &rust_specs, &case),\n213:         \"osq-refuses\" => assert_osq_refuses(&cli, &openspec, first, &rust_specs, &case),\n214:         other =