+describe('validator prompt', () => {
+  const inputs: ValidatorInputs = {
+    base: 'abc123',
+    deltaPaths: ['openspec/changes/001-x/specs/x/spec.md'],
+    scenarios: [],
+    patch: 'diff --git a/src/a.ts b/src/a.ts\n',
+    testPaths: ['tests/a.test.ts'],
+    resultPaths: ['openspec/changes/001-x/.run/results/1.md'],
+  };
+  const paths = {
+    changeFolder: 'openspec/changes/001-x',
+    scenariosFile: 'openspec/changes/001-x/.run/validator/scenarios.md',
+    patchFile: 'openspec/changes/001-x/.run/validator/diff.patch',
+    findingsFile: 'openspec/changes/001-x/.run/validator/findings.json',
+  };
+
+  it('puts the claims heading after the paths and the result after it', () => {
+    const prompt = buildValidatorPrompt(inputs, paths);
+    const claims = prompt.indexOf('Executor claims (check them; do not start from them):');
+    assert.ok(claims > 0);
+    for (const before of [
+      inputs.deltaPaths[0],
+      paths.scenariosFile,
+      paths.patchFile,
+      inputs.testPaths[0],
+      paths.findingsFile,
+    ]) {
+      assert.ok(prompt.indexOf(before) < claims, before);
+    }
+    assert.ok(prompt.indexOf(inputs.resultPaths[0]) > claims);
+    const lines = prompt.split('\n');
+    assert.equal(
+      lines.at(-1),
+      `CRITICAL: Before exiting, write ${paths.findingsFile}. Change no other file. Never run git.`,
+    );
+    for (const problem of ['no_code', 'no_test', 'passes_without_change']) {
+      assert.ok(prompt.includes(problem));
+    }
+    assert.ok(prompt.includes('{"findings": []}'));
+  });
+});
