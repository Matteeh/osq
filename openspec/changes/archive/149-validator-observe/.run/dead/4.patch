@@ -0,0 +1,247 @@
+import assert from 'node:assert/strict';
+import { execFile } from 'node:child_process';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { afterEach, describe, it } from 'node:test';
+import { promisify } from 'node:util';
+import { DEFAULT_CONFIG } from '../src/core/foundation/config.js';
+import { GitVcs } from '../src/core/vcs/git-vcs.js';
+import { NoVcs } from '../src/core/vcs/no-vcs.js';
+import { buildClaudeArgs } from '../src/harness/claude/claude-exec-args.js';
+import { buildPiArgs } from '../src/harness/pi/pi-args.js';
+import { buildExecutorPrompt } from '../src/harness/prompt.js';
+import type { SpawnTaskOptions } from '../src/harness/types.js';
+import { parseValidatorFindings } from '../src/watcher/validator-findings.js';
+import {
+  type ValidatorInputs,
+  formatScenariosFile,
+  judgedScenarios,
+  readValidatorInputs,
+} from '../src/watcher/validator-inputs.js';
+import { buildValidatorPrompt } from '../src/watcher/validator-prompt.js';
+
+const execFileAsync = promisify(execFile);
+const tmpDirs: string[] = [];
+afterEach(async () => {
+  for (const dir of tmpDirs.splice(0)) await fs.rm(dir, { recursive: true, force: true });
+});
+async function makeTempDir(prefix: string): Promise<string> {
+  const dir = await fs.mkdtemp(path.join(os.tmpdir(), prefix));
+  tmpDirs.push(dir);
+  return dir;
+}
+async function git(args: string[], cwd: string): Promise<string> {
+  const env = { ...process.env };
+  for (const key of ['GIT_DIR', 'GIT_INDEX_FILE', 'GIT_WORK_TREE'])
+    Reflect.deleteProperty(env, key);
+  const { stdout } = await execFileAsync('git', args, { cwd, env });
+  return stdout.trim();
+}
+
+/** One scenario block, as a delta or living spec writes it. */
+function scenario(name: string, when: string, then: string): string {
+  return `#### Scenario: ${name}\n- **WHEN** ${when}\n- **THEN** ${then}`;
+}
+
+const LIVING_SPEC = `# x Specification\n\n## Purpose\n\nTest capability.\n\n## Requirements\n\n### Requirement: Existing\nThe system SHALL exist.\n\n${scenario('Existing scenario', 'it runs', 'it works')}\n`;
+const NEW_DELTA = `# x\n\n## ADDED Requirements\n\n### Requirement: Added thing\nThe system SHALL do a new thing.\n\n${scenario('New scenario', 'it is new', 'it works')}\n`;
+const UNCHANGED_DELTA = `# x\n\n## MODIFIED Requirements\n\n### Requirement: Existing\nThe system SHALL exist.\n\n${scenario('Existing scenario', 'it runs', 'it works')}\n`;
+
+interface Repo {
+  root: string;
+  change: string;
+  vcs: GitVcs;
+  base: string;
+}
+
+/** A temporary repository with a living `x` spec and a change folder. */
+async function makeRepo(prefix: string, withBase: boolean): Promise<Repo> {
+  const root = await makeTempDir(prefix);
+  await git(['init', '-q', '-b', 'main'], root);
+  await git(['config', 'user.name', 'osq'], root);
+  await git(['config', 'user.email', 'osq@example.invalid'], root);
+  await fs.mkdir(path.join(root, 'openspec', 'specs', 'x'), { recursive: true });
+  await fs.writeFile(path.join(root, 'openspec', 'specs', 'x', 'spec.md'), LIVING_SPEC, 'utf8');
+  await fs.mkdir(path.join(root, 'src'), { recursive: true });
+  await fs.writeFile(path.join(root, 'src', 'a.ts'), 'export const a = 1;\n', 'utf8');
+  await git(['add', '-A'], root);
+  await git(['commit', '-qm', 'base'], root);
+  const base = await git(['rev-parse', 'HEAD'], root);
+  const change = path.join(root, 'openspec', 'changes', '001-x');
+  await fs.mkdir(path.join(change, 'specs', 'x'), { recursive: true });
+  await fs.writeFile(path.join(change, 'specs', 'x', 'spec.md'), NEW_DELTA, 'utf8');
+  if (withBase) {
+    await fs.mkdir(path.join(change, '.run'), { recursive: true });
+    await fs.writeFile(path.join(change, '.run', 'base'), `${base}\n`, 'utf8');
+  }
+  return { root, change, vcs: new GitVcs(root, DEFAULT_CONFIG), base };
+}
+
+describe('validator inputs', () => {
+  it('judges only scenarios the living spec at the base lacks', () => {
+    const living = `# x\n\n## Requirements\n\n### Requirement: Behavior\nThe system SHALL behave.\n\n${scenario('Keep', 'it keeps', 'it holds')}\n`;
+    const delta = `# x\n\n## MODIFIED Requirements\n\n### Requirement: Behavior\nThe system SHALL behave better.\n\n${scenario('Keep', 'it keeps', 'it holds')}\n\n${scenario('Fresh', 'it is fresh', 'it is new')}\n`;
+    const judged = judgedScenarios(new Map([['x', delta]]), new Map([['x', living]]));
+    assert.deepEqual(
+      judged.map((scenario) => scenario.scenario),
+      ['Fresh'],
+    );
+  });
+
+  it('leaves spec files out of the patch and names existing test paths', async () => {
+    const repo = await makeRepo('osq-vi-patch-', true);
+    await fs.mkdir(path.join(repo.root, 'tests'), { recursive: true });
+    await fs.writeFile(path.join(repo.root, 'tests', 'a.test.ts'), 'export {};\n', 'utf8');
+    await fs.writeFile(path.join(repo.root, 'src', 'a.ts'), 'export const a = 2;\n', 'utf8');
+    await fs.writeFile(
+      path.join(repo.root, 'openspec', 'specs', 'x', 'spec.md'),
+      `${LIVING_SPEC}\n## Extra\n`,
+      'utf8',
+    );
+    const inputs = await readValidatorInputs(repo.root, repo.change, repo.vcs, DEFAULT_CONFIG);
+    assert.ok(!('skipped' in inputs));
+    if ('skipped' in inputs) return;
+    assert.equal(inputs.base, repo.base);
+    assert.ok(inputs.patch.includes('src/a.ts'));
+    assert.ok(!inputs.patch.includes('openspec/'));
+    assert.deepEqual(inputs.testPaths, ['tests/a.test.ts']);
+    assert.deepEqual(inputs.deltaPaths, ['openspec/changes/001-x/specs/x/spec.md']);
+    assert.deepEqual(
+      inputs.scenarios.map((scenario) => scenario.scenario),
+      ['New scenario'],
+    );
+    assert.ok(formatScenariosFile(inputs.scenarios).includes('## x: Added thing'));
+  });
+
+  it('skips with no_base when .run/base is missing', async () => {
