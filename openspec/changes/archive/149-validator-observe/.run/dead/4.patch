+++ b/src/watcher/validator-findings.ts
@@ -0,0 +1,61 @@
+import type { ValidatorFinding, ValidatorProblem } from '../harness/types.js';
+
+const PROBLEMS: ReadonlySet<string> = new Set<ValidatorProblem>([
+  'no_code',
+  'no_test',
+  'passes_without_change',
+]);
+
+function nonEmptyString(value: unknown): string | null {
+  if (typeof value !== 'string') return null;
+  const trimmed = value.trim();
+  return trimmed.length > 0 ? trimmed : null;
+}
+
+function parseFinding(entry: unknown): ValidatorFinding | null {
+  if (typeof entry !== 'object' || entry === null || Array.isArray(entry)) return null;
+  const record = entry as Record<string, unknown>;
+  if (record.kind !== 'scenario') return null;
+  const capability = nonEmptyString(record.capability);
+  const requirement = nonEmptyString(record.requirement);
+  const scenario = nonEmptyString(record.scenario);
+  const detail = nonEmptyString(record.detail);
+  const problem = record.problem;
+  if (capability === null || requirement === null || scenario === null || detail === null) {
+    return null;
+  }
+  if (typeof problem !== 'string' || !PROBLEMS.has(problem)) return null;
+  return {
+    kind: 'scenario',
+    capability,
+    requirement,
+    scenario,
+    problem: problem as ValidatorProblem,
+    detail,
+  };
+}
+
+/**
+ * Parse the validator's `findings.json`. Returns the findings in file order
+ * with their strings trimmed, or null when the text is not JSON, has no
+ * `findings` array, or holds any malformed finding.
+ */
+export function parseValidatorFindings(text: string): ValidatorFinding[] | null {
+  let data: unknown;
+  try {
+    data = JSON.parse(text);
+  } catch {
+    return null;
+  }
+  if (typeof data !== 'object' || data === null || Array.isArray(data)) return null;
+  const findings = (data as Record<string, unknown>).findings;
+  if (!Array.isArray(findings)) return null;
+
+  const parsed: ValidatorFinding[] = [];
+  for (const entry of findings) {
+    const finding = parseFinding(entry);
+    if (finding === null) return null;
+    parsed.push(finding);
+  }
+  return parsed;
+}
diff --git a/src/watcher/validator-inputs.ts b/src/watcher/validator-inputs.ts
new file mode 100644
index 0000000..07ac503
--- /dev/null
+++ b/src/watcher/validator-inputs.ts
@@ -0,0 +1,230 @@
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import type { OsqConfig } from '../core/foundation/config.js';
+import { normalizeRequirementName, parseCapabilitySpec, parseDelta } from '../core/spec/delta.js';
+import { compareNumericPrefix } from '../core/status/state.js';
+import { isTestPath } from '../core/trace/test-path.js';
+import type { Vcs } from '../core/vcs/vcs.js';
+import type { ValidatorSkipReason } from '../harness/types.js';
+
+/** One scenario the validator is asked to judge. */
+export interface JudgedScenario {
+  readonly capability: string;
+  readonly requirement: string;
+  readonly scenario: string;
+  /** The scenario's block as the delta spec writes it, trimmed. */
+  readonly text: string;
+}
+
+/** Everything osq gives the validator for one run. */
+export interface ValidatorInputs {
+  readonly base: string;
+  readonly deltaPaths: readonly string[];
+  readonly scenarios: readonly JudgedScenario[];
+  readonly patch: string;
+  readonly testPaths: readonly string[];
+  readonly resultPaths: readonly string[];
+}
+
+interface DeltaFile {
+  readonly capability: string;
+  readonly absolute: string;
+  readonly relative: string;
+}
+
+const PATCH_HEADER_REGEX = /^diff --git a\/(.+) b\/(.+)$/;
+
+/** The file a `diff --git` header names, or null when it cannot be read. */
+function patchBlockPath(header: string): string | null {
+  const match = PATCH_HEADER_REGEX.exec(header);
+  if (!match) return null;
+  return match[2] === '/dev/null' ? match[1] : match[2];
+}
+
+/** The `diff --git` blocks of a patch, in order, each with its verbatim text. */
+function patchSections(patch: string): { path: string; text: string }[] {
+  const sections: { path: string; text: string }[] = [];
+  let current: { path: string; text: string } | null = null;
+  for (const line of patch.split('\n')) {
+    if (line.startsWith('diff --git a/')) {
+      if (current) sections.push(current);
+      current = { path: patchBlockPath(line) ?? line, text: line };
+    } else if (current) {
+      current.text += `\n${line}`;
+    }
+  }
+  if (current) sections.push(current);
+  return sections;
+}
+
+/** Drop every `openspecRoot` block, keeping the rest byte for byte. */
+function filterPatch(patch: string, openspecRoot: string): { patch: string; paths: string[] } {
+  const prefix = `${openspecRoot}/`;
+  const kept: string[] = [];
+  const paths: string[] = [];
+  for (const section of patchSections(patch)) {
+    if (section.path.startsWith(prefix)) continue;
+    kept.push(section.text);
+    paths.push(section.path);
+  }
+  return { patch: kept.join('\n'), paths };
+}
+
+async function readBase(specFolderPath: string): Promise<string | null> {
+  try {
+    const content = await fs.readFile(path.join(specFolderPath, '.run', 'base'), 'utf8');
+    const trimmed = content.trim();
+    return trimmed.length > 0 ? trimmed : null;
+  } catch {
+    return null;
+  }
+}
+
+/** The change's delta spec files, in capability name order. */
+async function readDeltaFiles(
+  projectRoot: string,
+  specFolderPath: string,
+): Promise<{ deltaPaths: string[]; deltas: Map<string, string> }> {
+  const dir = path.join(specFolderPath, 'specs');
+  const entries = await fs.readdir(dir, { withFileTypes: true }).catch(() => []);
+  const files: DeltaFile[] = entries
+    .filter((entry) => entry.isDirectory())
+    .map((entry) => {
+      const absolute = path.join(dir, entry.name, 'spec.md');
+      return {
+        capability: entry.name,
+        absolute,
+        relative: path.relative(projectRoot, absolute),
+      };
+    })
+    .sort((a, b) => a.capability.localeCompare(b.capability));
+
+  const deltaPaths: string[] = [];
+  const deltas = new Map<string, string>();
+  for (const file of files) {
+    const content = await fs.readFile(file.absolute, 'utf8').catch(() => null);
+    if (content === null) continue;
+    deltaPaths.push(file.relative);
+    deltas.set(file.capability, content);
+  }
+  return { deltaPaths, deltas };
+}
+
+/** Requirements the living spec at the base has, keyed by name then scenario. */
+function livingScenarios(living: string | null | undefined): Map<string, Map<string, string>> {
+  const byRequirement = new Map<string, Map<string, string>>();
+  if (!living) return byRequirement;
+  for (const requirement of parseCapabilitySpec(living).requirements) {
+    const scenarios = new Map<string, string>();
+    for (const scenario of requirement.scenarios) {
+      scenarios.set(scenario.name, scenario.raw.trim());
+    }
+    byRequirement.set(normalizeRequirementName(requirement.name), scenarios);
+  }
+  return byRequirement;
+}
+
+/**
+ * The scenarios of the delta specs that a base did not already hold: those of
+ * ADDED or MODIFIED requirements whose name and text the living spec at the
+ * base lacks. Capability order, then document order.
+ */
+export function judgedScenarios(
+  deltas: ReadonlyMap<string, string>,
+  livingAtBase: ReadonlyMap<string, string | null>,
+): JudgedScenario[] {
+  const judged: JudgedScenario[] = [];
+  for (const capability of [...deltas.keys()].sort()) {
+    const content = deltas.get(capability);
+    if (content === undefined) continue;
+    const living = livingScenarios(livingAtBase.get(capability));
+    const parsed = parseDelta(content);
+    for (const requirement of [...parsed.added, ...parsed.modified]) {
+      const requirementName = normalizeRequirementName(requirement.name);
+      const prior = living.get(requirementName);
+      for (const scenario of requirement.scenarios) {
+        if (prior?.get(scenario.name) === scenario.raw.trim()) continue;
+        judged.push({
+          capability,
+          requirement: requirementName,
+          scenario: scenario.name,
+          text: scenario.raw.trim(),
+        });
+      }
+    }
+  }
+  return judged;
+}
+
+/** The scenarios file's text: a heading per requirement over its scenarios. */
+export function formatScenariosFile(scenarios: readonly JudgedScenario[]): string {
+  const lines = ['# Scenarios to judge'];
+  let current: string | null = null;
+  for (const scenario of scenarios) {
+    const key = `${scenario.capability}: ${scenario.requirement}`;
+    if (key !== current) {
+      lines.push('', `## ${key}`);
+      current = key;
+    }
+    lines.push('', scenario.text);
+  }
+  return `${lines.join('\n')}\n`;
+}
+
+async function existingTestPaths(
+  candidates: readonly string[],
+  projectRoot: string,
+): Promise<string[]> {
+  const existing = new Set<string>();
+  for (const candidate of candidates) {
+    if (!isTestPath(candidate)) continue;
+    const stat = await fs.stat(path.resolve(projectRoot, candidate)).catch(() => null);
+    if (stat?.isFile()) existing.add(candidate);
+  }
+  return [...existing].sort();
+}
+
+async function existingResultPaths(projectRoot: string, specFolderPath: string): Promise<string[]> {
+  const dir = path.join(specFolderPath, '.run', 'results');
+  const entries = await fs.readdir(dir).catch(() => []);
+  const numbers: string[] = [];
+  for (const name of entries) {
+    if (!name.endsWith('.md')) continue;
+    const stat = await fs.stat(path.join(dir, name)).catch(() => null);
+    if (stat?.isFile()) numbers.push(name.slice(0, -'.md'.length));
+  }
+  numbers.sort(compareNumericPrefix);
+  return numbers.map((number) => path.relative(projectRoot, path.join(dir, `${number}.md`)));
+}
+
+/**
+ * Gather the scenarios to judge, the diff and tests under review, and the
+ * executor results for one validator run. Returns a skip reason instead when
+ * git is off, `.run/base` is missing or empty, or no scenario is judged.
+ */
+export async function readValidatorInputs(
+  projectRoot: string,
+  specFolderPath: string,
+  vcs: Vcs,
+  config: OsqConfig,
+): Promise<ValidatorInputs | { readonly skipped: ValidatorSkipReason }> {
+  if (vcs.kind === 'none') return { skipped: 'no_base' };
+  const base = await readBase(specFolderPath);
+  if (base === null) return { skipped: 'no_base' };
+
+  const { deltaPaths, deltas } = await readDeltaFiles(projectRoot, specFolderPath);
+  const livingAtBase = new Map<string, string | null>();
+  for (const capability of deltas.keys()) {
+    const livingPath = `${config.paths.features}/${capability}/spec.md`;
+    livingAtBase.set(capability, await vcs.show(base, livingPath));
+  }
+
+  const scenarios = judgedScenarios(deltas, livingAtBase);
+  if (scenarios.length === 0) return { skipped: 'no_scenarios' };
+
+  const { patch, paths } = filterPatch(await vcs.patch(base), config.paths.openspecRoot);
+  const testPaths = await existingTestPaths(paths, projectRoot);
+  const resultPaths = await existingResultPaths(projectRoot, specFolderPath);
+
+  return { base, deltaPaths, scenarios, patch, testPaths, resultPaths };
+}
