+//! TypeScript's task commit message: its trailers, id and elapsed seconds.
+//!
+//! Every rule mirrors TypeScript's `commit-message.ts`, and a line that is not
+//! an event osq wrote is passed over.
+
+use std::fs;
+use std::path::Path;
+
+use osq_core::Event;
+use osq_core::parse_event_line;
+use osq_kernel_storage::timestamp_ms;
+
+/// One trailer line in an osq commit message.
+pub(crate) struct Trailer {
+    /// The trailer's key, such as `Osq-Change`.
+    pub(crate) key: String,
+    /// The trailer's value.
+    pub(crate) value: String,
+}
+
+/// The parts a task commit message assembles, in order.
+pub(crate) struct Message<'a> {
+    /// The first line, such as `osq: 001 task 1 verified`.
+    pub(crate) subject: &'a str,
+    /// The task's title.
+    pub(crate) title: &'a str,
+    /// The outcome line, such as `[ok] task 1 verified (elapsed: 3s)`.
+    pub(crate) outcome: &'a str,
+    /// The trailers after the body.
+    pub(crate) trailers: &'a [Trailer],
+}
+
+/// Assembles one osq commit message, ending with its one final newline.
+///
+/// Implements: rust-run/task-commit-message
+pub(crate) fn format(message: &Message<'_>) -> String {
+    let mut lines = vec![
+        message.subject.to_owned(),
+        String::new(),
+        message.title.to_owned(),
+        message.outcome.to_owned(),
+        String::new(),
+    ];
+    for trailer in message.trailers {
+        lines.push(format!("{}: {}", trailer.key, trailer.value));
+    }
+    lines.push(String::new());
+    lines.join("\n")
+}
+
+/// The change folder's leading digits, or its whole name without any.
+///
+/// Implements: rust-run/task-commit-message
+pub(crate) fn id(folder: &str) -> String {
+    let digits: String = folder.chars().take_while(char::is_ascii_digit).collect();
+    if digits.is_empty() {
+        folder.to_owned()
+    } else {
+        digits
+    }
+}
+
+/// The `Osq-Change` and `Osq-Task` trailers, plus the last started event's pair.
+///
+/// Implements: rust-run/task-commit-message
+pub(crate) fn read_trailers(folder: &Path, task: &str) -> Vec<Trailer> {
+    let mut trailers = vec![
+        Trailer {
+            key: "Osq-Change".to_owned(),
+            value: folder_name(folder),
+        },
+        Trailer {
+            key: "Osq-Task".to_owned(),
+            value: task.to_owned(),
+        },
+    ];
+    if let Some((harness, model, version)) = last_started(folder, task) {
+        trailers.push(Trailer {
+            key: "Osq-Model".to_owned(),
+            value: format!("{harness} {model}"),
+        });
+        trailers.push(Trailer {
+            key: "Osq-Version".to_owned(),
+            value: version,
+        });
+    }
+    trailers
+}
+
+/// The whole seconds from the last started event to `now_ms`, never below 0.
+///
+/// Implements: rust-run/task-commit-message
+pub(crate) fn elapsed_seconds(folder: &Path, task: &str, now_ms: i64) -> i64 {
+    let path = events_path(folder, task);
+    let Ok(text) = fs::read_to_string(path) else {
+        return 0;
+    };
+    let mut latest = None;
+    for line in text.lines() {
+        let Ok(envelope) = parse_event_line(line) else {
+            continue;
+        };
+        if matches!(envelope.event, Event::Started(_)) {
+            if let Some(milliseconds) = timestamp_ms(&envelope.timestamp) {
+                latest = Some(milliseconds);
+            }
+        }
+    }
+    latest.map_or(0, |milliseconds| {
+        (now_ms.saturating_sub(milliseconds) / 1000).max(0)
+    })
+}
+
+/// The harness, model and osq version of the last complete started event.
+fn last_started(folder: &Path, task: &str) -> Option<(String, String, String)> {
+    let path = events_path(folder, task);
+    let text = fs::read_to_string(path).ok()?;
+    let mut found = None;
+    for line in text.lines() {
+        let Ok(envelope) = parse_event_line(line) else {
+            continue;
+        };
+        let Event::Started(data) = envelope.event else {
+            continue;
+        };
+        if let (Some(harness), Some(model), Some(version)) =
+            (data.harness, data.model, data.osq_version)
+        {
+            found = Some((harness, model, version));
+        }
+    }
+    found
+}
+
+/// One task's event file inside a change folder.
+fn events_path(folder: &Path, task: &str) -> std::path::PathBuf {
+    folder
+        .join(".run")
+        .join("events")
+        .join(format!("{task}.jsonl"))
+}
+
+/// A folder's base name.
+fn folder_name(folder: &Path) -> String {
+    folder.file_name().map_or_else(
+        || folder.to_string_lossy().into_owned(),
+        |name| name.to_string_lossy().into_owned(),
+    )
+}
