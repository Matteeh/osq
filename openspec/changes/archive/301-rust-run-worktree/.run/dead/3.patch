@@ -0,0 +1,253 @@
+//! Proves a verified task in an osq worktree is committed as TypeScript does.
+
+mod support;
+mod worktree_support;
+
+#[path = "worktree_support/verified.rs"]
+mod verified;
+
+#[allow(dead_code)]
+#[path = "../src/feature/message.rs"]
+mod source_message;
+
+use std::fs;
+use std::os::unix::fs::PermissionsExt;
+use std::path::Path;
+
+use osq_core::FeatureError;
+use osq_core::event::{Event, parse_event_line};
+
+use support::{FOLDER, TASK};
+
+/// The branch the change's worktree checks out.
+const BRANCH: &str = "osq/001-a";
+
+/// The fixture task's title.
+const TITLE: &str = "When run, it works";
+
+/// The path of one task record in the worktree.
+fn change_path(name: &str) -> String {
+    format!("openspec/changes/{FOLDER}/{name}")
+}
+
+/// The harness, model and osq version of the task's last complete started event.
+fn started_identity(root: &Path) -> (String, String, String) {
+    let text = support::read_text(root, &change_path(&format!(".run/events/{TASK}.jsonl")));
+    let mut found = None;
+    for line in text.lines() {
+        let Ok(envelope) = parse_event_line(line) else {
+            continue;
+        };
+        let Event::Started(data) = envelope.event else {
+            continue;
+        };
+        if let (Some(harness), Some(model), Some(version)) =
+            (data.harness, data.model, data.osq_version)
+        {
+            found = Some((harness, model, version));
+        }
+    }
+    found.expect("the run wrote a complete started event")
+}
+
+/// The whole seconds a message's outcome line names.
+fn elapsed(message: &str) -> i64 {
+    let start = message
+        .find("(elapsed: ")
+        .expect("the message has an elapsed time")
+        + "(elapsed: ".len();
+    let rest = &message[start..];
+    let end = rest.find('s').expect("the elapsed time has seconds");
+    rest[..end]
+        .parse()
+        .expect("the elapsed time is a whole number")
+}
+
+/// Proves a passing task's worktree commit holds the scoped files and records.
+///
+/// Covers: rust-run/verified-task-commit
+#[test]
+fn verified_task_commit() {
+    let repo = verified::prepared("verified-commit");
+    worktree_support::mode(&repo, "done");
+    let before = worktree_support::tip(&repo.worktree, BRANCH);
+    let output = worktree_support::run(&repo, &[FOLDER, TASK]).expect("the task passes");
+    assert_eq!(output.text, "Task 1 of 001-a done\n", "the ending");
+    let tip = worktree_support::tip(&repo.worktree, BRANCH);
+    assert_ne!(tip, before, "the run made a commit");
+    let message = worktree_support::message(&repo.worktree, &tip);
+    let message = message.strip_suffix('\n').unwrap_or(&message);
+    let (_, model, version) = started_identity(&repo.worktree);
+    let expected = format!(
+        "osq: 001 task 1 verified\n\n{TITLE}\n[ok] task 1 verified (elapsed: {}s)\n\nOsq-Change: 001-a\nOsq-Task: 1\nOsq-Model: pi {model}\nOsq-Version: {version}\n",
+        elapsed(message)
+    );
+    assert_eq!(message, expected, "the commit message");
+    assert_eq!(
+        worktree_support::name_status(&repo.worktree, &tip),
+        "A\topenspec/changes/001-a/.run/done/1\n\
+         A\topenspec/changes/001-a/.run/events/1.jsonl\n\
+         A\topenspec/changes/001-a/.run/results/1.md\n\
+         M\topenspec/changes/001-a/tasks.md\n\
+         A\tsrc/a.txt\n",
+        "the committed paths"
+    );
+}
+
+/// Proves a refused commit fails the run and leaves the ending records.
+///
+/// Covers: rust-run/verified-task-commit-fails
+#[test]
+fn verified_task_commit_fails() {
+    let repo = verified::prepared("verified-commit-fails");
+    let hook = repo.checkout.join(".git").join("hooks").join("pre-commit");
+    support::write(
+        &repo.checkout,
+        ".git/hooks/pre-commit",
+        "#!/bin/sh\necho refused by hook >&2\nexit 1\n",
+    );
+    fs::set_permissions(&hook, fs::Permissions::from_mode(0o755)).expect("the hook is executable");
+    worktree_support::mode(&repo, "done");
+    let before = worktree_support::tip(&repo.worktree, BRANCH);
+    let error = worktree_support::run(&repo, &[FOLDER, TASK]).expect_err("the commit is refused");
+    let FeatureError::Failed { message, .. } = error else {
+        panic!("the run fails after reading its arguments");
+    };
+    assert!(
+        message.starts_with("task 1 of 001-a is done, but osq could not commit it: "),
+        "the failure names the commit: {message}"
+    );
+    assert!(
+        message.contains("refused by hook"),
+        "git's output: {message}"
+    );
+    assert!(
+        repo.worktree.join(change_path(".run/done/1")).is_file(),
+        "the done marker stays"
+    );
+    assert_eq!(
+        worktree_support::tip(&repo.worktree, BRANCH),
+        before,
+        "the branch is unchanged"
+    );
+}
+
+/// Proves the trailers come from the run's own started event, not an old one.
+///
+/// Covers: rust-run/trailers-from-the-last-started-event
+#[test]
+fn trailers_from_the_last_started_event() {
+    let repo = verified::prepared("verified-commit-trailers");
+    verified::events(
+        &repo,
+        TASK,
+        "not json\n{\"type\":\"started\",\"timestamp\":\"2020-01-01T00:00:00.000Z\",\"data\":{\"harness\":\"old\",\"model\":\"m0\",\"osqVersion\":\"0.0.1\"}}\n",
+    );
+    worktree_support::mode(&repo, "done");
+    worktree_support::run(&repo, &[FOLDER, TASK]).expect("the task passes");
+    let tip = worktree_support::tip(&repo.worktree, BRANCH);
+    let message = worktree_support::message(&repo.worktree, &tip);
+    let message = message.strip_suffix('\n').unwrap_or(&message);
+    let (harness, model, version) = started_identity(&repo.worktree);
+    assert_eq!(harness, "pi", "the run's harness");
+    assert!(
+        message.ends_with(&format!("Osq-Model: pi {model}\nOsq-Version: {version}\n")),
+        "the run's trailers: {message}"
+    );
+    assert!(!message.contains("Osq-Model: old"), "no old harness");
+    assert!(!message.contains("m0"), "no old model");
+    assert!(!message.contains("0.0.1"), "no old version");
+    assert!(elapsed(message) < 60, "the elapsed time is this run's");
+}
+
+/// Proves the elapsed time floors whole seconds and never goes below zero.
+///
+/// Covers: rust-run/trailers-from-the-last-started-event
+#[test]
+fn elapsed_seconds_rounds_down_and_clamps() {
+    let root = support::scratch("message-elapsed");
+    let folder = root.join("openspec/changes").join(FOLDER);
+    support::write(
+        &folder,
+        &format!(".run/events/{TASK}.jsonl"),
+        "{\"type\":\"started\",\"timestamp\":\"2020-01-01T00:00:00.000Z\",\"data\":{}}\n",
+    );
+    let start = 1_577_836_800_000;
+    assert_eq!(
+        source_message::elapsed_seconds(&folder, TASK, start + 5_500),
+        5,
+        "whole seconds round down"
+    );
+    assert_eq!(
+        source_message::elapsed_seconds(&folder, TASK, start - 5_000),
+        0,
+        "a future start clamps at zero"
+    );
+}
+
+/// Proves the commit takes scoped paths, lock followers and untracked tests.
+///
+/// Covers: rust-run/verified-task-commit
+#[test]
+fn verified_commit_paths_follow_scope_locks_and_tests() {
+    let repo = verified::prepared("verified-commit-paths");
+    verified::set_scope(
+        &repo,
+        &["src/a.txt", "crate/Cargo.toml", "pkg/package.json"],
+    );
+    support::write(&repo.worktree, "crate/Cargo.toml", "[package]\n");
+    support::write(&repo.worktree, "pkg/package.json", "{}\n");
+    support::write(&repo.worktree, "Cargo.lock", "lock\n");
+    support::write(&repo.worktree, "crate/Cargo.lock", "lock\n");
+    support::write(&repo.worktree, "pkg/package-lock.json", "{}\n");
+    support::write(&repo.worktree, "pkg/pnpm-lock.yaml", "lock\n");
+    support::write(&repo.worktree, "pkg/yarn.lock", "lock\n");
+    support::write(&repo.worktree, "pkg/Cargo.lock", "unrelated\n");
+    support::write(&repo.worktree, "other/Cargo.lock", "unrelated\n");
+    support::write(&repo.worktree, "tests/root.rs", "//! A new root test.\n");
+    support::write(&repo.worktree, "tests/staged.rs", "//! A staged test.\n");
+    worktree_support::git(&repo.worktree, &["add", "tests/staged.rs"]);
+    worktree_support::mode(&repo, "done");
+    worktree_support::run(&repo, &[FOLDER, TASK]).expect("the task passes");
+    let tip = worktree_support::tip(&repo.worktree, BRANCH);
+    assert_eq!(
+        worktree_support::name_status(&repo.worktree, &tip),
+        "A\tCargo.lock\n\
+         A\tcrate/Cargo.lock\n\
+         A\tcrate/Cargo.toml\n\
+         A\topenspec/changes/001-a/.run/done/1\n\
+         A\topenspec/changes/001-a/.run/events/1.jsonl\n\
+         A\topenspec/changes/001-a/.run/results/1.md\n\
+         M\topenspec/changes/001-a/tasks.md\n\
+         A\tpkg/package-lock.json\n\
+         A\tpkg/package.json\n\
+         A\tpkg/pnpm-lock.yaml\n\
+         A\tpkg/yarn.lock\n\
+         A\tsrc/a.txt\n\
+         A\ttests/root.rs\n",
+        "the committed paths"
+    );
+}
+
+/// Proves a change in the root runs without making a commit.
+///
+/// Covers: rust-run/worktree-run-finds-its-tree
+#[test]
+fn change_in_the_root_makes_no_commit() {
+    let root = support::repo("root-no-commit");
+    let fake = support::fixture("fake-pi").join("run.sh");
+    support::write(
+        &root,
+        "osq.toml",
+        format!(
+            "[executor]\nharness = \"pi\"\n\n[pi]\nbin = \"{}\"\n\n[vcs]\nenabled = true\nauthor = \"Osq Bot <bot@example.com>\"\n",
+            fake.display()
+        ),
+    );
+    support::write(&root, "fake-pi-mode", "done");
+    let before = support::git(&root, &["rev-parse", "HEAD"]);
+    let output = support::run(&root, &[FOLDER, TASK]).expect("the task passes");
+    assert_eq!(output.text, "Task 1 of 001-a done\n", "the ending");
+    let after = support::git(&root, &["rev-parse", "HEAD"]);
+    assert_eq!(before.trim(), after.trim(), "the root made no commit");
