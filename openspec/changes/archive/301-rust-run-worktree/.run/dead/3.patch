+//! Helpers for the verified-commit tests, built on the worktree repository.
+
+use std::fs;
+
+use super::worktree_support::{self, Repo};
+
+/// Builds the worktree repository and makes its records committable.
+///
+/// The fixture's `.gitignore` hides `.run/`, so the approval commit drops that
+/// rule; the approval seal still matches because the seal leaves `.run/` out.
+pub fn prepared(name: &str) -> Repo {
+    let repo = worktree_support::build(name);
+    let ignore = repo.worktree.join(".gitignore");
+    fs::remove_file(&ignore).expect("the fixture ignore file is removed");
+    worktree_support::git(&repo.worktree, &["add", "-A"]);
+    worktree_support::git(&repo.worktree, &["commit", "-q", "--amend", "--no-edit"]);
+    repo
+}
+
+/// Writes one task's event stream in the worktree.
+pub fn events(repo: &Repo, task: &str, content: &str) {
+    super::support::write(
+        &repo.worktree,
+        &format!("openspec/changes/001-a/.run/events/{task}.jsonl"),
+        content,
+    );
+}
+
+/// Rewrites task 1's scope, reseals the change and amends the approval commit.
+pub fn set_scope(repo: &Repo, scope: &[&str]) {
+    let entries = scope.iter().fold(String::new(), |mut text, entry| {
+        text.push_str("  - ");
+        text.push_str(entry);
+        text.push('\n');
+        text
+    });
+    let task = format!(
+        "---\ntitle: When run, it works\nverify: \"test -f src/a.txt\"\nverify_starts: red\nscope:\n{entries}entry: []\n---\n## Acceptance\n\n- [ ] When run, it works\n"
+    );
+    super::support::write(&repo.worktree, "openspec/changes/001-a/tasks/1.md", task);
+    super::support::write_seal(&repo.worktree);
+    worktree_support::git(&repo.worktree, &["add", "-A"]);
+    worktree_support::git(&repo.worktree, &["commit", "-q", "--amend", "--no-edit"]);
+}
