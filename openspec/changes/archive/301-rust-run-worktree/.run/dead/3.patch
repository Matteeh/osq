+//! Committing a verified task in its osq worktree, as TypeScript does.
+
+use std::path::Path;
+
+use osq_core::FeatureError;
+use osq_kernel_config::Config;
+use osq_kernel_specs::TaskFile;
+use osq_kernel_storage::ChangeEntry;
+use osq_kernel_vcs::{GitVcs, Vcs};
+
+use super::{message, scope, text, time};
+
+/// Commits a verified task's files and records on the tree's branch.
+///
+/// # Errors
+///
+/// Returns a `Failed` error when git status or the commit fails, leaving every
+/// file as it was.
+///
+/// Implements: rust-run/verified-task-commit
+pub(crate) fn verified(
+    tree_root: &Path,
+    config: &Config,
+    entry: &ChangeEntry,
+    task: &str,
+    task_file: &TaskFile,
+) -> Result<(), FeatureError> {
+    let vcs = GitVcs::new(tree_root).with_timeouts(&config.timeouts);
+    let status = vcs.status().map_err(|error| refused(entry, task, &error))?;
+    let paths = scope::commit_paths(tree_root, entry, task, task_file, &status);
+    let refs: Vec<&str> = paths.iter().map(String::as_str).collect();
+    let seconds = message::elapsed_seconds(&entry.path, task, time::now_ms());
+    let outcome = text::verified_outcome(task, seconds);
+    let subject = text::verified_subject(&message::id(&entry.folder), task);
+    let trailers = message::read_trailers(&entry.path, task);
+    let body = message::format(&message::Message {
+        subject: &subject,
+        title: &task_file.title,
+        outcome: &outcome,
+        trailers: &trailers,
+    });
+    let author = config.vcs.author.as_deref().unwrap_or_default();
+    vcs.commit(&refs, &body, author)
+        .map(|_| ())
+        .map_err(|error| refused(entry, task, &error))
+}
+
+/// The failure for a verified commit that git refused.
+fn refused(entry: &ChangeEntry, task: &str, error: impl std::fmt::Display) -> FeatureError {
+    FeatureError::failed(
+        "run",
+        text::commit_failed(task, &entry.folder, &error.to_string()),
+    )
+}
