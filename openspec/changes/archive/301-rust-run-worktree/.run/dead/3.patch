+/// Every path a verified task's commit holds, relative to the tree's root.
+///
+/// The status entries contribute the paths the task's scope covers, its lock
+/// rules included, and every untracked path in an audited test folder. The
+/// existing done, result, event and `tasks.md` records follow when status
+/// lists them; a record git ignores is left alone.
+///
+/// Implements: rust-run/verified-task-commit
+pub(crate) fn commit_paths(
+    root: &Path,
+    entry: &ChangeEntry,
+    task: &str,
+    task_file: &TaskFile,
+    status: &[StatusEntry],
+) -> Vec<String> {
+    let changed: Vec<ChangedPath> = status
+        .iter()
+        .map(|item| ChangedPath {
+            path: item.path.clone(),
+            change: PathChange::Modified,
+        })
+        .collect();
+    let folders = test_folders(root, &changed);
+    let manifests: Vec<String> = status.iter().map(|item| item.path.clone()).collect();
+    let rules = lock_rules();
+    let mut selected = BTreeSet::new();
+    for item in status {
+        if item.code == "??" && in_test_folder(&item.path, &folders) {
+            selected.insert(item.path.clone());
+        }
+        let candidates = std::iter::once(&item.path).chain(item.from.iter());
+        for candidate in candidates {
+            if scoped(candidate, &task_file.scope, &manifests, &rules) {
+                selected.insert(candidate.clone());
+            }
+        }
+    }
+    for record in records(entry, task) {
+        if record.is_file() {
+            let path = relative(root, &record);
+            if status.iter().any(|item| item.path == path) {
+                selected.insert(path);
+            }
+        }
+    }
+    selected.into_iter().collect()
+}
+
+/// Whether the scope covers a path, or a lock file follows a covered manifest.
+fn scoped(path: &str, scope: &[String], changed: &[String], rules: &[LockRule]) -> bool {
+    scope_covers_path(scope, path) || lock_file_follows(path, changed, scope, rules)
+}
+
+/// Whether `path` is a lock file following a changed manifest the scope covers.
+fn lock_file_follows(path: &str, changed: &[String], scope: &[String], rules: &[LockRule]) -> bool {
+    let lock_base = base_name_of(path);
+    let lock_folder = folder_of(path);
+    rules.iter().any(|rule| {
+        rule.lock_files
+            .iter()
+            .any(|name| name.as_str() == lock_base)
+            && changed.iter().any(|manifest| {
+                scope_covers_path(scope, manifest)
+                    && rule
+                        .manifests
+                        .iter()
+                        .any(|name| name.as_str() == base_name_of(manifest))
+                    && is_at_or_below(folder_of(manifest), lock_folder)
+            })
+    })
+}
+
+/// Whether a path lies at or under one of the audit's test folders.
+fn in_test_folder(path: &str, folders: &[String]) -> bool {
+    is_at_or_under(path, "tests") || folders.iter().any(|folder| is_at_or_under(path, folder))
+}
+
+/// The done, result, event and `tasks.md` records of one task.
+fn records(entry: &ChangeEntry, task: &str) -> [PathBuf; 4] {
+    let run = entry.path.join(".run");
+    [
+        run.join("done").join(task),
+        run.join("results").join(format!("{task}.md")),
+        run.join("events").join(format!("{task}.jsonl")),
+        entry.path.join("tasks.md"),
+    ]
+}
+
+/// The folder part of a POSIX path, `""` for a root file.
+fn folder_of(path: &str) -> &str {
+    path.rsplit_once('/').map_or("", |(folder, _)| folder)
+}
+
+/// The file part of a POSIX path.
+fn base_name_of(path: &str) -> &str {
+    path.rsplit_once('/').map_or(path, |(_, name)| name)
+}
+
+/// True when `path` is `folder` itself or a path below it.
+fn is_at_or_under(path: &str, folder: &str) -> bool {
+    path == folder
+        || path
+            .strip_prefix(folder)
+            .is_some_and(|rest| rest.starts_with('/'))
+}
+
+/// True when `folder` is `parent` or a folder below it.
+fn is_at_or_below(folder: &str, parent: &str) -> bool {
+    parent.is_empty()
+        || folder
+            .strip_prefix(parent)
+            .is_some_and(|rest| rest.is_empty() || rest.starts_with('/'))
+}
