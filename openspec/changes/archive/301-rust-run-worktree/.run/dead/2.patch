+/// Builds the audit facts for one task's changed paths.
+fn scope_audit(
+    root: &Path,
+    task_file: &TaskFile,
+    change_folder: String,
+    changes: Vec<ChangedPath>,
+) -> ScopeAudit {
+    let test_folders = test_folders(root, &changes);
+    ScopeAudit {
+        scope: task_file.scope.clone(),
+        tests_modify: task_file.tests_modify,
+        change_folder,
+        test_folders,
+        lock_rules: lock_rules(),
+        changes,
+    }
+}
+
+/// The status paths the task's scope or a lock rule covers, for its commit.
+///
+/// The change folder itself never counts here, since the commit names the
+/// change's records separately, and an untracked test path is added when it
+/// lies in a folder the audit gates for it.
+///
+/// Implements: rust-run/verified-task-commit
+pub(crate) fn commit_paths(
+    root: &Path,
+    task_file: &TaskFile,
+    status: &[StatusEntry],
+) -> Vec<String> {
+    let changes: Vec<ChangedPath> = status
+        .iter()
+        .map(|item| ChangedPath {
+            path: item.path.clone(),
+            change: status_change(root, item),
+        })
+        .collect();
+    let audit = scope_audit(root, task_file, String::new(), changes);
+    let disallowed = audit_scope(&audit);
+    let outside: BTreeSet<&str> = disallowed
+        .iter()
+        .filter(|item| item.reason == DisallowReason::OutsideScope)
+        .map(|item| item.path.as_str())
+        .collect();
+    let mut paths = BTreeSet::new();
+    for item in status {
+        if item.code == "??" && gated(&item.path, &audit.test_folders) {
+            paths.insert(item.path.clone());
+        }
+        for candidate in std::iter::once(&item.path).chain(item.from.iter()) {
+            if !outside.contains(candidate.as_str()) {
+                paths.insert(candidate.clone());
+            }
+        }
+    }
+    paths.into_iter().collect()
+}
+
+/// How one status entry changed, as the audit sees it.
+fn status_change(root: &Path, entry: &StatusEntry) -> PathChange {
+    if !root.join(&entry.path).exists() {
+        PathChange::Deleted
+    } else if entry.code == "??" || entry.code.starts_with('A') {
+        PathChange::Added
+    } else {
+        PathChange::Modified
+    }
+}
+
+/// True when `path` is one of the test folders or lies under one.
+fn gated(path: &str, folders: &[String]) -> bool {
+    folders.iter().any(|folder| {
+        path == folder
+            || path
+                .strip_prefix(folder.as_str())
+                .is_some_and(|rest| rest.starts_with('/'))
+    })
+}
