+//! The verified task's commit in an osq worktree.
+
+use std::collections::BTreeSet;
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use osq_core::FeatureError;
+use osq_kernel_config::Config;
+use osq_kernel_specs::TaskFile;
+use osq_kernel_storage::ChangeEntry;
+use osq_kernel_vcs::{GitVcs, StatusEntry, Vcs};
+
+use super::message::{elapsed, id, message, trailers};
+use super::{scope, time};
+
+/// Commits one verified task in the worktree at `tree_root`.
+///
+/// # Errors
+///
+/// Returns a `Failed` error with the command `run` when git status or the
+/// commit fails.
+///
+/// Implements: rust-run/verified-task-commit
+/// Implements: rust-run/task-commit-message
+pub(crate) fn verified(
+    tree_root: &Path,
+    entry: &ChangeEntry,
+    task: &str,
+    task_file: &TaskFile,
+    config: &Config,
+) -> Result<(), FeatureError> {
+    let vcs = GitVcs::new(tree_root).with_timeouts(&config.timeouts);
+    let status = vcs.status().map_err(|error| failed(error.to_string()))?;
+    let paths = paths(tree_root, entry, task, task_file, &status);
+    let events = read_events(entry, task);
+    let subject = format!("osq: {} task {task} verified", id(&entry.folder));
+    let outcome = format!(
+        "[ok] task {task} verified (elapsed: {}s)",
+        elapsed(&events, time::now_ms())
+    );
+    let message = message(
+        &subject,
+        &task_file.title,
+        &outcome,
+        &entry.folder,
+        task,
+        trailers(&events).as_ref(),
+    );
+    let refs: Vec<&str> = paths.iter().map(String::as_str).collect();
+    let author = config.vcs.author.as_deref().unwrap_or_default();
+    vcs.commit(&refs, &message, author)
+        .map(|_| ())
+        .map_err(|error| failed(commit_text(task, &entry.folder, &error)))
+}
+
+/// Every path the verified commit holds, relative to the tree's root and sorted.
+fn paths(
+    tree_root: &Path,
+    entry: &ChangeEntry,
+    task: &str,
+    task_file: &TaskFile,
+    status: &[StatusEntry],
+) -> Vec<String> {
+    let mut selected: BTreeSet<String> = scope::commit_paths(tree_root, task_file, status)
+        .into_iter()
+        .collect();
+    for record in records(entry, task) {
+        if record.is_file() {
+            selected.insert(relative(tree_root, &record));
+        }
+    }
+    selected.into_iter().collect()
+}
+
+/// The change's records a verified commit holds when they exist.
+fn records(entry: &ChangeEntry, task: &str) -> [PathBuf; 4] {
+    let run = entry.path.join(".run");
+    [
+        run.join("done").join(task),
+        run.join("results").join(format!("{task}.md")),
+        run.join("events").join(format!("{task}.jsonl")),
+        entry.path.join("tasks.md"),
+    ]
+}
+
+/// Reads one task's event stream, or empty text without one.
+fn read_events(entry: &ChangeEntry, task: &str) -> String {
+    let path = entry
+        .path
+        .join(".run")
+        .join("events")
+        .join(format!("{task}.jsonl"));
+    fs::read_to_string(path).unwrap_or_default()
+}
+
+/// A path relative to `root`, with every component joined by `/`.
+fn relative(root: &Path, path: &Path) -> String {
+    path.strip_prefix(root)
+        .unwrap_or(path)
+        .components()
+        .map(|component| component.as_os_str().to_string_lossy())
+        .collect::<Vec<_>>()
+        .join("/")
+}
+
+/// The failure for a verified task's commit git refused.
+fn commit_text(task: &str, folder: &str, error: impl std::fmt::Display) -> String {
+    format!("task {task} of {folder} is done, but osq could not commit it: {error}")
+}
+
+/// Builds the failed error for a commit step.
+fn failed(message: String) -> FeatureError {
+    FeatureError::failed("run", message)
+}
