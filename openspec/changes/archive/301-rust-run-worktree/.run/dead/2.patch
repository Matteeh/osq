@@ -0,0 +1,300 @@
+//! Proves running and committing a task of a change in an osq worktree.
+
+mod support;
+mod worktree_support;
+
+#[path = "../src/feature/message.rs"]
+mod source_message;
+
+use worktree_support::{BRANCH, FOLDER, TASK};
+
+/// The title task 1 of the fixture carries.
+const TITLE: &str = "When run, it works";
+
+/// Runs the fake pi in `mode` and expects the task to be done.
+fn run_done(name: &str, mode: &str) -> worktree_support::Repo {
+    let repo = worktree_support::build(name, mode);
+    let result = support::run(&repo.root, &["1", "1"]);
+    assert_eq!(
+        result.expect("the task is done").text,
+        format!("Task {TASK} of {FOLDER} done\n")
+    );
+    repo
+}
+
+/// Replaces every `elapsed: <n>s` with `elapsed: <s>s`.
+fn mask_elapsed(text: &str) -> String {
+    let mut masked = String::new();
+    let mut rest = text;
+    while let Some(index) = rest.find("elapsed: ") {
+        let (before, after) = rest.split_at(index + "elapsed: ".len());
+        masked.push_str(before);
+        masked.push_str("<s>");
+        rest = after.trim_start_matches(|character: char| character.is_ascii_digit());
+    }
+    masked.push_str(rest);
+    masked
+}
+
+/// Proves the change is found and run in its worktree, not in the checkout.
+///
+/// Covers: rust-run/worktree-run-finds-its-tree
+#[test]
+fn worktree_run_finds_its_tree() {
+    let repo = run_done("finds-tree", "done");
+    assert!(
+        worktree_support::exists(&repo.tree, "src/a.txt"),
+        "the worktree holds the executor's file"
+    );
+    assert!(
+        worktree_support::exists(
+            &repo.tree,
+            &format!("openspec/changes/{FOLDER}/.run/done/{TASK}")
+        ),
+        "the worktree holds the done marker"
+    );
+    assert!(
+        !worktree_support::exists(&repo.root, "src/a.txt"),
+        "the checkout holds no executor file"
+    );
+    assert!(
+        !worktree_support::exists(
+            &repo.root,
+            &format!("openspec/changes/{FOLDER}/.run/done/{TASK}")
+        ),
+        "the checkout holds no done marker"
+    );
+}
+
+/// Proves the verified task is committed on the worktree's branch.
+///
+/// Covers: rust-run/verified-task-commit
+#[test]
+fn verified_task_commit() {
+    let repo = worktree_support::build("verified-commit", "done");
+    let approved = worktree_support::tip(&repo.tree, BRANCH);
+    let result = support::run(&repo.root, &["1", "1"]);
+    result.expect("the task is done");
+    let tip = worktree_support::tip(&repo.tree, BRANCH);
+    assert_ne!(tip, approved, "the run commits on the branch");
+    let (model, version) = worktree_support::started_trailers(&repo.tree);
+    let expected = format!(
+        "osq: 001 task 1 verified\n\n{TITLE}\n[ok] task 1 verified (elapsed: <s>s)\n\nOsq-Change: {FOLDER}\nOsq-Task: {TASK}\nOsq-Model: {model}\nOsq-Version: {version}\n"
+    );
+    let actual = worktree_support::message(&repo.tree, &tip);
+    assert_eq!(
+        mask_elapsed(actual.trim_end_matches('\n')),
+        expected.trim_end_matches('\n'),
+        "the commit message"
+    );
+    let files = worktree_support::name_status(&repo.tree, &tip);
+    let rows: Vec<(&str, String)> = files
+        .iter()
+        .map(|(status, path)| (status.as_str(), path.clone()))
+        .collect();
+    assert_eq!(
+        rows,
+        vec![
+            ("A", format!("openspec/changes/{FOLDER}/.run/done/{TASK}")),
+            (
+                "A",
+                format!("openspec/changes/{FOLDER}/.run/events/{TASK}.jsonl")
+            ),
+            (
+                "A",
+                format!("openspec/changes/{FOLDER}/.run/results/{TASK}.md")
+            ),
+            ("M", format!("openspec/changes/{FOLDER}/tasks.md")),
+            ("A", "src/a.txt".to_owned()),
+        ],
+        "the commit's paths"
+    );
+}
+
+/// Proves a refused commit fails the run and keeps the done records.
+///
+/// Covers: rust-run/verified-task-commit-fails
+#[test]
+fn verified_task_commit_fails() {
+    let repo = worktree_support::build("commit-fails", "done");
+    let approved = worktree_support::tip(&repo.tree, BRANCH);
+    worktree_support::hook(&repo.root, "#!/bin/sh\necho \"refused by hook\"\nexit 1\n");
+    let error = support::run(&repo.root, &["1", "1"]).expect_err("the commit is refused");
+    let text = error.to_string();
+    assert!(
+        text.starts_with(&format!(
+            "run failed: task {TASK} of {FOLDER} is done, but osq could not commit it: "
+        )),
+        "{text}"
+    );
+    assert!(text.contains("refused by hook"), "{text}");
+    assert!(
+        worktree_support::exists(
+            &repo.tree,
+            &format!("openspec/changes/{FOLDER}/.run/done/{TASK}")
+        ),
+        "the done marker stays"
+    );
+    assert_eq!(
+        worktree_support::tip(&repo.tree, BRANCH),
+        approved,
+        "the branch tip stays at the approval commit"
+    );
+}
+
+/// Proves the commit's trailers come from the task's last started event.
+///
+/// Covers: rust-run/trailers-from-the-last-started-event
+#[test]
+fn trailers_from_the_last_started_event() {
+    let repo = worktree_support::build("trailers", "done");
+    worktree_support::write(
+        &repo.tree,
+        &format!("openspec/changes/{FOLDER}/.run/events/{TASK}.jsonl"),
+        "not json\n{\"type\":\"started\",\"timestamp\":\"2020-01-01T00:00:00.000Z\",\"data\":{\"harness\":\"old\",\"model\":\"m0\",\"osqVersion\":\"0.0.1\"}}\n",
+    );
+    let result = support::run(&repo.root, &["1", "1"]);
+    result.expect("the task is done");
+    let tip = worktree_support::tip(&repo.tree, BRANCH);
+    let message = worktree_support::message(&repo.tree, &tip);
+    let body = message.trim_end_matches('\n');
+    let (model, version) = worktree_support::started_trailers(&repo.tree);
+    assert!(
+        body.ends_with(&format!("Osq-Model: {model}\nOsq-Version: {version}")),
+        "{message}"
+    );
+    assert!(!message.contains("old"), "{message}");
+    assert!(!message.contains("m0"), "{message}");
+    assert!(!message.contains("0.0.1"), "{message}");
+    let outcome = message
+        .lines()
+        .find(|line| line.starts_with(&format!("[ok] task {TASK} verified")))
+        .expect("the outcome line");
+    let seconds: u64 = outcome
+        .split_once("elapsed: ")
+        .expect("the outcome line names the elapsed seconds")
+        .1
+        .chars()
+        .take_while(char::is_ascii_digit)
+        .collect::<String>()
+        .parse()
+        .expect("the elapsed seconds are a number");
+    assert!(seconds < 60, "{outcome}");
+}
+
+/// Proves the elapsed seconds and trailers a task's stream gives.
+///
+/// Covers: rust-run/trailers-from-the-last-started-event
+#[test]
+fn elapsed_seconds_and_trailers() {
+    let at = 1_577_836_800_000;
+    let started = "{\"type\":\"started\",\"timestamp\":\"2020-01-01T00:00:00.000Z\",\"data\":{\"harness\":\"pi\",\"model\":\"m\",\"osqVersion\":\"9\"}}\n";
+    assert_eq!(source_message::elapsed(started, at + 3_500), 3);
+    assert_eq!(source_message::elapsed(started, at - 5_000), 0);
+    assert_eq!(source_message::elapsed("", at), 0);
+    let done = "{\"type\":\"done\",\"timestamp\":\"2020-01-01T00:00:00.000Z\"}\n";
+    assert_eq!(source_message::elapsed(done, at + 3_500), 0);
+    let trailers = source_message::trailers(started).expect("the started event has trailers");
+    assert_eq!(trailers.harness, "pi");
+    assert_eq!(trailers.model, "m");
+    assert_eq!(trailers.osq_version, "9");
+    assert!(source_message::trailers(done).is_none());
+    assert_eq!(source_message::id("001-a"), "001");
+    assert_eq!(source_message::id("x-y"), "x-y");
+    assert_eq!(
+        source_message::message("s", "t", "o", "001-a", "1", Some(&trailers)),
+        "s\n\nt\no\n\nOsq-Change: 001-a\nOsq-Task: 1\nOsq-Model: pi m\nOsq-Version: 9\n"
+    );
+    assert_eq!(
+        source_message::message("s", "t", "o", "001-a", "1", None),
+        "s\n\nt\no\n\nOsq-Change: 001-a\nOsq-Task: 1\n"
+    );
+}
+
+/// Proves a change outside the checkout is not found while git is off.
+///
+/// Covers: rust-run/run-refusal-texts
+#[test]
+fn git_off_stays_in_the_checkout() {
+    let repo = worktree_support::build("git-off", "done");
+    worktree_support::write(
+        &repo.root,
+        "osq.toml",
+        format!(
+            "[executor]\nharness = \"pi\"\n\n[pi]\nbin = \"{}\"\n",
+            worktree_support::fake_pi()
+        ),
+    );
+    let error = support::run(&repo.root, &["1", "1"]).expect_err("git is off");
+    assert_eq!(
+        error.to_string(),
+        format!(
+            "run failed: Spec \"1\" not found in {}",
+            repo.root.join("openspec").join("changes").display()
+        )
+    );
+    assert!(
+        !worktree_support::exists(&repo.tree, "src/a.txt"),
+        "the worktree is not run"
+    );
+}
+
+/// Proves a change in the checkout makes no commit with git on.
+///
+/// Covers: rust-run/worktree-run-finds-its-tree
+#[test]
+fn git_on_root_makes_no_commit() {
+    let root = support::repo("git-on-root");
+    support::write(
+        &root,
+        "osq.toml",
+        format!(
+            "[executor]\nharness = \"pi\"\n\n[pi]\nbin = \"{}\"\n\n[vcs]\nenabled = true\nauthor = \"Osq Bot <bot@example.com>\"\n",
+            worktree_support::fake_pi()
+        ),
+    );
+    support::write(&root, "fake-pi-mode", "done");
+    let before = worktree_support::git(&root, &["rev-parse", "HEAD"])
+        .trim()
+        .to_owned();
+    let result = support::run(&root, &["1", "1"]);
+    assert_eq!(
+        result.expect("the task is done").text,
+        format!("Task {TASK} of {FOLDER} done\n")
+    );
+    let after = worktree_support::git(&root, &["rev-parse", "HEAD"])
+        .trim()
+        .to_owned();
+    assert_eq!(after, before, "a root change makes no commit");
+}
+
+/// Proves the commit's path choice includes scoped and untracked test paths.
+///
+/// Covers: rust-run/verified-task-commit
+#[test]
+fn commit_path_choice() {
+    let repo = worktree_support::build("commit-paths", "done");
+    worktree_support::write(&repo.tree, "tests/new.txt", "a\n");
+    worktree_support::write(&repo.tree, "lib/Cargo.toml", "[package]\nname = \"lib\"\n");
+    worktree_support::write(&repo.tree, "lib/tests/new.rs", "//! A test.\n");
+    let result = support::run(&repo.root, &["1", "1"]);
+    result.expect("the task is done");
+    let tip = worktree_support::tip(&repo.tree, BRANCH);
+    let files: Vec<String> = worktree_support::name_status(&repo.tree, &tip)
+        .into_iter()
+        .map(|(status, path)| format!("{status} {path}"))
+        .collect();
+    assert_eq!(
+        files,
+        vec![
+            "A lib/tests/new.rs".to_owned(),
+            format!("A openspec/changes/{FOLDER}/.run/done/{TASK}"),
+            format!("A openspec/changes/{FOLDER}/.run/events/{TASK}.jsonl"),
+            format!("A openspec/changes/{FOLDER}/.run/results/{TASK}.md"),
+            format!("M openspec/changes/{FOLDER}/tasks.md"),
+            "A src/a.txt".to_owned(),
+            "A tests/new.txt".to_owned(),
+        ],
+        "the commit's paths"
+    );
+}
