@@ -0,0 +1,234 @@
+//! Scratch repositories whose change lives in an osq worktree.
+//!
+//! Each test binary compiles this module on its own, so some helpers are
+//! unused in a given binary even though another test uses them.
+#![allow(dead_code)]
+
+use std::fs;
+use std::os::unix::fs::PermissionsExt;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+use osq_core::event::{Event, parse_event_line};
+use osq_kernel_storage::change_folder_seal;
+
+/// The change folder every worktree test executes.
+pub const FOLDER: &str = "001-a";
+
+/// The task every worktree test executes.
+pub const TASK: &str = "1";
+
+/// The branch the worktree checks out.
+pub const BRANCH: &str = "osq/001-a";
+
+/// The date every test commit gets.
+const DATE: &str = "2000-01-01T00:00:00+0000";
+/// The author and committer name every test commit gets.
+const NAME: &str = "Osq Test";
+/// The author and committer email every test commit gets.
+const EMAIL: &str = "osq@example.com";
+
+/// One scratch repository and the worktree that holds the change.
+pub struct Repo {
+    /// The checkout every run starts from.
+    pub root: PathBuf,
+    /// The worktree the change sits in.
+    pub tree: PathBuf,
+}
+
+/// The path of one fixture folder under the crate's `tests/fixtures`.
+pub fn fixture(name: &str) -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("tests")
+        .join("fixtures")
+        .join(name)
+}
+
+/// The fake pi's executable path, made absolute for `pi.bin`.
+pub fn fake_pi() -> String {
+    fixture("fake-pi")
+        .join("run.sh")
+        .to_string_lossy()
+        .into_owned()
+}
+
+/// A fresh empty scratch root under `CARGO_TARGET_TMPDIR`, named `name`.
+pub fn scratch(name: &str) -> PathBuf {
+    let root = Path::new(env!("CARGO_TARGET_TMPDIR"))
+        .join("run_worktree")
+        .join(name);
+    let _ = fs::remove_dir_all(&root);
+    fs::create_dir_all(&root).expect("the scratch root is created");
+    root
+}
+
+/// Builds the repository the worktree scenarios build, with the fake pi in `mode`.
+pub fn build(name: &str, mode: &str) -> Repo {
+    let root = scratch(name);
+    copy_tree(&fixture("run-project"), &root);
+    let _ = fs::remove_file(root.join(".gitignore"));
+    write(&root, "osq.toml", config());
+    git(&root, &["init", "-q", "-b", "main"]);
+    git(&root, &["config", "user.name", NAME]);
+    git(&root, &["config", "user.email", EMAIL]);
+    git(&root, &["config", "commit.gpgsign", "false"]);
+    git(&root, &["add", "-A"]);
+    git(&root, &["commit", "-q", "-m", "fixture"]);
+    let seal = change_folder_seal(&change(&root)).expect("the change folder seals");
+    write(
+        &root,
+        &format!("openspec/changes/{FOLDER}/.run/approved"),
+        format!("{}\n", seal.as_str()),
+    );
+    git(&root, &["add", "-A"]);
+    git(&root, &["commit", "-q", "-m", "osq: 001 approved"]);
+    let tree = root.join("trees").join(FOLDER);
+    fs::create_dir_all(tree.parent().expect("the tree has a parent"))
+        .expect("the trees folder is created");
+    git(
+        &root,
+        &[
+            "worktree",
+            "add",
+            "-q",
+            "-b",
+            BRANCH,
+            tree.to_str().expect("the path is UTF-8"),
+            "main",
+        ],
+    );
+    fs::remove_dir_all(change(&root)).expect("the change leaves the checkout");
+    write(&tree, "fake-pi-mode", mode);
+    Repo { root, tree }
+}
+
+/// The `osq.toml` every scratch repository holds.
+fn config() -> String {
+    format!(
+        "[executor]\nharness = \"pi\"\n\n[pi]\nbin = \"{}\"\n\n[vcs]\nenabled = true\nauthor = \"Osq Bot <bot@example.com>\"\n",
+        fake_pi()
+    )
+}
+
+/// The change folder's path under `root`.
+pub fn change(root: &Path) -> PathBuf {
+    root.join("openspec").join("changes").join(FOLDER)
+}
+
+/// Copies a folder tree, dot files included.
+pub fn copy_tree(from: &Path, to: &Path) {
+    fs::create_dir_all(to).expect("the target folder is created");
+    for entry in fs::read_dir(from).expect("the source folder is read") {
+        let entry = entry.expect("the folder entry is read");
+        let target = to.join(entry.file_name());
+        if entry.file_type().expect("the entry type is read").is_dir() {
+            copy_tree(&entry.path(), &target);
+        } else {
+            fs::copy(entry.path(), target).expect("the file is copied");
+        }
+    }
+}
+
+/// Writes one file under `root`, creating its folders.
+pub fn write(root: &Path, relative: &str, contents: impl AsRef<[u8]>) {
+    let path = root.join(relative);
+    if let Some(parent) = path.parent() {
+        fs::create_dir_all(parent).expect("the file's folders are created");
+    }
+    fs::write(path, contents).expect("the file is written");
+}
+
+/// Reads one file under `root` as text.
+pub fn read_text(root: &Path, relative: &str) -> String {
+    fs::read_to_string(root.join(relative)).expect("the file reads as text")
+}
+
+/// Whether a file or folder under `root` exists.
+pub fn exists(root: &Path, relative: &str) -> bool {
+    root.join(relative).exists()
+}
+
+/// Runs `git` in `root` with isolated settings, giving its standard output.
+pub fn git(root: &Path, args: &[&str]) -> String {
+    let mut command = Command::new("git");
+    command.args(args).current_dir(root);
+    command
+        .env("GIT_CONFIG_GLOBAL", "/dev/null")
+        .env("GIT_CONFIG_NOSYSTEM", "1")
+        .env("GIT_CONFIG_COUNT", "1")
+        .env("GIT_CONFIG_KEY_0", "maintenance.auto")
+        .env("GIT_CONFIG_VALUE_0", "false")
+        .env("GIT_AUTHOR_NAME", NAME)
+        .env("GIT_AUTHOR_EMAIL", EMAIL)
+        .env("GIT_AUTHOR_DATE", DATE)
+        .env("GIT_COMMITTER_NAME", NAME)
+        .env("GIT_COMMITTER_EMAIL", EMAIL)
+        .env("GIT_COMMITTER_DATE", DATE);
+    let output = command.output().expect("git starts");
+    assert!(
+        output.status.success(),
+        "git {} failed in {}: {}",
+        args.join(" "),
+        root.display(),
+        String::from_utf8_lossy(&output.stderr)
+    );
+    String::from_utf8_lossy(&output.stdout).into_owned()
+}
+
+/// Writes an executable `.git/hooks/pre-commit` in the checkout at `root`.
+pub fn hook(root: &Path, script: &str) {
+    let path = root.join(".git").join("hooks").join("pre-commit");
+    write(root, ".git/hooks/pre-commit", script);
+    let mut permissions = fs::metadata(&path).expect("the hook reads").permissions();
+    permissions.set_mode(0o755);
+    fs::set_permissions(&path, permissions).expect("the hook is executable");
+}
+
+/// The commit one rev names in the worktree at `tree`.
+pub fn tip(tree: &Path, rev: &str) -> String {
+    git(tree, &["rev-parse", rev]).trim().to_owned()
+}
+
+/// The raw message of the commit one rev names.
+pub fn message(tree: &Path, rev: &str) -> String {
+    git(tree, &["log", "-1", "--format=%B", rev])
+}
+
+/// Each name-status line of one commit, as its status and path.
+pub fn name_status(tree: &Path, rev: &str) -> Vec<(String, String)> {
+    git(
+        tree,
+        &["show", "--no-renames", "--name-status", "--format=", rev],
+    )
+    .lines()
+    .filter(|line| !line.trim().is_empty())
+    .map(|line| {
+        let mut parts = line.split('\t');
+        let status = parts.next().unwrap_or_default().to_owned();
+        let path = parts.next().unwrap_or_default().to_owned();
+        (status, path)
+    })
+    .collect()
+}
+
+/// The model and version the last usable `started` event of the task records.
+pub fn started_trailers(tree: &Path) -> (String, String) {
+    let text = read_text(
+        tree,
+        &format!("openspec/changes/{FOLDER}/.run/events/{TASK}.jsonl"),
+    );
+    let mut found = None;
+    for line in text.lines() {
+        let Ok(envelope) = parse_event_line(line) else {
+            continue;
+        };
+        if let Event::Started(data) = envelope.event {
+            if let (Some(harness), Some(model), Some(version)) =
+                (data.harness, data.model, data.osq_version)
+            {
+                found = Some((format!("{harness} {model}"), version));
+            }
+        }
+    }
+    found.expect("the task's stream holds a started event with trailers")
+}
