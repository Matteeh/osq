+//! The message one osq task commit carries, built as TypeScript builds it.
+
+use osq_kernel_storage::timestamp_ms;
+use serde_json::Value;
+
+/// The harness, model and osq version one usable `started` event records.
+pub(crate) struct Trailers {
+    /// The harness that started.
+    pub(crate) harness: String,
+    /// The model the harness ran.
+    pub(crate) model: String,
+    /// The osq version that started it.
+    pub(crate) osq_version: String,
+}
+
+/// The harness, model and version of the last usable `started` event.
+///
+/// Implements: rust-run/task-commit-message
+pub(crate) fn trailers(events: &str) -> Option<Trailers> {
+    events.split('\n').filter_map(started).next_back()
+}
+
+/// The harness, model and version of one usable `started` line.
+fn started(line: &str) -> Option<Trailers> {
+    let event: Value = serde_json::from_str(line).ok()?;
+    let record = event.as_object()?;
+    if record.get("type")?.as_str()? != "started" {
+        return None;
+    }
+    let data = record.get("data")?.as_object()?;
+    Some(Trailers {
+        harness: data.get("harness")?.as_str()?.to_owned(),
+        model: data.get("model")?.as_str()?.to_owned(),
+        osq_version: data.get("osqVersion")?.as_str()?.to_owned(),
+    })
+}
+
+/// Whole seconds from the last `started` event's timestamp to `now_ms`.
+///
+/// Implements: rust-run/task-commit-message
+pub(crate) fn elapsed(events: &str, now_ms: i64) -> i64 {
+    match started_at(events) {
+        Some(at) => (now_ms - at).max(0) / 1000,
+        None => 0,
+    }
+}
+
+/// The timestamp of the last parseable `started` event, in epoch milliseconds.
+fn started_at(events: &str) -> Option<i64> {
+    events.split('\n').filter_map(started_ms).next_back()
+}
+
+/// The timestamp of one `started` line, when it has a usable one.
+fn started_ms(line: &str) -> Option<i64> {
+    let event: Value = serde_json::from_str(line).ok()?;
+    let record = event.as_object()?;
+    if record.get("type")?.as_str()? != "started" {
+        return None;
+    }
+    timestamp_ms(record.get("timestamp")?.as_str()?)
+}
+
+/// Assembles one osq task commit message, as `formatCommitMessage` does.
+///
+/// Implements: rust-run/task-commit-message
+pub(crate) fn message(
+    subject: &str,
+    title: &str,
+    outcome: &str,
+    folder: &str,
+    task: &str,
+    trailers: Option<&Trailers>,
+) -> String {
+    let mut lines = vec![
+        subject.to_owned(),
+        String::new(),
+        title.to_owned(),
+        outcome.to_owned(),
+        String::new(),
+        format!("Osq-Change: {folder}"),
+        format!("Osq-Task: {task}"),
+    ];
+    if let Some(trailers) = trailers {
+        lines.push(format!(
+            "Osq-Model: {} {}",
+            trailers.harness, trailers.model
+        ));
+        lines.push(format!("Osq-Version: {}", trailers.osq_version));
+    }
+    lines.push(String::new());
+    lines.join("\n")
+}
+
+/// The change folder's leading digits, or its whole name without any.
+///
+/// Implements: rust-run/task-commit-message
+pub(crate) fn id(folder: &str) -> String {
+    let digits: String = folder.chars().take_while(char::is_ascii_digit).collect();
+    if digits.is_empty() {
+        folder.to_owned()
+    } else {
+        digits
+    }
+}
