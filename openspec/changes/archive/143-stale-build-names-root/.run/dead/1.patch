diff --git a/tests/stale-build-root.test.ts b/tests/stale-build-root.test.ts
new file mode 100644
index 0000000..4fc0b98
--- /dev/null
+++ b/tests/stale-build-root.test.ts
@@ -0,0 +1,124 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { afterEach, beforeEach, describe, it } from 'node:test';
+import { DEFAULT_CONFIG } from '../src/core/foundation/config.js';
+import { scaffoldProject } from '../src/core/foundation/init.js';
+import { createNewSpec } from '../src/core/foundation/new.js';
+import { approveSpec } from '../src/core/spec/approve.js';
+import { MockAdapter } from '../src/harness/mock.js';
+import { StaleBuildError, findStaleBuild, staleBuildMessage } from '../src/watcher/build.js';
+import { runWatcherCycle, startWatcher } from '../src/watcher/loop.js';
+import { installFakeValidator } from './helpers.js';
+
+const PASSING_VERIFY = 'node verify.cjs';
+const LOCAL_VERIFIER = `const fs = require('node:fs');
+if (!fs.existsSync('openspec')) {
+  process.exit(1);
+}
+process.exit(0);
+`;
+
+const NEWER_SRC_TIME = new Date('2024-01-03T00:00:00Z');
+const OLDER_DIST_TIME = new Date('2024-01-01T00:00:00Z');
+
+/** Write `src/` newer than `dist/` under `root`, returning the package root. */
+async function makeStalePackage(root: string): Promise<string> {
+  const srcFile = path.join(root, 'src', 'index.ts');
+  const distFile = path.join(root, 'dist', 'index.js');
+  await fs.mkdir(path.dirname(srcFile), { recursive: true });
+  await fs.mkdir(path.dirname(distFile), { recursive: true });
+  await fs.writeFile(srcFile, 'source', 'utf8');
+  await fs.writeFile(distFile, 'compiled', 'utf8');
+  await fs.utimes(srcFile, NEWER_SRC_TIME, NEWER_SRC_TIME);
+  await fs.utimes(distFile, OLDER_DIST_TIME, OLDER_DIST_TIME);
+  return root;
+}
+
+async function writeTask1(specFolder: string): Promise<void> {
+  const task = [
+    '---',
+    'title: A stale root test task',
+    `verify: ${PASSING_VERIFY}`,
+    'scope: []',
+    'entry: []',
+    'skills: []',
+    '---',
+    '## Acceptance',
+    '- [ ] completes',
+  ].join('\n');
+  await fs.writeFile(path.join(specFolder, 'tasks', '1.md'), `${task}\n`, 'utf8');
+}
+
+/** An approved one-task change with a local verifier, ready for a cycle. */
+async function setupApprovedSpec(projectRoot: string): Promise<void> {
+  const spec = await createNewSpec(projectRoot, 'Stale Build Root');
+  await fs.writeFile(path.join(projectRoot, 'verify.cjs'), LOCAL_VERIFIER, 'utf8');
+  const proposalPath = path.join(spec.folderPath, 'proposal.md');
+  const proposal = await fs.readFile(proposalPath, 'utf8');
+  await fs.writeFile(
+    proposalPath,
+    proposal.replace(/^verify:\s*.*$/m, `verify: ${PASSING_VERIFY}`),
+    'utf8',
+  );
+  await writeTask1(spec.folderPath);
+  await approveSpec(projectRoot, '001', DEFAULT_CONFIG);
+}
+
+describe('Stale build line names the package root', () => {
+  let tmpDir: string;
+  let originalError: typeof console.error;
+
+  beforeEach(async () => {
+    tmpDir = await fs.mkdtemp(path.join(os.tmpdir(), 'osq-stale-build-root-'));
+    await installFakeValidator(tmpDir);
+    await scaffoldProject(tmpDir);
+    originalError = console.error;
+  });
+
+  afterEach(async () => {
+    console.error = originalError;
+    await fs.rm(tmpDir, { recursive: true, force: true });
+  });
+
+  it('names the absolute root when findStaleBuild is given a relative one', async () => {
+    const packageRoot = await makeStalePackage(path.join(tmpDir, 'package'));
+    const relativeRoot = path.relative(process.cwd(), packageRoot);
+
+    assert.equal(
+      await findStaleBuild({ packageRoot: relativeRoot }),
+      staleBuildMessage(packageRoot),
+    );
+  });
+
+  it('prints the absolute-root line and exits 1 at watcher start in once mode', async () => {
+    const packageRoot = await makeStalePackage(path.join(tmpDir, 'package'));
+    const relativeRoot = path.relative(process.cwd(), packageRoot);
+    const errorLines: string[] = [];
+    const exits: number[] = [];
+    console.error = (...args: unknown[]) => {
+      errorLines.push(args.map(String).join(' '));
+    };
+
+    await startWatcher(tmpDir, DEFAULT_CONFIG, new MockAdapter(), {
+      once: true,
+      packageRoot: relativeRoot,
+      exit: (code) => exits.push(code),
+    });
+
+    assert.deepEqual(errorLines, [staleBuildMessage(packageRoot)]);
+    assert.deepEqual(exits, [1]);
+  });
+
+  it('rejects with a StaleBuildError carrying the line the check returned', async () => {
+    await setupApprovedSpec(tmpDir);
+    const line = staleBuildMessage('/some/other/package/root');
+
+    await assert.rejects(
+      () =>
+        runWatcherCycle(tmpDir, DEFAULT_CONFIG, new MockAdapter(), undefined, async () => line),
+      (err: unknown) => err instanceof StaleBuildError && err.message === line,
+    );
+  });
+});
