@@ -0,0 +1,35 @@
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import type { HarnessAdapter, SpawnResult, SpawnTaskOptions } from '../src/harness/types.js';
+import { runWatcherOnce } from '../src/watcher/loop.js';
+import { recoveryConfig } from './recovery-support.js';
+
+/**
+ * A real watcher process a recovery test can kill mid-task. Given the repo, the
+ * worktree root and a ready-file path, it runs one watcher pass whose executor
+ * writes `half` to the task's first scoped file, writes the ready file, then
+ * never resolves, so the test can SIGKILL the process while its lock is held.
+ */
+const [repo, worktreeRoot, readyPath] = process.argv.slice(2);
+
+const adapter: HarnessAdapter = {
+  name: 'half-writer',
+  async setup(): Promise<void> {},
+
+  async spawn(options: SpawnTaskOptions): Promise<SpawnResult> {
+    const target = options.scope[0];
+    if (target !== undefined) {
+      const file = path.join(options.projectRoot, target);
+      await fs.mkdir(path.dirname(file), { recursive: true });
+      await fs.writeFile(file, 'half\n', 'utf8');
+    }
+    if (readyPath !== undefined) {
+      await fs.writeFile(readyPath, 'ready\n', 'utf8');
+    }
+    return new Promise<SpawnResult>(() => {});
+  },
+};
+
+if (repo !== undefined && worktreeRoot !== undefined) {
+  await runWatcherOnce(repo, recoveryConfig(worktreeRoot, 1), adapter);
+}
diff --git a/tests/recovery-killed-watcher.test.ts b/tests/recovery-killed-watcher.test.ts
new file mode 100644
index 00000000..683ede3f
--- /dev/null
+++ b/tests/recovery-killed-watcher.test.ts
@@ -0,0 +1,148 @@
+import assert from 'node:assert/strict';
+import { type ChildProcess, spawn } from 'node:child_process';
+import fs from 'node:fs/promises';
+import { createRequire } from 'node:module';
+import path from 'node:path';
+import { afterEach, describe, it } from 'node:test';
+import { setTimeout as delay } from 'node:timers/promises';
+import { fileURLToPath } from 'node:url';
+import {
+  ScriptedAdapter,
+  assertOk,
+  createRecoveryProject,
+  exists,
+  git,
+} from './recovery-support.js';
+
+const repoRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const require = createRequire(import.meta.url);
+const tsxLoader = require.resolve('tsx');
+const gitTestEnv = path.join(repoRoot, 'tests', 'git-test-env.ts');
+const childScript = path.join(repoRoot, 'tests', 'recovery-killed-watcher-child.ts');
+
+const tmpDirs: string[] = [];
+
+afterEach(async () => {
+  for (const dir of tmpDirs.splice(0)) {
+    await fs.rm(dir, { recursive: true, force: true });
+  }
+});
+
+/** Poll until `target` exists or `timeoutMs` elapses. */
+async function waitForFile(target: string, timeoutMs: number): Promise<void> {
+  const deadline = Date.now() + timeoutMs;
+  while (Date.now() < deadline) {
+    if (await exists(target)) return;
+    await delay(25);
+  }
+  throw new Error(`timed out waiting for ${target}`);
+}
+
+/** Resolve once the child has exited. */
+function childExit(child: ChildProcess): Promise<void> {
+  return new Promise((resolve) => child.once('exit', () => resolve()));
+}
+
+/** The sorted entries of `dir`, or null when it does not exist. */
+async function snapshotDir(dir: string): Promise<string[] | null> {
+  return fs
+    .readdir(dir)
+    .then((entries) => entries.sort())
+    .catch(() => null);
+}
+
+describe("Killed watcher's task resumed", () => {
+  it('names the stopped watcher at retry, reaps the lock, retries, and lands', async () => {
+    const project = await createRecoveryProject(tmpDirs, {
+      tasks: [{ title: 'First task', scope: 'src/one.txt' }],
+      autoRetries: 1,
+    });
+
+    // Approval puts the change on its branch in a worktree, where it runs.
+    assertOk(await project.approve(), 'approve');
+
+    const worktreeRoot =
+      project.config.vcs?.worktreeRoot ?? path.join(path.dirname(project.repo), 'worktrees');
+    const readyPath = path.join(path.dirname(project.repo), 'ready');
+    const runDir = path.join(project.changeFolder, '.run');
+    const lockPath = path.join(runDir, 'running', '1.pid');
+
+    const child = spawn(
+      process.execPath,
+      [
+        '--import',
+        tsxLoader,
+        '--import',
+        gitTestEnv,
+        childScript,
+        project.repo,
+        worktreeRoot,
+        readyPath,
+      ],
+      {
+        cwd: project.repo,
+        env: { ...process.env, NO_COLOR: '1', CI: '1' },
+        stdio: ['ignore', 'pipe', 'pipe'],
+      },
+    );
+
+    let childStderr = '';
+    child.stderr?.on('data', (chunk: Buffer) => {
+      childStderr += chunk.toString();
+    });
+
+    try {
+      // The executor wrote part of `src/one.txt` and opened its lock.
+      try {
+        await waitForFile(readyPath, 15000);
+      } catch (error) {
+        throw new Error(`${(error as Error).message}\nchild stderr:\n${childStderr}`);
+      }
+
+      // THEN the watcher process is killed mid-task.
+      child.kill('SIGKILL');
+      await childExit(child);
+      assert.equal(await exists(lockPath), true);
+    } finally {
+      if (child.exitCode === null && child.signalCode === null) {
+        child.kill('SIGKILL');
+      }
+    }
+
+    const lock = JSON.parse(await fs.readFile(lockPath, 'utf8')) as { pid: number };
+    const pid = lock.pid;
+    const lockBefore = await fs.readFile(lockPath, 'utf8');
+    const deadBefore = await snapshotDir(path.join(runDir, 'dead'));
+
+    // THEN osq retry exits 1 with the stopped-watcher refusal.
+    const retry = await project.retry('1');
+    assert.equal(retry.exitCode, 1);
+    assert.match(
+      retry.stderr,
+      new RegExp(`Task 1 was left running by a stopped watcher \\(pid ${pid}\\)`),
+    );
+
+    // THEN the lock and every marker are unchanged.
+    assert.equal(await fs.readFile(lockPath, 'utf8'), lockBefore);
+    assert.deepEqual(await snapshotDir(path.join(runDir, 'dead')), deadBefore);
+
+    // The next watcher reaps the lock and retries the task automatically.
+    const adapter = new ScriptedAdapter(() => 'good\n');
+    await project.watchOnce(adapter);
+    assert.equal(adapter.calls.length, 1);
+
+    // THEN the archived folder holds the crashed lock as retained history and
+    // the retried attempt's done marker.
+    assert.equal(await exists(path.join(project.archivedFolder, '.run', 'dead', '1.1.md')), true);
+    assert.match(
+      await fs.readFile(path.join(project.archivedFolder, '.run', 'dead', '1.1.md'), 'utf8'),
+      /reason: crashed/,
+    );
+    assert.equal(await exists(path.join(project.archivedFolder, '.run', 'done', '1')), true);
+
+    // THEN osq land exits 0 with the retried attempt's src/one.txt.
+    assertOk(await project.land(), 'land');
+    assert.equal(await fs.readFile(path.join(project.repo, 'src', 'one.txt'), 'utf8'), 'good\n');
+    assert.equal(await git(['status', '--porcelain'], project.repo), '');
+  });
+});
