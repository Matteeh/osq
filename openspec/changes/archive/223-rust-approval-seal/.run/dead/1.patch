--- /dev/null
+++ b/crates/core/tests/seal_compute.rs
@@ -0,0 +1,144 @@
+//! Proves `compute_seal` gives the seal `hashChangeFolder` gives.
+
+use osq_core::compute_seal;
+
+/// The seal text `compute_seal` gives for entries.
+fn seal(entries: &[(&str, &[u8])]) -> String {
+    compute_seal(entries).to_string()
+}
+
+/// Proves no entries give the empty digest.
+///
+/// Covers: rust-core/seals-of-entries
+#[test]
+fn none() {
+    assert_eq!(
+        seal(&[]),
+        "sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
+    );
+}
+
+/// Proves one plain entry.
+///
+/// Covers: rust-core/seals-of-entries
+#[test]
+fn plain_entry() {
+    assert_eq!(
+        seal(&[("proposal.md", b"a\n")]),
+        "sha256:0dde7716d600b92d32148bafc60a3111581ee9c4836ae6925c584dcaac2ab9bd"
+    );
+}
+
+/// Proves CRLF and LF content give one seal.
+///
+/// Covers: rust-core/seals-of-entries
+#[test]
+fn crlf_is_lf() {
+    let expected = "sha256:84e73026f37063934c900dfa2c1ecf3f8fdebffc3b1483d78a2275a21b248241";
+    assert_eq!(seal(&[("a.md", b"x\r\ny\r\n")]), expected);
+    assert_eq!(seal(&[("a.md", b"x\ny\n")]), expected);
+}
+
+/// Proves checked and unchecked boxes in `tasks.md` give one seal.
+///
+/// Covers: rust-core/seals-of-entries
+#[test]
+fn tasks_checkboxes_reset() {
+    let expected = "sha256:c66367cc16aa800f014845d20689fc87356ebee7053a9dfd46653693529a011a";
+    assert_eq!(
+        seal(&[("tasks.md", b"- [x] 1. a\n  - [X] 2. b\n")]),
+        expected
+    );
+    assert_eq!(
+        seal(&[("tasks.md", b"- [ ] 1. a\n  - [ ] 2. b\n")]),
+        expected
+    );
+}
+
+/// Proves only the root `tasks.md` has its checkboxes reset.
+///
+/// Covers: rust-core/seals-of-entries
+#[test]
+fn nested_tasks_not_reset() {
+    assert_eq!(
+        seal(&[("notes/tasks.md", b"- [x] 1. a\n")]),
+        "sha256:fa65172b5ab5cee5da25838e4c968ded29d7a4837aa65283758225af2586088f"
+    );
+}
+
+/// Proves U+00A0 is whitespace before a checkbox.
+///
+/// Covers: rust-core/seals-of-entries
+#[test]
+fn nbsp_is_space() {
+    assert_eq!(
+        seal(&[("tasks.md", "\u{A0}- [x] a\n".as_bytes())]),
+        "sha256:ba2854b7aadd6685d64d1624f7b144e4b5e5d69e017060244b846491ef0b304b"
+    );
+}
+
+/// Proves U+0085 is not whitespace before a checkbox.
+///
+/// Covers: rust-core/seals-of-entries
+#[test]
+fn nel_is_not_space() {
+    assert_eq!(
+        seal(&[("tasks.md", "\u{85}- [x] a\n".as_bytes())]),
+        "sha256:52902fea6a1daefdb3316706390ca2fc5a816709f0eb28a514aacc0a31f007d0"
+    );
+}
+
+/// Proves invalid UTF-8 decodes with replacement characters.
+///
+/// Covers: rust-core/seals-of-entries
+#[test]
+fn invalid_utf8_is_replaced() {
+    assert_eq!(
+        seal(&[("b.bin", &[0xFF, 0xFE, 0x41])]),
+        "sha256:f2859d36ed56daac01133dde3da6a05522a65da80d2fe1659fd1cf64716c8ac8"
+    );
+}
+
+/// Proves entries sort by UTF-16 code unit, whatever their given order.
+///
+/// Covers: rust-core/javascript-path-order
+#[test]
+fn utf16_path_order() {
+    let high = ("a-\u{FF61}.md", b"2\n".as_slice());
+    let astral = ("a-\u{1F600}.md", b"1\n".as_slice());
+    let utf16 = "sha256:f47bbfc7ba5286ec24f4ddf82d9bf58771d785ef0b0806c45b8e4ca2ff469938";
+    assert_eq!(seal(&[high, astral]), utf16);
+    assert_eq!(seal(&[astral, high]), utf16);
+}
+
+/// Proves line-start and whitespace edges of the checkbox reset, each against
+/// the seal of the reset text.
+///
+/// Covers: rust-core/seals-of-entries
+#[test]
+fn checkbox_edges_match_reset_text() {
+    let cases: [(&str, &str); 7] = [
+        ("a\n- [x] b\n", "a\n- [ ] b\n"),
+        ("a\r- [x] b\n", "a\r- [ ] b\n"),
+        ("a\u{2028}- [x] b", "a\u{2028}- [ ] b"),
+        ("a\u{2029}- [X] b", "a\u{2029}- [ ] b"),
+        ("-\t\u{FEFF}[x]", "-\t\u{FEFF}[ ]"),
+        ("\n\n  -   [x]]", "\n\n  -   [ ]]"),
+        ("a - [x] b\n", "a - [x] b\n"),
+    ];
+    for (before, after) in cases {
+        assert_eq!(
+            seal(&[("tasks.md", before.as_bytes())]),
+            seal(&[("tasks.md", after.as_bytes())]),
+            "{before:?}"
+        );
+    }
+    assert_ne!(
+        seal(&[("tasks.md", b"-[xx]")]),
+        seal(&[("tasks.md", b"-[ x]")])
+    );
+    assert_ne!(
+        seal(&[("tasks.md", b"- [y]")]),
+        seal(&[("tasks.md", b"- [ ]")])
+    );
+}
