+//! Content normalization as `hashChangeFolder` does it in JavaScript.
+//!
+//! Implements: rust-core/seal-computation
+
+/// The file name whose checkboxes are reset.
+const TASKS_FILE: &str = "tasks.md";
+
+/// Decodes bytes as JavaScript decodes UTF-8, turns CRLF into LF and, for
+/// `tasks.md` alone, resets checkboxes.
+pub(super) fn normalize(path: &str, bytes: &[u8]) -> String {
+    let text = String::from_utf8_lossy(bytes).replace("\r\n", "\n");
+    if path == TASKS_FILE {
+        reset_checkboxes(&text)
+    } else {
+        text
+    }
+}
+
+/// Ports `/^(\s*-\s*\[)[xX](\])/gm` with ` ` in place of the letter.
+fn reset_checkboxes(text: &str) -> String {
+    let mut chars: Vec<char> = text.chars().collect();
+    for start in 0..chars.len() {
+        if is_line_start(&chars, start) {
+            if let Some(letter) = checkbox_at(&chars, start) {
+                chars[letter] = ' ';
+            }
+        }
+    }
+    chars.into_iter().collect()
+}
+
+/// Whether `index` is the text's start or follows a JavaScript line terminator.
+fn is_line_start(chars: &[char], index: usize) -> bool {
+    index == 0 || matches!(chars[index - 1], '\n' | '\r' | '\u{2028}' | '\u{2029}')
+}
+
+/// The index of the `x` or `X` of a checkbox whose match begins at `start`.
+fn checkbox_at(chars: &[char], start: usize) -> Option<usize> {
+    let dash = skip_spaces(chars, start);
+    if chars.get(dash) != Some(&'-') {
+        return None;
+    }
+    let bracket = skip_spaces(chars, dash + 1);
+    if chars.get(bracket) != Some(&'[') {
+        return None;
+    }
+    let letter = bracket + 1;
+    let marked = matches!(chars.get(letter), Some('x' | 'X'));
+    (marked && chars.get(letter + 1) == Some(&']')).then_some(letter)
+}
+
+/// The index of the first character at or after `from` that is not `\s`.
+fn skip_spaces(chars: &[char], from: usize) -> usize {
+    from + chars[from..]
+        .iter()
+        .take_while(|&&c| is_js_space(c))
+        .count()
+}
+
+/// JavaScript's `\s`, which is not `char::is_whitespace`.
+fn is_js_space(c: char) -> bool {
+    matches!(
+        c,
+        '\t' | '\n' | '\u{B}' | '\u{C}' | '\r' | ' ' | '\u{A0}' | '\u{1680}' | '\u{2000}'
+            ..='\u{200A}'
+                | '\u{2028}'
+                | '\u{2029}'
+                | '\u{202F}'
+                | '\u{205F}'
+                | '\u{3000}'
+                | '\u{FEFF}'
+    )
+}
