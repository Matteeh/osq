index 000000000..82f5f55b9
--- /dev/null
+++ b/crates/kernel/storage/tests/reading_dependencies_added.rs
@@ -0,0 +1,140 @@
+//! Proves reading the dependencies that a change folder's task streams add.
+
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use osq_kernel_storage::{DependencyPair, read_dependencies_added};
+
+/// A fresh change folder under `CARGO_TARGET_TMPDIR`.
+fn scratch(test: &str, name: &str) -> PathBuf {
+    let folder = Path::new(env!("CARGO_TARGET_TMPDIR"))
+        .join("reading_dependencies_added")
+        .join(test)
+        .join(name);
+    let _ = fs::remove_dir_all(&folder);
+    fs::create_dir_all(&folder).expect("the scratch change folder is created");
+    folder
+}
+
+/// Writes a file, creating its parent folders.
+fn write(path: &Path, text: &str) {
+    if let Some(parent) = path.parent() {
+        fs::create_dir_all(parent).expect("the parent folder is created");
+    }
+    fs::write(path, text).expect("the file is written");
+}
+
+/// One `dependencies_added` event line with the given `added` JSON value.
+fn added(value: &str) -> String {
+    format!(
+        "{{\"type\":\"dependencies_added\",\"timestamp\":\"2026-10-20T08:00:00.000Z\",\
+         \"data\":{{\"added\":{value}}}}}"
+    )
+}
+
+/// One pair written as `<name> (<file>)`, as the table names it.
+fn pair(name: &str, file: &str) -> DependencyPair {
+    DependencyPair {
+        file: file.to_owned(),
+        name: name.to_owned(),
+    }
+}
+
+/// One row of the "Dependencies of task streams" table.
+struct Row {
+    /// The scratch folder's name.
+    name: &'static str,
+    /// The event files, by name and lines.
+    files: Vec<(&'static str, Vec<String>)>,
+    /// The pairs the row expects, in order.
+    expected: Vec<DependencyPair>,
+}
+
+/// Every "Dependencies of task streams" row, in the table's order.
+fn rows() -> Vec<Row> {
+    vec![
+        Row {
+            name: "two-files",
+            files: vec![
+                (
+                    "1.jsonl",
+                    vec![added(
+                        r#"[{"file":"package.json","name":"zod"},{"file":"package.json","name":"zod"},{"file":" Cargo.toml ","name":" serde "},{"file":"","name":"empty-file"},{"file":"Cargo.toml","name":7},"bad"]"#,
+                    )],
+                ),
+                (
+                    "2.jsonl",
+                    vec![added(r#"[{"file":"Cargo.toml","name":"anyhow"}]"#)],
+                ),
+            ],
+            expected: vec![
+                pair("anyhow", "Cargo.toml"),
+                pair("serde", "Cargo.toml"),
+                pair("zod", "package.json"),
+            ],
+        },
+        Row {
+            name: "not-an-array",
+            files: vec![(
+                "1.jsonl",
+                vec![added(r#"{"file":"Cargo.toml","name":"serde"}"#)],
+            )],
+            expected: Vec::new(),
+        },
+        Row {
+            name: "other-names",
+            files: vec![
+                (
+                    "change.jsonl",
+                    vec![added(r#"[{"file":"Cargo.toml","name":"serde"}]"#)],
+                ),
+                (
+                    "1.json",
+                    vec![added(r#"[{"file":"Cargo.toml","name":"serde"}]"#)],
+                ),
+            ],
+            expected: Vec::new(),
+        },
+        Row {
+            name: "sorted-and-loose",
+            files: vec![(
+                "1.jsonl",
+                vec![
+                    String::from("not json"),
+                    added(r#"[{"file":"b","name":"x"},{"file":"a","name":"y"}]"#),
+                ],
+            )],
+            expected: vec![pair("y", "a"), pair("x", "b")],
+        },
+        Row {
+            name: "no-events-folder",
+            files: Vec::new(),
+            expected: Vec::new(),
+        },
+    ]
+}
+
+/// Writes a row's event files into its folder.
+fn write_row(folder: &Path, files: &[(&str, Vec<String>)]) {
+    for (name, lines) in files {
+        let content = lines.join("\n") + "\n";
+        write(&folder.join(".run").join("events").join(name), &content);
+    }
+}
+
+/// Proves every row of the "Dependencies of task streams" table.
+///
+/// Covers: rust-storage/dependencies-of-task-streams
+#[test]
+fn dependencies_of_task_streams() {
+    for row in rows() {
+        let folder = scratch("dependencies_of_task_streams", row.name);
+        write_row(&folder, &row.files);
+        assert_eq!(
+            read_dependencies_added(&folder),
+            row.expected,
+            "{}",
+            row.name
+        );
+    }
+}
diff --git a/crates/kernel/storage/tests/reading_task_sizes.rs b/crates/kernel/storage/tests/reading_task_sizes.rs
new file mode 100644
index 000000000..fc1433160
--- /dev/null
+++ b/crates/kernel/storage/tests/reading_task_sizes.rs
@@ -0,0 +1,362 @@
+//! Proves measuring change folders against TypeScript's report rows.
+
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use osq_kernel_storage::{ScopeResolver, TaskSize, read_task_sizes};
+
+/// A fresh change folder under `CARGO_TARGET_TMPDIR`.
+fn scratch(test: &str, name: &str) -> PathBuf {
+    let folder = Path::new(env!("CARGO_TARGET_TMPDIR"))
+        .join("reading_task_sizes")
+        .join(test)
+        .join(name);
+    let _ = fs::remove_dir_all(&folder);
+    fs::create_dir_all(&folder).expect("the scratch change folder is created");
+    folder
+}
+
+/// Writes a file, creating its parent folders.
+fn write(path: &Path, text: &str) {
+    if let Some(parent) = path.parent() {
+        fs::create_dir_all(parent).expect("the parent folder is created");
+    }
+    fs::write(path, text).expect("the file is written");
+}
+
+/// One event line with the given type, timestamp and data.
+fn line(kind: &str, timestamp: &str, data: &str) -> String {
+    format!("{{\"type\":\"{kind}\",\"timestamp\":\"2026-10-20T{timestamp}\",\"data\":{data}}}")
+}
+
+/// The task file every row writes.
+const TASK_FILE: &str = "---\ntitle: When one runs, it passes\n---\n\n\
+## Acceptance\n- [ ] first\n- [ ] second\n- [ ] third\n";
+
+/// One row of the "Task sizes of task streams" table.
+struct Row {
+    /// The scratch folder's name.
+    name: &'static str,
+    /// The event lines, in order. A line starting with `not` stays raw.
+    lines: Vec<String>,
+    /// The one task the row expects, or `None` for no entry.
+    expected: Option<TaskSize>,
+}
+
+/// The task size every row expects unless it says otherwise.
+fn expected(
+    scope_files: f64,
+    resolver: ScopeResolver,
+    attempts: u64,
+    first_attempt_pass: bool,
+    duration_ms: Option<i64>,
+) -> TaskSize {
+    TaskSize {
+        task: String::from("1"),
+        title: String::from("When one runs, it passes"),
+        acceptance_lines: 3,
+        scope_files,
+        resolver,
+        attempts,
+        first_attempt_pass,
+        duration_ms,
+    }
+}
+
+/// The lines of the first row, reused by the task-file ordering scenario.
+fn measured_lines() -> Vec<String> {
+    vec![
+        line(
+            "measures",
+            "08:00:00.000Z",
+            r#"{"phase":"start","scopeFiles":2}"#,
+        ),
+        line("started", "08:00:01.000Z", "{}"),
+        line("done", "08:01:00.000Z", "{}"),
+        line("measures", "08:01:00.000Z", r#"{"phase":"end"}"#),
+    ]
+}
+
+/// The rows naming each resolver generation.
+fn resolver_rows() -> Vec<Row> {
+    vec![
+        Row {
+            name: "legacy",
+            lines: measured_lines(),
+            expected: Some(expected(2.0, ScopeResolver::Legacy, 1, true, Some(60_000))),
+        },
+        Row {
+            name: "resolver-2",
+            lines: vec![
+                line(
+                    "measures",
+                    "08:00:00.000Z",
+                    r#"{"phase":"start","scopeFiles":3,"scopeResolver":2}"#,
+                ),
+                line("started", "08:00:05.000Z", "{}"),
+                line("done", "08:30:00.000Z", "{}"),
+                line(
+                    "measures",
+                    "08:30:00.000Z",
+                    r#"{"phase":"end","scopeHashes":{"a":"1","b":"2","c":"3","d":"4","e":"5","f":"6","g":"7","h":"8","i":"9"}}"#,
+                ),
+            ],
+            expected: Some(expected(
+                9.0,
+                ScopeResolver::Second,
+                1,
+                true,
+                Some(1_800_000),
+            )),
+        },
+        Row {
+            name: "resolver-3",
+            lines: vec![
+                line(
+                    "measures",
+                    "08:00:00.000Z",
+                    r#"{"phase":"start","scopeFiles":1,"scopeResolver":3}"#,
+                ),
+                line("started", "08:00:01.000Z", "{}"),
+                line("done", "08:06:00.000Z", "{}"),
+            ],
+            expected: Some(expected(1.0, ScopeResolver::Other, 1, true, None)),
+        },
+        Row {
+            name: "resolver-null",
+            lines: vec![
+                line(
+                    "measures",
+                    "08:00:00.000Z",
+                    r#"{"phase":"start","scopeFiles":1,"scopeResolver":null}"#,
+                ),
+                line("started", "08:00:01.000Z", "{}"),
+            ],
+            expected: Some(expected(1.0, ScopeResolver::Other, 1, false, None)),
+        },
+    ]
+}
+
+/// The rows measuring durations and the first attempt's fate.
+fn duration_rows() -> Vec<Row> {
+    vec![
+        Row {
+            name: "retry",
+            lines: vec![
+                line(
+                    "measures",
+                    "08:00:00.000Z",
+                    r#"{"phase":"start","scopeFiles":5}"#,
+                ),
+                line("started", "08:00:01.000Z", "{}"),
+                line("dead", "08:02:00.000Z", "{}"),
+                line("measures", "08:02:00.000Z", r#"{"phase":"end"}"#),
+                String::from("not json"),
+                line("started", "08:10:00.000Z", "{}"),
+                line(
+                    "measures",
+                    "08:10:00.000Z",
+                    r#"{"phase":"start","scopeFiles":6}"#,
+                ),
+                line("done", "08:12:00.000Z", "{}"),
+                line("measures", "08:12:30.000Z", r#"{"phase":"end"}"#),
+            ],
+            expected: Some(expected(
+                5.0,
+                ScopeResolver::Legacy,
+                2,
+                false,
+                Some(270_000),
+            )),
+        },
+        Row {
+            name: "negative-start",
+            lines: vec![
+                line(
+                    "measures",
+                    "08:00:00.000Z",
+                    r#"{"phase":"start","scopeFiles":-1}"#,
+                ),
+                line(
+                    "measures",
+                    "08:00:01.000Z",
+                    r#"{"phase":"start","scopeFiles":4}"#,
+                ),
+                line("started", "08:00:02.000Z", "{}"),
+                line("regressed", "08:00:03.000Z", "{}"),
+                line("done", "08:00:04.000Z", "{}"),
+            ],
+            expected: Some(expected(4.0, ScopeResolver::Legacy, 1, false, None)),
+        },
+        Row {
+            name: "zero-duration",
+            lines: vec![
+                line(
+                    "measures",
+                    "08:00:00.000Z",
+                    r#"{"phase":"start","scopeFiles":2}"#,
+                ),
+                line(
+                    "measures",
+                    "08:00:00.000Z",
+                    r#"{"phase":"end","scopeHashes":["a"]}"#,
+                ),
+                line("started", "08:00:01.000Z", "{}"),
+                line("done", "08:00:02.000Z", "{}"),
+            ],
+            expected: Some(expected(2.0, ScopeResolver::Legacy, 1, true, Some(0))),
+        },
+    ]
+}
+
+/// The rows that pass over a bad timestamp, missing start or bad scope size.
+fn missing_rows() -> Vec<Row> {
+    vec![
+        Row {
+            name: "bad-timestamps",
+            lines: vec![
+                line(
+                    "measures",
+                    "08:05:00.000Z",
+                    r#"{"phase":"start","scopeFiles":2}"#,
+                ),
+                line("measures", "08:04:00.000Z", r#"{"phase":"end"}"#),
+                line("measures", "bad", r#"{"phase":"start","scopeFiles":2}"#),
+                line("measures", "08:06:00.000Z", r#"{"phase":"end"}"#),
+            ],
+            expected: Some(expected(2.0, ScopeResolver::Legacy, 0, false, None)),
+        },
+        Row {
+            name: "no-start-measure",
+            lines: vec![
+                line("started", "08:00:00.000Z", "{}"),
+                line("done", "08:01:00.000Z", "{}"),
+            ],
+            expected: None,
+        },
+        Row {
+            name: "string-scope-files",
+            lines: vec![line(
+                "measures",
+                "08:00:00.000Z",
+                r#"{"phase":"start","scopeFiles":"2"}"#,
+            )],
+            expected: None,
+        },
+    ]
+}
+
+/// Every "Task sizes of task streams" row, in the table's order.
+fn rows() -> Vec<Row> {
+    let mut rows = resolver_rows();
+    rows.extend(duration_rows());
+    rows.extend(missing_rows());
+    rows
+}
+
+/// Writes a row's task file and event lines into its folder.
+fn write_row(folder: &Path, lines: &[String]) {
+    write(&folder.join("tasks").join("1.md"), TASK_FILE);
+    if lines.is_empty() {
+        return;
+    }
+    let content = lines.join("\n") + "\n";
+    write(
+        &folder.join(".run").join("events").join("1.jsonl"),
+        &content,
+    );
+}
+
+/// Proves every row of the "Task sizes of task streams" table.
+///
+/// Covers: rust-storage/task-sizes-of-task-streams
+#[test]
+fn task_sizes_of_task_streams() {
+    for row in rows() {
+        let folder = scratch("task_sizes_of_task_streams", row.name);
+        write_row(&folder, &row.lines);
+        let expected = row.expected.into_iter().collect::<Vec<_>>();
+        assert_eq!(read_task_sizes(&folder), expected, "{}", row.name);
+    }
+}
+
+/// Proves task-file order, unreadable metadata and a missing tasks folder.
+///
+/// Covers: rust-storage/task-files-without-a-measured-stream
+#[test]
+fn task_files_without_a_measured_stream() {
+    let folder = scratch("task_files_without_a_measured_stream", "mixed");
+    write(&folder.join("tasks").join("2.md"), TASK_FILE);
+    write(&folder.join("tasks").join("3.md"), TASK_FILE);
+    write(&folder.join("tasks").join("10.md"), "not a task");
+    write(&folder.join("tasks").join("notes.txt"), TASK_FILE);
+    let content = measured_lines().join("\n") + "\n";
+    write(
+        &folder.join(".run").join("events").join("2.jsonl"),
+        &content,
+    );
+    write(
+        &folder.join(".run").join("events").join("10.jsonl"),
+        &content,
+    );
+    let tasks = read_task_sizes(&folder);
+    assert_eq!(
+        tasks
+            .iter()
+            .map(|task| task.task.as_str())
+            .collect::<Vec<_>>(),
+        vec!["2", "10"]
+    );
+    assert_eq!(tasks[0].title, "When one runs, it passes");
+    assert_eq!(tasks[0].acceptance_lines, 3);
+    assert_eq!(tasks[0].scope_files, 2.0);
+    assert_eq!(tasks[1].title, "");
+    assert_eq!(tasks[1].acceptance_lines, 0);
+    assert_eq!(tasks[1].scope_files, 2.0);
+
+    let empty = scratch("task_files_without_a_measured_stream", "no-tasks");
+    assert_eq!(read_task_sizes(&empty), Vec::<TaskSize>::new());
+}
+
+/// Proves a resolution before the first start does not decide the first attempt.
+///
+/// Covers: rust-storage/task-sizes-of-task-streams
+#[test]
+fn first_attempt_edges() {
+    let cases = [
+        (
+            "regressed-before-start",
+            vec![
+                line(
+                    "measures",
+                    "08:00:00.000Z",
+                    r#"{"phase":"start","scopeFiles":2}"#,
+                ),
+                line("regressed", "08:00:01.000Z", "{}"),
+                line("started", "08:00:02.000Z", "{}"),
+                line("done", "08:00:03.000Z", "{}"),
+            ],
+            true,
+        ),
+        (
+            "done-before-start",
+            vec![
+                line(
+                    "measures",
+                    "08:00:00.000Z",
+                    r#"{"phase":"start","scopeFiles":2}"#,
+                ),
+                line("done", "08:00:01.000Z", "{}"),
+                line("started", "08:00:02.000Z", "{}"),
+            ],
+            false,
+        ),
+    ];
+    for (name, lines, expected) in cases {
+        let folder = scratch("first_attempt_edges", name);
+        write_row(&folder, &lines);
+        let tasks = read_task_sizes(&folder);
+        assert_eq!(tasks.len(), 1, "{name}");
+        assert_eq!(tasks[0].first_attempt_pass, expected, "{name}");
+    }
+}
