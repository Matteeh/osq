@@ -0,0 +1,219 @@
+//! Measuring one change folder's tasks as TypeScript's report measures them.
+//!
+//! Implements: rust-storage/task-sizes
+
+use std::fs;
+use std::path::Path;
+
+use osq_kernel_specs::parse_task_file;
+use serde_json::Value;
+
+use super::compare_names;
+use super::stream::{self, Event};
+use crate::read::text::timestamp_ms;
+
+/// One measured task of a change folder.
+///
+/// Implements: rust-storage/task-sizes
+#[derive(Clone, Debug, PartialEq)]
+pub struct TaskSize {
+    /// The task id, the task file's name without `.md`.
+    pub task: String,
+    /// The task file's title, or empty text without one.
+    pub title: String,
+    /// The number of acceptance items in the task file.
+    pub acceptance_lines: usize,
+    /// The files in the last measured end's `scopeHashes`, else the start's size.
+    pub scope_files: f64,
+    /// The scope resolver generation the first start measure names.
+    pub resolver: ScopeResolver,
+    /// The number of `started` events.
+    pub attempts: u64,
+    /// Whether a `done` event resolved the first attempt.
+    pub first_attempt_pass: bool,
+    /// The summed measured start-to-end lengths, or `None` without one.
+    pub duration_ms: Option<i64>,
+}
+
+/// The scope resolver generation a start measure names.
+///
+/// Implements: rust-storage/task-sizes
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ScopeResolver {
+    /// No `scopeResolver` member.
+    Legacy,
+    /// The number 2.
+    Second,
+    /// Any other value.
+    Other,
+}
+
+/// Reads the measured tasks of one change folder, in task-file order.
+///
+/// Implements: rust-storage/task-sizes
+#[must_use]
+pub fn read_task_sizes(folder: &Path) -> Vec<TaskSize> {
+    let dir = folder.join("tasks");
+    let Ok(entries) = fs::read_dir(dir) else {
+        return Vec::new();
+    };
+    let mut names: Vec<String> = entries
+        .flatten()
+        .filter_map(|entry| {
+            let name = entry.file_name().into_string().ok()?;
+            name.strip_suffix(".md").is_some().then_some(name)
+        })
+        .collect();
+    names.sort_by(|left, right| compare_names(left, right));
+    names
+        .into_iter()
+        .filter_map(|name| task_size(folder, &name))
+        .collect()
+}
+
+/// One task file's measured size, or `None` without a readable measured stream.
+fn task_size(folder: &Path, name: &str) -> Option<TaskSize> {
+    let task = name.strip_suffix(".md").unwrap_or(name);
+    let path = folder
+        .join(".run")
+        .join("events")
+        .join(format!("{task}.jsonl"));
+    let content = fs::read_to_string(path).ok()?;
+    let events = stream::parse(&content);
+    let measured = measure(&events)?;
+    let (title, acceptance_lines) = task_metadata(folder, task);
+    let (attempts, first_attempt_pass) = observe_attempts(&events);
+    Some(TaskSize {
+        task: task.to_owned(),
+        title,
+        acceptance_lines,
+        scope_files: measured.scope_files,
+        resolver: measured.resolver,
+        attempts,
+        first_attempt_pass,
+        duration_ms: measured.duration_ms,
+    })
+}
+
+/// The measures a task's stream yields, or `None` without a valid start.
+struct Measure {
+    /// The first valid start's `scopeFiles`.
+    scope_files: f64,
+    /// The start's resolver generation.
+    resolver: ScopeResolver,
+    /// The summed measured lengths, or `None` without a valid pair.
+    duration_ms: Option<i64>,
+}
+
+/// Folds the stream's measures into its scope size, resolver and duration.
+fn measure(events: &[Event]) -> Option<Measure> {
+    let mut start_scope_files = None;
+    let mut resolver = ScopeResolver::Legacy;
+    let mut latest_hashes = None;
+    let mut pending_start = None;
+    let mut covered = 0;
+    let mut has_duration = false;
+    for event in events {
+        if event.kind() != Some("measures") {
+            continue;
+        }
+        match event.text("phase") {
+            Some("start") => {
+                if start_scope_files.is_none() {
+                    if let Some(scope_files) =
+                        event.number("scopeFiles").filter(|size| *size >= 0.0)
+                    {
+                        start_scope_files = Some(scope_files);
+                        resolver = resolver_of(event);
+                    }
+                }
+                pending_start = event.timestamp().and_then(timestamp_ms);
+            }
+            Some("end") => {
+                let end = event.timestamp().and_then(timestamp_ms);
+                if let (Some(start), Some(end)) = (pending_start, end)
+                    && end >= start
+                {
+                    covered += end - start;
+                    has_duration = true;
+                }
+                pending_start = None;
+                if let Some(keys) = scope_hashes(event) {
+                    latest_hashes = Some(keys);
+                }
+            }
+            _ => {}
+        }
+    }
+    let start_scope_files = start_scope_files?;
+    Some(Measure {
+        scope_files: latest_hashes.map_or(start_scope_files, |keys| {
+            f64::from(u32::try_from(keys).unwrap_or(u32::MAX))
+        }),
+        resolver,
+        duration_ms: has_duration.then_some(covered),
+    })
+}
+
+/// The number of keys of an end measure's object `scopeHashes`, or `None`.
+fn scope_hashes(event: &Event) -> Option<usize> {
+    match event.value("scopeHashes") {
+        Some(Value::Object(hashes)) => Some(hashes.len()),
+        _ => None,
+    }
+}
+
+/// The resolver generation a valid start measure names.
+fn resolver_of(event: &Event) -> ScopeResolver {
+    match event.value("scopeResolver") {
+        None => ScopeResolver::Legacy,
+        Some(_) if event.number("scopeResolver") == Some(2.0) => ScopeResolver::Second,
+        Some(_) => ScopeResolver::Other,
+    }
+}
+
+/// Counts attempts and whether a `done` resolved the first one.
+fn observe_attempts(events: &[Event]) -> (u64, bool) {
+    let mut attempts = 0;
+    let mut first_active = false;
+    let mut first_resolved = false;
+    let mut first_pass = false;
+    for event in events {
+        match event.kind() {
+            Some("started") => {
+                attempts += 1;
+                if first_active {
+                    first_resolved = true;
+                    first_active = false;
+                } else if !first_resolved {
+                    first_active = true;
+                }
+            }
+            Some("done") => {
+                if first_active && !first_resolved {
+                    first_pass = true;
+                    first_resolved = true;
+                    first_active = false;
+                }
+            }
+            Some("dead" | "regressed") if first_active && !first_resolved => {
+                first_resolved = true;
+                first_active = false;
+            }
+            _ => {}
+        }
+    }
+    (attempts, first_pass)
+}
+
+/// A task file's title and acceptance count, or empty values without one.
+fn task_metadata(folder: &Path, task: &str) -> (String, usize) {
+    let path = folder.join("tasks").join(format!("{task}.md"));
+    let Ok(text) = fs::read_to_string(path) else {
+        return (String::new(), 0);
+    };
+    parse_task_file(&text).map_or_else(
+        |_| (String::new(), 0),
+        |file| (file.title, file.acceptance.len()),
+    )
+}
