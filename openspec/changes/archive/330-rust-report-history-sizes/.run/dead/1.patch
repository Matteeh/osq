@@ -0,0 +1,93 @@
+//! Reading the packages a change folder's tasks added to manifests.
+//!
+//! Implements: rust-storage/dependencies-added
+
+use std::fs;
+use std::path::Path;
+
+use osq_kernel_specs::js_trim;
+use serde_json::Value;
+
+use super::compare_names;
+use super::stream;
+
+/// One package added to one manifest.
+///
+/// Implements: rust-storage/dependencies-added
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct DependencyPair {
+    /// The manifest's path, trimmed.
+    pub file: String,
+    /// The package's name, trimmed.
+    pub name: String,
+}
+
+/// Reads the distinct packages one change folder's tasks added, sorted.
+///
+/// Implements: rust-storage/dependencies-added
+#[must_use]
+pub fn read_dependencies_added(folder: &Path) -> Vec<DependencyPair> {
+    let dir = folder.join(".run").join("events");
+    let Ok(entries) = fs::read_dir(&dir) else {
+        return Vec::new();
+    };
+    let mut names: Vec<String> = entries
+        .flatten()
+        .filter_map(|entry| {
+            let name = entry.file_name().into_string().ok()?;
+            is_event_file(&name).then_some(name)
+        })
+        .collect();
+    names.sort_by(|left, right| compare_names(left, right));
+    let mut pairs: Vec<DependencyPair> = names
+        .into_iter()
+        .flat_map(|name| stream_pairs(&dir.join(name)))
+        .collect();
+    pairs.sort_by(|left, right| {
+        left.file
+            .cmp(&right.file)
+            .then_with(|| left.name.cmp(&right.name))
+    });
+    pairs.dedup();
+    pairs
+}
+
+/// Whether a file name is digits then `.jsonl`.
+fn is_event_file(name: &str) -> bool {
+    name.strip_suffix(".jsonl")
+        .is_some_and(|stem| !stem.is_empty() && stem.bytes().all(|byte| byte.is_ascii_digit()))
+}
+
+/// One stream's valid added pairs, in file order.
+fn stream_pairs(path: &Path) -> Vec<DependencyPair> {
+    let Ok(content) = fs::read_to_string(path) else {
+        return Vec::new();
+    };
+    stream::parse(&content)
+        .into_iter()
+        .filter(|event| event.kind() == Some("dependencies_added"))
+        .flat_map(|event| added_pairs(event.value("added")))
+        .collect()
+}
+
+/// The valid pairs of one `added` value, or none when it is not an array.
+fn added_pairs(value: Option<&Value>) -> Vec<DependencyPair> {
+    let Some(Value::Array(items)) = value else {
+        return Vec::new();
+    };
+    items.iter().filter_map(pair).collect()
+}
+
+/// One `{file, name}` entry with both strings non-blank after trimming.
+fn pair(value: &Value) -> Option<DependencyPair> {
+    let object = value.as_object()?;
+    let file = js_trim(object.get("file")?.as_str()?);
+    let name = js_trim(object.get("name")?.as_str()?);
+    if file.is_empty() || name.is_empty() {
+        return None;
+    }
+    Some(DependencyPair {
+        file: file.to_owned(),
+        name: name.to_owned(),
+    })
+}
