@@ -0,0 +1,134 @@
+//! Proves reading change fixes and result disclosures from change folders.
+
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use osq_kernel_storage::{TaskDisclosure, read_change_fixes, read_result_disclosures};
+
+/// A fresh change folder under `CARGO_TARGET_TMPDIR`.
+fn scratch(test: &str, name: &str) -> PathBuf {
+    let folder = Path::new(env!("CARGO_TARGET_TMPDIR"))
+        .join("reading_change_records")
+        .join(test)
+        .join(name);
+    let _ = fs::remove_dir_all(&folder);
+    fs::create_dir_all(&folder).expect("the scratch change folder is created");
+    folder
+}
+
+/// Writes a file, creating its parent folders.
+fn write(path: &Path, text: &str) {
+    if let Some(parent) = path.parent() {
+        fs::create_dir_all(parent).expect("the parent folder is created");
+    }
+    fs::write(path, text).expect("the file is written");
+}
+
+/// The fixture project holding the result files.
+fn files_fixture() -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/fixtures/files")
+}
+
+/// One row of the "Fixes of change folders" table.
+struct Row {
+    /// The scratch folder's name.
+    name: &'static str,
+    /// The files, by name and text.
+    files: Vec<(&'static str, &'static str)>,
+    /// The ids the row expects.
+    expected: Vec<String>,
+}
+
+/// Every "Fixes of change folders" row, in the table's order.
+fn rows() -> Vec<Row> {
+    vec![
+        Row {
+            name: "numeric-and-string",
+            files: vec![("proposal.md", "---\nfixes: [201, \"201\"]\n---\n")],
+            expected: vec![String::from("201"), String::from("201")],
+        },
+        Row {
+            name: "pads-numbers",
+            files: vec![("proposal.md", "---\nfixes: [1, abc]\n---\n")],
+            expected: vec![String::from("001"), String::from("abc")],
+        },
+        Row {
+            name: "no-fixes",
+            files: vec![("proposal.md", "---\ntitle: Quiet\n---\n")],
+            expected: Vec::new(),
+        },
+        Row {
+            name: "legacy-spec",
+            files: vec![("spec.md", "---\nfixes: [7]\n---\n")],
+            expected: vec![String::from("007")],
+        },
+        Row {
+            name: "proposal-wins",
+            files: vec![
+                ("proposal.md", "---\ntitle: Quiet\n---\n"),
+                ("spec.md", "---\nfixes: [7]\n---\n"),
+            ],
+            expected: Vec::new(),
+        },
+        Row {
+            name: "broken-proposal",
+            files: vec![("proposal.md", "---\nfixes: [\n---\n")],
+            expected: Vec::new(),
+        },
+        Row {
+            name: "no-file",
+            files: Vec::new(),
+            expected: Vec::new(),
+        },
+    ]
+}
+
+/// Proves every row of the "Fixes of change folders" table.
+///
+/// Covers: rust-storage/fixes-of-change-folders
+#[test]
+fn fixes_of_change_folders() {
+    for row in rows() {
+        let folder = scratch("fixes_of_change_folders", row.name);
+        for (name, text) in &row.files {
+            write(&folder.join(name), text);
+        }
+        assert_eq!(read_change_fixes(&folder), row.expected, "{}", row.name);
+    }
+}
+
+/// Proves the disclosures the files fixture holds and the silent folder's none.
+///
+/// Covers: rust-storage/disclosure-reader-on-the-files-fixture
+#[test]
+fn disclosure_reader_on_the_files_fixture() {
+    let changes = files_fixture().join("openspec").join("changes");
+    let told = read_result_disclosures(&changes.join("archive").join("001-told"));
+    let expected = vec![
+        TaskDisclosure {
+            task: String::from("1"),
+            deviated: Some(String::from(
+                "- Kept the old name.\n  It reads better.\n\n- Split one file.",
+            )),
+            missing_context: None,
+            outside_scope: Some(String::from("The listing skips hidden folders.")),
+        },
+        TaskDisclosure {
+            task: String::from("2"),
+            deviated: Some(String::from("Used a map.\n\nAnd a second deviation.")),
+            missing_context: None,
+            outside_scope: None,
+        },
+        TaskDisclosure {
+            task: String::from("10"),
+            deviated: None,
+            missing_context: Some(String::from("Nonexistent file named in the task.")),
+            outside_scope: Some(String::from("None\nThe second line keeps this section.")),
+        },
+    ];
+    assert_eq!(told, expected);
+    assert_eq!(
+        read_result_disclosures(&changes.join("archive").join("002-silent")),
+        Vec::<TaskDisclosure>::new()
+    );
+}
