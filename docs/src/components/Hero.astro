---
import DemoCard from './DemoCard.astro';
import { installCommand, links } from '../data/site';
---

<section class="hero">
  <canvas id="circuit" aria-hidden="true"></canvas>
  <div class="wrap">
    <div id="hero-copy">
      <span class="pill accent">Open source · MIT</span>
      <h1>Let AI write the code.<br /><em>Keep the checks it can't skip.</em></h1>
      <p class="lede">osq turns a short brief into a plan you approve, hands each small task to a coding agent, and runs the tests itself before anything counts as done. Every step leaves a file you can read later.</p>
      <div class="cta">
        <a class="btn" href="#start">Get started</a>
        <a class="btn secondary" href={links.github}>View on GitHub</a>
      </div>
      <div class="install">
        <code data-install><span class="dim">$</span> {installCommand}</code>
        <button class="copy" type="button" data-copy={installCommand}>Copy</button>
      </div>
    </div>
    <DemoCard />
  </div>
</section>

<script>
  import { startCircuit } from '../scripts/circuit';

  const canvas = document.getElementById('circuit');
  const copy = document.getElementById('hero-copy');
  const card = document.getElementById('hero-card');
  if (canvas instanceof HTMLCanvasElement && copy && card) startCircuit(canvas, copy, card);

  // Copy the install command; where the clipboard is refused, select it instead.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    button.addEventListener('click', async () => {
      const done = (label: string) => {
        button.textContent = label;
        setTimeout(() => (button.textContent = 'Copy'), 1600);
      };
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        done('Copied');
      } catch {
        const code = button.parentElement?.querySelector('[data-install]');
        if (code) window.getSelection()?.selectAllChildren(code);
        done('Select');
      }
    });
  }
</script>

<style>
  .hero { padding-block: clamp(72px, 10vw, 128px) clamp(80px, 11vw, 144px); position: relative; overflow: hidden; isolation: isolate; }
  #circuit {
    position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 18%, #000 82%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 18%, #000 82%, transparent 100%);
  }
  /* the wide column gap leaves room for the chip between the copy and the card */
  .wrap { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: 48px 232px; align-items: center; }
  h1 { margin-top: 24px; font-family: var(--serif); font-weight: 500; font-size: clamp(36px, 5.2vw, 58px); line-height: 1.08; letter-spacing: -0.02em; }
  em { font-style: italic; color: var(--accent); }
  .lede { margin-top: 28px; font-size: 18px; line-height: 1.65; text-wrap: pretty; }
  .cta { display: flex; gap: 12px; margin-top: 40px; flex-wrap: wrap; align-items: center; }
  .install { margin-top: 24px; display: flex; align-items: center; gap: 10px; background: var(--code-bg); color: var(--code-fg); font-family: var(--mono); font-size: 14px; border-radius: 6px; padding: 10px 10px 10px 14px; max-width: 100%; }
  code { flex: 1; min-width: 0; overflow-x: auto; white-space: nowrap; }
  .dim { color: var(--code-dim); }
  .copy { font: 500 12px var(--sans); background: transparent; color: var(--code-fg); border: 1px solid var(--code-dim); border-radius: 4px; padding: 6px 10px; cursor: pointer; min-height: 32px; }
  @media (max-width: 760px) {
    .wrap { grid-template-columns: minmax(0, 1fr); gap: 128px 32px; }
  }
</style>
