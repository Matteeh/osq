---
/*
 * A self-playing example of one change moving through osq. The change, its files and the flag are
 * made up; the commands and how each step behaves match osq today. Driven by scripts/demo.ts.
 */
const stages = [
  { id: 'plan', label: 'Plan' },
  { id: 'lint', label: 'Lint' },
  { id: 'approve', label: 'Approve' },
  { id: 'run', label: 'Run' },
  { id: 'land', label: 'Land' },
];
const planned = [
  { file: 'proposal.md', note: 'goal, verify, non-goals' },
  { file: 'specs/orders/spec.md', note: '2 new requirements' },
  { file: 'tasks/1.md to 4.md', note: 'each with its own files and test' },
];
const lintChecks = [
  { title: 'Proposal sections', note: 'goal, verify, non-goals, delta' },
  { title: 'Every task has a scope and a test', note: '4 of 4 tasks' },
  { title: 'Spec changes are valid', note: 'orders: 2 added' },
  { title: 'Task order', note: '4 waits for 3' },
];
const tasks = ['Cancel endpoint', 'Release reserved stock', 'Refund on cancel', 'Customer email'];
---

<div class="card demo" id="hero-card" role="region" aria-label="Example: a change moving through osq">
  <div class="head"><span class="mono">042-order-cancellation</span><span class="pill" data-state>planning</span></div>
  <div class="tabs" role="tablist" aria-label="Stages">
    {stages.map((s, i) => (
      <button type="button" role="tab" id={`tab-${s.id}`} data-tab={s.id} aria-controls={`pane-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'}>{s.label}</button>
    ))}
  </div>
  <div class="body">
    <div class="pane" id="pane-plan" data-pane="plan" role="tabpanel" aria-labelledby="tab-plan">
      <div class="cmd">$ <b>osq plan order-cancellation --brief brief.md</b></div>
      <div class="brief"><span data-brief></span><span class="caret" aria-hidden="true"></span></div>
      {planned.map((p) => (
        <div class="row reveal"><div><div class="t file">{p.file}</div><div class="k">{p.note}</div></div><span class="pill">written</span></div>
      ))}
    </div>

    <div class="pane" id="pane-lint" data-pane="lint" role="tabpanel" aria-labelledby="tab-lint" hidden>
      <div class="cmd">$ <b>osq lint order-cancellation</b></div>
      {lintChecks.map((c) => (
        <div class="row reveal"><div><div class="t">{c.title}</div><div class="k">{c.note}</div></div><span class="ok">ok</span></div>
      ))}
      <div class="foot reveal"><span>0 findings. Ready for a human.</span><span class="file">osq lint</span></div>
    </div>

    <div class="pane" id="pane-approve" data-pane="approve" role="tabpanel" aria-labelledby="tab-approve" hidden>
      <div class="cmd">$ <b>osq approve 042</b></div>
      <div class="row"><div><div class="t">Goal</div><div class="k">Customers can cancel an order before it ships</div></div></div>
      <div class="row"><div><div class="t">4 tasks</div><div class="k">9 files in scope · tests for each</div></div><span class="pill">digest</span></div>
      <div class="row"><div><div class="t">Requirements</div><div class="k">+2 in orders</div></div><span class="pill">digest</span></div>
      <div class="row"><div><div class="t">1 flag: shared file</div><div class="k file">src/orders/cancel.ts in tasks 1 and 3</div></div><span class="pill red">look</span></div>
      <div class="foot"><span data-approve-note>Nothing runs until you approve.</span><button type="button" class="act" data-approve>Approve</button></div>
    </div>

    <div class="pane" id="pane-run" data-pane="run" role="tabpanel" aria-labelledby="tab-run" hidden>
      <div class="cmd">$ <b>osq watch</b></div>
      {tasks.map((name, i) => (
        <div class="row" data-task><div><div class="t">{i + 1}. {name}</div><div class="k">{i === 3 ? 'waits for task 3' : 'waiting'}</div></div><span class="pill">queued</span></div>
      ))}
      <div class="foot"><span data-run-count>Agent said "done" 0 times. osq checked 0 times.</span><span class="file" data-run-cost>$0.00</span></div>
    </div>

    <div class="pane" id="pane-land" data-pane="land" role="tabpanel" aria-labelledby="tab-land" hidden>
      <div class="cmd">$ <b>osq land 042</b></div>
      <div class="row reveal"><div><div class="t">Final check</div><div class="k">every task's test re-run on the finished code</div></div><span class="ok">passed</span></div>
      <div class="row reveal"><div><div class="t">Specs updated</div><div class="k file">openspec/specs/orders/spec.md</div></div><span class="ok">+2</span></div>
      <div class="row reveal"><div><div class="t">Cost of the change</div><div class="k">planning $0.38 · tasks $1.64 · from osq report</div></div><span class="ok">$2.02</span></div>
      <div class="row reveal"><div><div class="t">Change archived</div><div class="k file">openspec/changes/archive/042-…</div></div><span class="ok">ok</span></div>
      <div class="foot"><span data-land-note>Ready to merge into main.</span><button type="button" class="act" data-land>Land</button></div>
    </div>
  </div>
  <div class="cursor" data-cursor aria-hidden="true">
    <svg viewBox="0 0 18 22"><path d="M1.5 1.5 L1.5 17.5 L5.8 13.6 L8.6 20 L11.4 18.8 L8.7 12.6 L14.6 12.4 Z"></path></svg>
  </div>
</div>

<script>
  import { startDemo } from '../scripts/demo';

  const card = document.getElementById('hero-card');
  if (card) startDemo(card);
</script>

<style>
  .demo { position: relative; transition: box-shadow 0.4s ease; }
  .demo.zap { box-shadow: 0 0 0 1px var(--accent-soft), 0 0 14px -6px var(--streak); }
  .head { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 16px 20px 0; font-size: 12px; color: var(--muted); }
  .tabs { display: flex; gap: 4px; padding: 12px 16px 14px; border-bottom: 1px solid var(--line); overflow-x: auto; }
  .tabs button { font: 500 12.5px var(--sans); color: var(--muted); background: transparent; border: 0; border-radius: 5px; padding: 0 10px; min-height: 32px; cursor: pointer; white-space: nowrap; }
  .tabs button:hover { color: var(--fg); background: var(--pill); }
  .tabs button[aria-selected='true'] { color: var(--accent-soft-fg); background: var(--accent-soft); font-weight: 600; }
  .body { position: relative; height: 392px; overflow: hidden; }
  .pane { position: absolute; inset: 0; display: flex; flex-direction: column; }
  .cmd { font-family: var(--mono); font-size: 12px; color: var(--muted); padding: 16px 20px 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cmd b { color: var(--fg); font-weight: 500; }
  .brief { margin: 0 20px 12px; padding: 12px 14px; border-radius: 6px; background: var(--bg); font-size: 13px; min-height: 58px; }
  .caret { display: inline-block; width: 7px; height: 14px; background: var(--accent); vertical-align: -2px; margin-left: 1px; }
  .row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 20px; min-height: 52px; border-top: 1px solid var(--line); }
  .row > div { min-width: 0; }
  .t { font-size: 14px; }
  .t.file { font-size: 12.5px; color: var(--fg); }
  .k { font-size: 12px; color: var(--muted); }
  .reveal { opacity: 0; transform: translateY(4px); transition: opacity 0.35s ease, transform 0.35s ease; }
  .reveal.on { opacity: 1; transform: none; }
  .ok { color: var(--green-fg); font-weight: 600; font-size: 12px; }
  .foot { margin-top: auto; padding: 14px 20px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center; gap: 10px; font-size: 12px; color: var(--muted); }
  .act { min-height: 36px; padding: 0 16px; border-radius: 6px; border: 0; background: var(--accent); color: var(--surface); font: 600 13px var(--sans); cursor: pointer; transition: transform 0.12s ease, filter 0.2s ease; }
  .act.pressed { transform: scale(0.95); filter: brightness(0.9); }
  .act[disabled] { background: var(--pill); color: var(--muted); cursor: default; }
  .cursor { position: absolute; left: 0; top: 0; width: 18px; height: 22px; pointer-events: none; z-index: 5; opacity: 0; transition: transform 0.7s cubic-bezier(0.4, 0.1, 0.2, 1), opacity 0.3s ease; }
  .cursor svg { display: block; width: 18px; height: 22px; }
  .cursor path { fill: var(--fg); stroke: var(--surface); stroke-width: 1.4; }
  .cursor::after { content: ''; position: absolute; left: -9px; top: -9px; width: 18px; height: 18px; border-radius: 50%; border: 2px solid var(--accent); opacity: 0; transform: scale(0.4); }
  .cursor.click::after { animation: ripple 0.5s ease-out; }
  @keyframes ripple {
    0% { opacity: 0.9; transform: scale(0.4); }
    100% { opacity: 0; transform: scale(1.6); }
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal, .cursor, .demo { transition: none; }
    .cursor { display: none; }
  }
</style>
